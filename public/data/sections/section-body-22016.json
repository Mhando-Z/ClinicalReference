{"id": "section-body-22016", "title": "Regular Wide QRS Tachycardias", "chapterId": "chapter-twenty", "tocLevel": 4, "tocPath": ["APPROACH TO PATIENTS WITH EMERGENCY CONDITIONS", "CARDIOVASCULAR DISEASE CONDITIONS", "Cardiac Arrhythmias/ Dysrhythmias", "Regular Wide QRS Tachycardias"], "blocks": [{"id": "body-22016", "type": "heading", "style": "Heading4", "text": "Regular Wide QRS Tachycardias", "runs": [{"text": "Regular"}, {"text": " "}, {"text": "Wide"}, {"text": " "}, {"text": "QRS"}, {"text": " "}, {"text": "Tachycardias"}], "level": 4, "list": {"level": 3, "numberingId": "781"}}, {"id": "body-22017", "type": "paragraph", "style": "BodyText", "text": "These are ventricular tachycardias until proved otherwise. Regular wide QRS supraventricular tachycardias are uncommon.", "runs": [{"text": "These"}, {"text": " "}, {"text": "are"}, {"text": " "}, {"text": "ventricular"}, {"text": " "}, {"text": "tachycardias"}, {"text": " "}, {"text": "until"}, {"text": " "}, {"text": "proved"}, {"text": " "}, {"text": "otherwise."}, {"text": " "}, {"text": "Regular"}, {"text": " "}, {"text": "wide"}, {"text": " "}, {"text": "QRS"}, {"text": " "}, {"text": "supraventricular"}, {"text": " "}, {"text": "tachycardias"}, {"text": " "}, {"text": "are"}, {"text": " "}, {"text": "uncommon."}]}, {"id": "body-22019", "type": "heading", "style": "Heading4", "text": "Non-Pharmacological Management", "runs": [{"text": "Non-Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-22020", "type": "paragraph", "style": "BodyText", "text": "Refer all cases after resuscitation and stabilization. Emergency DC cardioversion is mandatory with a full protocol of Cardiopulmonary Resuscitation (CPR)", "runs": [{"text": "Refer"}, {"text": " "}, {"text": "all"}, {"text": " "}, {"text": "cases"}, {"text": " "}, {"text": "after"}, {"text": " "}, {"text": "resuscitation"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "stabilization."}, {"text": " "}, {"text": "Emergency"}, {"text": " "}, {"text": "DC"}, {"text": " "}, {"text": "cardioversion"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "mandatory"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "full"}, {"text": " "}, {"text": "protocol"}, {"text": " "}, {"text": "of Cardiopulmonary Resuscitation (CPR)"}]}, {"id": "body-22021", "type": "paragraph", "style": "ListParagraph", "text": "If no cardiac arrest: DC cardioversion, 200J, after sedation with: Diazepam, I.V, 10–20mg If 200J fails, use 360J.", "runs": [{"text": "If"}, {"text": " "}, {"text": "no"}, {"text": " "}, {"text": "cardiac"}, {"text": " "}, {"text": "arrest:"}, {"text": " "}, {"text": "DC"}, {"text": " "}, {"text": "cardioversion,"}, {"text": " "}, {"text": "200J,"}, {"text": " "}, {"text": "after"}, {"text": " "}, {"text": "sedation"}, {"text": " "}, {"text": "with:"}, {"text": " "}, {"text": "Diazepam,"}, {"text": " "}, {"text": "I.V,"}, {"text": " "}, {"text": "10–20mg"}, {"text": " "}, {"text": "If"}, {"text": " "}, {"text": "200J"}, {"text": " "}, {"text": "fails,"}, {"text": " "}, {"text": "use"}, {"text": " "}, {"text": "360J."}], "list": {"level": 4, "numberingId": "781"}}, {"id": "body-22022", "type": "paragraph", "style": "ListParagraph", "text": "If cardiac arrest: Defibrillate (not synchronized).", "runs": [{"text": "If"}, {"text": " "}, {"text": "cardiac"}, {"text": " "}, {"text": "arrest:"}, {"text": " "}, {"text": "Defibrillate"}, {"text": " "}, {"text": "(not"}, {"text": " "}, {"text": "synchronized)."}], "list": {"level": 4, "numberingId": "781"}}, {"id": "body-22023", "type": "heading", "style": "Heading4", "text": "Pharmacological Management", "runs": [{"text": "Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-22024", "type": "paragraph", "style": "BodyText", "text": "DC cardioversion is first line therapy for regular wide QRS tachycardias. Medicines are needed if VT recurs after cardioversion or if spontaneous termination/recurrence.", "runs": [{"text": "DC"}, {"text": " "}, {"text": "cardioversion"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "first"}, {"text": " "}, {"text": "line"}, {"text": " "}, {"text": "therapy"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "regular"}, {"text": " "}, {"text": "wide"}, {"text": " "}, {"text": "QRS"}, {"text": " "}, {"text": "tachycardias."}, {"text": " "}, {"text": "Medicines"}, {"text": " "}, {"text": "are"}, {"text": " "}, {"text": "needed"}, {"text": " "}, {"text": "if"}, {"text": " "}, {"text": "VT"}, {"text": " "}, {"text": "recurs"}, {"text": " "}, {"text": "after"}, {"text": " "}, {"text": "cardioversion or if spontaneous termination/recurrence."}]}, {"id": "body-22026", "type": "paragraph", "style": "BodyText", "text": "S: amiodarone (IV) 5mg/kg (150-300mg) infused over 30minutes then continue with maintenance dose to total dose of 1200mg/24hours", "runs": [{"text": "S:", "bold": true}, {"text": " ", "bold": true}, {"text": "amiodarone"}, {"text": " "}, {"text": "(IV)"}, {"text": " "}, {"text": "5mg/kg"}, {"text": " "}, {"text": "(150-300mg)"}, {"text": " "}, {"text": "infused"}, {"text": " "}, {"text": "over"}, {"text": " "}, {"text": "30minutes"}, {"text": " "}, {"text": "then"}, {"text": " "}, {"text": "continue"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "maintenance"}, {"text": " "}, {"text": "dose"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "total"}, {"text": " "}, {"text": "dose"}, {"text": " "}, {"text": "of "}, {"text": "1200mg/24hours"}]}, {"id": "body-22027", "type": "paragraph", "style": "Heading3", "text": "OR", "runs": [{"text": "OR"}], "level": 3, "conjunction": true}, {"id": "body-22028", "type": "paragraph", "style": "BodyText", "text": "S: amiodarone (PO) 800 mg 24hourly for 7days, 600mg/day for 3days followed by a maintenance dose of 200–400mg/day", "runs": [{"text": "S:", "bold": true}, {"text": " ", "bold": true}, {"text": "amiodarone"}, {"text": " "}, {"text": "(PO)"}, {"text": " "}, {"text": "800"}, {"text": " "}, {"text": "mg"}, {"text": " "}, {"text": "24hourly"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "7days,"}, {"text": " "}, {"text": "600mg/day"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "3days"}, {"text": " "}, {"text": "followed"}, {"text": " "}, {"text": "by"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "maintenance"}, {"text": " "}, {"text": "dose"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "200–400mg/day"}]}, {"id": "body-22030", "type": "paragraph", "style": "BodyText", "text": "Amiodarone may cause serious long-term side effects due to long half-life. Therefore, patients require regular monitoring by specialist.", "runs": [{"text": "Amiodarone may cause serious long-term side effects due to long half-life. Therefore, patients require regular monitoring by "}, {"text": "specialist."}]}, {"id": "body-22031", "type": "paragraph", "style": "BodyText", "text": "A: lidocaine (IV) 50–100mg (1–2mg/kg) initially and at 5minute intervals if required to a total of 200–300mg,", "runs": [{"text": "A:", "bold": true}, {"text": " ", "bold": true}, {"text": "lidocaine"}, {"text": " "}, {"text": "(IV)"}, {"text": " "}, {"text": "50–100mg"}, {"text": " "}, {"text": "(1–2mg/kg)"}, {"text": " "}, {"text": "initially"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "at"}, {"text": " "}, {"text": "5minute"}, {"text": " "}, {"text": "intervals"}, {"text": " "}, {"text": "if"}, {"text": " "}, {"text": "required"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "total"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "200–300mg,"}]}, {"id": "body-22033", "type": "paragraph", "style": "BodyText", "text": "Thereafter, for recurrent ventricular tachycardia only", "runs": [{"text": "Thereafter,"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "recurrent"}, {"text": " "}, {"text": "ventricular"}, {"text": " "}, {"text": "tachycardia"}, {"text": " "}, {"text": "only"}]}, {"id": "body-22034", "type": "paragraph", "style": "BodyText", "text": "A: lidocaine (IV)1–3mg/minute for 24–30hours. lidocaine will only terminate ± 30% of sustained ventricular tachycardias, and may cause hypotension, heart block or convulsions.", "runs": [{"text": "A: ", "bold": true}, {"text": "lidocaine (IV)1–3mg/minute for 24–30hours. lidocaine will only terminate ± 30% of sustained ventricular tachycardias, and may cause hypotension, heart block or convulsions."}]}, {"id": "body-22035-textbox1-00001", "type": "paragraph", "style": "Normal", "text": "Note", "runs": [{"text": "Note", "bold": true}]}, {"id": "body-22035-textbox1-00002", "type": "paragraph", "style": "BodyText", "text": "Never give verapamil IV to patients with a wide QRS tachycardia.", "runs": [{"text": "Never"}, {"text": " "}, {"text": "give"}, {"text": " "}, {"text": "verapamil"}, {"text": " "}, {"text": "IV"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "patients"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "wide"}, {"text": " "}, {"text": "QRS"}, {"text": " "}, {"text": "tachycardia."}], "list": {"level": 0, "numberingId": "681"}}, {"id": "body-22035-textbox1-00003", "type": "paragraph", "style": "BodyText", "text": "For emergency treatment of ventricular tachycardia, DC cardioversion is first–line therapy, even if stable.", "runs": [{"text": "For"}, {"text": " "}, {"text": "emergency"}, {"text": " "}, {"text": "treatment"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "ventricular"}, {"text": " "}, {"text": "tachycardia,"}, {"text": " "}, {"text": "DC"}, {"text": " "}, {"text": "cardioversion"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "first–line"}, {"text": " "}, {"text": "therapy,"}, {"text": " "}, {"text": "even"}, {"text": " "}, {"text": "if"}, {"text": " "}, {"text": "stable."}], "list": {"level": 0, "numberingId": "681"}}], "source": {"file": "medical.docx", "chapter": "Cardiovascular disease conditions", "start": "body-22016", "end": "body-22035-textbox1-00003"}}