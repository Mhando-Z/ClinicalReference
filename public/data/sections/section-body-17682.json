{"id": "section-body-17682", "title": "Osteomyelitis of the Jaw", "chapterId": "chapter-sixteen", "tocLevel": 4, "tocPath": ["APPROACH TO PATIENTS WITH EMERGENCY CONDITIONS", "MUSCULOSKELETAL DISORDERS", "Infections", "Osteomyelitis"], "blocks": [{"id": "body-17682", "type": "heading", "style": "Heading2", "text": "Osteomyelitis of the Jaw", "runs": [{"text": "Osteomyelitis"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "Jaw"}], "level": 2, "list": {"level": 1, "numberingId": "1126"}}, {"id": "body-17683", "type": "paragraph", "style": "BodyText", "text": "Osteomyelitis of the jaw is a localized or diffuse infection and inflammation of the bone and bone marrow of the mandible or maxilla, caused by bacterial invasion, often originating from a dental or periodontal infection, trauma, or surgical procedures.", "runs": [{"text": "Osteomyelitis of the jaw is a localized or diffuse infection and inflammation of the bone and bone marrow of the mandible or maxilla, caused by bacterial invasion, often originating from a dental or periodontal infection, trauma, or surgical procedures."}]}, {"id": "body-17686", "type": "heading", "style": "Heading4", "text": "Clinical Presentation", "runs": [{"text": "Clinical"}, {"text": " "}, {"text": "Presentation"}], "level": 4}, {"id": "body-17687", "type": "paragraph", "style": "ListParagraph", "text": "In the initial stage there is no swelling", "runs": [{"text": "In"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "initial"}, {"text": " "}, {"text": "stage"}, {"text": " "}, {"text": "there"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "no"}, {"text": " "}, {"text": "swelling"}], "list": {"level": 0, "numberingId": "1116"}}, {"id": "body-17688", "type": "paragraph", "style": "ListParagraph", "text": "Malaise and fever", "runs": [{"text": "Malaise"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "fever"}], "list": {"level": 0, "numberingId": "1116"}}, {"id": "body-17689", "type": "paragraph", "style": "ListParagraph", "text": "Enlargement of regional lymph nodes", "runs": [{"text": "Enlargement"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "regional"}, {"text": " "}, {"text": "lymph"}, {"text": " "}, {"text": "nodes"}], "list": {"level": 0, "numberingId": "1116"}}, {"id": "body-17690", "type": "paragraph", "style": "ListParagraph", "text": "Teeth in the affected area become painful and loose.", "runs": [{"text": "Teeth"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "affected"}, {"text": " "}, {"text": "area"}, {"text": " "}, {"text": "become"}, {"text": " "}, {"text": "painful"}, {"text": " "}, {"text": "and "}, {"text": "loose."}], "list": {"level": 0, "numberingId": "1116"}}, {"id": "body-17691", "type": "heading", "style": "Heading4", "text": "Investigations", "runs": [{"text": "Investigations"}], "level": 4}, {"id": "body-17692", "type": "paragraph", "style": "ListParagraph", "text": "OPG", "runs": [{"text": "OPG"}], "list": {"level": 0, "numberingId": "1116"}}, {"id": "body-17693", "type": "paragraph", "style": "ListParagraph", "text": "CBCT", "runs": [{"text": "CBCT"}], "list": {"level": 0, "numberingId": "1116"}}, {"id": "body-17695", "type": "paragraph", "style": "ListParagraph", "text": "Later as the bone undergoes necrosis the area becomes very painful and swollen", "runs": [{"text": "Later as the bone undergoes necrosis the area becomes very painful and swollen"}], "list": {"level": 0, "numberingId": "1116"}}, {"id": "body-17696", "type": "paragraph", "style": "ListParagraph", "text": "Pus ruptures through the periosteum and discharged outside the skin surface through a sinus", "runs": [{"text": "Pus ruptures through the periosteum and discharged outside the skin surface through a "}, {"text": "sinus"}], "list": {"level": 0, "numberingId": "1116"}}, {"id": "body-17698", "type": "paragraph", "style": "ListParagraph", "text": "CT-Scan", "runs": [{"text": "CT-"}, {"text": "Scan"}], "list": {"level": 0, "numberingId": "1116"}}, {"id": "body-17699", "type": "paragraph", "style": "ListParagraph", "text": "Pus for culture and sensitivity", "runs": [{"text": "Pus"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "culture"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "sensitivity"}], "list": {"level": 0, "numberingId": "1116"}}, {"id": "body-17702", "type": "heading", "style": "Heading4", "text": "Non-Pharmacological Management", "runs": [{"text": "Non-Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-17703", "type": "paragraph", "style": "BodyText", "text": "Treatment for osteomyelitis involves eliminating the source of infection and necrotic tissue, establishing drainage, restoring blood supply, and controlling the infection with appropriate antimicrobial therapy.", "runs": [{"text": "Treatment for osteomyelitis involves eliminating the source of infection and necrotic tissue, establishing drainage, restoring"}, {"text": " "}, {"text": "blood supply, and controlling the infection with appropriate antimicrobial therapy."}]}, {"id": "body-17706", "type": "heading", "style": "Heading4", "text": "Pharmacological Management", "runs": [{"text": "Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-17707", "type": "paragraph", "style": "BodyText", "text": "For acute osteomyelitis of the jaw", "runs": [{"text": "For"}, {"text": " "}, {"text": "acute"}, {"text": " "}, {"text": "osteomyelitis"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "jaw"}]}, {"id": "body-17708", "type": "paragraph", "style": "BodyText", "text": "S: clindamycin (PO) 150mg 12hourly for 5 days", "runs": [{"text": "S:", "bold": true}, {"text": " ", "bold": true}, {"text": "clindamycin"}, {"text": " "}, {"text": "(PO)"}, {"text": " "}, {"text": "150mg"}, {"text": " "}, {"text": "12hourly"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"