{"id": "section-body-12543", "title": "Late Syphilis", "chapterId": "chapter-twelve", "blocks": [{"id": "body-12543", "type": "heading", "style": "Heading2", "text": "Late Syphilis", "runs": [{"text": "Late"}, {"text": " "}, {"text": "Syphilis"}], "level": 2, "list": {"level": 2, "numberingId": "1397"}}, {"id": "body-12544", "type": "paragraph", "style": "BodyText", "text": "This refers to Syphilis infection of more than 2years.", "runs": [{"text": "This"}, {"text": " "}, {"text": "refers"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "Syphilis"}, {"text": " "}, {"text": "infection"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "more"}, {"text": " "}, {"text": "than"}, {"text": " "}, {"text": "2years."}]}, {"id": "body-12546", "type": "heading", "style": "Heading4", "text": "Pharmacological Management", "runs": [{"text": "Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-12547", "type": "paragraph", "style": "BodyText", "text": "A: benzathine benzylpenicillin (IM) 2.4MU once weekly for 3 consecutive weeks.", "runs": [{"text": "A:", "bold": true}, {"text": " ", "bold": true}, {"text": "benzathine"}, {"text": " "}, {"text": "benzylpenicillin"}, {"text": " "}, {"text": "(IM)"}, {"text": " "}, {"text": "2.4MU"}, {"text": " "}, {"text": "once"}, {"text": " "}, {"text": "weekly"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "3"}, {"text": " "}, {"text": "consecutive"}, {"text": " "}, {"text": "weeks."}]}, {"id": "body-12548", "type": "paragraph", "style": "Heading3", "text": "AND", "runs": [{"text": "AND"}], "level": 3, "conjunction": true}, {"id": "body-12549", "type": "paragraph", "style": "BodyText", "text": "A: azithromycin (PO) 2g stat.", "runs": [{"text": "A:", "bold": true}, {"text": " ", "bold": true}, {"text": "azithromycin"}, {"text": " "}, {"text": "(PO)"}, {"text": " "}, {"text": "2g"}, {"text": " "}, {"text": "stat."}]}, {"id": "body-12551", "type": "heading", "style": "Heading4", "text": "S