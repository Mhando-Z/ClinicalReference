text": " "}, {"text": "spectacles"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "constant"}, {"text": " "}, {"text": "wear."}, {"text": " "}, {"text": "These"}, {"text": " "}, {"text": "can"}, {"text": " "}, {"text": "be"}, {"text": " "}, {"text": "plus"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "minus"}, {"text": " "}, {"text": "depends"}, {"text": " "}, {"text": "on"}, {"text": " "}, {"text": "refractive"}, {"text": " "}, {"text": "findings."}], "list": {"level": 1, "numberingId": "1275"}}, {"id": "body-14384", "type": "paragraph", "style": "ListParagraph", "text": "Contact Lenses can be used as well", "runs": [{"text": "Contact"}, {"text": " "}, {"text": "Lenses"}, {"text": " "}, {"text": "can"}, {"text": " "}, {"text": "be"}, {"text": " "}, {"text": "used"}, {"text": " "}, {"text": "as"}, {"text": " "}, {"text": "well"}], "list": {"level": 1, "numberingId": "1275"}}, {"id": "body-14385", "type": "paragraph", "style": "ListParagraph", "text": "Refractive Surgery such as LASIK and SMILE can be used", "runs": [{"text": "Refractive"}, {"text": " "}, {"text": "Surgery"}, {"text": " "}, {"text": "such"}, {"text": " "}, {"text": "as"}, {"text": " "}, {"text": "LASIK"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "SMILE"}, {"text": " "}, {"text": "can"}, {"text": " "}, {"text": "be"}, {"text": " "}, {"text": "used"}], "list": {"level": 1, "numberingId": "1275"}}, {"id": "body-14386", "type": "paragraph", "style": "ListParagraph", "text": "Surgery (Limbal relaxation incisions) can be done", "runs": [{"text": "Surgery"}, {"text": " "}, {"text": "(Limbal"}, {"text": " "}, {"text": "relaxation"}, {"text": " "}, {"text": "incisions)"}, {"text": " "}, {"text": "can"}, {"text": " "}, {"text": "be"}, {"text": " "}, {"text": "done"}], "list": {"level": 1, "numberingId": "1275"}}, {"id": "body-14387-textbox1-00001", "type": "paragraph", "style": "Normal", "text": "Note:", "runs": [{"text": "Note:", "bold": true}]}, {"id": "body-14387-textbo