{"id": "section-body-07931", "title": "Chronic Obstructive Pulmonary Disease (COPD)", "chapterId": "chapter-nine", "tocLevel": 4, "tocPath": ["APPROACH TO PATIENTS WITH EMERGENCY CONDITIONS", "RESPIRATORY DISEASE CONDITIONS", "Obstructive Lung Diseases", "Chronic Obstructive Pulmonary Disease (COPD)"], "blocks": [{"id": "body-07931", "type": "heading", "style": "Heading4", "text": "Chronic Obstructive Pulmonary Disease (COPD)", "runs": [{"text": "Chronic"}, {"text": " "}, {"text": "Obstructive"}, {"text": " "}, {"text": "Pulmonary"}, {"text": " "}, {"text": "Disease"}, {"text": " "}, {"text": "(COPD)"}], "level": 4, "list": {"level": 2, "numberingId": "1593"}}, {"id": "body-07932", "type": "paragraph", "style": "BodyText", "text": "Chronic Obstructive Pulmonary Disease (COPD) is a diverse lung condition marked by persistent airflow limitation and respiratory symptoms of shortness of breath, cough, and exacerbations; resulting from structural abnormalities in the airways (Bronchitis) or in the alveoli (Emphysema). It is usually caused by significant exposure to noxious particles or gases.", "runs": [{"text": "Chronic Obstructive Pulmonary Disease (COPD) is a diverse lung condition marked by persistent airflow limitation and respiratory symptoms of shortness of breath, cough, and exacerbations; resulting from structural abnormalities in the airways (Bronchitis) or in the alveoli (Emphysema). It is usually caused by significant exposure to noxious particles or gases."}]}, {"id": "body-07935", "type": "heading", "style": "Heading4", "text": "Risk Factors for COPD", "runs": [{"text": "Risk"}, {"text": " "}, {"text": "Factors"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "COPD"}], "level": 4}, {"id": "body-07937", "type": "paragraph", "style": "ListParagraph", "text": "Indoor and outdoor air pollution", "runs": [{"text": "Indoor"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "outdoor"}, {"text": " "}, {"text": "air"}, {"text": " "}, {"text": "poll