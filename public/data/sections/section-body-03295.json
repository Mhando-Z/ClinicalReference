{"id": "section-body-03295", "title": "Brucellosis", "chapterId": "chapter-four", "tocLevel": 4, "tocPath": ["APPROACH TO PATIENTS WITH EMERGENCY CONDITIONS", "NOTIFIABLE DISEASES", "Bacterial Infections", "Brucellosis"], "blocks": [{"id": "body-03295", "type": "heading", "style": "Heading4", "text": "Brucellosis", "runs": [{"text": "Brucellosis"}], "level": 4, "list": {"level": 2, "numberingId": "1802"}}, {"id": "body-03296", "type": "paragraph", "style": "BodyText", "text": "Brucellosis is a zoonotic bacterial disease caused by Brucella species (mainly B. melitensis, B. abortus, B. suis, B. canis) affecting humans, livestock, and wildlife.", "runs": [{"text": "Brucellosis is a zoonotic bacterial disease caused by Brucella species (mainly B. melitensis, B. abortus, B. suis, B. canis)"}, {"text": " "}, {"text": "affecting humans, livestock, and wildlife."}]}, {"id": "body-03298", "type": "paragraph", "style": "BodyText", "text": "Transmission: Foodborne (undercooked meat, unpasteurized milk/soft cheese), direct contact with infected animal blood/placenta/foetus/secretions via skin breaks/mucosa, or airborne.", "runs": [{"text": "Transmission:", "bold": true}, {"text": " ", "bold": true}, {"text": "Foodborne"}, {"text": " "}, {"text": "(undercooked"}, {"text": " "}, {"text": "meat,"}, {"text": " "}, {"text": "unpasteurized"}, {"text": " "}, {"text": "milk/soft"}, {"text": " "}, {"text": "cheese),"}, {"text": " "}, {"text": "direct"}, {"text": " "}, {"text": "contact"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "infected"}, {"text": " "}, {"text": "animal"}, {"text": " "}, {"text": "blood/placenta/foetus/secretions via skin breaks/mucosa, or airborne."}]}, {"id": "body-03300", "type": "paragraph", "style": "BodyText", "text": "High-risk groups: consumers of raw animal products, farmers, butchers, hunters, veterinarians, lab personnel. Incubation: usually 2–4 weeks (range 1 week–several months).", "runs": [{"text": "High-risk groups: consumers of raw animal products, farmers, butchers, hunters, veterinarians, lab personnel. Incubation:"}, {"text": " "}, {"text": "usually 2–4 weeks (range 1 week–several months)."}]}, {"id": "body-03301", "type": "heading", "style": "Heading4", "text": "Clinical Presentation", "runs": [{"text": "Clinical"}, {"text": " "}, {"text": "Presentation"}], "level": 4}, {"id": "body-03302", "type": "paragraph", "style": "BodyText", "text": "Wide range: acute/insidious onset with continued/intermittent/irregular fever, night sweats, chills, fatigue, headache, malaise, anorexia, weight loss, myalgia, arthralgia.", "runs": [{"text": "Wide"}, {"text": " "}, {"text": "range:"}, {"text": " "}, {"text": "acute/insidious"}, {"text": " "}, {"text": "onset"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "continued/intermittent/irregular"}, {"text": " "}, {"text": "fever,"}, {"text": " "}, {"text": "night"}, {"text": " "}, {"text": "sweats,"}, {"text": " "}, {"text": "chills,"}, {"text": " "}, {"text": "fatigue,"}, {"text": " "}, {"text": "headache,"}, {"text": " "}, {"text": "malaise, anorexia, weight loss, myalgia, arthralgia."}]}, {"id": "body-03303", "type": "paragraph", "style": "BodyText", "text": "Others include low back pain, dizziness, abdominal pain, dyspepsia, cough. In children: higher rash, respiratory/cardiac complications, orchitis/epididymitis.", "runs": [{"text": "Others"}, {"text": " "}, {"text": "include"}, {"text": " "}, {"text": "low"}, {"text": " "}, {"text": "back"}, {"text": " "}, {"text": "pain,"}, {"text": " "}, {"text": "dizziness,"}, {"text": " "}, {"text": "abdominal"}, {"text": " "}, {"text": "pain,"}, {"text": " "}, {"text": "dyspepsia,"}, {"text": " "}, {"text": "cough."}, {"text": " "}, {"text": "In"}, {"text": " "}, {"text": "children:"}, {"text": " "}, {"text": "higher"}, {"text": " "}, {"text": "rash,"}, {"text": " "}, {"text": "respiratory/cardiac complications, orchitis/epididymitis."}]}, {"id": "body-03304", "type": "paragraph", "style": "BodyText", "text": "Late presentation common; untreated cases lead to focal/multi-organ involvement (e.g., splenomegaly/hepatomegaly, osteoarticular, orchitis in males, abortion/premature delivery, rare endocarditis/neurobrucellosis causing most deaths).", "runs": [{"text": "Late"}, {"text": " "}, {"text": "presentation"}, {"text": " "}, {"text": "common;"}, {"text": " "}, {"text": "untreated"}, {"text": " "}, {"text": "cases"}, {"text": " "}, {"text": "lead"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "focal/multi-organ"}, {"text": " "}, {"text": "involvement"}, {"text": " "}, {"text": "(e.g.,"}, {"text": " "}, {"text": "splenomegaly/hepatomegaly, osteoarticular, orchitis in males, abortion/premature delivery, rare endocarditis/neurobrucellosis causing most deaths)."}]}, {"id": "body-03306", "type": "heading", "style": "Heading4", "text": "Case Definitions", "runs": [{"text": "Case"}, {"text": " "}, {"text": "Definitions"}], "level": 4}, {"id": "body-03307", "type": "paragraph", "style": "BodyText", "text": "Suspected case: Any person epidemiologically linked to suspected/confirmed animal cases or contaminated animal products presenting with an illness characterized by acute or insidious onset of fever and/or one or more of the following: night sweats, arthralgia, headache, fatigue, anorexia, myalgia, weight loss, arthritis/spondylitis, meningitis or other organ involvement (i.e.: endocarditis, orchitis/epididymitis, hepatomegaly, splenomegaly).", "runs": [{"text": "Suspected"}, {"text": " "}, {"text": "case:"}, {"text": " "}, {"text": "Any"}, {"text": " "}, {"text": "person"}, {"text": " "}, {"text": "epidemiologically"}, {"text": " "}, {"text": "linked"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "suspected/confirmed"}, {"text": " "}, {"text": "animal"}, {"text": " "}, {"text": "cases"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "contaminated"}, {"text": " "}, {"text": "animal"}, {"text": " "}, {"text": "products presenting"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "an"}, {"text": " "}, {"text": "illness"}, {"text": " "}, {"text": "characterized"}, {"text": " "}, {"text": "by"}, {"text": " "}, {"text": "acute"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "insidious"}, {"text": " "}, {"text": "onset"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "fever"}, {"text": " "}, {"text": "and/or"}, {"text": " "}, {"text": "one"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "more"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "following:"}, {"text": " "}, {"text": "night"}, {"text": " "}, {"text": "sweats, arthralgia, headache, fatigue, anorexia, myalgia, weight loss, arthritis/spondylitis, meningitis or other organ involvement (i.e.: endocarditis, orchitis/epididymitis, hepatomegaly, splenomegaly)."}]}, {"id": "body-03309", "type": "paragraph", "style": "BodyText", "text": "Probable case: A suspected case with presumptive laboratory diagnosis OR epidemiologically linked to a confirmed human or animal brucellosis case.", "runs": [{"text": "Probable"}, {"text": " "}, {"text": "case:"}, {"text": " "}, {"text": "A"}, {"text": " "}, {"text": "suspected"}, {"text": " "}, {"text": "case"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "presumptive"}, {"text": " "}, {"text": "laboratory"}, {"text": " "}, {"text": "diagnosis"}, {"text": " "}, {"text": "OR"}, {"text": " "}, {"text": "epidemiologically"}, {"text": " "}, {"text": "linked"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "confirmed"}, {"text": " "}, {"text": "human"}, {"text": " "}, {"text": "or animal brucellosis case."}]}, {"id": "body-03310", "type": "paragraph", "style": "BodyText", "text": "Confirmed case: A suspected or probable case with confirmatory laboratory diagnosis", "runs": [{"text": "Confirmed"}, {"text": " "}, {"text": "case:"}, {"text": " "}, {"text": "A"}, {"text": " "}, {"text": "suspected"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "probable"}, {"text": " "}, {"text": "case"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "confirmatory"}, {"text": " "}, {"text": "laboratory"}, {"text": " "}, {"text": "diagnosis"}]}, {"id": "body-03312", "type": "heading", "style": "Heading4", "text": "Severity of the Disease", "runs": [{"text": "Severity"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "Disease"}], "level": 4}, {"id": "body-03313", "type": "paragraph", "style": "BodyText", "text": "Uncomplicated Brucellosis: Clinical symptoms, signs and laboratory confirmation without focal/multi-organ involvement.", "runs": [{"text": "Uncomplicated"}, {"text": " "}, {"text": "Brucellosis:"}, {"text": " "}, {"text": "Clinical"}, {"text": " "}, {"text": "symptoms,"}, {"text": " "}, {"text": "signs"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "laboratory"}, {"text": " "}, {"text": "confirmation"}, {"text": " "}, {"text": "without"}, {"text": " "}, {"text": "focal/multi-organ"}, {"text": " "}, {"text": "involvement."}]}, {"id": "body-03315", "type": "paragraph", "style": "BodyText", "text": "Complicated Brucellosis: Clinical symptoms, signs and laboratory confirmation with focal/multi-organ involvement.", "runs": [{"text": "Complicated"}, {"text": " "}, {"text": "Brucellosis:"}, {"text": " "}, {"text": "Clinical"}, {"text": " "}, {"text": "symptoms,"}, {"text": " "}, {"text": "signs"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "laboratory"}, {"text": " "}, {"text": "confirmation"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "focal/multi-organ"}, {"text": " "}, {"text": "involvement."}]}, {"id": "body-03316", "type": "heading", "style": "Heading4", "text": "Laboratory Investigation", "runs": [{"text": "Laboratory"}, {"text": " "}, {"text": "Investigation"}], "level": 4}, {"id": "body-03317", "type": "paragraph", "style": "ListParagraph", "text": "Presumptive: Positive Rose Bengal Plate Test (RBT) with serial dilution OR Positive result (≥1:160) in standard agglutination test (SAT) in a single sample", "runs": [{"text": "Presumptive: Positive Rose Bengal Plate Test (RBT) with serial dilution OR Positive result (≥1:160) in standard agglutination test (SAT) in a single sample"}], "list": {"level": 0, "numberingId": "1797"}}, {"id": "body-03318", "type": "paragraph", "style": "ListParagraph", "text": "Confirmatory: Isolation of Brucella from blood/other specimens (bone marrow/CSF/wounds/joint fluid; prefer acute febrile phase) OR ≥4-fold rise in SAT titres between acute (<7 days’ onset) and convalescent (2–4 weeks later) samples.", "runs": [{"text": "Confirmatory: Isolation of Brucella from blood/other specimens (bone marrow/CSF/wounds/joint fluid; prefer acute febrile phase) OR ≥4-fold rise in SAT titres between acute (<7 days’ onset) and convalescent (2–4 weeks later) "}, {"text": "samples."}], "list": {"level": 0, "numberingId": "1797"}}, {"id": "body-03319", "type": "heading", "style": "Heading4", "text": "Pharmacological Management", "runs": [{"text": "Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-03320", "type": "paragraph", "style": "BodyText", "text": "Uncomplicated acute cases respond well to prolonged combination antibiotics to minimize risk of failure/relapse). Relapses (5–15%) treated as new cases; failures often due to poor compliance.", "runs": [{"text": "Uncomplicated acute cases respond well to prolonged combination antibiotics to minimize risk of failure/relapse). Relapses (5–15%) treated as new cases; failures often due to poor compliance."}]}, {"id": "body-03323", "type": "heading", "style": "Heading4", "text": "Uncomplicated Brucellosis", "runs": [{"text": "Uncomplicated"}, {"text": " "}, {"text": "Brucellosis"}], "level": 4}, {"id": "body-03324", "type": "paragraph", "style": "BodyText", "text": "Adults and Children >8 years (all PO unless stated):", "runs": [{"text": "Adults"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "Children"}, {"text": " "}, {"text": ">8"}, {"text": " "}, {"text": "years"}, {"text": " "}, {"text": "(all"}, {"text": " "}, {"text": "PO"}, {"text": " "}, {"text": "unless"}, {"text": " "}, {"text": "stated):"}]}, {"id": "body-03325", "type": "paragraph", "style": "BodyText", "text": "A: doxycycline (PO) 100 mg 12hourly for 6weeks", "runs": [{"text": "A:", "bold": true}, {"text": " ", "bold": true}, {"text": "doxycycline"}, {"text": " "}, {"text": "(PO)"}, {"text": " "}, {"text": "100"}, {"text": " "}, {"text": "mg"}, {"text": " "}, {"text": "12hourly"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "6weeks"}]}, {"id": "body-03326", "type": "paragraph", "style": "Heading3", "text": "AND", "runs": [{"text": "AND"}], "level": 3, "conjunction": true}, {"id": "body-03327", "type": "paragraph", "style": "BodyText", "text": "A: streptomycin (IM) 1g 24hourly for 2–3 weeks", "runs": [{"text": "A:", "bold": true}, {"text": " ", "bold": true}, {"text": "streptomycin"}, {"text": " "}, {"text": "(IM)"}, {"text": " "}, {"text": "1g"}, {"text": " "}, {"text": "24hourly"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "2–3"}, {"text": " "}, {"text": "weeks"}]}, {"id": "body-03328", "type": "paragraph", "style": "Heading3", "text": "OR", "runs": [{"text": "OR"}], "level": 3, "conjunction": true}, {"id": "body-03329", "type": "paragraph", "style": "BodyText", "text": "A: doxycycline (PO) 100mg 12hourly for 6weeks", "runs": [{"text": "A:", "bold": true}, {"text": " ", "bold": true}, {"text": "doxycycline"}, {"text": " "}, {"text": "(PO)"}, {"text": " "}, {"text": "100mg"}, {"text": " "}, {"text": "12hourly"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "6weeks"}]}, {"id": "body-03330", "type": "paragraph", "style": "Heading3", "text": "AND", "runs": [{"text": "AND"}], "level": 3, "conjunction": true}, {"id": "body-03331", "type": "paragraph", "style": "BodyText", "text": "A: gentamicin (IM/I