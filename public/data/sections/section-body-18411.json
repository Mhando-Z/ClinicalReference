xt": "preauricular"}, {"text": " "}, {"text": "area"}], "list": {"level": 0, "numberingId": "1080"}}, {"id": "body-18421", "type": "paragraph", "style": "ListParagraph", "text": "Condyle displaced anteriorly and inferiorly", "runs": [{"text": "Condyle"}, {"text": " "}, {"text": "displaced"}, {"text": " "}, {"text": "anteriorly"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "inferiorly"}], "list": {"level": 0, "numberingId": "1080"}}, {"id": "body-18422", "type": "heading", "style": "Heading4", "text": "Investigations", "runs": [{"text": "Investigations"}], "level": 4}, {"id": "body-18423", "type": "paragraph", "style": "ListParagraph", "text": "Clinical diagnosis based on history and physical examination", "runs": [{"text": "Clinical"}, {"text": " "}, {"text": "diagnosis"}, {"text": " "}, {"text": "based"}, {"text": " "}, {"text": "on"}, {"text": " "}, {"text": "history"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "physical"}, {"text": " "}, {"text": "examination"}], "list": {"level": 0, "numberingId": "1080"}}, {"id": "body-18424", "type": "paragraph", "style": "ListParagraph", "text": "Plain X-rays (Panoramic or Lateral TMJ view): may help confirm dislocation", "runs": [{"text": "Plain"}, {"text": " "}, {"text": "X-rays"}, {"text": " "}, {"text": "(Panoramic"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "Lateral"}, {"text": " "}, {"text": "TMJ"}, {"text": " "}, {"text": "view):"}, {"text": " "}, {"text": "may"}, {"text": " "}, {"text": "help"}, {"text": " "}, {"text": "confirm"}, {"text": " "}, {"text": "dislocation"}], "list": {"level": 0, "numberingId": "1080"}}, {"id": "body-18426", "type": "heading", "style": "Heading4", "text": "Management", "runs": [{"text": "Management"}], "level": 4}, {"id": "body-18427", "type": "paragraph", "style": "ListParagraph", "text": "Acute Anterior TMJ Dislocation:", "runs": [{"text": "Acute"}, {"text": " "}, {"text": "Anterior"}, {"text": " "}, {"text": "TMJ"}, {"text": " "}, {"text": "Dislocation:"}], "list": {"level": 0, "numberingId": "1080"}}, {"id": "body-18428", "type": "paragraph", "style": "ListParagraph", "text": "Manual Reduction (Hippocratic technique)", "runs": [{"text": "Manual"}, {"text": " "}, {"text": "Reduction"}, {"text": " "}, {"text": "(Hippocratic"}, {"text": " "}, {"text": "technique)"}], "list": {"level": 0, "numberingId": "1080"}}, {"id": "body-18429", "type": "paragraph", "style": "ListParagraph", "text": "Patient seated with head supported", "runs": [{"text": "Patient"}, {"text": " "}, {"text": "seated"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "head"}, {"text": " "}, {"text": "supported"}], "list": {"level": 0, "numberingId": "1080"}}, {"id": "body-18430", "type": "paragraph", "style": "ListParagraph", "text": "Provider stands in front, places thumbs over the lower molars (with gauze padding) and fingers under the mandible", "runs": [{"text": "Provider"}, {"text": " "}, {"text": "stands"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "front,"}, {"text": " "}, {"text": "places"}, {"text": " "}, {"text": "thumbs"}, {"text": " "}, {"text": "over"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "lower"}, {"text": " "}, {"text": "molars"}, {"text": " "}, {"text": "(with"}, {"text": " "}, {"text": "gauze"}, {"text": " "}, {"text": "padding)"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "fingers under the mandible"}], "list": {"level": 0, "numberingId": "1080"}}, {"id": "body-18431", "type": "paragraph", "style": "ListParagraph", "text": "Downward and posterior pressure applied to guide the condyle back into place", "runs": [{"text": "Downward"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "posterior"}, {"text": " "}, {"text": "pressure"}, {"text": " "}, {"text": "applied"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "guide"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "condyle"}, {"text": " "}, {"text": "back"}, {"text": " "}, {"text": "into"}, {"text": " "}, {"text": "place"}], "list": {"level": 0, "numberingId": "1080"}}, {"id": "body-18432", "type": "paragraph", "style": "ListParagraph", "text": "Use sedation (e.g., midazolam, diazepam) or local anesthetic if needed to overcome muscle spasm", "runs": [{"text": "Use"}, {"text": " "}, {"text": "sedation"}, {"text": " "}, {"text": "(e.g.,"}, {"text": " "}, {"text": "midazolam,"}, {"text": " "}, {"text": "diazepam)"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "local"}, {"text": " "}, {"text": "anesthetic"}, {"text": " "}, {"text": "if"}, {"text": " "}, {"text": "needed"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "overcome"}, {"text": " "}, {"text": "muscle"}, {"text": " "}, {"text": "spasm"}], "list": {"level": 0, "numberingId": "1080"}}, {"id": "body-18433", "type": "heading", "style": "Heading4", "text": "Post-reduction care", "runs": [{"text": "Post-reduction"}, {"text": " "}, {"text": "care"}], "level": 4}, {"id": "body-18434", "type": "paragraph", "style": "ListParagraph", "text": "Apply a soft bandage (Barton bandage) to limit mouth opening", "runs": [{"text": "Apply"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "soft"}, {"text": " "}, {"text": "bandage"}, {"text": " "}, {"text": "(Barton"}, {"text": " "}, {"text": "bandage)"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "limit"}, {"text": " "}, {"text": "mouth"}, {"text": " "}, {"text": "opening"}], "list": {"level": 0, "numberingId": "1080"}}, {"id": "body-18435", "type": "paragraph", "style": "ListParagraph", "text": "Advise soft diet for 1–2 weeks", "runs": [{"text": "Advise"}, {"text": " "}, {"text": "soft"}, {"text": " "}, {"text": "diet"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "1–2"}, {"text": " "}, {"text": "weeks"}], "list": {"level": 0, "numberingId": "1080"}}, {"id": "body-18436", "type": "paragraph", "style": "ListParagraph", "text": "Avoid wide mouth opening (yawning, dental procedures)", "runs": [{"text": "Avoid"}, {"text"