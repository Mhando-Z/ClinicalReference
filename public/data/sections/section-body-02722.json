{"id": "section-body-02722", "title": "Idiopathic Thrombocytopenic Purpura (ITP) Clinical Presentation", "chapterId": "chapter-three", "tocLevel": 4, "tocPath": ["APPROACH TO PATIENTS WITH EMERGENCY CONDITIONS", "HAEMATOLOGY AND BLOOD TRANSFUSION", "Bleeding Disorders", "Idiopathic Thrombocytopenic Purpura (ITP)"], "blocks": [{"id": "body-02722", "type": "heading", "style": "Heading4", "text": "Idiopathic Thrombocytopenic Purpura (ITP) Clinical Presentation", "runs": [{"text": "Idiopathic"}, {"text": " "}, {"text": "Thrombocytopenic"}, {"text": " "}, {"text": "Purpura"}, {"text": " "}, {"text": "(ITP) Clinical Presentation"}], "level": 4, "list": {"level": 3, "numberingId": "1835"}}, {"id": "body-02723", "type": "paragraph", "style": "ListParagraph", "text": "Long history of Purpura, menorrhagia, epistaxis, and gingival haemorrhage.", "runs": [{"text": "Long"}, {"text": " "}, {"text": "history"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "Purpura,"}, {"text": " "}, {"text": "menorrhagia,"}, {"text": " "}, {"text": "epistaxis,"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "gingival"}, {"text": " "}, {"text": "haemorrhage."}], "list": {"level": 4, "numberingId": "1835"}}, {"id": "body-02724", "type": "paragraph", "style": "ListParagraph", "text": "Intracerebral haemorrhage occurs infrequently but is the most common cause of death", "runs": [{"text": "Intracerebral"}, {"text": " "}, {"text": "haemorrhage"}, {"text": " "}, {"text": "occurs"}, {"text": " "}, {"text": "infrequently"}, {"text": " "}, {"text": "but"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "most"}, {"text": " "}, {"text": "common"}, {"text": " "}, {"text": "cause"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "death"}], "list": {"level": 4, "numberingId": "1835"}}, {"id": "body-02725", "type": "paragraph", "style": "ListParagraph", "text": "Overt bleeding is rare unless thrombocytopenia is severe (less than 10 X109/L).", "r