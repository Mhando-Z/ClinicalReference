, {"text": " "}, {"text": "commonly"}, {"text": " "}, {"text": "appear"}, {"text": " "}, {"text": "after"}, {"text": " "}, {"text": "first"}, {"text": " "}, {"text": "trimester,"}, {"text": " "}, {"text": "grow"}, {"text": " "}, {"text": "rapidly,"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "typically"}, {"text": " "}, {"text": "regress"}, {"text": " "}, {"text": "after"}, {"text": " "}, {"text": "delivery."}], "list": {"level": 4, "numberingId": "1126"}}, {"id": "body-18159", "type": "paragraph", "style": "ListParagraph", "text": "Found on the gingiva mainly in between the teeth. Occasionally can occur on the tongue, lips and palate.", "runs": [{"text": "Found"}, {"text": " "}, {"text": "on"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "gingiva"}, {"text": " "}, {"text": "mainly"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "between"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "teeth."}, {"text": " "}, {"text": "Occasionally"}, {"text": " "}, {"text": "can"}, {"text": " "}, {"text": "occur"}, {"text": " "}, {"text": "on"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "tongue,"}, {"text": " "}, {"text": "lips"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "palate."}], "list": {"level": 4, "numberingId": "1126"}}, {"id": "body-18160", "type": "paragraph", "style": "ListParagraph", "text": "They are exophytic, lobulated, or smooth surfaced lesion with a red to purplish color and a soft, spongy texture and easily bleed", "runs": [{"text": "They"}, {"text": " "}, {"text": "are"}, {"text": " "}, {"text": "exophytic,"}, {"text": " "}, {"text": "lobulated,"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "smooth"}, {"text": " "}, {"text": "surfaced"}, {"text": " "}, {"text": "lesion"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "red"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "purplish"}, {"text": " "}, {"text": "color"}, {"text": 