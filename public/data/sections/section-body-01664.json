text": " "}, {"text": "air,"}, {"text": " "}, {"text": "oxygen"}, {"text": " "}, {"text": "titrated"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "desired"}, {"text": " "}, {"text": "effect"}]}, {"id": "body-01680", "type": "paragraph", "style": "Heading3", "text": "OR", "runs": [{"text": "OR"}], "level": 3, "conjunction": true}, {"id": "body-01681", "type": "paragraph", "style": "BodyText", "text": "S: sevoflurane 5–7% in air, oxygen titrated to desired effect.", "runs": [{"text": "S:", "bold": true}, {"text": " ", "bold": true}, {"text": "sevoflurane"}, {"text": " "}, {"text": "5–7%"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "air,"}, {"text": " "}, {"text": "oxygen"}, {"text": " "}, {"text": "titrated"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "desired"}, {"text": " "}, {"text": "effect."}]}, {"id": "body-01682", "type": "paragraph", "style": "BodyText", "text": "Maintenance: 0.5–3% sevoflurane with or without the concomitant use of nitrous oxide.", "runs": [{"text": "Maintenance:"}, {"text": " "}, {"text": "0.5–3%"}, {"text": " "}, {"text": "sevoflurane"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "without"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "concomitant"}, {"text": " "}, {"text": "use"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "nitrous"}, {"text": " "}, {"text": "oxide."}]}, {"id": "body-01683-textbox1-00001", "type": "paragraph", "style": "Normal", "text": "Note:", "runs": [{"text": "Note:", "bold": true}]}, {"id": "body-01683-textbox1-00002", "type": "paragraph", "style": "BodyText", "text": "Recommended to use Sevoflurane for induction only, then move to Isoflurane unless the condition recommends maintenance with Sevoflurane.", "runs": [{"text": "Recommended to use Sevoflurane for induction only, then move to Isoflurane unless the condition recommends maintenance with Sevoflurane."}], "list": {"level": 0, "numberingId": "1848"}}, {"id": "body-01683-textbox1-00003", "type": "paragraph", "style": "BodyText", "text": "Low-flow anesthesia is the best technique to conserve consumption of Sevoflurane", "runs": [{"text": "Low-flow"}, {"text": " "}, {"text": "anesthesia"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "best"}, {"text": " "}, {"text": "technique"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "conserve"}, {"text": " "}, {"text": "consumption"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "Sevoflurane"}], "list": {"level": 0, "numberingId": "1848"}}, {"id": "body-01683-textbox1-00004", "type": "paragraph", "style": "BodyText", "text": "Propofol is contraindicated for patients at risk of hypotension or in shock. Use IV ketamine infusion for maintenance of anaesthesia", "runs": [{"text": "Propofol"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "contraindicated"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "patients"}, {"text": " "}, {"text": "at"}, {"text": " "}, {"text": "risk"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "hypotension"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "shock."}, {"text": " "}, {"text": "Use"}, {"text": " "}, {"text": "IV"}, {"text": " "}, {"text": "ketamine"}, {"text": " "}, {"text": "infusion"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "maintenance of anaesthesia"}], "list": {"level": 0, "numberingId": "1848"}}], "source": {"file": "medical.docx", "chapter": "Anaesthesia and critical care", "start": "body-01664", "end": "body-01683-textbox1-00004"}}