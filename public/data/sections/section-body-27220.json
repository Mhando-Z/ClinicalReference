R", "runs": [{"text": "OR"}], "level": 3, "conjunction": true}, {"id": "body-27272", "type": "paragraph", "style": "BodyText", "text": "S: escitalopram (PO) 10-20 mg nocte (titrating according to individual response)", "runs": [{"text": "S:", "bold": true}, {"text": " ", "bold": true}, {"text": "escitalopram"}, {"text": " "}, {"text": "(PO)"}, {"text": " "}, {"text": "10-20"}, {"text": " "}, {"text": "mg"}, {"text": " "}, {"text": "nocte"}, {"text": " "}, {"text": "(titrating"}, {"text": " "}, {"text": "according"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "individual"}, {"text": " "}, {"text": "response)"}]}, {"id": "body-27274", "type": "paragraph", "style": "BodyText", "text": "Pharmacological management in Autism should be symptomatic management depending on how the child is presenting, e.g. comorbid with ADHD, psychosis or overstimulation", "runs": [{"text": "Pharmacological management in Autism should be symptomatic management depending on how the child is presenting, e.g. comorbid with ADHD, psychosis or overstimulation"}]}], "source": {"file": "medical.docx", "chapter": "Mental health conditions", "start": "body-27220", "end": "body-27274"}}