ph", "style": "BodyText", "text": "Note: Health care worker should communicate with DTLC and RTLC whenever they suspect leprosy reaction", "runs": [{"text": "Note:", "bold": true}, {"text": " ", "bold": true}, {"text": "Health"}, {"text": " "}, {"text": "care worker"}, {"text": " "}, {"text": "should communicate"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "DTLC"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "RTLC whenever"}, {"text": " "}, {"text": "they suspect"}, {"text": " "}, {"text": "leprosy"}, {"text": " "}, {"text": "reaction"}]}, {"id": "body-05684", "type": "paragraph", "style": "BodyText", "text": "Treatment of Reaction: Depending on severity, treatment of reverse reaction is by giving anti- inflammatory drugs or corticosteroids usually prednisolone for a prolonged period.", "runs": [{"text": "Treatment", "bold": true}, {"text": " ", "bold": true}, {"text": "of", "bold": true}, {"text": " ", "bold": true}, {"text": "Reaction:", "bold": true}, {"text": " ", "bold": true}, {"text": "Depending"}, {"text": " "}, {"text": "on"}, {"text": " "}, {"text": "severity,"}, {"text": " "}, {"text": "treatm"}, {"text": "e", "bold": true}, {"text": "nt"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "reverse"}, {"text": " "}, {"text": "reaction"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "by"}, {"text": " "}, {"text": "giving"}, {"text": " "}, {"text": "anti-"}, {"text": " "}, {"text": "inflammatory"}, {"text": " "}, {"text": "drugs"}, {"text": " "}, {"text": "or corticosteroids usually prednisolone for a prolonged period."}]}], "source": {"file": "medical.docx", "chapter": "Tuberculosis and leprosy", "start": "body-05676", "end": "body-05684"}}