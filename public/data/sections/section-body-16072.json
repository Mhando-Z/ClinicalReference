al positioning), oxygen (oral) if needed, urgent referral.", "runs": [{"text": "Primary"}, {"text": " "}, {"text": "level:"}, {"text": " "}, {"text": "Maintain"}, {"text": " "}, {"text": "airway"}, {"text": " "}, {"text": "(oral"}, {"text": " "}, {"text": "airway"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "prone/lateral"}, {"text": " "}, {"text": "positioning),"}, {"text": " "}, {"text": "oxygen"}, {"text": " "}, {"text": "(oral)"}, {"text": " "}, {"text": "if"}, {"text": " "}, {"text": "needed,"}, {"text": " "}, {"text": "urgent"}, {"text": " "}, {"text": "referral."}], "list": {"level": 1, "numberingId": "1184"}}, {"id": "body-16090", "type": "paragraph", "style": "ListParagraph", "text": "Secondary level: Supportive care (suction, feeding via orogastric tube), refer to tertiary immediately.", "runs": [{"text": "Secondary"}, {"text": " "}, {"text": "level:"}, {"text": " "}, {"text": "Supportive"}, {"text": " "}, {"text": "care"}, {"text": " "}, {"text": "(suction,"}, {"text": " "}, {"text": "feeding"}, {"text": " "}, {"text": "via"}, {"text": " "}, {"text": "orogastric"}, {"text": " "}, {"text": "tube),"}, {"text": " "}, {"text": "refer"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "tertiary"}, {"text": " "}, {"text": "immediately."}], "list": {"level": 1, "numberingId": "1184"}}, {"id": "body-16091", "type": "paragraph", "style": "ListParagraph", "text": "Tertiary level: if suspected at tertiary facility, urgently follow the above approach and consult ENT on call immediately or refer.", "runs": [{"text": "Tertiary"}, {"text": " "}, {"text": "level:"}, {"text": " "}, {"text": "if"}, {"text": " "}, {"text": "suspected"}, {"text": " "}, {"text": "at"}, {"text": " "}, {"text": "tertiary"}, {"text": " "}, {"text": "facility,"}, {"text": " "}, {"text": "urgently"}, {"text": " "}, {"text": "follow"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "above"}, {"text": " "}, {"text": "approach"}, {"text": " "}, {"text": "and"}, {"text": "