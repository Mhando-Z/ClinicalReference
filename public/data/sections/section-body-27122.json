, "numberingId": "337"}}, {"id": "body-27151", "type": "paragraph", "style": "Normal", "text": "Non-Pharmacological Management", "runs": [{"text": "Non-Pharmacological", "bold": true}, {"text": " ", "bold": true}, {"text": "Management", "bold": true}]}, {"id": "body-27152", "type": "paragraph", "style": "ListParagraph", "text": "Cognitive behavioral therapy", "runs": [{"text": "Cognitive"}, {"text": " "}, {"text": "behavioral"}, {"text": " "}, {"text": "therapy"}], "list": {"level": 3, "numberingId": "337"}}, {"id": "body-27153", "type": "paragraph", "style": "ListParagraph", "text": "Supportive psychotherapy", "runs": [{"text": "Supportive"}, {"text": " "}, {"text": "psychotherapy"}], "list": {"level": 3, "numberingId": "337"}}, {"id": "body-27154", "type": "paragraph", "style": "ListParagraph", "text": "Relaxation techniques", "runs": [{"text": "Relaxation"}, {"text": " "}, {"text": "techniques"}], "list": {"level": 3, "numberingId": "337"}}, {"id": "body-27155", "type": "paragraph", "style": "ListParagraph", "text": "Sleep hygiene", "runs": [{"text": "Sleep"}, {"text": " "}, {"text": "hygiene"}], "list": {"level": 3, "numberingId": "337"}}, {"id": "body-27156", "type": "paragraph", "style": "ListParagraph", "text": "Dietary counseling", "runs": [{"text": "Dietary"}, {"text": " "}, {"text": "counseling"}], "list": {"level": 3, "numberingId": "337"}}, {"id": "body-27158", "type": "heading", "style": "Heading4", "text": "Pharmacological Management", "runs": [{"text": "Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-27159", "type": "paragraph", "style": "BodyText", "text": "Refer to the specific section above", "runs": [{"text": "Refer"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "specific"}, {"text": " "}, {"text": "section"}, {"text": " "}, {"text": "above"}]}, {"id": "body-27160-textbox1-00001", "type": "paragraph", "style": "Normal", "text": "Note:", "runs": [{"text": "Note:", "bold": true}]}, {"id": "body-27160-textbox1-00002", "type": "paragraph", "style": "BodyText", "text": "Decision whether to use mood stabilizers must be made following an assessment of risks and benefits.", "runs": [{"text": "Decision"}, {"text": " "}, {"text": "whether"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "use"}, {"text": " "}, {"text": "mood"}, {"text": " "}, {"text": "stabilizers"}, {"text": " "}, {"text": "must"}, {"text": " "}, {"text": "be"}, {"text": " "}, {"text": "made"}, {"text": " "}, {"text": "following"}, {"text": " "}, {"text": "an"}, {"text": " "}, {"text": "assessment"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "risks"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "benefits."}], "list": {"level": 0, "numberingId": "336"}}, {"id": "body-27160-textbox1-00003", "type": "paragraph", "style": "BodyText", "text": "Low doses of mood stabilizers should be as low as possible", "runs": [{"text": "Low"}, {"text": " "}, {"text": "doses"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "mood"}, {"text": " "}, {"text": "stabilizers"}, {"text": " "}, {"text": "should"}, {"text": " "}, {"text": "be"}, {"text": " "}, {"text": "as"}, {"text": " "}, {"text": "low"}, {"text": " "}, {"text": "as"}, {"text": " "}, {"text": "possible"}], "list": {"level": 0, "numberingId": "336"}}, {"id": "body-27160-textbox1-00004", "type": "paragraph", "style": "BodyText", "text": "Factors to consider include number and severity of previous episodes, level of insight, family supports, and the wishes of the woman", "runs": [{"text": "Factors"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "consider"}, {"text": " "}, {"text": "include"}, {"text": " "}, {"text": "number"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "severity"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "previous"}, {"text": " "}, {"text": "episodes,"}, {"text": " "}, {"text": "level"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "insight,"}, {"text": " "}, {"text": "family"}, {"text": " "}, {"text": "supports,"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "wishes of the woman"}], "list": {"level": 0, "numberingId": "336"}}, {"id": "body-27160-textbox1-00005", "type": "paragraph", "style": "BodyText", "text": "Careful monitoring of psychological symptoms throughout the pregnancy is of paramount importance", "runs": [{"text": "Careful"}, {"text": " "}, {"text": "monitoring"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "psychological"}, {"text": " "}, {"text": "symptoms"}, {"text": " "}, {"text": "throughout"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "pregnancy"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "paramount"}, {"text": " "}, {"text": "importance"}], "list": {"level": 0, "numberingId": "336"}}, {"id": "body-27162", "type": "heading", "style": "Heading4", "text": "Schizophrenia", "runs": [{"text": "Schizophrenia"}], "level": 4, "list": {"level": 2, "numberingId": "337"}}, {"id": "body-27163", "type": "paragraph", "style": "Normal", "text": "Non-Pharmacological Management", "runs": [{"text": "Non-Pharmacological", "bold": true}, {"text": " ", "bold": true}, {"text": "Management", "bold": true}]}, {"id": "body-27164", "type": "paragraph", "style": "ListParagraph", "text": "Cognitive behavioral therapy", "runs": [{"text": "Cognitive"}, {"text": " "}, {"text": "behavioral"}, {"text": " "}, {"text": "therapy"}], "list": {"level": 3, "numberingId": "337"}}, {"id": "body-27165", "type": "paragraph", "style": "ListParagraph", "text": "Supportive psychotherapy", "runs": [{"text": "Supportive"}, {"text": " "}, {"text": "psychotherapy"}], "list": {"level": 3, "numberingId": "337"}}, {"id": "body-27166", "type": "paragraph", "style": "ListParagraph", "text": "Relaxation techniques", "runs": [{"text": "Relaxation"}, {"text": " "}, {"text": "techniques"}], "list": {"level": 3, "numberingId": "337"}}, {"id": "body-27167", "type": "paragraph", "style": "ListParagraph", "text": "Sleep hygiene", "runs": [{"text": "Sleep"}, {"text": " "}, {"text": "hygiene"}], "list": {"level": 3, "numberingId": "337"}}, {"id": "body-27168", "type": "paragraph", "style": "ListParagraph", "text": "Dietary counseling", "runs": [{"text": "Dietary"}, {"text": " "}, {"text": "counseling"}], "list": {"level": 3, "numberingId": "337"}}, {"id": "body-27169", "type": "heading", "style": "Heading4", "text": "Pharmacological Management", "runs": [{"text": "Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-27170", "type": "paragraph", "style": "BodyText", "text": "Treat as in the treatment of schizophrenia in non-pregnant woman", "runs": [{"text": "Treat"}, {"text": " "}, {"text": "as"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "treatment"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "schizophrenia"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "non-pregnant"}, {"text": " "}, {"text": "woman"}]}, {"id": "body-27171-textbox1-00001", "type": "paragraph", "style": "Normal", "text": "Note:", "runs": [{"text": "Note:", "bold": true}]}, {"id": "body-27171-textbox1-00002", "type": "paragraph", "style": "BodyText", "text": "Women with a history of psychosis require close monitoring during pregnancy", "runs": [{"text": "Women"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "history"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "psychosis"}, {"text": " "}, {"text": "require"}, {"text": " "}, {"text": "close"}, {"text": " "}, {"text": "monitoring"}, {"text": " "}, {"text": "during"}, {"text": " "}, {"text": "pregnancy"}], "list": {"level": 0, "numberingId": "335"}}, {"id": "body-27171-textbox1-00003", "type": "paragraph", "style": "BodyText", "text": "Psychosis during pregnancy can have devastating consequences for both the mother and her fetus, including failure to obtain proper prenatal care, negative pregnancy outcomes such as low birth weight and prematurity, and neonaticide or suicide", "runs": [{"text": "Psychosis"}, {"text": " "}, {"text": "during"}, {"text": " "}, {"text": "pregnancy"}, {"text": " "}, {"text": "can"}, {"text": " "}, {"text": "have"}, {"text": " "}, {"text": "devastating"}, {"text": " "}, {"text": "consequences"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "both"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "mother"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "her"}, {"text": " "}, {"text": "fetus,"}, {"text": " "}, {"text": "including"}, {"text": " "}, {"text": "failure to obtain proper prenatal care, negative pregnancy outcomes such as low birth weight and prematurity, and neonaticide or suicide"}], "list": {"level": 0, "numberingId": "335"}}, {"id": "body-27171-textbox1-00004", "type": "paragraph", "style": "BodyText", "text": "Treatment of acute psychosis in pregnancy is mandatory and includes mobilization of supports, pharmacotherapy, and hospitalization", "runs": [{"text": "Treatment of acute psychosis in pregnancy is mandatory and includes mobilization of supports, pharmacotherapy, and hospitalization"}], "list": {"level": 0, "numberingId": "335"}}, {"id": "body-27171-textbox1-00005", "type": "paragraph", "style": "BodyText", "text": "Electroconvulsive therapy may be used for psychotic depression", "runs": [{"text": "Electroconvulsive"}, {"text": " "}, {"text": "therapy"}, {"text": " "}, {"text": "may"}, {"text": " "}, {"text": "be"}, {"text": " "}, {"text": "used"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "psychotic"}, {"text": " "}, {"text": "depression"}], "list": {"level": 0, "numberingId": "335"}}], "source": {"file": "medical.docx", "chapter": "Mental health conditions", "start": "body-27122", "end": "body-27171-textbox1-00005"}}