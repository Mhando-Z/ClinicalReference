"}, {"text": " "}, {"text": "Gram-positive"}, {"text": " "}, {"text": "(especially"}, {"text": " "}, {"text": "Staphylococcus"}, {"text": " "}, {"text": "aureus,"}, {"text": " "}, {"text": "including"}, {"text": " "}, {"text": "MRSA)"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "Gram-negative"}, {"text": " "}, {"text": "organisms."}, {"text": " "}, {"text": "Treatment duration is 14-21 days"}]}, {"id": "body-22778", "type": "paragraph", "style": "BodyText", "text": "Adults", "runs": [{"text": "Adults"}]}, {"id": "body-22779", "type": "paragraph", "style": "BodyText", "text": "S: vancomycin (IV) in MRSA: Loading dose of 20 mg/kg over the last hour of dialysis, then maintenance doses of 500–1000 mg IV during the last hour of subsequent HD sessions, three times weekly", "runs": [{"text": "S", "bold": true}, {"text": ": vancomycin (IV) in MRSA: Loading dose of 20 mg/kg over the last hour of dialysis, then maintenance doses of 500–1000 mg IV during the last hour of subsequent HD sessions, three times weekly"}]}, {"id": "body-22780", "type": "paragraph", "style": "Heading3", "text": "OR", "runs": [{"text": "OR"}], "level": 3, "conjunction": true}, {"id": "body-22781", "type": "paragraph", "style": "BodyText", "text": "C: flucloxacillin (IV) in MSSA: 1-6 g/day divided into 3 doses and then oral therapy", "runs": [{"text": "C:", "bold": true}, {"text": " ", "bold": true}, {"text": "flucloxacillin"}, {"text": " "}, {"text": "(IV)"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "MSSA:"}, {"text": " "}, {"text": "1-6"}, {"text": " "}, {"text": "g/day"}, {"text": " "}, {"text": "divided"}, {"text": " "}, {"text": "into"}, {"text": " "}, {"text": "3"}, {"text": " "}, {"text": "doses"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "then"}, {"text": " "}, {"text": "oral"}, {"text": " "}, {"text": "therapy"}]}, {"id": "body-22782", "type": "paragraph", "style": "Heading3", "text": "AND", "runs": [{"text": "AND"}], "level": 3, "conjunction": true},