 months after the event or procedure:"}]}, {"id": "body-20526", "type": "paragraph", "style": "BodyText", "text": "A: acetylsalicylic acid (PO) 75–100mg 24hourly", "runs": [{"text": "A:", "bold": true}, {"text": " ", "bold": true}, {"text": "acetylsalicylic"}, {"text": " "}, {"text": "acid"}, {"text": " "}, {"text": "(PO)"}, {"text": " "}, {"text": "75–100mg"}, {"text": " "}, {"text": "24hourly"}]}, {"id": "body-20527", "type": "paragraph", "style": "Heading3", "text": "AND", "runs": [{"text": "AND"}], "level": 3, "conjunction": true}, {"id": "body-20528", "type": "paragraph", "style": "BodyText", "text": "D: clopidogrel (PO) 75mg 24hourly", "runs": [{"text": "D:", "bold": true}, {"text": " ", "bold": true}, {"text": "clopidogrel"}, {"text": " "}, {"text": "(PO)"}, {"text": " "}, {"text": "75mg"}, {"text": " "}, {"text": "24hourly"}]}, {"id": "body-20529-textbox1-00001", "type": "paragraph", "style": "Normal", "text": "Note:", "runs": [{"text": "Note:", "bold": true}]}, {"id": "body-20529-textbox1-00002", "type": "paragraph", "style": "BodyText", "text": "Acetylsalicylic acid is also indicated for primary prevention for people with T2DM >40years with family history of ischemic heart disease (IHD), cigarette smoking, obesity, proteinuria, or dyslipidemia.", "runs": [{"text": "Acetylsalicylic"}, {"text": " "}, {"text": "acid"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "also"}, {"text": " "}, {"text": "indicated"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "primary"}, {"text": " "}, {"text": "prevention"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "people"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "T2DM"}, {"text": " "}, {"text": ">40years"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "family"}, {"text": " "}, {"text": "history"}, {"text": " "}, {"text": "of ischemic heart disease (IHD), cigarette smoking, obesity, proteinuria, or dyslipidemia."}], "list": {"level": 0, "numberingId": "873"}}, {"id": "body-20529-textbox1-00003", "type": "paragraph", "style": "BodyText", "text": "It is contraindicated in peptic/duodenal ulcer, dyspepsia, heartburn, malignant hypertension, hemorrhagic stroke.", "runs": [{"text": "It"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "contraindicated"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "peptic/duodenal"}, {"text": " "}, {"text": "ulcer,"}, {"text": " "}, {"text": "dyspepsia,"}, {"text": " "}, {"text": "heartburn,"}, {"text": " "}, {"text": "malignant"}, {"text": " "}, {"text": "hypertension,"}, {"text": " "}, {"text": "hemorrhagic"}, {"text": " "}, {"text": "stroke."}], "list": {"level": 0, "numberingId": "873"}}, {"id": "body-20531", "type": "heading", "style": "Heading4", "text": "Hyperlipidemia", "runs": [{"text": "Hyperlipidemia"}], "level": 4}, {"id": "body-20533", "type": "paragraph", "style": "BodyText", "text": "Statin therapy results in a significant decrease in CVD morbidity and mortality in T2DM and are indicated in Type 2 diabetics > 40 years of age, or diabetes for > 10years", "runs": [{"text": "Statin"}, {"text": " "}, {"text": "therapy"}, {"text": " "}, {"text": "results"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "significant"}, {"text": " "}, {"text": "decrease"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "CVD"}, {"text": " "}, {"text": "morbidity"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "mortality"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "T2DM"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "are"}, {"text": " "}, {"text": "indicated"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "Type"}, {"text": " "}, {"text": "2"}, {"text": " "}, {"text": "diabetics"}, {"text": " "}, {"text": "> 40 years of age, or diabetes for > 10years"}]}, {"id": "body-20535", "type": "paragraph", "style": "BodyText", "text": "B: atorvastatin (PO) 10mg 24hourly. Dose may be increased to 80mg daily i