{"id": "section-body-10996", "title": "Pregnancy induced hypertension (gestational hypertension)", "chapterId": "chapter-eleven", "tocLevel": 4, "tocPath": ["APPROACH TO PATIENTS WITH EMERGENCY CONDITIONS", "OBSTETRICS, GYNECOLOGY AND CONTRACEPTION", "Antenatal Care", "Pregnancy induced hypertension (gestational hypertension)"], "blocks": [{"id": "body-10996", "type": "heading", "style": "Heading4", "text": "Pregnancy induced hypertension (gestational hypertension)", "runs": [{"text": "Pregnancy"}, {"text": " "}, {"text": "induced"}, {"text": " "}, {"text": "hypertension"}, {"text": " "}, {"text": "(gestational"}, {"text": " "}, {"text": "hypertension)"}], "level": 4, "list": {"level": 3, "numberingId": "1452"}}, {"id": "body-10997", "type": "paragraph", "style": "BodyText", "text": "Gestational hypertension or pregnancy-induced hypertension (PIH) is the development of new hypertension in a pregnant woman after 20 weeks of gestation without the presence of protein in the urine or other signs of preeclampsia. Usually disappears within 12 weeks postpartum.", "runs": [{"text": "Gestational hypertension or pregnancy-induced hypertension (PIH) is the development of new hypertension in a pregnant woman after 20 weeks of gestation without the presence of protein in the urine or other signs of preeclampsia. Usually disappears within 12 weeks postpartum."}]}, {"id": "body-11000", "type": "heading", "style": "Heading4", "text": "Non-Pharmacological Management", "runs": [{"text": "Non-Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-11001", "type": "paragraph", "style": "ListParagraph", "text": "Adequate rest at home and avoid strenuous activities", "runs": [{"text": "Adequate"}, {"text": " "}, {"text": "rest"}, {"text": " "}, {"text": "at"}, {"text": " "}, {"text": "home"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "avoid"}, {"text": " "}, {"text": "strenuous"}, {"text": " "}, {"text": "activities"}], "list": {"level": 4, "num