xt": "hour."}], "list": {"level": 0, "numberingId": "1648"}}, {"id": "body-06124", "type": "heading", "style": "Heading4", "text": "Surgical management", "runs": [{"text": "Surgical management"}], "level": 4}, {"id": "body-06126", "type": "paragraph", "style": "ListParagraph", "text": "Bed pan, indwelling Foley catheter if patient is lethargic, incontinent with strict Inputs & outputs measurements.", "runs": [{"text": "Bed pan,"}, {"text": " "}, {"text": "indwelling Foley catheter"}, {"text": " "}, {"text": "if"}, {"text": " "}, {"text": "patient"}, {"text": " "}, {"text": "is lethargic, incontinent with strict Inputs & outputs measurements."}], "list": {"level": 0, "numberingId": "1647"}}, {"id": "body-06127", "type": "paragraph", "style": "ListParagraph", "text": "Keep Nil per Oral (if in preparation for surgery or endovascular intervention)", "runs": [{"text": "Keep Nil per Oral (if in preparation for surgery or endovascular intervention)"}], "list": {"level": 0, "numberingId": "1647"}}, {"id": "body-06128", "type": "paragraph", "style": "ListParagraph", "text": "Maintain SBP 120–160mmHg in unsecured (unclipped/uncoiled) aneurysm to minimize rebleeding risk, consider", "runs": [{"text": "Maintain SBP 120–160mmHg in unsecured (unclipped/uncoiled) aneurysm to minimize rebleeding risk, consider"}], "list": {"level": 0, "numberingId": "1647"}}, {"id": "body-06130", "type": "paragraph", "style": "BodyText", "text": "For Neurosurgical evaluation and Intervention via surgical clipping or endovascular intervention (coiling or embolization) to secure the ruptured cerebral aneurysm.", "runs": [{"text": "For"}, {"text": " "}, {"text": "Neurosurgical"}, {"text": " "}, {"text": "evaluation"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "Intervention"}, {"text": " "}, {"text": "via"}, {"text": " "}, {"text": "surgical"}, {"text": " "}, {"text": "clipping"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "endovascular"}, {"text": " "}, {"text": "intervention