: "paragraph", "style": "BodyText", "text": "For Pediatrics 0.01mg/kg, every 5-15min as soon as possible. If inadequate response, start.", "runs": [{"text": "For"}, {"text": " "}, {"text": "Pediatrics"}, {"text": " "}, {"text": "0.01mg/kg,"}, {"text": " "}, {"text": "every"}, {"text": " "}, {"text": "5-15min"}, {"text": " "}, {"text": "as"}, {"text": " "}, {"text": "soon"}, {"text": " "}, {"text": "as"}, {"text": " "}, {"text": "possible. If inadequate response, start."}]}, {"id": "body-00906", "type": "paragraph", "style": "BodyText", "text": "A: epinephrine (adrenaline) (IV) 0.05- 1mcg/kg/min in 0.9% sodium chloride or sodium lactate compound (ringer’s lactate)20mls/kg", "runs": [{"text": "A:", "bold": true}, {"text": " ", "bold": true}, {"text": "epinephrine"}, {"text": " "}, {"text": "(adrenaline)"}, {"text": " "}, {"text": "(IV)"}, {"text": " "}, {"text": "0.05-"}, {"text": " "}, {"text": "1mcg/kg/min"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "0.9%"}, {"text": " "}, {"text": "sodium"}, {"text": " "}, {"text": "chloride"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "sodium"}, {"text": " "}, {"text": "lactate"}, {"text": " "}, {"text": "compound"}, {"text": " "}, {"text": "(ringer’s "}, {"text": "lactate)20mls/kg"}]}, {"id": "body-00907", "type": "paragraph", "style": "BodyText", "text": "If hypotensive.", "runs": [{"text": "If"}, {"text": " hypotensive."}]}, {"id": "body-00908", "type": "paragraph", "style": "BodyText", "text": "Repeat IV fluids as needed.", "runs": [{"text": "Repeat"}, {"text": " "}, {"text": "IV"}, {"text": " "}, {"text": "fluids"}, {"text": " "}, {"text": "as"}, {"text": " "}, {"text": "needed."}]}, {"id": "body-00909", "type": "heading", "style": "Heading3", "text": "OR/AND", "runs": [{"text": "OR/AND"}], "level": 3}, {"id": "body-00910", "type": "paragraph", "style": "BodyText", "text": "A: hydrocortisone (IV)200mg stat", "runs": [{"text": "A:", "bold": true}, {"text": " ", "bold": true}, {"text": "hydrocortisone