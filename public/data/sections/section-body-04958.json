≥10%"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "East"}, {"text": " "}, {"text": "Africa"}, {"text": " "}, {"text": "which"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "above"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "recommended"}, {"text": " "}, {"text": "threshold for using NNRTIs."}], "list": {"level": 0, "numberingId": "1734"}}, {"id": "body-04962-textbox1-00004", "type": "paragraph", "style": "BodyText", "text": "**LPV/r should be used in the first line if DTG can’t be used due to intolerance and when there is resistance to EFV", "runs": [{"text": "**LPV/r"}, {"text": " "}, {"text": "should"}, {"text": " "}, {"text": "be"}, {"text": " "}, {"text": "used"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "first"}, {"text": " "}, {"text": "line"}, {"text": " "}, {"text": "if"}, {"text": " "}, {"text": "DTG"}, {"text": " "}, {"text": "can’t"}, {"text": " "}, {"text": "be"}, {"text": " "}, {"text": "used"}, {"text": " "}, {"text": "due"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "intolerance"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "when"}, {"text": " "}, {"text": "there"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "resistance"}, {"text": " "}, {"text": "to "}, {"text": "EFV"}], "list": {"level": 0, "numberingId": "1734"}}, {"id": "body-04962-textbox1-00005", "type": "paragraph", "style": "BodyText", "text": "TAF is contraindicated in TB/HIV co-infection as Rifampicin lowers TAF concentration below the therapeutic level.", "runs": [{"text": "TAF is contraindicated in TB/HIV co-infection as Rifampicin lowers TAF concentration below the therapeutic "}, {"text": "level."}], "list": {"level": 0, "numberingId": "1734"}}, {"id": "body-04962-textbox1-00006", "type": "paragraph", "style": "BodyText", "text": "TAF use in pregnancy is currently not recommended due to limited data on its safety.", "runs": [{"text": "TAF"}, {"text": " "}, {"text": "use"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "pregnancy"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "currently"}, {"text": " "}, {"text": "not"}, {"text": " "}, {"text": "recommended"}, {"text": " "}, {"text": "due"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "limited"}, {"text": " "}, {"text": "data"}, {"text": " "}, {"text": "on"}, {"text": " "}, {"text": "its"}, {"text": " "}, {"text": "safety."}], "list": {"level": 0, "numberingId": "1734"}}, {"id": "body-04962-textbox1-00007", "type": "paragraph", "style": "BodyText", "text": "For recipients of care with weight <30kg, avoid TDF and use ABC based regimen.", "runs": [{"text": "For"}, {"text": " "}, {"text": "recipients"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "care"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "weight"}, {"text": " "}, {"text": "<30kg,"}, {"text": " "}, {"text": "avoid"}, {"text": " "}, {"text": "TDF"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "use"}, {"text": " "}, {"text": "ABC"}, {"text": " "}, {"text": "based"}, {"text": " "}, {"text": "regimen."}], "list": {"level": 0, "numberingId": "1734"}}, {"id": "body-04962-textbox1-00008", "type": "paragraph", "style": "BodyText", "text": "Consider PI based ARV if unable to use DTG and EFV", "runs": [{"text": "Consider"}, {"text": " "}, {"text": "PI"}, {"text": " "}, {"text": "based"}, {"text": " "}, {"text": "ARV"}, {"text": " "}, {"text": "if"}, {"text": " "}, {"text": "unable"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "use"}, {"text": " "}, {"text": "DTG"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "EFV"}], "list": {"level": 0, "numberingId": "1734"}}, {"id": "body-04962-textbox1-00009", "type": "paragraph", "style": "BodyText", "text": "DTG does not interact with methadone; therefore, it is a suitable drug for regimens in PWID. Initiate treatment after the Recipient of Care (RoC) has been stabilized, usually 2-3months after starting MAT.", "runs": [{"text": "DTG"}, {"text": " "}, {"text": "does"}, {"text": " "}, {"text": "not"}, {"text": " "}, {"text": "interact"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "methadone;"}, {"text": " "}, {"text": "therefore,"}, {"text": " "}, {"text": "it"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "suitable"}, {"text": " "}, {"text": "drug"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "regimens"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "PWID."}, {"text": " "}, {"text": "Initiate"}, {"text": " "}, {"text": "treatment after the Recipient of Care (RoC) has been stabilized, usually 2-3months after starting MAT."}], "list": {"level": 0, "numberingId": "1734"}}, {"id": "body-04962-textbox1-00010", "type": "paragraph", "style": "BodyText", "text": "Administer DTG50mg twice a day for RoC on Rifampicin based regimen to reach DTG therapeutic levels.", "runs": [{"text": "Administer"}, {"text": " "}, {"text": "DTG50mg"}, {"text": " "}, {"text": "twice"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "day"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "RoC"}, {"text": " "}, {"text": "on"}, {"text": " "}, {"text": "Rifampicin"}, {"text": " "}, {"text": "based"}, {"text": " "}, {"text": "regimen"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "reach"}, {"text": " "}, {"text": "DTG"}, {"text": " "}, {"text": "therapeutic"}, {"text": " "}, {"text": "levels."}], "list": {"level": 0, "numberingId": "1734"}}, {"id": "body-04962-textbox1-00011", "type": "paragraph", "style": "BodyText", "text": "ARV drugs have the potential to decrease the bioavailability of hormonal contraceptives especially with oral contraceptives. Dual contraception with condoms and injectable contraceptives is therefore recommended.", "runs": [{"text": "ARV drugs have the potential to decrease the bioavailability of hormonal contraceptives especially with oral contraceptives. Dual contraception with condoms and injectable contraceptives is therefore recommended."}], "list": {"level": 0, "numberingId": "1734"}}, {"id": "body-04965", "type": "heading", "style": "Heading4", "text": "Prevention of vertical transmission of HIV, Syphilis and Hepatitis B", "runs": [{"text": "Prevention"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "vertical"}, {"text": " "}, {"text": "transmission"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "HIV,"}, {"text": " "}, {"text": "Syphilis"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "Hepatitis"}, {"text": " "}, {"text": "B"}], "level": 4, "list": {"level": 2, "numberingId": "1741"}}, {"id": "body-04967", "type": "paragraph", "style": "BodyText", "text": "The PMTCT program aims to eliminate vertical transmission of HIV, Syphilis, and Hepatitis B by using effective interventions such as antenatal screening, treatment, and vaccination. The risks of vertical transmission without intervention are significant, and multiple risk factors increase the chance of a mother transmitting HIV, Syphilis and Hepatitis B virus to her child. The goal is to achieve aMTCT rate of less than 4% for HIV, less than 50cases of congenital syphilis per 100,000 live births, and less than 0.1% prevalence of HBsAg among children.", "runs": [{"text": "The"}, {"text": " "}, {"text": "PMTCT"}, {"text": " "}, {"text": "program aims"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "eliminate"}, {"text": " "}, {"text": "vertical"}, {"text": " "}, {"text": "transmission"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "HIV,"}, {"text": " "}, {"text": "Syphilis,"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "Hepatitis"}, {"text": " "}, {"text": "B"}, {"text": " "}, {"text": "by"}, {"text": " "}, {"text": "using"}, {"text": " "}, {"text": "effective"}, {"text": " "}, {"text": "interventions such"}, {"text": " "}, {"text": "as"}, {"text": " "}, {"text": "antenatal"}, {"text": " "}, {"text": "screening,"}