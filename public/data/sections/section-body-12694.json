{"id": "section-body-12694", "title": "Abscess", "chapterId": "chapter-thirteen", "tocLevel": 4, "tocPath": ["APPROACH TO PATIENTS WITH EMERGENCY CONDITIONS", "SKIN DISEASES", "Bacterial Skin Infection", "Abscess"], "blocks": [{"id": "body-12694", "type": "heading", "style": "Heading4", "text": "Abscess", "runs": [{"text": "Abscess"}], "level": 4, "list": {"level": 2, "numberingId": "1368"}}, {"id": "body-12695", "type": "paragraph", "style": "Normal", "text": "An abscess is a collection of pus within the dermis or subcutaneous tissue caused by Staphylococcus aureus.", "runs": [{"text": "An"}, {"text": " "}, {"text": "abscess"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "collection"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "pus"}, {"text": " "}, {"text": "within"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "dermis"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "subcutaneous"}, {"text": " "}, {"text": "tissue"}, {"text": " "}, {"text": "caused"}, {"text": " "}, {"text": "by"}, {"text": " "}, {"text": "Staphylococcus", "italic": true}, {"text": " ", "italic": true}, {"text": "aureus.", "italic": true}]}, {"id": "body-12697", "type": "heading", "style": "Heading4", "text": "Clinical Presentation:", "runs": [{"text": "Clinical"}, {"text": " "}, {"text": "Presentation:"}], "level": 4}, {"id": "body-12698", "type": "paragraph", "style": "ListParagraph", "text": "Painful, fluctuant, erythematous nodules filled with pus", "runs": [{"text": "Painful,"}, {"text": " "}, {"text": "fluctuant,"}, {"text": " "}, {"text": "erythematous"}, {"text": " "}, {"text": "nodules"}, {"text": " "}, {"text": "filled"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "pus"}], "list": {"level": 0, "numberingId": "1349"}}, {"id": "body-12699", "type": "paragraph", "style": "ListParagraph", "text": "Spontaneous drainage of purulent material may occur", "runs": [{"text": "Spontaneous"}, {"text": " "}, {"text": "drainage"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "purulent"}, {"text": " "}, {"text": "material"}, {"text": " "}, {"text": "may"}, {"text": " "}, {"text": "occur"}], "list": {"level": 0, "numberingId": "1349"}}, {"id": "body-12700", "type": "paragraph", "style": "ListParagraph", "text": "Fever and chills are often absent", "runs": [{"text": "Fever"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "chills"}, {"text": " "}, {"text": "are"}, {"text": " "}, {"text": "often"}, {"text": " "}, {"text": "absent"}], "list": {"level": 0, "numberingId": "1349"}}, {"id": "body-12702", "type": "heading", "style": "Heading4", "text": "Surgical Treatment", "runs": [{"text": "Surgical"}, {"text": " "}, {"text": "Treatment"}], "level": 4}, {"id": "body-12703", "type": "paragraph", "style": "ListParagraph", "text": "Incision and drainage", "runs": [{"text": "Incision"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "drainage"}], "list": {"level": 0, "numberingId": "1349"}}, {"id": "body-12704", "type": "paragraph", "style": "ListParagraph", "text": "If incision and drainage are not performed, apply hot compresses several times per day to the swelling until it breaks.", "runs": [{"text": "If"}, {"text": " "}, {"text": "incision"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "drainage"}, {"text": " "}, {"text": "are"}, {"text": " "}, {"text": "not"}, {"text": " "}, {"text": "performed,"}, {"text": " "}, {"text": "apply"}, {"text": " "}, {"text": "hot"}, {"text": " "}, {"text": "compresses"}, {"text": " "}, {"text": "several"}, {"text": " "}, {"text": "times"}, {"text": " "}, {"text": "per"}, {"text": " "}, {"text": "day"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "swelling"}, {"text": " "}, {"text": "until"}, {"text": " "}, {"text": "it"}, {"text": " "}, {"text": "breaks."}], "list": {"level": 0, "numberingId": "1349"}}, {"id": "body-12706", "type": "heading", "style": "Heading4", "text": "Pharmacological Management:", "runs": [{"text": "Pharmacological"}, {"text": " "}, {"text": "Management:"}], "level": 4}, {"id": "body-12707", "type": "paragraph", "style": "BodyText", "text": "A: sulfamethoxazole + trimethoprim (cotrimoxazole) (PO) 480-960mg; paediatric 8-12 TMP mg/kg 12hourly for 5-7 days", "runs": [{"text": "A:", "bold": true}, {"text": " ", "bold": true}, {"text": "sulfamethoxazole"}, {"text": " "}, {"text": "+"}, {"text": " "}, {"text": "trimethoprim"}, {"text": " "}, {"text": "(cotrimoxazole)"}, {"text": " "}, {"text": "(PO)"}, {"text": " "}, {"text": "480-960mg;"}, {"text": " "}, {"text": "paediatric"}, {"text": " "}, {"text": "8-12"}, {"text": " "}, {"text": "TMP"}, {"text": " "}, {"text": "mg/kg"}, {"text": " "}, {"text": "12hourly"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "5-7"}, {"text": " "}, {"text": "days"}]}, {"id": "body-12708", "type": "paragraph", "style": "Heading3", "text": "OR", "runs": [{"text": "OR"}], "level": 3, "conjunction": true}, {"id": "body-12709", "type": "paragraph", "style": "BodyText", "text": "B: cefalexin (PO) 250 to 500mg; paediatric 25-50 mg/kg 6hourly for 7days", "runs": [{"text": "B:", "bold": true}, {"text": " ", "bold": true}, {"text": "cefalexin"}, {"text": " "}, {"text": "(PO)"}, {"text": " "}, {"text": "250"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "500mg;"}, {"text": " "}, {"text": "paediatric"}, {"text": " "}, {"text": "25-50"}, {"text": " "}, {"text": "mg/kg"}, {"text": " "}, {"text": "6hourly"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "7days"}]}], "source": {"file": "medical.docx", "chapter": "Skin diseases", "start": "body-12694", "end": "body-12709"}}