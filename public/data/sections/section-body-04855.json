{"id": "section-body-04855", "title": "Malaria in Pregnancy", "chapterId": "chapter-five", "tocLevel": 4, "tocPath": ["APPROACH TO PATIENTS WITH EMERGENCY CONDITIONS", "MALARIA", "Management of Malaria in Special Groups", "Malaria in Pregnancy"], "blocks": [{"id": "body-04855", "type": "heading", "style": "Heading4", "text": "Malaria in Pregnancy", "runs": [{"text": "Malaria"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "Pregnancy"}], "level": 4, "list": {"level": 2, "numberingId": "1748"}}, {"id": "body-04856", "type": "paragraph", "style": "BodyText", "text": "The effects of malaria in pregnancy are related to the malaria endemicity, with abortion more common in areas of low endemicity and intrauterine growth retardation more common in areas of high endemicity.", "runs": [{"text": "The"}, {"text": " "}, {"text": "effects"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "malaria"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "pregnancy"}, {"text": " "}, {"text": "are"}, {"text": " "}, {"text": "related"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "malaria"}, {"text": " "}, {"text": "endemicity,"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "abortion"}, {"text": " "}, {"text": "more"}, {"text": " "}, {"text": "common"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "areas"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "low endemicity and intrauterine growth retardation more common in areas of high endemicity."}]}], "source": {"file": "medical.docx", "chapter": "Malaria", "start": "body-04855", "end": "body-04856"}}