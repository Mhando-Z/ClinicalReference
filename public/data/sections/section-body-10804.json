M)10IU stat", "runs": [{"text": "A:", "bold": true}, {"text": " ", "bold": true}, {"text": "oxytocin"}, {"text": " "}, {"text": "(IM)10IU"}, {"text": " "}, {"text": "stat"}]}, {"id": "body-10841", "type": "paragraph", "style": "Heading3", "text": "AND", "runs": [{"text": "AND"}], "level": 3, "conjunction": true}, {"id": "body-10842", "type": "paragraph", "style": "BodyText", "text": "(In High-risk women as per guidelines)", "runs": [{"text": "(In"}, {"text": " "}, {"text": "High-risk"}, {"text": " "}, {"text": "women"}, {"text": " "}, {"text": "as"}, {"text": " "}, {"text": "per"}, {"text": " "}, {"text": "guidelines)"}]}, {"id": "body-10843", "type": "paragraph", "style": "BodyText", "text": "A: misoprostol (PO) 600mcg - 1200mcg stat", "runs": [{"text": "A:", "bold": true}, {"text": " ", "bold": true}, {"text": "misoprostol"}, {"text": " "}, {"text": "(PO)"}, {"text": " "}, {"text": "600mcg"}, {"text": " "}, {"text": "-"}, {"text": " "}, {"text": "1200mcg"}, {"text": " "}, {"text": "stat"}]}, {"id": "body-10844", "type": "paragraph", "style": "Heading3", "text": "OR", "runs": [{"text": "OR"}], "level": 3, "conjunction": true}, {"id": "body-10845", "type": "paragraph", "style": "BodyText", "text": "B: carbetocin 100mcg stat as 3rd line management after other interventions", "runs": [{"text": "B:", "bold": true}, {"text": " ", "bold": true}, {"text": "carbetocin"}, {"text": " "}, {"text": "100mcg"}, {"text": " "}, {"text": "stat"}, {"text": " "}, {"text": "as"}, {"text": " "}, {"text": "3rd"}, {"text": " "}, {"text": "line"}, {"text": " "}, {"text": "management"}, {"text": " "}, {"text": "after"}, {"text": " "}, {"text": "other"}, {"text": " "}, {"text": "interventions"}]}, {"id": "body-10847", "type": "paragraph", "style": "BodyText", "text": "Controlled cord traction (CCT) is recommended for vaginal births. Sustained uterine massage is not recommended as an intervention to prevent PPH in women who have received prophylactic oxytocin.", "runs": [{"text": "Controlled"}, {"text": " "}, {"text": "cord"}, {"text": " "}, {"text": "traction"}, {"text": " "}, {"text": "(CCT)"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "recommended"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "vaginal"}, {"text": " "}, {"text": "births."}, {"text": " "}, {"text": "Sustained"}, {"text": " "}, {"text": "uterine"}, {"text": " "}, {"text": "massage"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "not"}, {"text": " "}, {"text": "recommended"}, {"text": " "}, {"text": "as"}, {"text": " "}, {"text": "an intervention to prevent PPH in women who have received prophylactic oxytocin."}]}, {"id": "body-10849", "type": "heading", "style": "Heading4", "text": "Prevention of PPH in Cesarean section", "runs": [{"text": "Prevention"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "PPH"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "Cesarean"}, {"text": " "}, {"text": "section"}], "level": 4}, {"id": "body-10850", "type": "paragraph", "style": "BodyText", "text": "Cord traction is the recommended method for the removal of the placenta in Cesarean section", "runs": [{"text": "Cord"}, {"text": " "}, {"text": "traction"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "recommended"}, {"text": " "}, {"text": "method"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "removal"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "placenta"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "Cesarean"}, {"text": " "}, {"text": "section"}]}, {"id": "body-10852", "type": "paragraph", "style": "BodyText", "text": "A: oxytocin (IV/IM) 10IU (is the recommended uterotonic drug for the prevention of PPH plus MOTIVE bundle as per PPH guidelines when indicated)", "runs": [{"text": "A: ", "bold": true}, {"text": "oxytocin"}, {"text": " "}, {"text": "(IV/IM) 10IU"}, {"text": " "}, {"text": "(is the"}, {"text": " "}, {"text": "recommended"}, {"text": " "}, {"text": "uterotonic drug"}, {"text": " "}, {"text": "for the"}, {"text": " "}, {"text": "prevention"}, {"text": " "}, {"text": "of PPH"}, {"text": " "}, {"text": "plus MOTIVE"}, {"text": " "}, {"text": "bundle"}, {"text": " "}, {"text": "as per PPH guidelines when indicated)"}]}, {"id": "body-10853", "type": "paragraph", "style": "Heading3", "text": "OR", "runs": [{"text": "OR"}], "level": 3, "conjunction": true}, {"id": "body-10854", "type": "paragraph", "style": "BodyText", "text": "B: carbetocin (IV/IM) 100mcg stat as 3rd line management per guideline", "runs": [{"text": "B:", "bold": true}, {"text": " ", "bold": true}, {"text": "carbetocin"}, {"text": " "}, {"text": "(IV/IM)"}, {"text": " "}, {"text": "100mcg"}, {"text": " "}, {"text": "stat"}, {"text": " "}, {"text": "as"}, {"text": " "}, {"text": "3rd"}, {"text": " "}, {"text": "line"}, {"text": " "}, {"text": "management"}, {"text": " "}, {"text": "per"}, {"text": " "}, {"text": "guideline"}]}, {"id": "body-10856", "type": "heading", "style": "Heading2", "text": "Prelabour Rupture of Membranes (PROM)", "runs": [{"text": "Prelabour"}, {"text": " "}, {"text": "Rupture"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "Membranes"}, {"text": " "}, {"text": "(PROM)"}], "level": 2, "list": {"level": 1, "numberingId": "1452"}}, {"id": "body-10857", "type": "paragraph", "style": "BodyText", "text": "It is the rupture of membranes (breakage of the amniotic sac) before the onset of labor. If rupture occurs before 37weeks it is called preterm prelabour rupture of membranes (PPROM). Prolonged PROM is a case of premature rupture of membranes in which more than 24 hours have passed between the rupture and the onset of labour. Prolonged PROM for more than 18 hours is a risk of ascending infection which can lead to chorioamnionitis (infection of chorion, amnion and amniotic fluid.", "runs": [{"text": "It is the rupture of membranes (breakage of the amniotic sac) before