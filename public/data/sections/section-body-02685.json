"id": "body-02701-textbox1-00003", "type": "paragraph", "style": "BodyText", "text": "Never give Etamsylate or Tranexamic acid to patients bleeding per urethral", "runs": [{"text": "Never"}, {"text": " "}, {"text": "give"}, {"text": " "}, {"text": "Etamsylate"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "Tranexamic"}, {"text": " "}, {"text": "acid"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "patients"}, {"text": " "}, {"text": "bleeding"}, {"text": " "}, {"text": "per"}, {"text": " "}, {"text": "urethral"}], "list": {"level": 0, "numberingId": "1816"}}], "source": {"file": "medical.docx", "chapter": "Haematology and blood transfusion", "start": "body-02685", "end": "body-02701-textbox1-00003"}}