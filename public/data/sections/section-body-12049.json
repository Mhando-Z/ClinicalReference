{"id": "section-body-12049", "title": "Chlamydia", "chapterId": "chapter-twelve", "blocks": [{"id": "body-12049", "type": "heading", "style": "Heading2", "text": "Chlamydia", "runs": [{"text": "Chlamydia"}], "level": 2, "list": {"level": 1, "numberingId": "1397"}}, {"id": "body-12050", "type": "paragraph", "style": "BodyText", "text": "A common sexually transmitted infection caused by Chlamydia trachomatis, often asymptomatic but associated with significant reproductive complications if untreated.", "runs": [{"text": "A"}, {"text": " "}, {"text": "common"}, {"text": " "}, {"text": "sexually"}, {"text": " "}, {"text": "transmitted"}, {"text": " "}, {"text": "infection"}, {"text": " "}, {"text": "caused"}, {"text": " "}, {"text": "by"}, {"text": " "}, {"text": "Chlamydia"}, {"text": " "}, {"text": "trachomatis,"}, {"text": " "}, {"text": "often"}, {"text": " "}, {"text": "asymptomatic"}, {"text": " "}, {"text": "but"}, {"text": " "}, {"text": "associated"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "significant reproductive complications if untreated."}]}, {"id": "body-12052", "type": "heading", "style": "Heading4", "text": "Clinical Presentation", "runs": [{"text": "Clinical"}, {"text": " "}, {"text": "Presentation"}], "level": 4}, {"id": "body-12053", "type": "paragraph", "style": "ListParagraph", "text": "Often asymptomatic, especially in women.", "runs": [{"text": "Often"}, {"text": " "}, {"text": "asymptomatic,"}, {"text": " "}, {"text": "especially"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "women."}], "list": {"level": 0, "numberingId": "1370"}}, {"id": "body-12054", "type": "paragraph", "style": "ListParagraph", "text": "When symptomatic, may present as:", "runs": [{"text": "When"}, {"text": " "}, {"text": "symptomatic,"}, {"text": " "}, {"text": "may"}, {"text": " "}, {"text": "present"}, {"text": " "}, {"text": "as:"}], "list": {"level": 0, "numberingId": "1370"}}, {"id": "body-12055", "type": "paragraph", "style": "ListParagrap