{"id": "section-body-15643", "title": "Otitis Media with Effusion (Glue Ear)", "chapterId": "chapter-fifteen", "tocLevel": 4, "tocPath": ["APPROACH TO PATIENTS WITH EMERGENCY CONDITIONS", "EAR, NOSE AND THROAT/HEAD AND NECK DISEASES", "Trauma of the Pinna", "Otitis Media with Effusion (Glue Ear)"], "blocks": [{"id": "body-15643", "type": "heading", "style": "Heading4", "text": "Otitis Media with Effusion (Glue Ear)", "runs": [{"text": "Otitis"}, {"text": " "}, {"text": "Media"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "Effusion"}, {"text": " "}, {"text": "(Glue"}, {"text": " "}, {"text": "Ear)"}], "level": 4, "list": {"level": 3, "numberingId": "1219"}}, {"id": "body-15644", "type": "paragraph", "style": "BodyText", "text": "The presence of middle ear fluid without signs of acute infection. OME often occurs after acute otitis media (AOM) episodes, but it also may occur as a result of Eustachian tube dysfunction in young children in the absence of a preceding AOM.", "runs": [{"text": "The presence of middle ear fluid without signs of acute infection. OME often occurs after acute otitis media (AOM) episodes, but it also may occur as a result of Eustachian tube dysfunction in young children in the absence of a preceding AOM."}]}, {"id": "body-15646", "type": "heading", "style": "Heading4", "text": "Clinical Presentation", "runs": [{"text": "Clinical"}, {"text": " "}, {"text": "Presentation"}], "level": 4}, {"id": "body-15647", "type": "paragraph", "style": "BodyText", "text": "It is often discovered by chance with: -", "runs": [{"text": "It"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "often"}, {"text": " "}, {"text": "discovered"}, {"text": " "}, {"text": "by"}, {"text": " "}, {"text": "chance"}, {"text": " "}, {"text": "with:"}, {"text": " "}, {"text": "-"}]}, {"id": "body-15648", "type": "paragraph", "style": "BodyText", "text": "Little or no ear pain, Gradual loss of hearing, No ear discharge and Aural fullness.", "runs": [{"text": "Little"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "no"}, {"text": " "}, {"text": "ear"}, {"text": " "}, {"text": "pain,"}, {"text": " "}, {"text": "Gradual"}, {"text": " "}, {"text": "loss"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "hearing,"}, {"text": " "}, {"text": "No"}, {"text": " "}, {"text": "ear"}, {"text": " "}, {"text": "discharge"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "Aural"}, {"text": " "}, {"text": "fullness."}]}, {"id": "body-15650", "type": "paragraph", "style": "BodyText", "text": "Tympanometry, Audiometry.", "runs": [{"text": "Tympanometry,"}, {"text": " "}, {"text": "Audiometry."}]}, {"id": "body-15652", "type": "heading", "style": "Heading4", "text": "Non-Pharmacological Management", "runs": [{"text": "Non-Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-15653", "type": "paragraph", "style": "ListParagraph", "text": "Close follow-up\t\tValsalva maneuver\t\tEncourage chewing", "runs": [{"text": "Close"}, {"text": " "}, {"text": "follow-"}, {"text": "up"}, {"text": "\t"}, {"text": ""}, {"text": "\t"}, {"text": "Valsalva"}, {"text": " "}, {"text": "maneuver"}, {"text": "\t"}, {"text": ""}, {"text": "\t"}, {"text": "Encourage"}, {"text": " "}, {"text": "chewing"}], "list": {"level": 0, "numberingId": "1204"}}, {"id": "body-15655", "type": "heading", "style": "Heading4", "text": "Pharmacological Management", "runs": [{"text": "Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-15656", "type": "paragraph", "style": "BodyText", "text": "B: ephedrine (0.5% and 1%) nasal drop, Adults and children above 12years: Instill 1 to 2 drops in each nostril, not more than 4 times a day for 3 to 5 days", "runs": [{"text": "B: ", "bold": true}, {"text": "ephedrine (0.5% and 1%) nasal drop, Adults and children above 12years: Instill 1 to 2 drops in each nostril, not more than 4 times a day for 3 to 5 days"}]}, {"id": "body-15657", "type": "paragrap