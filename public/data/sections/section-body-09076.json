{"id": "section-body-09076", "title": "Non-ulcer Dyspepsia (Functional Dyspepsia, Indigestion)", "chapterId": "chapter-ten", "tocLevel": 4, "tocPath": ["APPROACH TO PATIENTS WITH EMERGENCY CONDITIONS", "GASTROINTESTINAL DISEASE CONDITIONS", "Disorders of Gastrointestinal Tract", "Non-ulcer Dyspepsia (Functional Dyspepsia, Indigestion)"], "blocks": [{"id": "body-09076", "type": "heading", "style": "Heading4", "text": "Non-ulcer Dyspepsia (Functional Dyspepsia, Indigestion)", "runs": [{"text": "Non-ulcer"}, {"text": " "}, {"text": "Dyspepsia"}, {"text": " "}, {"text": "(Functional"}, {"text": " "}, {"text": "Dyspepsia,"}, {"text": " "}, {"text": "Indigestion)"}], "level": 4, "list": {"level": 3, "numberingId": "1531"}}, {"id": "body-09077", "type": "paragraph", "style": "BodyText", "text": "It is a chronic recurrent dyspeptic disorder characterized by upper abdominal symptoms, discomfort, pain, fullness, early satiety, bloating, burning epigastric pain syndrome and post prandial distress syndrome without any organic, systemic or metabolic disease to explain its presence.", "runs": [{"text": "It"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "chronic"}, {"text": " "}, {"text": "recurrent"}, {"text": " "}, {"text": "dyspeptic"}, {"text": " "}, {"text": "disorder"}, {"text": " "}, {"text": "characterized"}, {"text": " "}, {"text": "by"}, {"text": " "}, {"text": "upper"}, {"text": " "}, {"text": "abdominal"}, {"text": " "}, {"text": "symptoms,"}, {"text": " "}, {"text": "discomfort,"}, {"text": " "}, {"text": "pain,"}, {"text": " "}, {"text": "fullness,"}, {"text": " "}, {"text": "early"}, {"text": " "}, {"text": "satiety, bloating, burning epigastric pain syndrome and post prandial distress syndrome without any organic, systemic or metabolic disease to explain its presence."}]}, {"id": "body-09079", "type": "heading", "style": "Heading4", "text": "Clinical Presentation", "runs": [{"text": "Clinical"}, {"text": " "}, {"text": "Presentation"}], "level": 4}, {"id": "body-09080", "type": "paragraph", "style": "ListParagraph", "text": "Dyspeptic symptoms present for last 3 months and onset at least months prior to diagnosis", "runs": [{"text": "Dyspeptic"}, {"text": " "}, {"text": "symptoms"}, {"text": " "}, {"text": "present"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "last"}, {"text": " "}, {"text": "3"}, {"text": " "}, {"text": "months"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "onset"}, {"text": " "}, {"text": "at"}, {"text": " "}, {"text": "least"}, {"text": " "}, {"text": "months"}, {"text": " "}, {"text": "prior"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "diagnosis"}], "list": {"level": 0, "numberingId": "1484"}}, {"id": "body-09081", "type": "paragraph", "style": "ListParagraph", "text": "Bothersome abdominal discomfort post prandial fullness.", "runs": [{"text": "Bothersome"}, {"text": " "}, {"text": "abdominal"}, {"text": " "}, {"text": "discomfort"}, {"text": " "}, {"text": "post"}, {"text": " "}, {"text": "prandial"}, {"text": " "}, {"text": "fullness."}], "list": {"level": 0, "numberingId": "1484"}}, {"id": "body-09082", "type": "paragraph", "style": "ListParagraph", "text": "Early satiety", "runs": [{"text": "Early"}, {"text": " "}, {"text": "satiety"}], "list": {"level": 0, "numberingId": "1484"}}, {"id": "body-09083", "type": "paragraph", "style": "ListParagraph", "text": "Epigastric pains", "runs": [{"text": "Epigastric"}, {"text": " "}, {"text": "pains"}], "list": {"level": 0, "numberingId": "1484"}}, {"id": "body-09084", "type": "paragraph", "style": "ListParagraph", "text": "Epigastric burning", "runs": [{"text": "Epigastric"}, {"text": " "}, {"text": "burning"}], "list": {"level": 0, "numberingId": "1484"}}, {"id": "body-09086", "type": "heading", "style": "Heading4", "text": "Investigations", "runs": [{"text": "Investigations"}], "level": 4}, {"id": "body-09087", "type": "paragraph", "style": "BodyText", "text": "Lack of evidence of structural disease by upper endoscopic examination.", "runs": [{"text": "Lack"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "evidence"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "structural"}, {"text": " "}, {"text": "disease"}, {"text": " "}, {"text": "by"}, {"text": " "}, {"text": "upper"}, {"text": " "}, {"text": "endoscopic"}, {"text": " "}, {"text": "examination."}]}, {"id": "body-09089", "type": "heading", "style": "Heading4", "text": "Non-Pharmacological Management", "runs": [{"text": "Non-Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-09090", "type": "paragraph", "style": "BodyText", "text": "Non-Pharmacological Management of functional dyspepsia (FD) focuses on dietary adjustments, lifestyle modifications, and stress reduction to alleviate symptoms like epigastric pain, burning, and early satiety. Key strategies include eating smaller, frequent meals, reducing fat and caffeine intake, avoiding trigger foods (spicy, acidic), and utilizing stress-reduction techniques like cognitive behavioral therapy (CBT), yoga, or meditation.", "runs": [{"text": "Non-Pharmacological Management of functional dyspepsia (FD)"}, {"text": " "}, {"text": "focuses on dietary adjustments, lifestyle modifications, and stress reduction"}, {"text": " "}, {"text": "to alleviate symptoms like epigastric pain, burning, and early satiety. Key strategies include eating smaller, frequent"}, {"text": " "}, {"text": "meals,"}, {"text": " "}, {"text": "reducing"}, {"text": " "}, {"text": "fat"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "caffeine"}, {"text": " "}, {"text": "intake,"}, {"text": " "}, {"text": "avoiding"}, {"text": " "}, {"text": "trigger"}, {"text": " "}, {"text": "foods"}, {"text": " "}, {"text": "(spicy,"}, {"text": " "}, {"text": "acidic),"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "utilizing"}, {"text": " "}, {"text": "stress-reduction"}, {"text": " "}, {"text": "techniques like cognitive behavioral therapy (CBT), yoga, or meditation."}]}, {"id": "body-09092", "type": "paragraph", "style": "ListParagraph", "text": "Dietary Modifications:", "runs": [{"text": "Dietary"}, {"text": " "}, {"text": "Modifications:"}], "list": {"level": 0, "numberingId": "1506"}}, {"id": "body-09093", "type": "paragraph", "style": "ListParagraph", "text": "Meal Frequency: Eat smaller, more frequent meals rather than three large ones to reduce the burden on the stomach.", "runs": [{"text": "Meal"}, {"text": " "}, {"text": "Frequency:"}, {"text": " "}, {"text": "Eat"}, {"text": " "}, {"text": "smaller,"}, {"text": " "}, {"text": "more"}, {"text": " "}, {"text": "frequent"}, {"text": " "}, {"text": "meals"}, {"text": " "}, {"text": "rather"}, {"text": " "}, {"text": "than"}, {"text": " "}, {"text": "three"}, {"text": " "}, {"text": "large"}, {"text": " "}, {"text": "ones"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "reduce"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "burden"}, {"text": " "}, {"text": "on"}, {"text": " "}, {"text": "the "}, {"text": "stomach."}], "list": {"level": 1, "numberingId": "1506"}}, {"id": "body-09094", "type": "paragraph", "style": "ListParagraph", "text": "Trigger Foods: Avoid foods that trigger symptoms, such as high-fat foods, alcohol, caffeine (coffee, tea), carbonated beverages, spicy foods, citrus fruits, and certain vegetables like broccoli or onions.", "runs": [{"text": "Trigger"}, {"text": " "}, {"text": "Foods:"}, {"text": " "}, {"text": "Avoid"}, {"text": " "}, {"text": "foods"}, {"text": " "}, {"text": "that"}, {"text": " "}, {"text": "trigger"}, {"text": " "}, {"text": "symptoms,"}, {"text": " "}, {"text": "such"}, {"text": " "}, {"text": "as"}, {"text": " "}, {"text": "high-fat"}, {"text": " "}, {"text": "foods,"}, {"text": " "}, {"text": "alcohol,"}, {"text": " "}, {"text": "caffeine"}, {"text": " "}, {"text": "(coffee,"}, {"text": " "}, {"text": "tea), carbonated beverages, spicy foods, citrus fruits, and certain vegetables like broccoli or onions."}], "list": {"level": 1, "numberingId": "1506"}}, {"id": "body-09095", "type": "paragraph", "style": "ListParagraph", "text": "Diet Composition: Adopt a diet rich in, or similar to, the Mediterranean diet, focusing on fresh foods while reducing processed items.", "runs": [{"text": "Diet"}, {"text": " "}, {"text": "Composition:"}, {"text": " "}, {"text": "Adopt"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "diet"}, {"text": " "}, {"text": "rich"}, {"text": " "}, {"text": "in,"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "similar"}, {"text": " "}, {"text": "to,"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "Mediterranean"}, {"text": " "}, {"text": "diet,"}, {"text": " "}, {"text": "focusing"}, {"text": " "}, {"text": "on"}, {"text": " "}, {"text": "fresh"}, {"text": " "}, {"text": "foods"}, {"text": " "}, {"text": "while"}, {"text": " "}, {"text": "reducing processed items."}], "list": {"level": 1, "numberingId": "1506"}}, {"id": "body-09096", "type": "paragraph", "style": "ListParagraph", "text": "Texture Modification: If necessary, ensure a portion of daily meals consists of soft or liquid foods.", "runs": [{"text": "Texture"}, {"text": " "}, {"text": "Modification:"}, {"text": " "}, {"text": "If"}, {"text": " "}, {"text": "necessary,"}, {"text": " "}, {"text": "ensure"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "portion"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "daily"}, {"text": " "}, {"text": "meals"}, {"text": " "}, {"text": "consists"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "soft"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "liquid"}, {"text": " "}, {"text": "foods."}], "list": {"level": 1, "numberingId": "1506"}}, {"id": "body-09097", "type": "paragraph", "style": "ListParagraph", "text": "Fiber Reduction: Reduce fiber-enriched foods, particularly those containing inulin.", "runs": [{"text": "Fiber"}, {"text": " 