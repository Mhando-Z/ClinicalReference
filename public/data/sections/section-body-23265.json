544"}}, {"id": "body-23282", "type": "paragraph", "style": "ListParagraph", "text": "Withdrawal of nonessential potentially nephrotoxic medications (e.g., NSAIDs, diuretics, aminoglycosides, amphotericin, platins, zoledronate, and methotrexate) in people with AKI or eGFR <30 ml/min per 1.73 m2 for 24–48 hours before contrast study", "runs": [{"text": "Withdrawal"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "nonessential"}, {"text": " "}, {"text": "potentially"}, {"text": " "}, {"text": "nephrotoxic"}, {"text": " "}, {"text": "medications"}, {"text": " "}, {"text": "(e.g.,"}, {"text": " "}, {"text": "NSAIDs,"}, {"text": " "}, {"text": "diuretics,"}, {"text": " "}, {"text": "aminoglycosides,"}, {"text": " "}, {"text": "amphotericin, platins, zoledronate, and methotrexate) in people with AKI or eGFR <30 ml/min per 1.73 m2 for 24–48 hours before contrast study"}], "list": {"level": 0, "numberingId": "544"}}, {"id": "body-23283", "type": "paragraph", "style": "ListParagraph", "text": "For people with AKI or an eGFR <30 ml/min per 1.73 m2, stop metformin restart 48 hours later only if GFR remains stable", "runs": [{"text": "For people with AKI or an eGFR <30 ml/min per 1.73 m"}, {"text": "2", "vertical": "superscript"}, {"text": ", stop metformin restart 48 hours later only if GFR remains "}, {"text": "stable"}], "list": {"level": 0, "numberingId": "544"}}, {"id": "body-23284", "type": "paragraph", "style": "ListParagraph", "text": "withholding RAASi in people at risk for 48 hours before elective contrast-enhanced CT restart 48 hours later only if GFR remains stable", "runs": [{"text": "withholding"}, {"text": " "}, {"text": "RAASi"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "people"}, {"text": " "}, {"text": "at"}, {"text": " "}, {"text": "risk"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "48"}, {"text": " "}, {"text": "hours"}, {"text": " "}, {"text": "before"}, {"text": " "}, {"text": "elective"}, {"text": " "}, {"text": "contra