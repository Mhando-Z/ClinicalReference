"}, {"text": " "}, {"text": "metabolic"}, {"text": " "}, {"text": "deficit "}, {"text": "accordingly"}], "list": {"level": 0, "numberingId": "1489"}}, {"id": "body-09590", "type": "heading", "style": "Heading4", "text": "Pharmacological Management", "runs": [{"text": "Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-09591", "type": "paragraph", "style": "BodyText", "text": "B: ceftriaxone (IV) 1g 12hourly for 7days", "runs": [{"text": "B:", "bold": true}, {"text": " ", "bold": true}, {"text": "ceftriaxone"}, {"text": " "}, {"text": "(IV)"}, {"text": " "}, {"text": "1g"}, {"text": " "}, {"text": "12hourly"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "7days"}]}, {"id": "body-09592", "type": "paragraph", "style": "Heading3", "text": "OR", "runs": [{"text": "OR"}], "level": 3, "conjunction": true}, {"id": "body-09593", "type": "paragraph", "style": "BodyText", "text": "C: ciprofloxacin (IV) 200-400mg 12hourly for 7days", "runs": [{"text": "C:", "bold": true}, {"text": " ", "bold": true}, {"text": "ciprofloxacin"}, {"text": " "}, {"text": "(IV)"}, {"text": " "}, {"text": "200-400mg"}, {"text": " "}, {"text": "12hourly"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "7days"}]}, {"id": "body-09594", "type": "paragraph", "style": "Heading3", "text": "AND", "runs": [{"text": "AND"}], "level": 3, "conjunction": true}, {"id": "body-09595", "type": "paragraph", "style": "BodyText", "text": "B: metronidazole (IV) 500mg 8hourly for 7days", "runs": [{"text": "B:", "bold": true}, {"text": " ", "bold": true}, {"text": "metronidazole"}, {"text": " "}, {"text": "(IV)"}, {"text": " "}, {"text": "500mg"}, {"text": " "}, {"text": "8hourly"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "7days"}]}, {"id": "body-09596", "type": "paragraph", "style": "Heading3", "text": "OR", "runs": [{"text": "OR"}], "level": 3, "conjunction": true}, {"id": "body-09597", "type": "paragraph", "style": "BodyText", "text": "S: meropenem (