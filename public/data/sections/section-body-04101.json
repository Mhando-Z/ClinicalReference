HIV infection or after prolonged interruption.", "runs": [{"text": "Initiate"}, {"text": " "}, {"text": "ART"}, {"text": " "}, {"text": "within"}, {"text": " "}, {"text": "7"}, {"text": " "}, {"text": "days"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "Mpox"}, {"text": " "}, {"text": "diagnosis"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "newly"}, {"text": " "}, {"text": "diagnosed"}, {"text": " "}, {"text": "HIV"}, {"text": " "}, {"text": "infection"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "after"}, {"text": " "}, {"text": "prolonged"}, {"text": " "}, {"text": "interruption."}], "list": {"level": 0, "numberingId": "1769"}}, {"id": "body-04146-textbox1-00004", "type": "paragraph", "style": "BodyText", "text": "HIV testing should be offered to all suspected and confirmed Mpox cases.", "runs": [{"text": "HIV"}, {"text": " "}, {"text": "testing"}, {"text": " "}, {"text": "should"}, {"text": " "}, {"text": "be"}, {"text": " "}, {"text": "offered"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "all"}, {"text": " "}, {"text": "suspected"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "confirmed"}, {"text": " "}, {"text": "Mpox"}, {"text": " "}, {"text": "cases."}], "list": {"level": 0, "numberingId": "1769"}}, {"id": "body-04146-textbox1-00005", "type": "paragraph", "style": "BodyText", "text": "No routine antiviral therapy is currently recommended for Mpox.", "runs": [{"text": "No"}, {"text": " "}, {"text": "routine"}, {"text": " "}, {"text": "antiviral"}, {"text": " "}, {"text": "therapy"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "currently"}, {"text": " "}, {"text": "recommended"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "Mpox."}], "list": {"level": 0, "numberingId": "1769"}}, {"id": "body-04146-textbox1-00006", "type": "paragraph", "style": "BodyText", "text": "Refer to the Pain Management chapter for analgesic escalation.", "runs": [{"text": "Refer"}, {"text": " "}, {"text