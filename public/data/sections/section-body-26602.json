{"id": "section-body-26602", "title": "3.12 Panic Disorder", "chapterId": "chapter-twenty-three", "blocks": [{"id": "body-26602", "type": "heading", "style": "Heading2", "text": "3.12 Panic Disorder", "runs": [{"text": "3.12"}, {"text": " "}, {"text": "Panic"}, {"text": " "}, {"text": "Disorder"}], "level": 2}, {"id": "body-26603", "type": "paragraph", "style": "BodyText", "text": "Panic disorder is an anxiety disorder characterized by recurrent unexpected panic attacks. A panic attack is characterized by an acute onset of intense anxiety accompanied by a sense of dread/impending threat, usually for no apparent reason.", "runs": [{"text": "Panic disorder is an anxiety disorder characterized by recurrent unexpected panic attacks. A panic attack is characterized by an acute onset of intense anxiety accompanied by a sense of dread/impending threat, usually for no apparent reason."}]}, {"id": "body-26605", "type": "heading", "style": "Heading4", "text": "Clinical Presentation", "runs": [{"text": "Clinical"}, {"text": " "}, {"text": "Presentation"}], "level": 4}, {"id": "body-26606", "type": "paragraph", "style": "BodyText", "text": "The patient will experience significant fear and emotional discomfort, typically peaking within 10 minutes and resolving within 30 minutes. There will usually be accompanying physical symptoms including:", "runs": [{"text": "The patient will experience significant fear and emotional discomfort, typically peaking within 10 minutes and resolving within 30 minutes. There will usually be accompanying physical symptoms including:"}]}, {"id": "body-26607", "type": "paragraph", "style": "ListParagraph", "text": "Rapid pulse/palpitations", "runs": [{"text": "Rapid"}, {"text": " "}, {"text": "pulse/palpitations"}], "list": {"level": 0, "numberingId": "361"}}, {"id": "body-26608", "type": "paragraph", "style": "ListParagraph", "text": "Shortness of breath", "runs": [{"text": "Shortness"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "breath"}], "list": {"level": 0, "numberingId": "361"}}, {"id": "body-26609", "type": "paragraph", "style": "ListParagraph", "text": "Dizziness", "runs": [{"text": "Dizziness"}], "list": {"level": 0, "numberingId": "361"}}, {"id": "body-26610", "type": "paragraph", "style": "ListParagraph", "text": "Sweating", "runs": [{"text": "Sweating"}], "list": {"level": 0, "numberingId": "361"}}, {"id": "body-26612", "type": "heading", "style": "Heading4", "text": "Non-Pharmacological Management", "runs": [{"text": "Non-Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-26613", "type": "paragraph", "style": "ListParagraph", "text": "Psycho-education and reassurance", "runs": [{"text": "Psycho-education"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "reassurance"}], "list": {"level": 0, "numberingId": "361"}}, {"id": "body-26614", "type": "paragraph", "style": "ListParagraph", "text": "Psychotherapy, e.g. cognitive-behaviour therapy", "runs": [{"text": "Psychotherapy,"}, {"text": " "}, {"text": "e.g."}, {"text": " "}, {"text": "cognitive-behaviour"}, {"text": " "}, {"text": "therapy"}], "list": {"level": 0, "numberingId": "361"}}, {"id": "body-26615", "type": "paragraph", "style": "ListParagraph", "text": "Exclude an underlying medical condition, e.g. thyrotoxicosis", "runs": [{"text": "Exclude"}, {"text": " "}, {"text": "an"}, {"text": " "}, {"text": "underlying"}, {"text": " "}, {"text": "medical"}, {"text": " "}, {"text": "condition,"}, {"text": " "}, {"text": "e.g."}, {"text": " "}, {"text": "thyrotoxicosis"}], "list": {"level": 0, "numberingId": "361"}}, {"id": "body-26617", "type": "heading", "style": "Heading4", "text": "Pharmacological Management", "runs": [{"text": "Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-26618", "type": "paragraph", "style": "BodyText", "text": "Panic attack: Acute management", "runs": [{"text": "Panic"}, {"text": " "}, {"text": "attack:"}, {"text": " "}, {"text": "Acute"}, {"text": " "}, {"text": "management"}]}, {"id": "body-26619", "type": "paragraph", "style": "BodyText", "text": "The initial aim is to control the panic symptoms and exclude an underlying medical cause.", "runs": [{"text": "The"}, {"text": " "}, {"text": "initial"}, {"text": " "}, {"text": "aim"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "control"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "panic"}, {"text": " "}, {"text": "symptoms"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "exclude"}, {"text": " "}, {"text": "an"}, {"text": " "}, {"text": "underlying"}, {"text": " "}, {"text": "medical"}, {"text": " "}, {"text": "cause."}]}, {"id": "body-26621", "type": "paragraph", "style": "BodyText", "text": "C: diazepam (PO) 5-10mg 12hourly (Medication should be titrated according to symptoms resolution)", "runs": [{"text": "C:", "bold": true}, {"text": " ", "bold": true}, {"text": "diazepam"}, {"text": " "}, {"text": "(PO)"}, {"text": " "}, {"text": "5-10mg"}, {"text": " "}, {"text": "12hourly"}, {"text": " "}, {"text": "(Medication"}, {"text": " "}, {"text": "should"}, {"text": " "}, {"text": "be"}, {"text": " "}, {"text": "titrated"}, {"text": " "}, {"text": "according"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "symptoms"}, {"text": " "}, {"text": "resolution)"}]}, {"id": "body-26622", "type": "paragraph", "style": "Heading3", "text": "OR", "runs": [{"text": "OR"}], "level": 3, "conjunction": true}, {"id": "body-26623", "type": "paragraph", "style": "BodyText", "text": "C: lorazepam (PO) 2-4mg 12hourly (Medication should be titrated according to symptoms resolution)", "runs": [{"text": "C:", "bold": true}, {"text": " ", "bold": true}, {"text": "lorazepam"}, {"text": " "}, {"text": "(PO)"}, {"text": " "}, {"text": "2-4mg"}, {"text": " "}, {"text": "12hourly"}, {"text": " "}, {"text": "(Medication"}, {"text": " "}, {"text": "should"}, {"text": " "}, {"text": "be"}, {"text": " "}, {