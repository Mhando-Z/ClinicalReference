{"id": "section-body-01290", "title": "Approach to Fever (Pyrexia)", "chapterId": "chapter-one", "blocks": [{"id": "body-01290", "type": "heading", "style": "Heading2", "text": "Approach to Fever (Pyrexia)", "runs": [{"text": "Approach"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "Fever"}, {"text": " "}, {"text": "(Pyrexia)"}], "level": 2, "list": {"level": 1, "numberingId": "1890"}}, {"id": "body-01291", "type": "paragraph", "style": "BodyText", "text": "Fever is an abnormal elevation of body temperature that occurs as part of a specific biologic response that is mediated and controlled by the central nervous system and is usually a symptom of an infection. It is characterized by an elevation of body temperature above the normal range of 36.5–37.5 0C", "runs": [{"text": "Fever is an abnormal elevation of body temperature that occurs as part of a specific biologic response that is mediated"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "controlled"}, {"text": " "}, {"text": "by"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "central"}, {"text": " "}, {"text": "nervous"}, {"text": " "}, {"text": "system"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "usually"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "symptom"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "an"}, {"text": " "}, {"text": "infection."}, {"text": " "}, {"text": "It"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "characterized by an elevation of body temperature above the normal range of 36.5–37.5 0C"}]}, {"id": "body-01292", "type": "heading", "style": "Heading4", "text": "Clinical Presentation", "runs": [{"text": "Clinical"}, {"text": " "}, {"text": "Presentation"}], "level": 4}, {"id": "body-01294", "type": "paragraph", "style": "ListParagraph", "text": "Depression", "runs": [{"text": "Depression"}], "list": {"level": 0, "numberingId": "1861"}}, {"id": "body-01295", "type": "paragraph", "