{"id": "section-body-08500", "title": "Pleural Effusion", "chapterId": "chapter-nine", "blocks": [{"id": "body-08500", "type": "heading", "style": "Heading2", "text": "Pleural Effusion", "runs": [{"text": "Pleural"}, {"text": " "}, {"text": "Effusion"}], "level": 2, "list": {"level": 1, "numberingId": "1593"}}, {"id": "body-08501", "type": "paragraph", "style": "BodyText", "text": "Pleural effusion, is collection of fluid abnormally present in the pleural space, usually resulting from excess fluid production and/or decreased lymphatic absorption, is rarely a primary disease process but is usually secondary to other diseases.", "runs": [{"text": "Pleural effusion, is collection of fluid abnormally present in the pleural space, usually resulting from excess fluid production"}, {"text": " "}, {"text": "and/or decreased lymphatic absorption, is rarely a primary disease process but is usually secondary to other diseases."}]}, {"id": "body-08504", "type": "heading", "style": "Heading4", "text": "Clinical Presentation", "runs": [{"text": "Clinical"}, {"text": " "}, {"text": "Presentation"}], "level": 4}, {"id": "body-08505", "type": "paragraph", "style": "ListParagraph", "text": "Progressive dyspnea", "runs": [{"text": "Progressive"}, {"text": " "}, {"text": "dyspnea"}], "list": {"level": 0, "numberingId": "1544"}}, {"id": "body-08506", "type": "paragraph", "style": "ListParagraph", "text": "Cough", "runs": [{"text": "Cough"}], "list": {"level": 0, "numberingId": "1544"}}, {"id": "body-08507", "type": "paragraph", "style": "ListParagraph", "text": "Pleuritic chest pain", "runs": [{"text": "Pleuritic"}, {"text": " "}, {"text": "chest"}, {"text": " "}, {"text": "pain"}], "list": {"level": 0, "numberingId": "1544"}}, {"id": "body-08508", "type": "paragraph", "style": "ListParagraph", "text": "Extrapulmonary symptoms that mimic features of congestive heart failure (CHF) etc.", "runs": [{"text": "Extrapulmonary"}, {"text": " "}, {"text": "symptoms"}, {"text": " "}, {"text": "th