{"id": "section-body-12252", "title": "Urethral Discharge Syndrome (UDS)", "chapterId": "chapter-twelve", "blocks": [{"id": "body-12252", "type": "heading", "style": "Heading2", "text": "Urethral Discharge Syndrome (UDS)", "runs": [{"text": "Urethral"}, {"text": " "}, {"text": "Discharge"}, {"text": " "}, {"text": "Syndrome"}, {"text": " "}, {"text": "(UDS)"}], "level": 2, "list": {"level": 1, "numberingId": "1397"}}, {"id": "body-12253", "type": "paragraph", "style": "BodyText", "text": "UDS refers to the presence of abnormal secretions in the distal portion of the urethra Caused by Neisseria gonorrhoeae and", "runs": [{"text": "UDS"}, {"text": " "}, {"text": "refers"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "presence"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "abnormal"}, {"text": " "}, {"text": "secretions"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "distal"}, {"text": " "}, {"text": "portion"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "urethra"}, {"text": " "}, {"text": "Caused"}, {"text": " "}, {"text": "by"}, {"text": " "}, {"text": "Neisseria", "italic": true}, {"text": " ", "italic": true}, {"text": "gonorrhoeae", "italic": true}, {"text": " ", "italic": true}, {"text": "and"}]}, {"id": "body-12254", "type": "paragraph", "style": "Normal", "text": "Chlamydia trachomatis.", "runs": [{"text": "Chlamydia", "italic": true}, {"text": " ", "italic": true}, {"text": "trachomatis.", "italic": true}]}, {"id": "body-12256", "type": "heading", "style": "Heading4", "text": "Clinical Presentation", "runs": [{"text": "Clinical"}, {"text": " "}, {"text": "Presentation"}], "level": 4}, {"id": "body-12257", "type": "paragraph", "style": "BodyText", "text": "Urethral discharge, Burning or painful micturition, Itchy urethra and increased frequency and urgency of micturition.", "runs": [{"text": "Urethral"}, {"text": " "}, {"text": "discharge,"}, {"text": " "}, {"text": "Burning"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "painful"}, {"text": " "}, {"text": "micturition,"}, {"text": " "}, {"text": "Itchy"}, {"text": " "}, {"text": "urethra"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "increased"}, {"text": " "}, {"text": "frequency"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "urgency"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "micturition."}]}, {"id": "body-12258-textbox1-00001", "type": "paragraph", "style": "Normal", "text": "Note", "runs": [{"text": "Note", "bold": true}]}, {"id": "body-12258-textbox1-00002", "type": "paragraph", "style": "BodyText", "text": "Persistent or recurrent symptoms of urethritis may be due to drug resistance, poor compliance or re-infection. In some cases, there may be infection with Trichomonas vaginalis (TV).", "runs": [{"text": "Persistent or recurrent symptoms of urethritis may be due to drug resistance, poor compliance or re-infection. In some cases, there may be infection with Trichomonas vaginalis (TV)."}], "list": {"level": 0, "numberingId": "1391"}}, {"id": "body-12258-textbox1-00003", "type": "paragraph", "style": "BodyText", "text": "Male patients complaining of urethral discharge and/or dysuria should be examined for evidence of discharge. If none is seen per inspection, the urethra should be gently milked from the ventral part of the penis towards the meatus.", "runs": [{"text": "Male patients complaining of urethral discharge and/or dysuria should be examined for evidence of discharge. If"}, {"text": " "}, {"text": "none"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "seen"}, {"text": " "}, {"text": "per"}, {"text": " "}, {"text": "inspection,"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "urethra"}, {"text": " "}, {"text": "should"}, {"text": " "}, {"text": "be"}, {"text": " "}, {"text": "gently"}, {"text": " "}, {"text": "milked"}, {"text": " "}, {"text": "from"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "ventral"}, {"text": " "}, {"text": "part"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "penis"}, {"text": " "}, {"text": "towards"}, {"text": " "}, {"text": "the "}, {"text": "meatus."}], "list": {"level": 0, "numberingId": "1391"}}, {"id": "body-12258-textbox1-00004", "type": "paragraph", "style": "BodyText", "text": "Delayed or inadequate treatment may result into orchitis, epididymitis, urethral stricture and/or infertility.", "runs": [{"text": "Delayed"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "inadequate"}, {"text": " "}, {"text": "treatment"}, {"text": " "}, {"text": "may"}, {"text": " "}, {"text": "result"}, {"text": " "}, {"text": "into"}, {"text": " "}, {"text": "orchitis,"}, {"text": " "}, {"text": "epididymitis,"}, {"text": " "}, {"text": "urethral"}, {"text": " "}, {"text": "stricture"}, {"text": " "}, {"text": "and/or"}, {"text": " "}, {"text": "infertility."}], "list": {"level": 0, "numberingId": "1391"}}, {"id": "body-12261", "type": "heading", "style": "Heading4", "text": "Investigations", "runs": [{"text": "Investigations"}], "level": 4}, {"id": "body-12262", "type": "paragraph", "style": "ListParagraph", "text": "Culture and Sensitivity", "runs": [{"text": "Culture"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "Sensitivity"}], "list": {"level": 0, "numberingId": "1373"}}, {"id": "body-12263", "type": "paragraph", "style": "ListParagraph", "text": "Gram stain", "runs": [{"text": "Gram"}, {"text": " "}, {"text": "stain"}], "list": {"level": 0, "numberingId": "1373"}}, {"id": "body-12264", "type": "paragraph", "style": "ListParagraph", "text": "ELISA", "runs": [{"text": "ELISA"}], "list": {"level": 0, "numberingId": "1373"}}, {"id": "body-12265", "type": "paragraph", "style": "Normal", "text": "Note: Management of UDS (see flow chart 12.1)", "runs": [{"text": "Note:", "bold": true}, {"text": " ", "bold": true}, {"text":