{"id": "section-body-04026", "title": "COVID-19", "chapterId": "chapter-four", "tocLevel": 4, "tocPath": ["APPROACH TO PATIENTS WITH EMERGENCY CONDITIONS", "NOTIFIABLE DISEASES", "Viral Infections", "COVID-19"], "blocks": [{"id": "body-04026", "type": "heading", "style": "Heading3", "text": "COVID-19", "runs": [{"text": "COVID-"}, {"text": "19"}], "level": 3, "list": {"level": 2, "numberingId": "1802"}}, {"id": "body-04027", "type": "paragraph", "style": "BodyText", "text": "COVID-19 is an infectious disease caused by SARS-CoV-2 virus (coronavirus family, related to SARS/MERS), with zoonotic origin and human-to-human transmission. First detected in Wuhan, China in December 2019. WHO declared a Public Health Emergency of International Concern (PHEIC) in January 2020 and Pandemic in March 2020. In May 2023 WHO declared it no longer a PHEIC.", "runs": [{"text": "COVID-19"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "an"}, {"text": " "}, {"text": "infectious"}, {"text": " "}, {"text": "disease"}, {"text": " "}, {"text": "caused"}, {"text": " "}, {"text": "by"}, {"text": " "}, {"text": "SARS-CoV-2"}, {"text": " "}, {"text": "virus"}, {"text": " "}, {"text": "(coronavirus"}, {"text": " "}, {"text": "family,"}, {"text": " "}, {"text": "related to SARS/MERS),"}, {"text": " "}, {"text": "with zoonotic origin"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "human-to-human"}, {"text": " "}, {"text": "transmission."}, {"text": " "}, {"text": "First"}, {"text": " "}, {"text": "detected"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "Wuhan,"}, {"text": " "}, {"text": "China"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "December"}, {"text": " "}, {"text": "2019."}, {"text": " "}, {"text": "WHO"}, {"text": " "}, {"text": "declared"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "Public"}, {"text": " "}, {"text": "Health Emergency of International Concern (PHEIC) in January 2020 and Pandemic in March 2020. In May 2023 WHO declared it no longer a PHEIC."}]}, {"id": "body-04029", "type": "heading", "style": "Heading4", "text": "Transmission", "runs": [{"text": "Transmission"}], "level": 4}, {"id": "body-04030", "type": "paragraph", "style": "BodyText", "text": "Mainly via respiratory droplets/aerosols (coughing, talking, sneezing); close contact; contaminated surfaces (fomites). Higher airborne risk in poorly ventilated areas.", "runs": [{"text": "Mainly"}, {"text": " "}, {"text": "via"}, {"text": " "}, {"text": "respiratory"}, {"text": " "}, {"text": "droplets/aerosols"}, {"text": " "}, {"text": "(coughing,"}, {"text": " "}, {"text": "talking,"}, {"text": " "}, {"text": "sneezing);"}, {"text": " "}, {"text": "close"}, {"text": " "}, {"text": "contact;"}, {"text": " "}, {"text": "contaminated"}, {"text": " "}, {"text": "surfaces"}, {"text": " "}, {"text": "(fomites)."}, {"text": " "}, {"text": "Higher airborne risk in poorly ventilated areas."}]}, {"id": "body-04031", "type": "paragraph", "style": "BodyText", "text": "Incubation period: Typically, 2–5 days (range 2–14 days).", "runs": [{"text": "Incubation"}, {"text": " "}, {"text": "period:"}, {"text": " "}, {"text": "Typically,"}, {"text": " "}, {"text": "2–5"}, {"text": " "}, {"text": "days"}, {"text": " "}, {"text": "(range"}, {"text": " "}, {"text": "2–14"}, {"text": " "}, {"text": "days)."}]}, {"id": "body-04033", "type": "heading", "style": "Heading4", "text": "Case Definitions", "runs": [{"text": "Case"}, {"text": " "}, {"text": "Definitions"}], "level": 4}, {"id": "body-04034", "type": "paragraph", "style": "BodyText", "text": "Suspected case: Acute respiratory illness (fever + cough/shortness of breath) with history of travel to/transmission area in last 14 days, OR contact with confirmed/probable case in last 14 days, OR severe acute respiratory illness requiring hospitalization (no alternative diagnosis).", "runs": [{"text": "Suspected case: ", "bold": true}, {"text": "Acute respiratory illness (fever + cough/shortness of breath) with history of travel to/transmission area in last 14 days, OR contact with confirmed/probable case in last 14 days, OR severe acute respiratory illness requiring hospitalization (no alternative diagnosis)."}]}, {"id": "body-04035", "type": "paragraph", "style": "BodyText", "text": "Probable case: Suspect with inconclusive/no test, epidemiologic link to confirmed case/outbreak, or typical COVID-19 chest imaging (CT/X-ray).", "runs": [{"text": "Probable", "bold": true}, {"text": " ", "bold": true}, {"text": "case:", "bold": true}, {"text": " ", "bold": true}, {"text": "Suspect"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "inconclusive/no"}, {"text": " "}, {"text": "test,"}, {"text": " "}, {"text": "epidemiologic"}, {"text": " "}, {"text": "link"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "confirmed"}, {"text": " "}, {"text": "case/outbreak,"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "typical"}, {"text": " "}, {"text": "COVID-19"}, {"text": " "}, {"text": "chest imaging (CT/X-ray)."}]}, {"id": "body-04037", "type": "paragraph", "style": "BodyText", "text": "Confirmed case: Positive laboratory test (e.g., PCR/NAAT), or antigen/serology positive in suspect with strong epidemiologic link.", "runs": [{"text": "Confirmed", "bold": true}, {"text": " ", "bold": true}, {"text": "case:", "bold": true}, {"text": " ", "bold": true}, {"text": "Positive"}, {"text": " "}, {"text": "laboratory"}, {"text": " "}, {"text": "test"}, {"text": " "}, {"text": "(e.g.,"}, {"text": " "}, {"text": "PCR/NAAT),"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "antigen/serology"}, {"text": " "}, {"text": "positive"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "suspect"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "strong"}, {"text": " "}, {"text": "epidemiologic "}, {"text": "link."}]}, {"id": "body-04038", "type": "paragraph", "style": "BodyText", "text": "Case Definitions (WHO, last major update 2022–2023; still current):", "runs": [{"text": "Case"}, {"text": " "}, {"text": "Definitions"}, {"text": " "}, {"text": "(WHO,"}, {"text": " "}, {"text": "last"}, {"text": " "}, {"text": "major"}, {"text": " "}, {"text": "update"}, {"text": " "}, {"text": "2022–2023;"}, {"text": " "}, {"text": "still"}, {"text": " "}, {"text": "current):"}]}, {"id": "body-04039", "type": "paragraph", "style": "ListParagraph", "text": "Suspected: Acute respiratory illness (fever + cough/SOB) with travel to/transmission area, OR contact with confirmed/probable case (last 14 days), OR severe illness requiring hospitalization (no alternative diagnosis).", "runs": [{"text": "Suspected:"}, {"text": " "}, {"text": "Acute"}, {"text": " "}, {"text": "respiratory"}, {"text": " "}, {"text": "illness"}, {"text": " "}, {"text": "(fever"}, {"text": " "}, {"text": "+"}, {"text": " "}, {"text": "cough/SOB)"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "travel"}, {"text": " "}, {"text": "to/transmission"}, {"text": " "}, {"text": "area,"}, {"text": " "}, {"text": "OR"}, {"text": " "}, {"text": "contact"}, {"text": " "}, {"text": "with confirmed/probable case (last 14 days), OR severe illness requiring hospitalization (no alternative diagnosis)."}], "list": {"level": 0, "numberingId": "1773"}}, {"id": "body-04040", "type": "paragraph", "style": "ListParagraph", "text": "Probable: Suspect with inconclusive/no test, epidemiologic link to confirmed case/outbreak, or typical COVID imaging (CT/X-ray).", "runs": [{"text": "Probable:"}, {"text": " "}, {"text": "Suspect"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "inconclusive/no"}, {"text": " "}, {"text": "test,"}, {"text": " "}, {"text": "epidemiologic"}, {"text": " "}, {"text": "link"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "confirmed"}, {"text": " "}, {"text": "case/outbreak,"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "typical"}, {"text": " "}, {"text": "COVID imaging (CT/X-ray)."}], "list": {"level": 0, "numberingId": "1773"}}, {"id": "body-04041", "type": "paragraph", "style": "ListParagraph", "text": "Confirmed: Positive Nucleic Acid Amplification Test (NAAT) such as PCR, OR positive antigen/serology in suspect cases with strong epidemiologic link.", "runs": [{"text": "Confirmed: Positive Nucleic"}, {"text": " "}, {"text": "Acid"}, {"text": " "}, {"text": "Amplification"}, {"text": " "}, {"text": "Test (NAAT) such as PCR, OR positive antigen/serology in suspect cases with strong epidemiologic link."}], "list": {"level": 0, "numberingId": "1773"}}, {"id": "body-04043", "type": "heading", "style": "Heading4", "text": "Clinical Diagnosis", "runs": [{"text": "Clinical"}, {"text": " "}, {"text": "Diagnosis"}], "level": 4}, {"id": "body-04044", "type": "paragraph", "style": "BodyText", "text": "SARS-CoV-2 invades respiratory (and other) cells; symptoms vary by severity.", "runs": [{"text": "SARS-CoV-2"}, {"text": " "}, {"text": "invades"}, {"text": " "}, {"text": "respiratory"}, {"text": " "}, {"text": "(and"}, {"text": " "}, {"text": "other)"}, {"text": " "}, {"text": "cells;"}, {"text": " "}, {"text": "symptoms"}, {"text": " "}, {"text": "vary"}, {"text": " "}, {"text": "by"}, {"text": " "}, {"text": "severity."}]}, {"id": "body-04045", "type": "paragraph", "style": "ListParagraph", "text": "Most common: Fever, dry cough, tiredness.", "runs": [{"text": "Most"}, {"text": " "}, {"text": "common:"}, {"text": " "}, {"text": "Fever,"}, {"text": " "}, {"text": "dry"}, {"text": " "}, {"text": "cough,"}, {"text": " "}, {"text": "tiredness."}], "list": {"level": 0, "numberingId": "1773"}}, {"id": "body-04046", "type": "paragraph", "style": "ListParagraph", "text": "Less common: Headache, sore throat, loss of taste/smell, chills, runny nose, muscle aches, chest pain, diarrhea, conjunctivitis, skin rash, finger/toe discoloration.", "runs": [{"text": "Less common: Headache, sore throat, loss of taste/smell, chills, runny nose, muscle aches, chest pain, diarrhea, conjunctivitis, skin rash, finger/toe discoloration."}], "list": {"level": 0, "numberingId": "1773"}}, {"id": "body-04047", "type": "paragraph", "style": "ListParagraph", "text": "Serious (SARI): Difficulty breathing, shortness of breath, chest pain/pressure, loss of speech/movement.", "runs": [{"text": "Serious"}, {"text": " "}, {"text": "(SARI):"}, {"text": " "}, {"text": "Difficulty"}, {"text": " "}, {"text": "breathing,"}, {"text": " "}, {"text": "shortness"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "breath,"}, {"text": " "}, {"text": "chest"}, {"text": " "}, {"text": "pain/pressure,"}, {"text": " "}, {"text": "loss"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "speech/movement."}], "list": {"level": 0, "numberingId": "1773"}}, {"id": "body-04050", "type": "paragraph", "style": "BodyText", "text": "Comorbidities (heart disease, cancer, COPD, diabetes, asthma, liver/kidney disease, obesity, sickle cell, immunocompromised e.g., HIV, transplants, cancer therapy).", "runs": [{"text": "Comorbidities (heart disease, cancer, COPD, diabetes, asthma, liver/kidney disease, obesity, sickle cell, immunocompromised "}, {"text": "e.g., HIV, transplants, cancer therapy)."}]}, {"id": "body-04051", "type": "paragraph", "style": "BodyText", "text": "Severity Categories (WHO-aligned):", "runs": [{"text": "Severity"}, {"text": " "}, {"text": "Categories"}, {"text": " "}, {"text": "(WHO-aligned):"}]}, {"id": "body-04053", "type": "paragraph", "style": "ListParagraph", "text": "Asymptomatic/Pre-symptomatic: Positive test, no symptoms.", "runs": [{"text": "Asymptomatic/Pre-symptomatic:"}, {"text": " "}, {"text": "Positive"}, {"text": " "}, {"text": "test, no symptoms."}], "list": {"level": 0, "numberingId": "1773"}}, {"id": "body-04054", "type": "paragraph", "style": "ListParagraph", "text": "Mild:\tSymptoms\tpresent,\tno dyspnea/hypoxia/abnormal imaging.", "runs": [{"text": "Mild:"}, {"text": "\t"}, {"text": "Symptoms"}, {"text": "\t"}, {"text": "present,"}, {"text": "\t"}, {"text": "no "}, {"text": "dyspnea/hypoxia/abnormal imaging."}], "list": {"level": 0, "numberingId": "1773"}}, {"id": "body-04055", "type": "paragraph", "style": "ListParagraph", "text": "Moderate: Lower respiratory disease, SpO₂", "runs": [{"text": "Moderate:"}, {"text": " "}, {"text": "Lower"}, {"text": " "}, {"text": "respiratory"}, {"text": " "}, {"text": "disease,"}, {"text": " "}, {"text": "SpO"}, {"text": "₂"}], "list": {"level": 0, "numberingId": "1773"}}, {"id": "body-04056", "type": "paragraph", "style": "BodyText", "text": "≥94% on room air.", "runs": [{"text": "≥94%"}, {"text": " "}, {"text": "on"}, {"text": " "}, {"text": "room"}, {"text": " air."}]}, {"id": "body-04057", "type": "paragraph", "style": "ListParagraph", "text": "\nSevere: SpO₂ <94%, RR >30/min, PaO₂/FiO₂", "runs": [{"text": "\n"}, {"text": "Severe:"}, {"text": " "}, {"text": "SpO"}, {"text": "₂"}, {"text": " "}, {"text": "<94%,"}, {"text": " "}, {"text": "RR"}, {"text": " "}, {"text": ">30/min,"}, {"text": " "}, {"text": "PaO"}, {"text": "₂"}, {"text": "/FiO"}, {"text": "₂"}], "list": {"level": 0, "numberingId": "1773"}}, {"id": "body-04058", "type": "paragraph", "style": "BodyText", "text": "<300 mmHg, infiltrates >50%.", "runs": [{"text": "<300"}, {"text": " "}, {"text": "mmHg,"}, {"text": " "}, {"text": "infiltrates"}, {"text": " "}, {"text": ">50%."}]}, {"id": "body-04059", "type": "paragraph", "style": "ListParagraph", "text": "Critical: Respiratory failure, septic shock, multi- organ dysfunction.", "runs": [{"text": "Critical: Respiratory failure, septic shock, multi- organ dysfunction."}], "list": {"level": 0, "numberingId": "1773"}}, {"id": "body-04063", "type": "heading", "style": "Heading4", "text": "Laboratory Investigation & Testing", "runs": [{"text": "Laboratory"}, {"text": " "}, {"text": "Investigation"}, {"text": " "}, {"text": "&"}, {"text": " "}, {"text": "Testing"}], "level": 4}, {"id": "body-04064", "type": "paragraph", "style": "ListParagraph", "text": "Respiratory\tsamples:\tURT (nasopharyngeal/oropharyngeal) ± LRT (sputum, endotracheal aspirate, BAL) Collect before antimicrobials if possible; do not delay treatment.", "runs": [{"text": "Respiratory"}, {"text": "\t"}, {"text": "samples:"}, {"text": "\t"}, {"text": "URT "}, {"text": "(nasopharyngeal/oropharyngeal) ± LRT (sputum, endotracheal aspirate, BAL) Collect before antimicrobials if possible; do not delay "}, {"text": "treatment."}], "list": {"level": 0, "numberingId": "1773"}}, {"id": "body-04065", "type": "paragraph", "style": "ListParagraph", "text": "Use viral swabs and transport media; appropriate PPE (droplet/contact for URT, airborne for LRT).", "runs": [{"text": "Use viral swabs and transport media; appropriate PPE (droplet/contact for URT, airborne for LRT)."}], "list": {"level": 0, "numberingId": "1773"}}, {"id": "body-04066", "type": "paragraph", "style": "ListParagraph", "text": "Rule out other pathogens (e.g., bacterial pneumonia, influenza, RSV).", "runs": [{"text": "Rule out other pathogens (e.g., bacterial pneumonia, influenza, RSV)."}], "list": {"level": 0, "numberingId": "1773"}}, {"id": "body-04067", "type": "paragraph", "style": "ListParagraph", "text": "Virologic testing: NAAT (rRT-PCR) or antigen test to confirm SARS-CoV-2 infection.", "runs": [{"text": "Virologic testing: NAAT (rRT-PCR) or antigen test to confirm SARS-CoV-2 infection."}], "list": {"level": 0, "numberingId": "1773"}}, {"id": "body-04068", "type": "paragraph", "style": "ListParagraph", "text": "Test for other respiratory viruses if feasible like Influenza A and B (including zoonotic influenza", "runs": [{"text": "Test for other respiratory viruses if feasible like Influenza"}, {"text": " "}, {"text": "A and B (including zoonotic influenza"}], "list": {"level": 0, "numberingId": "1773"}}, {"id": "body-04070", "type": "heading", "style": "Heading4", "text": "Non-Pharmacological Management", "runs": [{"text": "Non-Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-04071", "type": "paragraph", "style": "BodyText", "text": "(Supportive; follow national protocols/MoH updates) Non-severe/Mild (home care if stable):", "runs": [{"text": "(Supportive;"}, {"text": " "}, {"text": "follow"}, {"text": " "}, {"text": "national"}, {"text": " "}, {"text": "protocols/MoH"}, {"text": " "}, {"text": "updates) Non-severe/Mild (home care if stable):"}]}, {"id": "body-04072", "type": "paragraph", "style": "ListParagraph", "text": "Self-isolation, monitor danger signs.", "runs": [{"text": "Self-isolation,"}, {"text": " "}, {"text": "monitor"}, {"text": " "}, {"text": "danger"}, {"text": " "}, {"text": "signs."}], "list": {"level": 0, "numberingId": "1773"}}, {"id": "body-04073", "type": "paragraph", "style": "ListParagraph", "text": "Supportive: Hydration, nutrition,", "runs": [{"text": "Supportive:"}, {"text": " "}, {"text": "Hydration,"}, {"text": " "}, {"text": "nutrition,"}], "list": {"level": 0, "numberingId": "1773"}}, {"id": "body-04074", "type": "paragraph", "style": "ListParagraph", "text": "No routine antibiotics/antivirals unless bacterial co-infection. Moderate/Severe (admit to designated area with oxygen):", "runs": [{"text": "No"}, {"text": " "}, {"text": "routine"}, {"text": " "}, {"text": "antibiotics/antivirals"}, {"text": " "}, {"text": "unless"}, {"text": " "}, {"text": "bacterial"}, {"text": " "}, {"text": "co-infection. Moderate/Severe (admit to designated area with oxygen):"}], "list": {"level": 0, "numberingId": "1773"}}, {"id": "body-04076", "type": "paragraph", "style": "BodyText", "text": "A), Respiratory syncytial virus, Parainfluenza viruses, Rhinoviruses, Adenoviruses, Enteroviruses (e.g., EVD68), Human meta pneumovirus, and Endemic human coronaviruses (i.e. HKU1, OC43, NL63, and 229E).", "runs": [{"text": "A), Respiratory syncytial virus, Parainfluenza viruses, Rhinoviruses, Adenoviruses, Enteroviruses (e.g., EVD68), Human meta pneumovirus, and Endemic human coronaviruses (i.e. HKU1, OC43, NL63, and "}, {"text