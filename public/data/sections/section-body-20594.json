nts, and herbal treatments"}], "list": {"level": 1, "numberingId": "865"}}, {"id": "body-20622", "type": "paragraph", "style": "ListParagraph", "text": "Avoid constipation by ensuring enough fluid intake and exercise.", "runs": [{"text": "Avoid"}, {"text": " "}, {"text": "constipation"}, {"text": " "}, {"text": "by"}, {"text": " "}, {"text": "ensuring"}, {"text": " "}, {"text": "enough"}, {"text": " "}, {"text": "fluid"}, {"text": " "}, {"text": "intake"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "exercise."}], "list": {"level": 1, "numberingId": "865"}}, {"id": "body-20623", "type": "paragraph", "style": "ListParagraph", "text": "Consider diuretics treatment to enhance the excretion of potassium in the kidneys especially when there is concomitant volume overload or hypertension.", "runs": [{"text": "Consider"}, {"text": " "}, {"text": "diuretics"}, {"text": " "}, {"text": "treatment"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "enhance"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "excretion"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "potassium"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "kidneys"}, {"text": " "}, {"text": "especially"}, {"text": " "}, {"text": "when"}, {"text": " "}, {"text": "there"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "concomitant volume overload or hypertension."}], "list": {"level": 1, "numberingId": "865"}}, {"id": "body-20624", "type": "paragraph", "style": "ListParagraph", "text": "Consider oral sodium bicarbonate especially in patients with CKD and metabolic acidosis.", "runs": [{"text": "Consider"}, {"text": " "}, {"text": "oral"}, {"text": " "}, {"text": "sodium"}, {"text": " "}, {"text": "bicarbonate"}, {"text": " "}, {"text": "especially"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "patients"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "CKD"}, {"text": " "}, {"text": "and"}, {"text": " "}