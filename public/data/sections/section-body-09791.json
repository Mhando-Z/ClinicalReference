s"}, {"text": " "}, {"text": "significance"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "determining"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "rate"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "liver"}, {"text": " "}, {"text": "disease progression, development of HCC and specific therapeutic responses."}]}, {"id": "body-09795", "type": "heading", "style": "Heading4", "text": "Clinical Presentation", "runs": [{"text": "Clinical"}, {"text": " "}, {"text": "Presentation"}], "level": 4}, {"id": "body-09796", "type": "paragraph", "style": "ListParagraph", "text": "Initial symptoms of HCV are often extrahepatic, most commonly involving the joints, muscle, and skin.", "runs": [{"text": "Initial symptoms of HCV are often extrahepatic, most"}, {"text": " "}, {"text": "commonly"}, {"text": " "}, {"text": "involving"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "joints,"}, {"text": " "}, {"text": "muscle,"}, {"text": " "}, {"text": "and "}, {"text": "skin."}], "list": {"level": 0, "numberingId": "1470"}}, {"id": "body-09797", "type": "paragraph", "style": "ListParagraph", "text": "Arthralgias,", "runs": [{"text": "Arthralgias,"}], "list": {"level": 0, "numberingId": "1470"}}, {"id": "body-09798", "type": "paragraph", "style": "ListParagraph", "text": "Paresthesias,", "runs": [{"text": "Paresthesias,"}], "list": {"level": 0, "numberingId": "1470"}}, {"id": "body-09800", "type": "paragraph", "style": "ListParagraph", "text": "Myalgias,", "runs": [{"text": "Myalgias,"}], "list": {"level": 0, "numberingId": "1470"}}, {"id": "body-09801", "type": "paragraph", "style": "ListParagraph", "text": "Pruritus,", "runs": [{"text": "Pruritus,"}], "list": {"level": 0, "numberingId": "1470"}}, {"id": "body-09802", "type": "paragraph", "style": "ListParagraph", "text": "Sicca syndrome.", "runs": [{"text": "Sicca"}, {"text": " "}, {"text": "syndrome."}], "list": {"level": 0, "numberingId": "1470"}}, {"id": "body-09803", "type": "paragraph