, {"text": " "}, {"text": "muscle"}, {"text": " "}, {"text": "tone,"}, {"text": " "}, {"text": "spastic"}, {"text": " "}, {"text": "paresis,"}, {"text": " "}, {"text": "Choreic"}, {"text": " "}, {"text": "dyskinesia,"}, {"text": " "}, {"text": "Coma"}], "list": {"level": 0, "numberingId": "319"}}, {"id": "body-27595", "type": "heading", "style": "Heading4", "text": "Management", "runs": [{"text": "Management"}], "level": 4}, {"id": "body-27596", "type": "paragraph", "style": "BodyText", "text": "C: thiamine hydrochloride 500mg dissolved in 100ml of NS given by infusion over 30 minutes, 8 hourly for 3 days. If an effective response is observed,", "runs": [{"text": "C:", "bold": true}, {"text": " ", "bold": true}, {"text": "thiamine"}, {"text": " "}, {"text": "hydrochloride"}, {"text": " "}, {"text": "500mg"}, {"text": " "}, {"text": "dissolved"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "100ml"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "NS"}, {"text": " "}, {"text": "given"}, {"text": " "}, {"text": "by"}, {"text": " "}, {"text": "infusion"}, {"text": " "}, {"text": "over"}, {"text": " "}, {"text": "30"}, {"text": " "}, {"text": "minutes,"}, {"text": " "}, {"text": "8"}, {"text": " "}, {"text": "hourly"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "3"}, {"text": " "}, {"text": "days. If an effective response is observed,"}]}, {"id": "body-27597", "type": "heading", "style": "Heading3", "text": "THEN", "runs": [{"text": "THEN"}], "level": 3}, {"id": "body-27598", "type": "paragraph", "style": "BodyText", "text": "C: thiamine 250mg IV/IM daily for 5 days,", "runs": [{"text": "C:", "bold": true}, {"text": " ", "bold": true}, {"text": "thiamine"}, {"text": " "}, {"text": "250mg"}, {"text": " "}, {"text": "IV/IM"}, {"text": " "}, {"text": "daily"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "5"}, {"text": " "}, {"text": "days,"}]}, {"id": "body-27600", "type": "paragraph", "style": "BodyText", "text": "Prophylactic treatment in people with alcohol intoxication, severe alcohol withdrawal and people with poor diet and signs of malnutrition:", "runs": [{"text": "Prophylactic treatment in people with alcohol intoxication, severe alcohol withdrawal and people with poor diet and signs of"}, {"text": " "}, {"text": "malnutrition:"}]}, {"id": "body-27601", "type": "paragraph", "style": "BodyText", "text": "C: thiamine 250mg IM once daily for 3-5 consecutive days.", "runs": [{"text": "C:", "bold": true}, {"text": " ", "bold": true}, {"text": "thiamine"}, {"text": " "}, {"text": "250mg"}, {"text": " "}, {"text": "IM"}, {"text": " "}, {"text": "once"}, {"text": " "}, {"text": "daily"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "3-5"}, {"text": " "}, {"text": "consecutive"}, {"text": " "}, {"text": "days."}]}, {"id": "body-27602", "type": "heading", "style": "Heading3", "text": "THEN", "runs": [{"text": "THEN"}], "level": 3}, {"id": "body-27603", "type": "paragraph", "style": "BodyText", "text": "C: thiamine 100mg (PO)daily for at least 3 months.", "runs": [{"text": "C:", "bold": true}, {"text": " ", "bold": true}, {"text": "thiamine"}, {"text": " "}, {"text": "100mg"}, {"text": " "}, {"text": "(PO)daily"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "at"}, {"text": " "}, {"text": "least"}, {"text": " "}, {"text": "3"}, {"text": " "}, {"text": "months."}]}, {"id": "body-27604", "type": "paragraph", "style": "BodyText", "text": "Give Thiamine before or concomitantly with intravenous administration of glucose if WE is suspected, as glucose alone can precipitate the disorder in thiamine-deficient individuals.", "runs": [{"text": "Give Thiamine before or concomitantly with intravenous administration of glucose if WE is suspected, as glucose alone can precipitate the disorder in thiamine-deficient individuals."}]}, {"id": "body-27606", "type": "paragraph", "style": "BodyText", "text": "Management of vitamin b12 deficiency with neuropsychiatric symptoms", "runs": [{"text