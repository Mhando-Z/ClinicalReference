{"id": "section-body-26764", "title": "Nicotine Use Disorder (Nicotine dependence)", "chapterId": "chapter-twenty-three", "tocLevel": 4, "tocPath": ["APPROACH TO PATIENTS WITH EMERGENCY CONDITIONS", "MENTAL HEALTH CONDITIONS", "Substance Related Disorder", "Nicotine Use Disorder (Nicotine dependence)"], "blocks": [{"id": "body-26764", "type": "heading", "style": "Heading4", "text": "Nicotine Use Disorder (Nicotine dependence)", "runs": [{"text": "Nicotine"}, {"text": " "}, {"text": "Use"}, {"text": " "}, {"text": "Disorder"}, {"text": " "}, {"text": "(Nicotine"}, {"text": " "}, {"text": "dependence)"}], "level": 4, "list": {"level": 3, "numberingId": "359"}}, {"id": "body-26765", "type": "paragraph", "style": "BodyText", "text": "Nicotine dependence is a chronic, relapsing disorder characterized by compulsive nicotine use, impaired control over tobacco consumption, development of tolerance, and withdrawal symptoms upon cessation. It can result from the use of any nicotine- containing product, including cigarettes, smokeless tobacco, and electronic cigarettes. Nicotine dependence is a major public health problem because it sustains tobacco use and increases the risk of preventable morbidity and premature mortality.", "runs": [{"text": "Nicotine"}, {"text": " "}, {"text": "dependence"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "chronic,"}, {"text": " "}, {"text": "relapsing"}, {"text": " "}, {"text": "disorder"}, {"text": " "}, {"text": "characterized"}, {"text": " "}, {"text": "by"}, {"text": " "}, {"text": "compulsive"}, {"text": " "}, {"text": "nicotine"}, {"text": " "}, {"text": "use,"}, {"text": " "}, {"text": "impaired"}, {"text": " "}, {"text": "control"}, {"text": " "}, {"text": "over"}, {"text": " "}, {"text": "tobacco consumption, development of tolerance, and withdrawal symptoms upon cessation. It can result from the use of any nicotine- containing product, including cigarettes, smokeless tobacco, and electronic cigarettes. Nicotine dependence is a major public health problem because it sustains tobacco use and increases the risk of preventable morbidity and premature mortality"}, {"text": ".", "bold": true}]}, {"id": "body-26768", "type": "heading", "style": "Heading4", "text": "Clinical Presentation", "runs": [{"text": "Clinical"}, {"text": " "}, {"text": "Presentation"}], "level": 4}, {"id": "body-26769", "type": "paragraph", "style": "BodyText", "text": "Withdrawal symptoms include:", "runs": [{"text": "Withdrawal"}, {"text": " "}, {"text": "symptoms"}, {"text": " "}, {"text": "include:"}]}, {"id": "body-26770", "type": "paragraph", "style": "ListParagraph", "text": "Restlessness", "runs": [{"text": "Restlessness"}], "list": {"level": 4, "numberingId": "359"}}, {"id": "body-26771", "type": "paragraph", "style": "ListParagraph", "text": "Tremors", "runs": [{"text": "Tremors"}], "list": {"level": 4, "numberingId": "359"}}, {"id": "body-26772", "type": "paragraph", "style": "ListParagraph", "text": "Difficult in getting/maintaining sleep", "runs": [{"text": "Difficult"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "getting/maintaining"}, {"text": " "}, {"text": "sleep"}], "list": {"level": 4, "numberingId": "359"}}, {"id": "body-26775", "type": "paragraph", "style": "ListParagraph", "text": "Anxiety", "runs": [{"text": "Anxiety"}], "list": {"level": 0, "numberingId": "355"}}, {"id": "body-26776", "type": "paragraph", "style": "ListParagraph", "text": "Loss of appetite", "runs": [{"text": "Loss"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "appetite"}], "list": {"level": 0, "numberingId": "355"}}, {"id": "body-26779", "type": "heading", "style": "Heading4", "text": "Non-Pharmacological Management", "runs": [{"text": "Non-Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-26780", "type": "paragraph", "style": "ListParagraph", "text": "Support group that encourages abstinence", "runs": [{"text": "Support"}, {"text": " "}, {"text": "group"}, {"text": " "}, {"text": "that"}, {"text": " "}, {"text": "encourages"}, {"text": " "}, {"text": "abstinence"}], "list": {"level": 1, "numberingId": "355"}}, {"id": "body-26781", "type": "paragraph", "style": "ListParagraph", "text": "Inpatient rehabilitation program where necessary", "runs": [{"text": "Inpatient"}, {"text": " "}, {"text": "rehabilitation"}, {"text": " "}, {"text": "program"}, {"text": " "}, {"text": "where"}, {"text": " "}, {"text": "necessary"}], "list": {"level": 1, "numberingId": "355"}}, {"id": "body-26782", "type": "heading", "style": "Heading4", "text": "Pharmacological Management", "runs": [{"text": "Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-26783", "type": "paragraph", "style": "BodyText", "text": "S: bupropion (PO), Initial dose: 150 mg orally once a day for 3 days, increased to 150 mg orally twice a day.", "runs": [{"text": "S:", "bold": true}, {"text": " ", "bold": true}, {"text": "bupropion"}, {"text": " "}, {"text": "(PO),"}, {"text": " "}, {"text": "Initial"}, {"text": " "}, {"text": "dose:"}, {"text": " "}, {"text": "150"}, {"text": " "}, {"text": "mg"}, {"text": " "}, {"text": "orally"}, {"text": " "}, {"text": "once"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "day"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "3"}, {"text": " "}, {"text": "days,"}, {"text": " "}, {"text": "increased"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "150"}, {"text": " "}, {"text": "mg"}, {"text": " "}, {"text": "orally"}, {"text": " "}, {"text": "twice"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "day."}]}, {"id": "body-26785", "type": "paragraph", "style": "BodyText", "text": "Maintenance dose: 150 mg orally twice a day. Maximum dose: 300 mg/day; maximum single dose should not exceed 150 mg. Duration of therapy: 7 to 12 weeks", "runs": [{"text": "Maintenance"}, {"text": " "}, {"text": "dose:"}, {"text": " "}, {"text": "150"}, {"text": " "}, {"text": "mg"}, {"text": " "}, {"text": "orally"}, {"text": " "}, {"text": "twice"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "day."}, {"text": " "}, {"text": "Maximum"}, {"text": " "}, {"text": "dose:"}, {"text": " "}, {"text": "300"}, {"text": " "}, {"text": "mg/day;"}, {"text": " "}, {"text": "maximum"}, {"text": " "}, {"text": "single"}, {"text": " "}, {"text": "dose"}, {"text": " "}, {"text": "should"}, {"text": " "}, {"text": "not"}, {"text": " "}, {"text": "exceed"}, {"text": " "}, {"text": "150"}, {"text": " "}, {"text": "mg. Duration of therapy: 7 to 12 weeks"}]}, {"id": "body-26787", "type": "paragraph", "style": "BodyText", "text": "If you take bupropion to help you stop smoking, you may continue to smoke for about 1 week after you start the medicine. Set a date to quit smoking during the second week of treatment.", "runs": [{"text": "If"}, {"text": " "}, {"text": "you"}, {"text": " "}, {"text": "take"}, {"text": " "}, {"text": "bupropion"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "help"}, {"text": " "}, {"text": "you"}, {"text": " "}, {"text": "stop"}, {"text": " "}, {"text": "smoking,"}, {"text": " "}, {"text": "you"}, {"text": " "}, {"text": "may"}, {"text": " "}, {"text": "continue"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "smoke"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "about"}, {"text": " "}, {"text": "1"}, {"text": " "}, {"text": "week"}, {"text": " "}, {"text": "after"}, {"text": " "}, {"text": "you"}, {"text": " "}, {"text": "start"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "medicine."}, {"text": " "}, {"text": "Set a date to quit smoking during the second week of treatment."}]}, {"id": "body-26787-textbox1-00001", "type": "paragraph", "style": "Normal", "text": "Note:", "runs": [{"text": "Note:", "bold": true}]}, {"id": "body-26787-textbox1-00002", "type": "paragraph", "style": "BodyText", "text": "Nicotine replacement therapy (NRT) may be provided as a transdermal patch, gum, lozenge/mini-lozenge, inhaler, or nasal spray. The choice of formulation and dosage should be individualized according to the patient's level of nicotine dependence, treatment preference, and clinical response.", "runs": [{"text": "Nicotine replacement therapy (NRT) may be provided as a transdermal patch, gum, lozenge/mini-lozenge, inhaler, or nasal spray."}, {"text": " "}, {"text": "The"}, {"text": " "}, {"text": "choice"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "formulation"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "dosage"}, {"text": " "}, {"text": "should"}, {"text": " "}, {"text": "be"}, {"text": " "}, {"text": "individualized"}, {"text": " "}, {"text": "according"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "patient's"}, {"text": " "}, {"text": "level"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "nicotine"}, {"text": " "}, {"text": "dependence, treatment preference, and clinical response."}]}], "source": {"file": "medical.docx", "chapter": "Mental health conditions", "start": "body-26764", "end": "body-26787-textbox1-00002"}}