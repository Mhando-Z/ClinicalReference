{"id": "section-body-25975", "title": "Aggressive Disruptive Behaviors in Adults", "chapterId": "chapter-twenty-three", "blocks": [{"id": "body-25975", "type": "heading", "style": "Heading2", "text": "Aggressive Disruptive Behaviors in Adults", "runs": [{"text": "Aggressive"}, {"text": " "}, {"text": "Disruptive"}, {"text": " "}, {"text": "Behaviors"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "Adults"}], "level": 2, "list": {"level": 1, "numberingId": "381"}}, {"id": "body-25976", "type": "paragraph", "style": "BodyText", "text": "Agitation may escalate to overt aggression and often manifests with restlessness, pacing, and loud or demanding speech. Aggressive behavior includes verbally abusive language, specific verbal threats, intimidating physical behavior, and/or actual physical violence to self, others or property. All agitation and aggression must be considered an emergency and violence prevented wherever possible.", "runs": [{"text": "Agitation may escalate to overt aggression and often manifests with restlessness, pacing, and loud or demanding speech. Aggressive behavior includes verbally abusive language, specific verbal threats, intimidating physical behavior, and/or actual physical violence to self, others or property. All agitation and aggression must be considered an emergency and violence prevented wherever possible."}]}, {"id": "body-25978", "type": "heading", "style": "Heading4", "text": "Causes:", "runs": [{"text": "Causes:"}], "level": 4}, {"id": "body-25979", "type": "paragraph", "style": "ListParagraph", "text": "Physical: acute medical illness, delirium and its causes, epilepsy, intracerebral lesions, traumatic brain injury.", "runs": [{"text": "Physical:"}, {"text": " "}, {"text": "acute"}, {"text": " "}, {"text": "medical"}, {"text": " "}, {"text": "illness,"}, {"text": " "}, {"text": "delirium"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "its"}, {"text": " "}, {"text": "causes,"}, {"text": " "}, {"text": "epilepsy,"}, {"text": " "}, {"text": "intracerebral"}, {"text": " "}, {"text": "lesions,"}, {"text": " "}, {"text": "traumatic"}, {"text": " "}, {"text": "brain"}, {"text": " "}, {"text": "injury."}], "list": {"level": 2, "numberingId": "381"}}, {"id": "body-25980", "type": "paragraph", "style": "ListParagraph", "text": "Psychiatric: psychosis, mania, agitated depression, neurocognitive disorders, developmental disorders, severe anxiety.", "runs": [{"text": "Psychiatric:"}, {"text": " "}, {"text": "psychosis,"}, {"text": " "}, {"text": "mania,"}, {"text": " "}, {"text": "agitated"}, {"text": " "}, {"text": "depression,"}, {"text": " "}, {"text": "neurocognitive"}, {"text": " "}, {"text": "disorders,"}, {"text": " "}, {"text": "developmental"}, {"text": " "}, {"text": "disorders,"}, {"text": " "}, {"text": "severe"}, {"text": " "}, {"text": "anxiety."}], "list": {"level": 2, "numberingId": "381"}}, {"id": "body-25981", "type": "paragraph", "style": "ListParagraph", "text": "Substance misuse: alcohol, cannabis, methaqualone (mandrax) intoxication or withdrawal; stimulant (e.g. cocaine) intoxication; benzodiazepine withdrawal.", "runs": [{"text": "Substance"}, {"text": " "}, {"text": "misuse:"}, {"text": " "}, {"text": "alcohol,"}, {"text": " "}, {"text": "cannabis,"}, {"text": " "}, {"text": "methaqualone"}, {"text": " "}, {"text": "(mandrax)"}, {"text": " "}, {"text": "intoxication"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "withdrawal;"}, {"text": " "}, {"text": "stimulant"}, {"text": " "}, {"text": "(e.g."}, {"text": " "}, {"text": "cocaine) intoxication; benzodiazepine withdrawal."}], "list": {"level": 2, "numberingId": "381"}}, {"id": "body-25982", "type": "paragraph", "style": "ListParagraph", "text": "Psychological factors: high levels of impulsivity and antagonism, hypersensitivity to rejection or insult, poor frustration tolerance and maladaptive coping skills all contribute to aggression and rage", "runs": [{"text": "Psychological factors: high levels of impulsivity and antagonism, hypersensitivity to rejection or insult, poor frustration tolerance and maladaptive coping skills all contribute to aggression and rage"}], "list": {"level": 2, "numberingId": "381"}}, {"id": "body-25984", "type": "paragraph", "style": "BodyText", "text": "In pregnant women: labour, obstetric complications, sepsis, organ failure as well as substances and mental disorders", "runs": [{"text": "In", "bold": true}, {"text": " ", "bold": true}, {"text": "pregnant", "bold": true}, {"text": " ", "bold": true}, {"text": "women:", "bold": true}, {"text": " ", "bold": true}, {"text": "labour,"}, {"text": " "}, {"text": "obstetric"}, {"text": " "}, {"text": "complications,"}, {"text": " "}, {"text": "sepsis,"}, {"text": " "}, {"text": "organ"}, {"text": " "}, {"text": "failure"}, {"text": " "}, {"text": "as"}, {"text": " "}, {"text": "well"}, {"text": " "}, {"text": "as"}, {"text": " "}, {"text": "substances"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "mental"}, {"text": " "}, {"text": "disorders"}]}, {"id": "body-25986", "type": "heading", "style": "Heading4", "text": "Non-Pharmacological Management", "runs": [{"text": "Non-Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-25987", "type": "paragraph", "style": "BodyText", "text": "Before starting pharmacological treatment, conduct a structured assessment:", "runs": [{"text": "Before"}, {"text": " "}, {"text": "starting"}, {"text": " "}, {"text": "pharmacological"}, {"text": " "}, {"text": "treatment,"}, {"text": " "}, {"text": "conduct"}, {"text": " "}, {"text": "a structured assessment:"}]}, {"id": "body-25988", "type": "paragraph", "style": "ListParagraph", "text": "Explore possible reasons for their distress", "runs": [{"text": "Explore"}, {"text": " "}, {"text": "possible"}, {"text": " "}, {"text": "reasons"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "their"}, {"text": " "}, {"text": "distress"}], "list": {"level": 2, "numberingId": "381"}}, {"id": "body-25989", "type": "paragraph", "style": "ListParagraph", "text": "Check for and address clinical or environmental causes (e.g., pain, delirium, or inappropriate care).", "runs": [{"text": "Check"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "address"}, {"text": " "}, {"text": "clinical"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "environmental"}, {"text": " "}, {"text": "causes"}, {"text": " "}, {"text": "(e.g.,"}, {"text": " "}, {"text": "pain,"}, {"text": " "}, {"text": "delirium,"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "inappropriate"}, {"text": " "}, {"text": "care)."}], "list": {"level": 2, "numberingId": "381"}}, {"id": "body-25990", "type": "paragraph", "style": "ListParagraph", "text": "Ensure the safety of the patient and those caring for them.", "runs": [{"text": "Ensure"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "safety"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "patient"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "those"}, {"text": " "}, {"text": "caring"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "them."}], "list": {"level": 2, "numberingId": "381"}}, {"id": "body-25991", "type": "paragraph", "style": "ListParagraph", "text": "Caution is needed with elderly and frail patients as they are vulnerable to falls and further injury if sedated.", "runs": [{"text": "Caution"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "needed"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "elderly"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "frail"}, {"text": " "}, {"text": "patients"}, {"text": " "}, {"text": "as"}, {"text": " "}, {"text": "they"}, {"text": " "}, {"text": "are"}, {"text": " "}, {"text": "vulnerable"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "falls"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "further"}, {"text": " "}, {"text": "injury"}, {"text": " "}, {"text": "if"}, {"text": " "}, {"text": "sedated."}], "list": {"level": 2, "numberingId": "381"}}, {"id": "body-25992", "type": "paragraph", "style": "ListParagraph", "text": "The use of physical restraint should only be employed when there is a need to protect the patient and surrounding people in an acute setting and it should be for as short time as possible with a constant monitoring of patients’ safety. Manual restraint may be necessary to administer medication.", "runs": [{"text": "The use of physical restraint should only be employed when there is a need to protect the patient and surrounding people in an acute setting and it should be for as short time as possible with a constant monitoring of patients’"}, {"text": " "}, {"text": "safety. Manual restraint may be necessary to administer medication."}], "list": {"level": 2, "numberingId": "381"}}, {"id": "body-25993", "type": "paragraph", "style": "ListParagraph", "text": "Mechanical restraint: Only if absolutely necessary to protect the patient and others for as short a time as possible.", "runs": [{"text": "Mechanical"}, {"text": " "}, {"text": "restraint:"}, {"text": " "}, {"text": "Only"}, {"text": " "}, {"text": "if"}, {"text": " "}, {"text": "absolutely"}, {"text": " "}, {"text": "necessary"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "protect"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "patient"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "others"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "as"}, {"text": " "}, {"text": "short"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "time"}, {"text": " "}, {"text": "as"}, {"text": " "}, {"text": "possible."}], "list": {"level": 3, "numberingId": "381"}}, {"id": "body-25994", "type": "paragraph", "style": "ListParagraph", "text": "Document the type, sites and duration of any restraints used.", "runs": [{"text": "Document"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "type,"}, {"text": " "}, {"text": "sites"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "duration"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "any"}, {"text": " "}, {"text": "restraints"}, {"text": " used."}], "list": {"level": 3, "numberingId": "381"}}, {"id": "body-25995", "type": "paragraph", "style": "ListParagraph", "text": "15-minute monitoring: vital signs, the mental state, restraint sites, and reasons for use.", "runs": [{"text": "15-minute"}, {"text": " "}, {"text": "monitoring:"}, {"text": " "}, {"text": "vital"}, {"text": " "}, {"text": "signs,"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "mental"}, {"text": " "}, {"text": "state,"}, {"text": " "}, {"text": "restraint"}, {"text": " "}, {"text": "sites,"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "reasons"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "use."}], "list": {"level": 3, "numberingId": "381"}}, {"id": "body-25996", "type": "paragraph", "style": "ListParagraph", "text": "As initial and ongoing management, offer psychosocial and environmental interventions to reduce aggressive and disruptive behavior.", "runs": [{"text": "As"}, {"text": " "}, {"text": "initial"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "ongoing"}, {"text": " "}, {"text": "management,"}, {"text": " "}, {"text": "offer"}, {"text": " "}, {"text": "psychosocial"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "environmental"}, {"text": " "}, {"text": "interventions"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "reduce"}, {"text": " "}, {"text": "aggressive"}, {"text": " "}, {"text": "and disruptive behavior."}], "list": {"level": 2, "numberingId": "381"}}, {"id": "body-25999", "type": "heading", "style": "Heading4", "text": "De-escalation Techniques should be attempted first:", "runs": [{"text": "De-escalation"}, {"text": " "}, {"text": "Techniques"}, {"text": " "}, {"text": "should"}, {"text": " "}, {"text": "be"}, {"text": " "}, {"text": "attempted"}, {"text": " "}, {"text": "first:"}], "level": 4}, {"id": "body-26000", "type": "paragraph", "style": "ListParagraph", "text": "Be calm, confident, kind, and reassuring.", "runs": [{"text": "Be"}, {"text": " "}, {"text": "calm,"}, {"text": " "}, {"text": "confident,"}, {"text": " "}, {"text": "kind,"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "reassuring."}], "list": {"level": 2, "numberingId": "381"}}, {"id": "body-26001", "type": "paragraph", "style": "ListParagraph", "text": "Maintain a submissive posture with open hands.", "runs": [{"text": "Maintain"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "submissive"}, {"text": " "}, {"text": "posture"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "open"}, {"text": " "}, {"text": "hands."}], "list": {"level": 2, "numberingId": "381"}}, {"id": "body-26002", "type": "paragraph", "style": "ListParagraph", "text": "Do not turn your back on the patient; avoid direct eye contact.", "runs": [{"text": "Do not turn your back on the patient; avoid direct eye contact."}], "list": {"level": 2, "numberingId": "381"}}, {"id": "body-26003", "type": "paragraph", "style": "ListParagraph", "text": "Do not attempt to reason with the patient.", "runs": [{"text": "Do"}, {"text": " "}, {"text": "not"}, {"text": " "}, {"text": "attempt"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "reason"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "patient."}], "list": {"level": 2, "numberingId": "381"}}, {"id": "body-26005", "type": "paragraph", "style": "ListParagraph", "text": "Do not argue, confront delusions, or touch the patient.", "runs": [{"text": "Do"}, {"text": " "}, {"text": "not"}, {"text": " "}, {"text": "argue,"}, {"text": " "}, {"text": "confront"}, {"text": " "}, {"text": "delusions,"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "touch"}, {"text": " "}, {"text": "the "}, {"text"