ntravitreal Vancomycin"}]}, {"id": "body-15292", "type": "paragraph", "style": "BodyText", "text": "1.0 mg/0.1 mL and Amikacin 400 μg/0.1 mL for Penicillin (PCN) allergic patients 24hourly for 5 days and assess accordingly as there is room for extension", "runs": [{"text": "1.0 mg/0.1 mL and Amikacin 400 μg/0.1 mL for Penicillin (PCN) allergic patients 24hourly for 5 days and assess accordingly as there is room for extension"}]}, {"id": "body-15293", "type": "paragraph", "style": "Normal", "text": "\nAND", "runs": [{"text": "\n"}, {"text": "AND", "bold": true}], "conjunction": true}, {"id": "body-15294", "type": "paragraph", "style": "BodyText", "text": "B: ceftriaxone (IV) 2g 24hourly for 7days", "runs": [{"text": "B:", "bold": true}, {"text": " ", "bold": true}, {"text": "ceftriaxone"}, {"text": " "}, {"text": "(IV)"}, {"text": " "}, {"text": "2g"}, {"text": " "}, {"text": "24hourly"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "7days"}]}, {"id": "body-15295", "type": "paragraph", "style": "Heading3", "text": "OR", "runs": [{"text": "OR"}], "level": 3, "conjunction": true}, {"id": "body-15296", "type": "paragraph", "style": "BodyText", "text": "D: ceftazidime (IVI) 2.25 mg/0.1 mL 24hourly", "runs": [{"text": "D:", "bold": true}, {"text": " ", "bold": true}, {"text": "ceftazidime"}, {"text": " "}, {"text": "(IVI)"}, {"text": " "}, {"text": "2.25"}, {"text": " "}, {"text": "mg/0.1"}, {"text": " "}, {"text": "mL"}, {"text": " "}, {"text": "24hourly"}]}, {"id": "body-15297", "type": "paragraph", "style": "Heading3", "text": "AND", "runs": [{"text": "AND"}], "level": 3, "conjunction": true}, {"id": "body-15298", "type": "paragraph", "style": "BodyText", "text": "C: chloramphenicol (PO) 500mg 12hourly for 5-7 days", "runs": [{"text": "C:", "bold": true}, {"text": " ", "bold": true}, {"text": "chloramphenicol"}, {"text": " "}, {"text": "(PO)"}, {"text": " "}, {"text": "500mg"}, {"text": " "}, {"text": "12hourly"}, {"text": " "}, {"text": "for"}, {"text": " "