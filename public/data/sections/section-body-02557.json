{"id": "section-body-02557", "title": "Aplastic Anaemia (Bone Marrow Failure)", "chapterId": "chapter-three", "tocLevel": 4, "tocPath": ["APPROACH TO PATIENTS WITH EMERGENCY CONDITIONS", "HAEMATOLOGY AND BLOOD TRANSFUSION", "Anaemia", "Aplastic Anaemia (Bone Marrow Failure)"], "blocks": [{"id": "body-02557", "type": "heading", "style": "Heading4", "text": "Aplastic Anaemia (Bone Marrow Failure)", "runs": [{"text": "Aplastic"}, {"text": " "}, {"text": "Anaemia"}, {"text": " "}, {"text": "(Bone"}, {"text": " "}, {"text": "Marrow"}, {"text": " "}, {"text": "Failure)"}], "level": 4, "list": {"level": 2, "numberingId": "1835"}}, {"id": "body-02558", "type": "paragraph", "style": "BodyText", "text": "Aplastic anaemia is defined as pancytopenia resulting from aplasia of the bone marrow. it can be inherited (Fanconi anaemia) or acquired (idiopathic, chemical, or drug-induced). It is one of the haematological emergencies.", "runs": [{"text": "Aplastic"}, {"text": " "}, {"text": "anaemia"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "defined"}, {"text": " "}, {"text": "as"}, {"text": " "}, {"text": "pancytopenia"}, {"text": " "}, {"text": "resulting"}, {"text": " "}, {"text": "from"}, {"text": " "}, {"text": "aplasia"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "bone"}, {"text": " "}, {"text": "marrow."}, {"text": " "}, {"text": "it"}, {"text": " "}, {"text": "can"}, {"text": " "}, {"text": "be"}, {"text": " "}, {"text": "inherited"}, {"text": " "}, {"text": "(Fanconi"}, {"text": " "}, {"text": "anaemia) or acquired (idiopathic, chemical, or drug-induced). It is one of the haematological emergencies."}]}, {"id": "body-02560", "type": "heading", "style": "Heading4", "text": "Clinical Presentation", "runs": [{"text": "Clinical"}, {"text": " "}, {"text": "Presentation"}], "level": 4}, {"id": "body-02561", "type": "paragraph", "style": "BodyText", "text": "Vary with severity but include; Anaemia, easy bruising/bleeding, recurrent infection, Splenomegaly is not a feature.", "runs": [{"text": "Vary"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "severity"}, {"text": " "}, {"text": "but"}, {"text": " "}, {"text": "include;"}, {"text": " "}, {"text": "Anaemia,"}, {"text": " "}, {"text": "easy"}, {"text": " "}, {"text": "bruising/bleeding,"}, {"text": " "}, {"text": "recurrent"}, {"text": " "}, {"text": "infection,"}, {"text": " "}, {"text": "Splenomegaly"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "not"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "feature."}]}, {"id": "body-02563", "type": "heading", "style": "Heading4", "text": "Diagnostic Criteria", "runs": [{"text": "Diagnostic"}, {"text": " "}, {"text": "Criteria"}], "level": 4}, {"id": "body-02564", "type": "paragraph", "style": "BodyText", "text": "Pancytopenia, Bone marrow hypocellularity of < 30% hematopoietic cells.", "runs": [{"text": "Pancytopenia,"}, {"text": " "}, {"text": "Bone"}, {"text": " "}, {"text": "marrow"}, {"text": " "}, {"text": "hypocellularity"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "<"}, {"text": " "}, {"text": "30%"}, {"text": " "}, {"text": "hematopoietic"}, {"text": " "}, {"text": "cells."}]}, {"id": "body-02566", "type": "heading", "style": "Heading4", "text": "Investigations", "runs": [{"text": "Investigations"}], "level": 4}, {"id": "body-02567", "type": "paragraph", "style": "ListParagraph", "text": "FBP, peripheral smear, reticulocyte count,", "runs": [{"text": "FBP,"}, {"text": " "}, {"text": "peripheral"}, {"text": " "}, {"text": "smear,"}, {"text": " "}, {"text": "reticulocyte"}, {"text": " "}, {"text": "count,"}], "list": {"level": 0, "numberingId": "1828"}}, {"id": "body-02568", "type": "paragraph", "style": "ListParagraph", "text": "Viral screening (HIV, Hepatitis B, and C),", "runs": [{"text": "Viral"}, {"text": " "}, {"text": "screening"}, {"text": " "}, {"text": "(HIV,"}, {"text": " "}, {"text": "Hepatitis"}, {"text": " "}, {"text": "B,"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "C),"}], "list": {"level": 0, "numberingId": "1828"}}, {"id": "body-02569", "type": "paragraph", "style": "ListParagraph", "text": "Bone marrow aspiration and trephine biopsy.", "runs": [{"text": "Bone"}, {"text": " "}, {"text": "marrow"}, {"text": " "}, {"text": "aspiration"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "trephine"}, {"text": " "}, {"text": "biopsy."}], "list": {"level": 0, "numberingId": "1828"}}, {"id": "body-02571", "type": "heading", "style": "Heading4", "text": "Pharmacological Management", "runs": [{"text": "Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-02573", "type": "paragraph", "style": "BodyText", "text": "Supportive treatment", "runs": [{"text": "Supportive"}, {"text": " "}, {"text": "treatment"}]}, {"id": "body-02574", "type": "paragraph", "style": "BodyText", "text": "B: blood transfusion (preferred irradiated, leukodepleted) when Hb<7g/dl", "runs": [{"text": "B:", "bold": true}, {"text": " ", "bold": true}, {"text": "blood"}, {"text": " "}, {"text": "transfusion"}, {"text": " "}, {"text": "(preferred"}, {"text": " "}, {"text": "irradiated,"}, {"text": " "}, {"text": "leukodepleted)"}, {"text": " "}, {"text": "when"}, {"text": " "}, {"text": "Hb<7g/dl"}]}, {"id": "body-02575", "type": "paragraph", "style": "Heading3", "text": "OR", "runs": [{"text": "OR"}], "level": 3, "conjunction": true}, {"id": "body-02576", "type": "paragraph", "style": "BodyText", "text": "S: platelet transfusion if bleeding or if platelet count is <10 X109/l. See dosage under the blood transfusion section 3.6", "runs": [{"text": "S:", "bold": true}, {"text": " ", "bold": true}, {"text": "platelet"}, {"text": " "}, {"text": "transfusion"}, {"text": " "}, {"text": "if"}, {"text": " "}, {"text": "bleeding"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "if"}, {"text": " "}, {"text": "platelet"}, {"text": " "}, {"text": "count"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "<10"}, {"text": " "}, {"text": "X109/l."}, {"text": " "}, {"text": "See"}, {"text": " "}, {"text": "dosage"}, {"text": " "}, {"text": "under"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "blood"}, {"text": " "}, {"text": "transfusion"}, {"text": " "}, {"text": "section"}, {"text": " "}, {"text": "3.6"}]}, {"id": "body-02577", "type": "paragraph", "style": "Heading3", "text": "AND", "runs": [{"text": "AND"}], "level": 3, "conjunction": true}, {"id": "body-02578", "type": "paragraph", "style": "BodyText", "text": "Prophylactic antibiotics, hygiene, isolation of the patient, and use of masks to prevent neutropenic sepsis in patients with ANC of less than 0.5 X 109/l.", "runs": [{"text": "Prophylactic"}, {"text": " "}, {"text": "antibiotics,"}, {"text": " "}, {"text": "hygiene,"}, {"text": " "}, {"text": "isolation"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "patient,"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "use"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "masks"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "prevent"}, {"text": " "}, {"text": "neutropenic"}, {"text": " "}, {"text": "sepsis"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "patients"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "ANC of less than 0.5 X 109/l."}]}, {"id": "body-02579-textbox1-00001", "type": "paragraph", "style": "BodyText", "text": "Note: Culture and sensitivity in patients with neutropenic sepsis. Refer to management of neutropenic sepsis under malignant diseases chapter.", "runs": [{"text": "Note: ", "bold": true}, {"text": "Culture"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "sensitivity"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "patients"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "neutropenic"}, {"text": " "}, {"text": "sepsis."}, {"text": " "}, {"text": "Refer"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "management"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "neutropenic sepsis under malignant diseases chapter."}]}, {"id": "body-02581", "type": "heading", "style": "Heading4", "text": "Definitive treatment", "runs": [{"text": "Definitive"}, {"text": " "}, {"text": "treatment"}], "level": 4}, {"id": "body-02582", "type": "paragraph", "style": "BodyText", "text": "Allogeneic haematopoietic stem cell transplantation is indicated in patients younger than 45 years. Immunosuppressive Therapy.", "runs": [{"text": "Allogeneic"}, {"text": " "}, {"text": "haematopoietic"}, {"text": " "}, {"text": "stem"}, {"text": " "}, {"text": "cell"}, {"text": " "}, {"text": "transplantation"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "indicated"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "patients"}, {"text": " "}, {"text": "younger"}, {"text": " "}, {"text": "than"}, {"text": " "}, {"text": "45"}, {"text": " "}, {"text": "years."}, {"text": " "}, {"text": "Immunosuppressive "}, {"text": "Therapy."}]}, {"id": "body-02584", "type": "paragraph", "style": "BodyText", "text": "S: anti-thymocyte globulin (ATG) (IV) 40mg/kg 24hourly for 4-10 days.", "runs": [{"text": "S:", "bold": true}, {"text": " ", "bold": true}, {"text": "anti-thymocyte"}, {"text": " "}, {"text": "globulin"}, {"text": " "}, {"text": "(ATG)"}, {"text": " "}, {"text": "(IV)"}, {"text": " "}, {"text": "40mg/kg"}, {"text": " "}, {"text": "24hourly"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "4-10"}, {"text": " "}, {"text": "days."}]}, {"id": "body-02585", "type": "paragraph", "style": "Heading3", "text": "AND", "runs": [{"text": "AND"}], "level": 3, "conjunction": true}, {"id": "body-02586", "type": "paragraph", "style": "BodyText", "text": "S: cyclosporine (PO) 2-10mg/kg 12hourly for 6-24 months", "runs": [{"text": "S:", "bold": true}, {"text": " ", "bold": true}, {"text": "cyclosporine"}, {"text": " "}, {"text": "(PO)"}, {"text": " "}, {"text": "2-10mg/kg"}, {"text": " "}, {"text": "12hourly"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "6-24"}, {"text": " "}, {"text": "months"}]}, {"id": "body-02587", "type": "paragraph", "style": "Heading3", "text": "AND", "runs": [{"text": "AND"}], "level": 3, "conjunction": true}, {"id": "body-02588", "type": "paragraph", "style": "BodyText", "text": "S: eltrombopag (PO):", "runs": [{"text": "S:", "bold": true}, {"text": " ", "bold": true}, {"text": "eltrombopag"}, {"text": " "}, {"text": "(PO):"}]}, {"id": "body-02589", "type": "paragraph", "style": "ListParagraph", "text": "Children <5 years: 2.5 mg/kg 24 hourly (every 24 hours)", "runs": [{"text": "Children"}, {"text": " "}, {"text": "<5"}, {"text": " "}, {"text": "years:"}, {"text": " "}, {"text": "2.5"}, {"text": " "}, {"text": "mg/kg"}, {"text": " "}, {"text": "24"}, {"text": " "}, {"text": "hourly"}, {"text": " "}, {"text": "(every"}, {"text": " "}, {"text": "24"}, {"text": " "}, {"text": "hours)"}], "list": {"level": 0, "numberingId": "1828"}}, {"id": "body-02590", "type": "paragraph", "style": "ListParagraph", "text": "Children 6–11 years: 75 mg 24 hourly", "runs": [{"text": "Children"}, {"text": " "}, {"text": "6–11"}, {"text": " "}, {"text": "years:"}, {"text": " "}, {"text": "75"}, {"text": " "}, {"text": "mg"}, {"text": " "}, {"text": "24"}, {"text": " "}, {"text": "hourly"}], "list": {"level": 0, "numberingId": "1828"}}, {"id": "body-02591", "type": "paragraph", "style": "ListParagraph", "text": "Adolescents ≥12 years: 150 mg 24 hourly Duration of therapy: 6 months", "runs": [{"text": "Adolescents"}, {"text": " "}, {"text": "≥12"}, {"text": " "}, {"text": "years:"}, {"text": " "}, {"text": "150"}, {"text": " "}, {"text": "mg"}, {"text": " "}, {"text": "24"}, {"text": " "}, {"text": "hourly Duration of therapy: 6 months"}], "list": {"level": 0, "numberingId": "1828"}}, {"id": "body-02593", "type": "paragraph", "style": "BodyText", "text": "For patients who develop cyclosporine toxicity (nephrotoxicity, hypertension, gingival hypertrophy and hirsutism), the following drugs may be used, although the response rate is low.", "runs": [{"text": "For"}, {"text": " "}, {"text": "patients"}, {"text": " "}, {"text": "who"}, {"text": " "}, {"text": "develop"}, {"text": " "}, {"text": "cyclosporine"}, {"text": " "}, {"text": "toxicity"}, {"text": " "}, {"text": "(nephrotoxicity,"}, {"text": " "}, {"text": "hypertension,"}, {"text": " "}, {"text": "gingival"}, {"text": " "}, {"text": "hypertrophy"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "hirsutism),"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "following drugs may be used, although the response rate is low."}]}, {"id": "body-02595", "type": "paragraph", "style": "BodyText", "text": "D: methylprednisolone (PO) 5-10mg/kg for 3–14days", "runs": [{"text": "D:", "bold": true}, {"text": " ", "bold": true}, {"text": "methylprednisolone"}, {"text": " "}, {"text": "(PO)"}, {"text": " "}, {"text": "5-10mg/kg"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "3–14days"}]}, {"id": "body-02596", "type": "paragraph", "style": "Heading3", "text": "OR", "runs": [{"text": "OR"}], "level": 3, "conjunction": true}, {"id": "body-02597", "type": "paragraph", "style": "BodyText", "text": "S: cyclophosphamide (IV) 45mg/kg /day for 4days.", "runs": [{"text": "S:", "bold": true}, {"text": " ", "bold": true}, {"text": "cyclophosphamide"}, {"text": " "}, {"text": "(IV)"}, {"text": " "}, {"text": "45mg/kg"}, {"text": " "}, {"text": "/day"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "4days."}]}, {"id": "body-02598", "type": "paragraph", "style": "Heading3", "text": "OR", "runs": [{"text": "OR"}], "level": 3, "conjunction": true}, {"id": "body-02599", "type": "paragraph", "style": "BodyText", "text": "S: danazol (PO) 5mg/kg 24hourly for 6months.", "runs": [{"text": "S:", "bold": true}, {"text": " ", "bold": true}, {"text": "danazol"}, {"text": " "}, {"text": "(PO)"}, {"text": " "}, {"text": "5mg/kg"}, {"text": " "}, {"text": "24hourly"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "6months."}]}, {"id": "body-02600-textbox1-00001", "type": "paragraph", "style": "Normal", "text": "Note", "runs": [{"text": "Note", "bold": true}]}, {"id": "body-02600-textbox1-00002", "type": "paragraph", "style": "BodyText", "text": "Give supportive therapy and refer patients to higher health facility with adequate expertise and facilities.", "runs": [{"text": "Give"}, {"text": " "}, {"text": "supportive"}, {"text": " "}, {"text": "therapy"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "refer"}, {"text": " "}, {"text": "patients"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "higher"}, {"text": " "}, {"text": "health"}, {"text": " "}, {"text": "facility"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "adequate"}, {"text": " "}, {"text": "expertise"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "facilities."}], "list": {"level": 0, "numberingId": "1827"}}, {"id": "body-02600-textbox1-00003", "type": "paragraph", "style": "BodyText", "text": "Monitor blood counts bi-monthly for outpatients, and as needed for admitted patients.", "runs": [{"text": "Monitor"}, {"text": " "}, {"text": "blood"}, {"text": " "}, {"text": "counts"}, {"text": " "}, {"text": "bi-monthly"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "outpatients,"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "as"}, {"text": " "}, {"text": "needed"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "admitted"}, {"text": " "}, {"text": "patients."}], "list": {"level": 0, "numberingId": "1827"}}], "source": {"file": "medical.docx", "chapter": "Haematology and blood transfusion", "start": "body-02557", "end": "body-02600-textbox1-00003"}}