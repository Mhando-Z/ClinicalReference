{"id": "section-body-28892", "title": "Opioid Poisoning", "chapterId": "chapter-twenty-five", "tocLevel": 4, "tocPath": ["APPROACH TO PATIENTS WITH EMERGENCY CONDITIONS", "POISONING", "Specific poisons", "Opioid Poisoning"], "blocks": [{"id": "body-28892", "type": "heading", "style": "Heading4", "text": "Opioid Poisoning", "runs": [{"text": "Opioid"}, {"text": " "}, {"text": "Poisoning"}], "level": 4, "list": {"level": 2, "numberingId": "154"}}, {"id": "body-28893", "type": "paragraph", "style": "BodyText", "text": "Opioid poisoning occurs following excessive exposure to opioids due to: Substance abuse, Unintentional overdose, Intentional overdose, Therapeutic medication errors, Neonatal exposure (maternal opioid use during delivery), and Palliative/terminal care dosing errors", "runs": [{"text": "Opioid"}, {"text": " "}, {"text": "poisoning"}, {"text": " "}, {"text": "occurs"}, {"text": " "}, {"text": "following"}, {"text": " "}, {"text": "excessive"}, {"text": " "}, {"text": "exposure"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "opioids"}, {"text": " "}, {"text": "due"}, {"text": " "}, {"text": "to:"}, {"text": " "}, {"text": "Substance"}, {"text": " "}, {"text": "abuse,"}, {"text": " "}, {"text": "Unintentional"}, {"text": " "}, {"text": "overdose,"}, {"text": " "}, {"text": "Intentional overdose,"}, {"text": " "}, {"text": "Therapeutic"}, {"text": " "}, {"text": "medication"}, {"text": " "}, {"text": "errors,"}, {"text": " "}, {"text": "Neonatal"}, {"text": " "}, {"text": "exposure"}, {"text": " "}, {"text": "(maternal"}, {"text": " "}, {"text": "opioid"}, {"text": " "}, {"text": "use"}, {"text": " "}, {"text": "during"}, {"text": " "}, {"text": "delivery),"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "Palliative/terminal"}, {"text": " "}, {"text": "care dosing errors"}]}, {"id": "body-28894", "type": "paragraph", "style": "BodyText", "text": "Common opioids involved include: Codeine, Diamorphine, Dihydrocodeine, Fentanyl, Heroin, Loperamide, Methadone, Morphine, Opium, or Tramadol. These may be taken alone or in combination with other sedatives.", "runs": [{"text": "Common opioids involved include: Codeine, Diamorphine, Dihydrocodeine, Fentanyl, Heroin, Loperamide, Methadone, Morphine, Opium, or Tramadol. These may be taken alone or in combination with other sedatives."}]}, {"id": "body-28896", "type": "heading", "style": "Heading4", "text": "Risk Factors for Toxicity", "runs": [{"text": "Risk"}, {"text": " "}, {"text": "Factors"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "Toxicity"}], "level": 4}, {"id": "body-28897", "type": "paragraph", "style": "ListParagraph", "text": "People with opioid use disorder", "runs": [{"text": "People"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "opioid"}, {"text": " "}, {"text": "use"}, {"text": " "}, {"text": "disorder"}], "list": {"level": 0, "numberingId": "120"}}, {"id": "body-28898", "type": "paragraph", "style": "ListParagraph", "text": "Social vulnerability/disadvantaged populations", "runs": [{"text": "Social"}, {"text": " "}, {"text": "vulnerability/disadvantaged"}, {"text": " "}, {"text": "populations"}], "list": {"level": 0, "numberingId": "120"}}, {"id": "body-28899", "type": "paragraph", "style": "ListParagraph", "text": "Previous opioid exposure for pain treatment", "runs": [{"text": "Previous"}, {"text": " "}, {"text": "opioid"}, {"text": " "}, {"text": "exposure"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "pain"}, {"text": " "}, {"text": "treatment"}], "list": {"level": 0, "numberingId": "120"}}, {"id": "body-28900", "type": "paragraph", "style": "ListParagraph", "text": "Concurrent alcohol use", "runs": [{"text": "Concurrent"}, {"text": " "}, {"text": "alcohol"}, {"text": " "}, {"text": "use"}], "list": {"level": 0, "numberingId": "120"}}, {"id": "body-28901", "type": "paragraph", "style": "ListParagraph", "text": "Concurrent sedative use (e.g., benzodiazepines)", "runs": [{"text": "Concurrent"}, {"te