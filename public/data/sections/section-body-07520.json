{"id": "section-body-07520", "title": "Acute Laryngo-Tracheobronchitis", "chapterId": "chapter-nine", "tocLevel": 4, "tocPath": ["APPROACH TO PATIENTS WITH EMERGENCY CONDITIONS", "RESPIRATORY DISEASE CONDITIONS", "Other Respiratory Infections", "Acute Laryngo-Tracheobronchitis"], "blocks": [{"id": "body-07520", "type": "heading", "style": "Heading4", "text": "Acute Laryngo-Tracheobronchitis", "runs": [{"text": "Acute"}, {"text": " "}, {"text": "Laryngo-Tracheobronchitis"}], "level": 4, "list": {"level": 2, "numberingId": "1603"}}, {"id": "body-07521", "type": "paragraph", "style": "BodyText", "text": "Laryngo-tracheobronchitis (croup) is acute inflammation of the larynx, trachea and bronchi which occurs in young children (usually between 6 months to 3 years of age). It arises as a result of narrowing of the airway in the region of the larynx. The most common cause is viral infection (particularly parainfluenza viruses) but may also be due to bacterial infection. The obstruction is due to inflammation and oedema.", "runs": [{"text": "Laryngo-tracheobronchitis (croup) is acute inflammation of the larynx, trachea and bronchi which occurs in young children (usually between 6 months to 3 years of age). It arises as a result of narrowing of the airway in the region of the larynx. The most common cause is viral infection (particularly parainfluenza viruses) but may also be due to bacterial infection. The obstruction is due to inflammation and oedema."}]}, {"id": "body-07523", "type": "heading", "style": "Heading4", "text": "Clinical Presentation", "runs": [{"text": "Clinical"}, {"text": " "}, {"text": "Presentation"}], "level": 4}, {"id": "body-07524", "type": "paragraph", "style": "ListParagraph", "text": "The symptoms include paroxysmal “barking” cough, inspiratory stridor, fever, wheezing, hoarseness of voice and tachypnoea", "runs": [{"text": "The symptoms include paroxysmal “barking” cough, inspiratory stridor, fever, wheezing, hoarseness of voice and "}, {"text": "tachypnoea"}], "list": {"level": 0, "numberingId": "1595"}}, {"id": "body-07525", "type": "paragraph", "style": "ListParagraph", "text": "Such symptoms usually occur at night", "runs": [{"text": "Such"}, {"text": " "}, {"text": "symptoms"}, {"text": " "}, {"text": "usually"}, {"text": " "}, {"text": "occur"}, {"text": " "}, {"text": "at"}, {"text": " "}, {"text": "night"}], "list": {"level": 0, "numberingId": "1595"}}, {"id": "body-07526", "type": "paragraph", "style": "ListParagraph", "text": "Respiratory failure and pneumonia are potentially fatal complications.", "runs": [{"text": "Respiratory"}, {"text": " "}, {"text": "failure"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "pneumonia"}, {"text": " "}, {"text": "are"}, {"text": " "}, {"text": "potentially"}, {"text": " "}, {"text": "fatal"}, {"text": " "}, {"text": "complications."}], "list": {"level": 0, "numberingId": "1595"}}, {"id": "body-07529", "type": "heading", "style": "Heading4", "text": "Non-Pharmacological Management", "runs": [{"text": "Non-Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-07530", "type": "paragraph", "style": "ListParagraph", "text": "Prevent asphyxiation", "runs": [{"text": "Prevent"}, {"text": " "}, {"text": "asphyxiation"}], "list": {"level": 0, "numberingId": "1595"}}, {"id": "body-07531", "type": "paragraph", "style": "ListParagraph", "text": "Treat inflammatory oedema", "runs": [{"text": "Treat"}, {"text": " "}, {"text": "inflammatory"}, {"text": " "}, {"text": "oedema"}], "list": {"level": 0, "numberingId": "1595"}}, {"id": "body-07534", "type": "paragraph", "style": "ListParagraph", "text": "Humidification of inhaled air", "runs": [{"text": "Humidification"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "inhaled"}, {"text": " "}, {"text": "air"}], "list": {"level": 0, "numberingId": "1602"}}, {"id": "body-07535", "type": "paragraph", "style": "ListParagraph", "text": "Hospitalization may be necessary", "runs": [{"text": "Hospitalization"}, {"text": " "}, {"text": "may"}, {"text": " "}, {"text": "be"}, {"text": " "}, {"text": "necessary"}], "list": {"level": 0, "numberingId": "1602"}}, {"id": "body-07538-textbox1-00001", "type": "paragraph", "style": "Normal", "text": "Note", "runs": [{"text": "Note", "bold": true}]}, {"id": "body-07538-textbox1-00002", "type": "paragraph", "style": "BodyText", "text": "No stridor at rest, give no antibiotics", "runs": [{"text": "No"}, {"text": " "}, {"text": "stridor"}, {"text": " "}, {"text": "at"}, {"text": " "}, {"text": "rest,"}, {"text": " "}, {"text": "give"}, {"text": " "}, {"text": "no"}, {"text": " "}, {"text": "antibiotics"}], "list": {"level": 0, "numberingId": "1601"}}, {"id": "body-07538-textbox1-00003", "type": "paragraph", "style": "Normal", "text": "Stridor at rest or chest in-drawing or fast breathing Refer Immediately to hospital", "runs": [{"text": "Stridor"}, {"text": " "}, {"text": "at"}, {"text": " "}, {"text": "rest"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "chest"}, {"text": " "}, {"text": "in-drawing"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "fast"}, {"text": " "}, {"text": "breathing"}, {"text": " "}, {"text": "Refer", "bold": true}, {"text": " ", "bold": true}, {"text": "Immediately", "bold": true}, {"text": " ", "bold": true}, {"text": "to"}, {"text": " "}, {"text": "hospital"}], "list": {"level": 0, "numberingId": "1601"}}, {"id": "body-07541", "type": "heading", "style": "Heading4", "text": "Mild Croup", "runs": [{"text": "Mild"}, {"text": " "}, {"text": "Croup"}], "level": 4}, {"id": "body-07542", "type": "paragraph", "style": "ListParagraph", "text": "Only stridor when upset, no moderate/severe ARI", "runs": [{"text": "Only"}, {"text": " "}, {"text": "stridor"}, {"text": " "}, {"text": "when"}, {"text": " "}, {"text": "upset,"}, {"text": " "}, {"text": "no"}, {"text": " "}, {"text": "moderate/severe "}, {"text": "ARI"}], "list": {"level": 1, "numberingId": "1602"}}, {"id": "body-07543", "type": "paragraph", "style": "ListParagraph", "text": "Likely of viral origin", "runs": [{"text": "Likely"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "viral"}, {"text": " "}, {"text": "origin"}], "list": {"level": 1, "numberingId": "1602"}}, {"id": "body-07544", "type": "paragraph", "style": "ListParagraph", "text": "Home care – steam inhalation", "runs": [{"text": "Home"}, {"text": " "}, {"text": "care"}, {"text": " "}, {"text": "–"}, {"text": " "}, {"text": "steam"}, {"text": " "}, {"text": "inhalation"}], "list": {"level": 1, "numberingId": "1602"}}, {"id": "body-07545", "type": "paragraph", "style": "ListParagraph", "text": "Antibiotics NOT required", "runs": [{"text": "Antibiotics"}, {"text": " "}, {"text": "NOT"}, {"text": " "}, {"text": "required"}], "list": {"level": 1, "numberingId": "1602"}}, {"id": "body-07546", "type": "heading", "style": "Heading4", "text": "\nSevere Croup", "runs": [{"text": "\n"}, {"text": "Severe"}, {"text": " "}, {"text": "Croup"}], "level": 4}, {"id": "body-07547", "type": "paragraph", "style": "ListParagraph", "text": "Likely bacterial origin", "runs": [{"text": "Likely"}, {"text": " "}, {"text": "bacterial"}, {"text": " "}, {"text": "origin"}], "list": {"level": 1, "numberingId": "1602"}}, {"id": "body-07548", "type": "paragraph", "style": "ListParagraph", "text": "Stridor in a calm child at rest", "runs": [{"text": "Stridor"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "calm"}, {"text": " "}, {"text": "child"}, {"text": " "}, {"text": "at"}, {"text": " rest"}], "list": {"level": 1, "numberingId": "1602"}}, {"id": "body-07549", "type": "paragraph", "style": "ListParagraph", "text": "Chest in drawing", "runs": [{"text": "Chest"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "drawing"}], "list": {"level": 1, "numberingId": "1602"}}, {"id": "body-07550", "type": "paragraph", "style": "ListParagraph", "text": "Antibiotics are NOT effective and should not be given", "runs": [{"text": "Antibiotics are NOT"}, {"text": " "}, {"text": "effective and should not be "}, {"text": "given"}], "list": {"level": 1, "numberingId": "1602"}}, {"id": "body-07553", "type": "heading", "style": "Heading4", "text": "Pharmacological Management", "runs": [{"text": "Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-07554", "type": "paragraph", "style": "BodyText", "text": "Admit to hospital, give Oxygen therapy to all patients with chest in-drawing (using nasal prongs only, DO NOT use nasopharyngeal or nasal catheter) until the lower chest wall in drawing is no longer present", "runs": [{"text": "Admit to hospital, give Oxygen therapy to all patients with chest in-drawing (using nasal prongs only, DO NOT use nasopharyngeal or nasal catheter) until the lower chest wall in drawing is no longer present"}]}, {"id": "body-07556", "type": "paragraph", "style": "BodyText", "text": "D: dexamethasone (PO) 0.6mg/kg 24hourly in 1–2 divided doses", "runs": [{"text": "D", "bold": true}, {"text": ":"}, {"text": " "}, {"text": "dexamethasone"}, {"text": " "}, {"text": "(PO)"}, {"text": " "}, {"text": "0.6mg/kg"}, {"text": " "}, {"text": "24hourly"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "1–2"}, {"text": " "}, {"text": "divided"}, {"text": " "}, {"text": "doses"}]}, {"id": "body-07557", "type": "paragraph", "style": "Heading3", "text": "AND", "runs": [{"text": "AND"}], "level": 3, "conjunction": true}, {"id": "body-07558", "type": "paragraph", "style": "BodyText", "text": "A: epinephrine (adrenaline) (inhalation) 400mcg/kg 2hourly if effective; repeat after 30min if necessary.", "runs": [{"text": "A:", "bold": true}, {"text": " ", "bold": true}, {"text": "epinephrine"}, {"text": " "}, {"text": "(adrenaline)"}, {"text": " "}, {"text": "(inhalation)"}, {"text": " "}, {"text": "400mcg/kg"}, {"text": " "}, {"text": "2hourly"}, {"text": " "}, {"text": "if"}, {"text": " "}, {"text": "effective;"}, {"text": " "}, {"text": "repeat"}, {"text": " "}, {"text": "after"}, {"text": " "}, {"text": "30min"}, {"text": " "}, {"text": "if"}, {"text": " "}, {"text": "necessary."}]}], "source": {"file": "medical.docx", "chapter": "Respiratory disease conditions", "start": "body-07520", "end": "body-07558"}}