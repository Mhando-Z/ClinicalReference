xt": " "}, {"text": "Management"}], "level": 4}, {"id": "body-27093", "type": "paragraph", "style": "BodyText", "text": "A: carbamazepine (PO) 200-1000mg, in divided doses, per day", "runs": [{"text": "A:", "bold": true}, {"text": " ", "bold": true}, {"text": "carbamazepine"}, {"text": " "}, {"text": "(PO)"}, {"text": " "}, {"text": "200-1000mg,"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "divided"}, {"text": " "}, {"text": "doses,"}, {"text": " "}, {"text": "per"}, {"text": " "}, {"text": "day"}]}, {"id": "body-27094", "type": "paragraph", "style": "Heading3", "text": "OR", "runs": [{"text": "OR"}], "level": 3, "conjunction": true}, {"id": "body-27095", "type": "paragraph", "style": "BodyText", "text": "A: phenobarbitone (PO) 30-200mg, in divided doses, per day", "runs": [{"text": "A:", "bold": true}, {"text": " ", "bold": true}, {"text": "phenobarbitone"}, {"text": " "}, {"text": "(PO)"}, {"text": " "}, {"text": "30-200mg,"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "divided"}, {"text": " "}, {"text": "doses,"}, {"text": " "}, {"text": "per"}, {"text": " "}, {"text": "day"}]}, {"id": "body-27096", "type": "paragraph", "style": "Heading3", "text": "OR", "runs": [{"text": "OR"}], "level": 3, "conjunction": true}, {"id": "body-27097", "type": "paragraph", "style": "BodyText", "text": "A: sodium valproate (PO) 500-2000mg in divided doses, per day", "runs": [{"text": "A:", "bold": true}, {"text": " ", "bold": true}, {"text": "sodium"}, {"text": " "}, {"text": "valproate"}, {"text": " "}, {"text": "(PO)"}, {"text": " "}, {"text": "500-2000mg"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "divided"}, {"text": " "}, {"text": "doses,"}, {"text": " "}, {"text": "per"}, {"text": " "}, {"text": "day"}]}, {"id": "body-27098-textbox1-00001", "type": "paragraph", "style": "BodyText", "text": "Note: Symptoms should be monitored and medication titrated accordingly", "runs": [{"text": "Note:", "bold": true}, {"text": " ", "bold": true}, {"text