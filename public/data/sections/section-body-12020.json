{"id": "section-body-12020", "title": "Sexually transmitted infections", "chapterId": "chapter-twelve", "blocks": [{"id": "body-12020", "type": "heading", "style": "Heading3", "text": "CHAPTER TWELVE SEXUALLY TRANSMITTED INFECTIONS", "runs": [{"text": "CHAPTER TWELVE "}, {"text": "SEXUALLY TRANSMITTED INFECTIONS"}], "level": 3}, {"id": "body-12021", "type": "paragraph", "style": "BodyText", "text": "Sexually transmitted infections (STIs) are generally acquired by sexual contact with a person who has an STI. The organisms (bacteria, viruses or parasites) that cause sexually transmitted diseases may pass from person to person in blood, semen, or vaginal and other bodily fluids. Reproductive tract infections (RTIs) occur in the genital tract and affect both women and men. Some RTIs, such as syphilis and gonorrhea, are sexually transmitted, but many are not. In women, overgrowth of endogenous microorganisms normally found in the vagina may cause RTIs (yeast infection, bacterial vaginosis).", "runs": [{"text": "Sexually transmitted infections (STIs) are generally acquired by sexual contact with a person who has an STI."}, {"text": " "}, {"text": "The organisms (bacteria, viruses or parasites) that cause sexually transmitted diseases may pass from person to person in blood, semen, or vaginal and other bodily fluids. Reproductive tract infections (RTIs) occur in the genital tract and affect both women and men. Some"}, {"text": " "}, {"text": "RTIs,"}, {"text": " "}, {"text": "such"}, {"text": " "}, {"text": "as"}, {"text": " "}, {"text": "syphilis"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "gonorrhea,"}, {"text": " "}, {"text": "are"}, {"text": " "}, {"text": "sexually"}, {"text": " "}, {"text": "transmitted,"}, {"text": " "}, {"text": "but"}, {"text": " "}, {"text": "many"}, {"text": " "}, {"text": "are"}, {"text": " "}, {"text": "not."}, {"text": " "}, {"text": "In"}, {"text": " "}, {"text": "women,"}, {"text": " "}, {"text": "overgrowth"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "endogenous microorganisms normally found in the vagina may cause RTIs (yeast infection, bacterial vaginosis)."}]}, {"id": "body-12024", "type": "heading", "style": "Heading4", "text": "Clinical Presentation", "runs": [{"text": "Clinical"}, {"text": " "}, {"text": "Presentation"}], "level": 4}, {"id": "body-12025", "type": "paragraph", "style": "ListParagraph", "text": "Sores or bumps on the genitals or in the oral or rectal area.", "runs": [{"text": "Sores or bumps on the genitals or in the oral or rectal area."}], "list": {"level": 1, "numberingId": "1398"}}, {"id": "body-12026", "type": "paragraph", "style": "ListParagraph", "text": "Painful or burning urination.", "runs": [{"text": "Painful"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "burning"}, {"text": " "}, {"text": "urination."}], "list": {"level": 1, "numberingId": "1398"}}, {"id": "body-12027", "type": "paragraph", "style": "ListParagraph", "text": "Discharge from the penis.", "runs": [{"text": "Discharge"}, {"text": " "}, {"text": "from"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "penis."}], "list": {"level": 1, "numberingId": "1398"}}, {"id": "body-12028", "type": "paragraph", "style": "ListParagraph", "text": "Vaginal discharge that is abnormal in colour, odour, amount or consistency.", "runs": [{"text": "Vaginal"}, {"text": " "}, {"text": "discharge"}, {"text": " "}, {"text": "that"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "abnormal"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "colour, odour, amount or consistency."}], "list": {"level": 1, "numberingId": "1398"}}, {"id": "body-12029", "type": "paragraph", "style": "ListParagraph", "text": "Itching or irritation of the", "runs": [{"text": "Itching"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "irritation"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "the"}], "list": {"level": 1, "numberingId": "1398"}}, {"id": "body-12030", "type": "paragraph", "style": "ListParagraph", "text": "vulva or vagina.", "runs": [{"text": "vulva"}, {"text": " "}, {"text": "or"}, {"text": " vagina."}], "list": {"level": 1, "numberingId": "1398"}}, {"id": "body-12031", "type": "heading", "style": "Heading2", "text": "STIs/RTIs Management Approaches", "runs": [{"text": "STIs/RTIs"}, {"text": " "}, {"text": "Management"}, {"text": " "}, {"text": "Approaches"}], "level": 2, "list": {"level": 1, "numberingId": "1397"}}, {"id": "body-12033", "type": "paragraph", "style": "ListParagraph", "text": "Unusual vaginal bleeding.", "runs": [{"text": "Unusual"}, {"text": " "}, {"text": "vaginal"}, {"text": " "}, {"text": "bleeding."}], "list": {"level": 0, "numberingId": "1369"}}, {"id": "body-12034", "type": "paragraph", "style": "ListParagraph", "text": "Pain during sex.", "runs": [{"text": "Pain"}, {"text": " "}, {"text": "during"}, {"text": " "}, {"text": "sex."}], "list": {"level": 0, "numberingId": "1369"}}, {"id": "body-12035", "type": "paragraph", "style": "ListParagraph", "text": "Lower abdominal pain", "runs": [{"text": "Lower"}, {"text": " "}, {"text": "abdominal"}, {"text": " "}, {"text": "pain"}], "list": {"level": 0, "numberingId": "1369"}}, {"id": "body-12036", "type": "paragraph", "style": "ListParagraph", "text": "Genital ulcers, sores or blisters", "runs": [{"text": "Genital"}, {"text": " "}, {"text": "ulcers,"}, {"text": " "}, {"text": "sores"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "blisters"}], "list": {"level": 0, "numberingId": "1369"}}, {"id": "body-12037", "type": "paragraph", "style": "ListParagraph", "text": "Swelling, lumps or ulcer in the groin area", "runs": [{"text": "Swelling,"}, {"text": " "}, {"text": "lumps"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "ulcer"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "the groin area"}], "list": {"level": 0, "numberingId": "1369"}}, {"id": "body-12039", "type": "paragraph", "style": "BodyText", "text": "Management of STIs/RTIs can be done in either of the following approaches:", "runs": [{"text": "Management"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "STIs/RTIs"}, {"text": " "}, {"text": "can"}, {"text": " "}, {"text": "be"}, {"text": " "}, {"text": "done"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "either"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "following"}, {"text": " "}, {"text": "approaches:"}]}, {"id": "body-12040", "type": "paragraph", "style": "ListParagraph", "text": "Aetiological laboratory approach: By identification of causative agents through laboratory methods and sensitivity pattern to the medicine to used, followed by disease- specific treatment.", "runs": [{"text": "Aetiological", "bold": true}, {"text": " ", "bold": true}, {"text": "laboratory approach: ", "bold": true}, {"text": "By identification of"}, {"text": " "}, {"text": "causative agents through laboratory"}, {"text": " "}, {"text": "methods"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "sensitivity pattern to the medicine to used, followed by disease- specific treatment."}], "list": {"level": 1, "numberingId": "1369"}}, {"id": "body-12042", "type": "paragraph", "style": "ListParagraph", "text": "Aetiological clinical approach: By targeting disease treatment based on suspected causative agents diagnosed clinically. This is not appropriate at any health facility because of its demands on the clinical acumen of the service provider and the danger of incorrect diagnosis and, hence, insufficient treatment.", "runs": [{"text": "Aetiological clinical approach: ", "bold": true}, {"text": "By targeting disease treatment based on suspected causative agents diagnosed clinically. This is not appropriate at any health facility because of its demands on the clinical acumen of the service provider and the danger of incorrect diagnosis and, hence, insufficient treatment."}], "list": {"level": 1, "numberingId": "1369"}}, {"id": "body-12044", "type": "paragraph", "style": "ListParagraph", "text": "Syndromic approach: This identifies clinical syndromes (symptoms and signs) followed by syndrome-specific treatment that targets causative agents which cause the syndrome.", "runs": [{"text": "Syndromic approach: ", "bold": true}, {"text": "This identifies clinical syndromes (symptoms and signs) followed"}, {"text": " "}, {"text": "by syndrome-specific treatment that targets causative agents which cause the syndrome."}], "list": {"level": 1, "numberingId": "1369"}}, {"id": "body-12046", "type": "heading", "style": "Heading4", "text": "Management of STIs/RTIs using Aetiological Laboratory Approach", "runs": [{"text": "Management"}, {"text": " "}, {"text": "of STIs/RTIs"}, {"text": " "}, {"text": "using"}, {"text": " "}, {"text": "Aetiological Laboratory"}, {"text": " "}, {"text": "Approach"}], "level": 4}, {"id": "body-12047", "type": "paragraph", "style": "BodyText", "text": "It identifies causative agents through laboratory methods, followed by disease-specific treatment. This is the best approach to be used at a Health Facility (HF) which has a Laboratory capable of doing the Laboratory Investigation and producing timely result(s) so as to enable the clinician to prescribe medicine (s) according to the causative agent(s) and sensitivity pattern.", "runs": [{"text": "It identifies causative agents through laboratory methods, followed by disease-specific treatment."}, {"text": " "}, {"text": "This is the best approach to be used at a Health Facility (HF) which has a Laboratory capable of doing the Laboratory Investigation and producing timely result(s) so as to enable the clinician to prescribe medicine (s) according to the causative agent(s) and sensitivity pattern."}]}, {"id": "body-12049", "type": "heading", "style": "Heading2", "text": "Chlamydia", "runs": [{"text": "Chlamydia"}], "level": 2, "list": {"level": 1, "numberingId": "1397"}}, {"id": "body-12050", "type": "paragraph", "style": "BodyText", "text": "A common sexually transmitted infection caused by Chlamydia trachomatis, often asymptomatic but associated with significant reproductive complications if untreated.", "runs": [{"text": "A"}, {"text": " "}, {"text": "common"}, {"text": " "}, {"text": "sexually"}, {"text": " "}, {"text": "transmitted"}, {"text": " "}, {"text": "infection"}, {"text": " "}, {"text": "caused"}, {"text": " "}, {"text": "by"}, {"text": " "}, {"text": "Chlamydia"}, {"text": " "}, {"text": "trachomatis,"}, {"text": " "}, {"text": "often"}, {"text": " "}, {"text": "asymptomatic"}, {"text": " "}, {"text": "but"}, {"text": " "}, {"text": "associated"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "significant reproductive complications if untreated."}]}, {"id": "body-12052", "type": "heading", "style": "Heading4", "text": "Clinical Presentation", "runs": [{"text": "Clinical"}, {"text": " "}, {"text": "Presentation"}], "level": 4}, {"id": "body-12053", "type": "paragraph", "style": "ListParagraph", "text": "Often asymptomatic, especially in women.", "runs": [{"text": "Often"}, {"text": " "}, {"text": "asymptomatic,"}, {"text": " "}, {"text": "especially"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "women."}], "list": {"level": 0, "numberingId": "1370"}}, {"id": "body-12054", "type": "paragraph", "style": "ListParagraph", "text": "When symptomatic, may present as:", "runs": [{"text": "When"}, {"text": " "}, {"text": "symptomatic,"}, {"text": " "}, {"text": "may"}, {"text": " "}, {"text": "present"}, {"text": " "}, {"text": "as:"}], "list": {"level": 0, "numberingId": "1370"}}, {"id": "body-12055", "type": "paragraph", "style": "ListParagraph", "text": "Urethral discharge, dysuria, urethral itching (men).", "runs": [{"text": "Urethral"}, {"text": " "}, {"text": "discharge,"}, {"text": " "}, {"text": "dysuria,"}, {"text": " "}, {"text": "urethral"}, {"text": " "}, {"text": "itching"}, {"text": " "}, {"text": "(men)."}], "list": {"level": 0, "numberingId": "1396"}}, {"id": "body-12056", "type": "paragraph", "style": "ListParagraph", "text": "Vaginal discharge, burning urination, lower abdominal pain, dyspareunia (women).", "runs": [{"text": "Vaginal"}, {"text": " "}, {"text": "discharge,"}, {"text": " "}, {"text": "burning"}, {"text": " "}, {"text": "urination,"}, {"text": " "}, {"text": "lower"}, {"text": " "}, {"text": "abdominal"}, {"text": " "}, {"text": "pain,"}, {"text": " "}, {"text": "dyspareunia"}, {"text": " "}, {"text": "(women)."}], "list": {"level": 0, "numberingId": "1396"}}, {"id": "body-12057", "type": "paragraph", "style": "ListParagraph", "text": "Rectal pain, discharge, or bleeding (rectal infection).", "runs": [{"text": "Rectal"}, {"text": " "}, {"text": "pain,"}, {"text": " "}, {"text": "discharge,"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "bleeding"}, {"text": " "}, {"text": "(rectal"}, {"text": " "}, {"text": "infection)."}], "list": {"level": 0, "numberingId": "1396"}}, {"id": "body-12058", "type": "paragraph", "style": "ListParagraph", "text": "Pharyngitis (rare, oropharyngeal infection).", "runs": [{"text": "Pharyngitis"}, {"text": " "}, {"text": "(rare,"}, {"text": " "}, {"text": "oropharyngeal"}, {"text": " "}, {"text": "infection)."}], "list": {"level": 0, "numberingId": "1396"}}, {"id": "body-12059", "type": "heading", "style": "Heading4", "text": "Investigations", "runs": [{"text": "Investigations"}], "level": 4}, {"id": "body-12060", "type": "paragraph", "style": "ListParagraph", "text": "Preferred: Nucleic acid amplification tests (NAATs) from urine or swabs (urethral, cervical, rectal, or oropharyngeal sites).", "runs": [{"text": "Preferred:"}, {"text": " "}, {"text": "Nucleic acid amplification tests (NAATs) from urine or swabs (urethral, cervical, rectal, or oropharyngeal "}, {"text": "sites)."}], "list": {"level": 0, "numberingId": "1370"}}, {"id": "body-12061", "type": "paragraph", "style": "ListParagraph", "text": "If NAAT unavailable: Gram stain (limited sensitivity), culture, or ELISA where available.", "runs": [{"text": "If"}, {"text": " "}, {"text": "NAAT"}, {"text": " "}, {"text": "unavailable:"}, {"text": " "}, {"text": "Gram"}, {"text": " "}, {"text": "stain"}, {"text": " "}, {"text": "(limited"}, {"text": " "}, {"text": "sensitivity),"}, {"text": " "}, {"text": "culture,"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "ELISA"}, {"text": " "}, {"text": "where"}, {"text": " "}, {"text": "available."}], "list": {"level": 0, "numberingId": "1370"}}, {"id": "body-12062", "type": "paragraph", "style": "ListParagraph", "text": "In resource-limited settings, syndromic management based on symptoms is recommended.", "runs": [{"text": "In"}, {"text": " "}, {"text": "resource-limited"}, {"text": " "}, {"text": "settings,"}, {"text": " "}, {"text": "syndromic"}, {"text": " "}, {"text": "management"}, {"text": " "}, {"text": "based"}, {"text": " "}, {"text": "on"}, {"text": " "}, {"text": "symptoms"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "recommended."}], "list": {"level": 0, "numberingId": "1370"}}, {"id": "body-12065", "type": "heading", "style": "Heading4", "text": "Pharmacological Management", "runs": [{"text": "Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-12066", "type": "paragraph", "style": "BodyText", "text": "Non-pregnant adults and adolescents", "runs": [{"text": "Non-pregnant"}, {"text": " "}, {"text": "adults"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "adolescents"}]}, {"id": "body-12067", "type": "paragraph", "style": "BodyText", "text": "A: doxycycline (PO) 100mg 12hourly for 7 days", "runs": [{"text": "A:", "bold": true}, {"text": " ", "bold": true}, {"text": "doxycycline"}, {"text": " "}, {"text": "(PO)"}, {"text": " "}, {"text": "100mg"}, {"text": " "}, {"text": "12hourly"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "7"}, {"text": " "}, {"text": "days"}]}, {"id": "body-12068", "type": "paragraph", "style": "Heading3", "text"