) 1000 mg/day 24hourly for 5 days", "runs": [{"text": "D:", "bold": true}, {"text": " ", "bold": true}, {"text": "methylprednisolone"}, {"text": " "}, {"text": "(IV)"}, {"text": " "}, {"text": "1000"}, {"text": " "}, {"text": "mg/day"}, {"text": " "}, {"text": "24hourly"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "5"}, {"text": " "}, {"text": "days"}]}, {"id": "body-06819", "type": "paragraph", "style": "BodyText", "text": "Plasma exchange is considered for severe relapse, refractory to steroid Modify disease course", "runs": [{"text": "Plasma"}, {"text": " "}, {"text": "exchange"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "considered"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "severe"}, {"text": " "}, {"text": "relapse,"}, {"text": " "}, {"text": "refractory"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "steroid Modify disease course"}]}, {"id": "body-06821", "type": "paragraph", "style": "BodyText", "text": "Induction phase", "runs": [{"text": "Induction"}, {"text": " "}, {"text": "phase"}]}, {"id": "body-06822", "type": "paragraph", "style": "BodyText", "text": "S: rituximab (IV) 1000mg two weeks apart for one months", "runs": [{"text": "S:", "bold": true}, {"text": " ", "bold": true}, {"text": "rituximab"}, {"text": " "}, {"text": "(IV)"}, {"text": " "}, {"text": "1000mg"}, {"text": " "}, {"text": "two"}, {"text": " "}, {"text": "weeks"}, {"text": " "}, {"text": "apart"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "one"}, {"text": " "}, {"text": "months"}]}, {"id": "body-06824", "type": "paragraph", "style": "BodyText", "text": "Maintenance phase", "runs": [{"text": "Maintenance"}, {"text": " "}, {"text": "phase"}]}, {"id": "body-06825", "type": "paragraph", "style": "BodyText", "text": "S: rituximab (IV) 1000mg every 6 months", "runs": [{"text": "S:", "bold": true}, {"text": " ", "bold": true}, {"text": "rituximab"}, {"text": " "}, {"text": "(IV)"}, {"text": " "}, {"text": "1000mg"}, {"text":