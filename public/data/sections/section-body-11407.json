{"id": "section-body-11407", "title": "Stimulation of Labour and Myometrial Relaxation", "chapterId": "chapter-eleven", "tocLevel": 4, "tocPath": ["APPROACH TO PATIENTS WITH EMERGENCY CONDITIONS", "OBSTETRICS, GYNECOLOGY AND CONTRACEPTION", "Antenatal Care", "Stimulation of Labour and Myometrial Relaxation"], "blocks": [{"id": "body-11407", "type": "heading", "style": "Heading4", "text": "Stimulation of Labour and Myometrial Relaxation", "runs": [{"text": "Stimulation"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "Labour"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "Myometrial"}, {"text": " "}, {"text": "Relaxation"}], "level": 4, "list": {"level": 2, "numberingId": "1452"}}, {"id": "body-11408", "type": "paragraph", "style": "BodyText", "text": "Myometrium stimulants should be used with great care before delivery especially in porous women. Use in obstructed labour should be avoided", "runs": [{"text": "Myometrium stimulants should be used with great care before delivery especially in porous women. Use in obstructed labour should be avoided"}]}, {"id": "body-11411", "type": "heading", "style": "Heading4", "text": "Oxytocics are indicated for: –", "runs": [{"text": "Oxytocics"}, {"text": " "}, {"text": "are"}, {"text": " "}, {"text": "indicated"}, {"text": " "}, {"text": "for:"}, {"text": " "}, {"text": "–"}], "level": 4}, {"id": "body-11412", "type": "paragraph", "style": "ListParagraph", "text": "Augmentation of labour", "runs": [{"text": "Augmentation"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "labour"}], "list": {"level": 0, "numberingId": "1419"}}, {"id": "body-11413", "type": "paragraph", "style": "ListParagraph", "text": "Induction of labour", "runs": [{"text": "Induction"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "labour"}], "list": {"level": 0, "numberingId": "1419"}}, {"id": "body-11414", "type": "paragraph", "style": "ListParagraph", "text": "Active management of third stage of labour.", "runs": [{"t