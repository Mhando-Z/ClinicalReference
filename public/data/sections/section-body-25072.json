{"text": " "}, {"text": "GS"}, {"text": " "}, {"text": "≤"}, {"text": " "}, {"text": "6"}], "list": {"level": 0, "numberingId": "413"}}, {"id": "body-25075", "type": "paragraph", "style": "ListParagraph", "text": "Intermediate risk: T2b or PSA 10 – 20 ng/ml or GS 7", "runs": [{"text": "Intermediate"}, {"text": " "}, {"text": "risk:"}, {"text": " "}, {"text": "T2b"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "PSA"}, {"text": " "}, {"text": "10"}, {"text": " "}, {"text": "–"}, {"text": " "}, {"text": "20"}, {"text": " "}, {"text": "ng/ml"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "GS"}, {"text": " "}, {"text": "7"}], "list": {"level": 0, "numberingId": "413"}}, {"id": "body-25076", "type": "paragraph", "style": "ListParagraph", "text": "High risk: T2c–T4 or PSA > 20ng/ml or GS 8–10", "runs": [{"text": "High"}, {"text": " "}, {"text": "risk:"}, {"text": " "}, {"text": "T2c–T4"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "PSA"}, {"text": " "}, {"text": ">"}, {"text": " "}, {"text": "20ng/ml"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "GS"}, {"text": " "}, {"text": "8–10"}], "list": {"level": 0, "numberingId": "413"}}, {"id": "body-25077", "type": "paragraph", "style": "BodyText", "text": "Patient can be offered appropriate treatment options according to stage of disease, prognostic risk group and estimated survival taking into account performance status and comorbidity.", "runs": [{"text": "Patient"}, {"text": " "}, {"text": "can"}, {"text": " "}, {"text": "be"}, {"text": " "}, {"text": "offered"}, {"text": " "}, {"text": "appropriate"}, {"text": " "}, {"text": "treatment"}, {"text": " "}, {"text": "options"}, {"text": " "}, {"text": "according"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "stage"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "disease,"}, {"text": " "}, {"text": "prognostic"}, {"text": " "}, {"text": "risk"}, {"text": " "}, {"text": "group"}, {"text": " "}, {"text": "and"}, {"