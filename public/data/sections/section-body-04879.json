{"id": "section-body-04879", "title": "Intermittent Preventive Treatment in Pregnancy (IPTp)", "chapterId": "chapter-five", "tocLevel": 4, "tocPath": ["APPROACH TO PATIENTS WITH EMERGENCY CONDITIONS", "MALARIA", "Management of Malaria in Special Groups", "Intermittent Preventive Treatment in Pregnancy (IPTp)"], "blocks": [{"id": "body-04879", "type": "heading", "style": "Heading4", "text": "Intermittent Preventive Treatment in Pregnancy (IPTp)", "runs": [{"text": "Intermittent"}, {"text": " "}, {"text": "Preventive"}, {"text": " "}, {"text": "Treatment"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "Pregnancy"}, {"text": " "}, {"text": "(IPTp)"}], "level": 4, "list": {"level": 3, "numberingId": "1748"}}, {"id": "body-04880", "type": "paragraph", "style": "BodyText", "text": "Malaria parasites can easily accumulate and multiply in the placenta leading to placenta malaria infections, resulting to complications such as maternal anaemia, low birth weight, premature delivery, congenital infection and/or perinatal death.", "runs": [{"text": "Malaria"}, {"text": " "}, {"text": "parasites"}, {"text": " "}, {"text": "can"}, {"text": " "}, {"text": "easily"}, {"text": " "}, {"text": "accumulate"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "multiply"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "placenta"}, {"text": " "}, {"text": "leading"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "placenta"}, {"text": " "}, {"text": "malaria"}, {"text": " "}, {"text": "infections,"}, {"text": " "}, {"text": "resulting"}, {"text": " "}, {"text": "to complications such as maternal anaemia, low birth weight, premature delivery, congenital infection and/or perinatal death."}]}, {"id": "body-04882", "type": "paragraph", "style": "BodyText", "text": "The medicine of choice for IPTp", "runs": [{"text": "The"}, {"text": " "}, {"text": "medicine"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "choice"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "IPTp"}]}, {"id": "body-04883", "type": "paragraph", "style": "BodyText", "text": "A: sulfadoxine + pyrimethamine (PO) 500mg +25mg as a fixed dose combination", "runs": [{"text": "A:", "bold": true}, {"text": " ", "bold": true}, {"text": "sulfadoxine"}, {"text": " "}, {"text": "+"}, {"text": " "}, {"text": "pyrimethamine"}, {"text": " "}, {"text": "(PO)"}, {"text": " "}, {"text": "500mg"}, {"text": " "}, {"text": "+25mg"}, {"text": " "}, {"text": "as"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "fixed"}, {"text": " "}, {"text": "dose"}, {"text": " "}, {"text": "combination"}]}, {"id": "body-04884", "type": "paragraph", "style": "ListParagraph", "text": "The dose is 3 tablets once", "runs": [{"text": "The"}, {"text": " "}, {"text": "dose"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "3"}, {"text": " "}, {"text": "tablets"}, {"text": " "}, {"text": "once"}], "list": {"level": 4, "numberingId": "1748"}}, {"id": "body-04885", "type": "paragraph", "style": "ListParagraph", "text": "A minimum of 3 doses in entire pregnancy period", "runs": [{"text": "A"}, {"text": " "}, {"text": "minimum"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "3"}, {"text": " "}, {"text": "doses"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "entire"}, {"text": " "}, {"text": "pregnancy"}, {"text": " "}, {"text": "period"}], "list": {"level": 4, "numberingId": "1748"}}, {"id": "body-04886", "type": "paragraph", "style": "ListParagraph", "text": "The first dose should be administered from 14 weeks of pregnancy onwards", "runs": [{"text": "The"}, {"text": " "}, {"text": "first"}, {"text": " "}, {"text": "dose"}, {"text": " "}, {"text": "should"}, {"text": " "}, {"text": "be"}, {"text": " "}, {"text": "administered"}, {"text": " "}, {"text": "from"}, {"text": " "}, {"text": "14"}, {"text": " "}, {"text": "weeks"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "pregnancy"}, {"text": " "}, {"text": "onwards"}], "list": {"level": 4, "numberingId": "1748"}}, {"id": "body-04887", "type": "paragraph", "style": "ListParagraph", "text": "Each dose should be given at least 4 weeks apart", "runs": [{"text": "Each"}, {"text": " "}, {"text": "dose"}, {"text": " "}, {"text": "should"}, {"text": " "}, {"text": "be"}, {"text": " "}, {"text": "given"}, {"text": " "}, {"text": "at"}, {"text": " "}, {"text": "least"}, {"text": " "}, {"text": "4"}, {"text": " "}, {"text": "weeks"}, {"text": " apart"}], "list": {"level": 4, "numberingId": "1748"}}, {"id": "body-04888", "type": "paragraph", "style": "ListParagraph", "text": "The last dose can be administered up to the time of delivery, without safety concerns", "runs": [{"text": "The"}, {"text": " "}, {"text": "last"}, {"text": " "}, {"text": "dose"}, {"text": " "}, {"text": "can"}, {"text": " "}, {"text": "be"}, {"text": " "}, {"text": "administered"}, {"text": " "}, {"text": "up"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "time"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "delivery,"}, {"text": " "}, {"text": "without"}, {"text": " "}, {"text": "safety"}, {"text": " "}, {"text": "concerns"}], "list": {"level": 4, "numberingId": "1748"}}], "source": {"file": "medical.docx", "chapter": "Malaria", "start": "body-04879", "end": "body-04888"}}