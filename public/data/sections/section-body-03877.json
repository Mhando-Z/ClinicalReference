{"id": "section-body-03877", "title": "Measles (Rubeola)", "chapterId": "chapter-four", "tocLevel": 4, "tocPath": ["APPROACH TO PATIENTS WITH EMERGENCY CONDITIONS", "NOTIFIABLE DISEASES", "Viral Infections", "Measles (Rubeola)"], "blocks": [{"id": "body-03877", "type": "heading", "style": "Heading4", "text": "Measles (Rubeola)", "runs": [{"text": "Measles"}, {"text": " "}, {"text": "(Rubeola)"}], "level": 4, "list": {"level": 2, "numberingId": "1802"}}, {"id": "body-03878", "type": "paragraph", "style": "BodyText", "text": "Measles is an acute, highly communicable (contagious) infectious viral disease caused by Measles virus (MeV) which is the member of the family Paramyxoviridae, genus Morbillivirus. The mode of transmission is airborne, by droplet spread through coughing or sneezing, or by direct contact with nasal or throat secretions of infected persons. It is the fourth leading cause of death in children less than 5 years of age in many African countries.", "runs": [{"text": "Measles is an acute, highly communicable (contagious) infectious viral disease caused by Measles virus (MeV) which is the member"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "the family Paramyxoviridae,"}, {"text": " "}, {"text": "genus Morbillivirus."}, {"text": " "}, {"text": "The mode of"}, {"text": " "}, {"text": "transmission is airborne,"}, {"text": " "}, {"text": "by droplet"}, {"text": " "}, {"text": "spread through coughing"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "sneezing,"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "by"}, {"text": " "}, {"text": "direct"}, {"text": " "}, {"text": "contact"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "nasal"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "throat"}, {"text": " "}, {"text": "secretions"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "infected"}, {"text": " "}, {"text": "persons."}, {"text": " "}, {"text": "It"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "fourth"}, {"text": " "}, {"text": "leading"}, {"text": " "}, {"text": "cause"}, {"text": " "}, {"text": "of death in children less than 5 years of age in many"}, {"text": " "}, {"text": "African countries."}]}, {"id": "body-03880", "type": "heading", "style": "Heading4", "text": "Case Definition Suspected case:", "runs": [{"text": "Case"}, {"text": " "}, {"text": "Definition"}, {"text": " "}, {"text": "Suspected"}, {"text": " "}, {"text": "case:"}], "level": 4}, {"id": "body-03881", "type": "paragraph", "style": "BodyText", "text": "Any person with fever and maculopapular (non-vesicular) generalized rash and cough, coryza or conjunctivitis (red eyes) or any person in whom a clinician suspects measles.", "runs": [{"text": "Any person with fever and maculopapular (non-vesicular) generalized rash and cough, coryza or conjunctivitis (red eyes) or any person in whom a clinician suspects measles."}]}, {"id": "body-03882", "type": "paragraph", "style": "BodyText", "text": "Confirmed case:", "runs": [{"text": "Confirmed"}, {"text": " "}, {"text": "case:"}]}, {"id": "body-03883", "type": "paragraph", "style": "BodyText", "text": "A suspected case with laboratory confirmation (positive IgM antibody) or epidemiological link to confirmed cases in an outbreak.", "runs": [{"text": "A"}, {"text": " "}, {"text": "suspected"}, {"text": " "}, {"text": "case"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "laboratory"}, {"text": " "}, {"text": "confirmation"}, {"text": " "}, {"text": "(positive"}, {"text": " "}, {"text": "IgM"}, {"text": " "}, {"text": "antibody)"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "epidemiological"}, {"text": " "}, {"text": "link"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "confirmed"}, {"text": " "}, {"text": "cases"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "an "}, {"text": "outbreak."}]}, {"id": "body-03886", "type": "heading", "style": "Heading4", "text": "Clinical Diagnostic Criteria", "runs": [{"text": "Clinical"}, {"text": " "}, {"text": "Diagnostic"}, {"text": " "}, {"text": "Criteria"}], "level": 4}, {"id": "body-03887", "type": "paragraph", "style": "ListParagraph", "text": "Generalized, reddish (erythematous), blotchy (maculopapular) rash;", "runs": [{"text": "Generalized,"}, {"text": " "}, {"text": "reddish"}, {"text": " "}, {"text": "(erythematous),"}, {"text": " "}, {"text": "blotchy (maculopapular) rash;"}], "list": {"level": 0, "numberingId": "1777"}}, {"id": "body-03888", "type": "paragraph", "style": "ListParagraph", "text": "History of fever usually above 38˚C (if not measured, then \"hot\" to touch);", "runs": [{"text": "History"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "fever"}, {"text": " "}, {"text": "usually"}, {"text": " "}, {"text": "above"}, {"text": " "}, {"text": "38˚C"}, {"text": " "}, {"text": "(if"}, {"text": " "}, {"text": "not measured, then \"hot\" to touch);"}], "list": {"level": 0, "numberingId": "1777"}}, {"id": "body-03889", "type": "paragraph", "style": "ListParagraph", "text": "Dry cough; Sore throat; Runny nose (coryza);", "runs": [{"text": "Dry"}, {"text": " "}, {"text": "cough;"}, {"text": " "}, {"text": "Sore"}, {"text": " "}, {"text": "throat;"}, {"text": " "}, {"text": "Runny"}, {"text": " "}, {"text": "nose"}, {"text": " "}, {"text": "(coryza);"}], "list": {"level": 0, "numberingId": "1777"}}, {"id": "body-03891", "type": "paragraph", "style": "ListParagraph", "text": "Inflamed eyes (conjunctivitis), tiny white spots with bluish-white centers on a red background found inside the mouth on the inner lining of the cheek- also called Koplik's spots.", "runs": [{"text": "Inflamed eyes (conjunctivitis), tiny white spots with bluish-white centers on a red background found"}, {"text": " "}, {"text": "inside"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "mouth"}, {"text": " "}, {"text": "on"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "inner"}, {"text": " "}, {"text": "lining"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "the cheek- also called Koplik's spots."}], "list": {"level": 0, "numberingId": "1777"}}, {"id": "body-03892", "type": "paragraph", "style": "ListParagraph", "text": "In addition, children with measles frequently exhibit a dislike of bright light (photophobia), and often have a sore red mouth (stomatitis).", "runs": [{"text": "In addition, children with measles frequently exhibit"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "dislike"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "bright"}, {"text": " "}, {"text": "light"}, {"text": " "}, {"text": "(photophobia),"}, {"text": " "}, {"text": "and often have a sore red mouth (stomatitis)."}], "list": {"level": 0, "numberingId": "1777"}}, {"id": "body-03894", "type": "paragraph", "style": "BodyText", "text": "Symptoms usually develop 10–12 days after exposure to an infected person and last 7–10 days", "runs": [{"text": "Symptoms"}, {"text": " "}, {"text": "usually"}, {"text": " "}, {"text": "develop"}, {"text": " "}, {"text": "10–12"}, {"text": " "}, {"text": "days"}, {"text": " "}, {"text": "after"}, {"text": " "}, {"text": "exposure"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "an"}, {"text": " "}, {"text": "infected"}, {"text": " "}, {"text": "person"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "last"}, {"text": " "}, {"text": "7–10"}, {"text": " "}, {"text": "days"}]}, {"id": "body-03896", "type": "heading", "style": "Heading4", "text": "Laboratory Investigation", "runs": [{"text": "Laboratory"}, {"text": " "}, {"text": "Investigation"}], "level": 4}, {"id": "body-03897", "type": "paragraph", "style": "BodyText", "text": "With coordination from the WHO, the Global Measles and Rubella Laboratory Network (GMRLN) performs case-based laboratory surveillance standardized methods to confirm Measles Infection by", "runs": [{"text": "With"}, {"text": " "}, {"text": "coordination"}, {"text": " "}, {"text": "from"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "WHO,"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "Global"}, {"text": " "}, {"text": "Measles"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "Rubella"}, {"text": " "}, {"text": "Laboratory"}, {"text": " "}, {"text": "Network"}, {"text": " "}, {"text": "(GMRLN)"}, {"text": " "}, {"text": "performs"}, {"text": " "}, {"text": "case-based laboratory surveillance standardized methods to confirm Measles Infection by"}]}, {"id": "body-03898", "type": "paragraph", "style": "ListParagraph", "text": "Detection of viral RNA by RT-PCR (increasing role in case confirmation),", "runs": [{"text": "Detection"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "viral"}, {"text": " "}, {"text": "RNA"}, {"text": " "}, {"text": "by"}, {"text": " "}, {"text": "RT-PCR"}, {"text": " "}, {"text": "(increasing"}, {"text": " "}, {"text": "role"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "case"}, {"text": " "}, {"text": "confirmation),"}], "list": {"level": 1, "numberingId": "1777"}}, {"id": "body-03899", "type": "paragraph", "style": "ListParagraph", "text": "Enzyme Immunoassay (EIA) for immunoglobulin M (IgM)", "runs": [{"text": "Enzyme"}, {"text": " "}, {"text": "Immunoassay"}, {"text": " "}, {"text": "(EIA)"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "immunoglobulin"}, {"text": " "}, {"text": "M"}, {"text": " "}, {"text": "(IgM)"}], "list": {"level": 1, "numberingId": "1777"}}, {"id": "body-03901", "type": "heading", "style": "Heading4", "text": "Pharmacological Management", "runs": [{"text": "Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-03901-textbox1-00001", "type": "paragraph", "style": "BodyText", "text": "Note: No specific antiviral treatment exists for measles virus", "runs": [{"text": "Note:", "bold": true}, {"text": " ", "bold": true}, {"text": "No"}, {"text": " "}, {"text": "specific antiviral"}, {"text": " "}, {"text": "treatment exists"}, {"text": " "}, {"text": "for measles"}, {"text": " "}, {"text": "virus"}]}, {"id": "body-03904", "type": "paragraph", "style": "BodyText", "text": "Adults", "runs": [{"text": "Adults"}]}, {"id": "body-03905", "type": "paragraph", "style": "BodyText", "text": "A: paracetamol (PO) 1g 8hourly for 5days", "runs": [{"text": "A:", "bold": true}, {"text": " ", "bold": true}, {"text": "paracetamol"}, {"text": " "}, {"text": "(PO)"}, {"text": " "}, {"text": "1g"}, {"text": " "}, {"text": "8hourly"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "5days"}]}, {"id": "body-03906", "type": "paragraph", "style": "Heading3", "text": "AND", "runs": [{"text": "AND"}], "level": 3, "conjunction": true}, {"id": "body-03907", "type": "paragraph", "style": "BodyText", "text": "A: vitamin A (PO) 200000 IU stat In case of ocular involvement, add", "runs": [{"text": "A: ", "bold": true}, {"text": "vitamin A (PO) 200000 IU stat In"}, {"text": " "}, {"text": "case"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "ocular"}, {"text": " "}, {"text": "involvement,"}, {"text": " "}, {"text": "add"}]}, {"id": "body-03908", "type": "paragraph", "style": "BodyText", "text": "A: oxytetracycline eye ointment 1% apply 24 hourly for 7 days", "runs": [{"text": "A: ", "bold": true}, {"text": "oxytetracycline eye ointment 1% apply 24 hourly for 7 "}, {"text": "days"}]}, {"id": "body-03910", "type": "paragraph", "style": "BodyText", "text": "Paediatrics:", "runs": [{"text": "Paediatrics:"}]}, {"id": "body-03911", "type": "paragraph", "style": "BodyText", "text": "A: paracetamol (PO) 10–15mg/kg 8hourly for 5days", "runs": [{"text": "A:", "bold": true}, {"text": " ", "bold": true}, {"text": "paracetamol"}, {"text": " "}, {"text": "(PO)"}, {"text": " "}, {"text": "10–15mg/kg"}, {"text": " "}, {"text": "8hourly"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "5days"}]}, {"id": "body-03912", "type": "paragraph", "style": "Heading3", "