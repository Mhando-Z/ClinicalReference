{"id": "section-body-18350", "title": "Temporal Mandibular Disorder and Chronic Orofacial Pain", "chapterId": "chapter-sixteen", "blocks": [{"id": "body-18350", "type": "heading", "style": "Heading2", "text": "Temporal Mandibular Disorder and Chronic Orofacial Pain", "runs": [{"text": "Temporal"}, {"text": " "}, {"text": "Mandibular"}, {"text": " "}, {"text": "Disorder"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "Chronic"}, {"text": " "}, {"text": "Orofacial"}, {"text": " "}, {"text": "Pain"}], "level": 2, "list": {"level": 1, "numberingId": "1126"}}, {"id": "body-18351", "type": "paragraph", "style": "BodyText", "text": "Temporomandibular disorders (TMD) are disorders of the jaw muscles, temporomandibular joints, and the nerves associated with chronic facial pain.", "runs": [{"text": "Temporomandibular disorders (TMD) are disorders of the jaw muscles, temporomandibular joints, and the nerves associated with chronic facial pain."}]}, {"id": "body-18352", "type": "heading", "style": "Heading4", "text": "Temporomandibular Disorders (TMDs)", "runs": [{"text": "Temporomandibular"}, {"text": " "}, {"text": "Disorders"}, {"text": " "}, {"text": "(TMDs)"}], "level": 4, "list": {"level": 2, "numberingId": "1126"}}, {"id": "body-18353", "type": "paragraph", "style": "BodyText", "text": "A collective term embracing several clinical problems that involve the masticatory musculature, the temporomandibular joint and associated structures, or both.", "runs": [{"text": "A collective term embracing several clinical problems that involve the masticatory musculature, the temporomandibular joint and associated structures, or both."}]}, {"id": "body-18355", "type": "heading", "style": "Heading4", "text": "Clinical Presentation", "runs": [{"text": "Clinical"}, {"text": " "}, {"text": "Presentation"}], "level": 4}, {"id": "body-18356", "type": "paragraph", "style": "ListParagraph", "text": "Facial pain.", "runs": [{"text": "Facial"}, {"text": " "}, {"text": "pain."}], "lis