{"id": "section-body-12267", "title": "Vaginal Discharge Syndrome (VDS)", "chapterId": "chapter-twelve", "blocks": [{"id": "body-12267", "type": "heading", "style": "Heading2", "text": "Vaginal Discharge Syndrome (VDS)", "runs": [{"text": "Vaginal"}, {"text": " "}, {"text": "Discharge"}, {"text": " "}, {"text": "Syndrome"}, {"text": " "}, {"text": "(VDS)"}], "level": 2, "list": {"level": 1, "numberingId": "1397"}}, {"id": "body-12269", "type": "paragraph", "style": "ListParagraph", "text": "Quantitative or qualitative PCR", "runs": [{"text": "Quantitative"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "qualitative"}, {"text": " "}, {"text": "PCR"}], "list": {"level": 0, "numberingId": "1374"}}, {"id": "body-12270", "type": "paragraph", "style": "ListParagraph", "text": "Genetic sequencing", "runs": [{"text": "Genetic"}, {"text": " "}, {"text": "sequencing"}], "list": {"level": 0, "numberingId": "1374"}}, {"id": "body-12272", "type": "paragraph", "style": "Normal", "text": "VDS refers to change of colour, odour and/or amount of vaginal secretions caused by T. vaginalis, C. albicans, Bacterial Vaginosis, Neisseria gonorrhoeae and Chlamydia trachomatis.", "runs": [{"text": "VDS"}, {"text": " "}, {"text": "refers"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "change"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "colour,"}, {"text": " "}, {"text": "odour"}, {"text": " "}, {"text": "and/or"}, {"text": " "}, {"text": "amount"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "vaginal"}, {"text": " "}, {"text": "secretions"}, {"text": " "}, {"text": "caused"}, {"text": " "}, {"text": "by"}, {"text": " "}, {"text": "T.", "italic": true}, {"text": " ", "italic": true}, {"text": "vaginalis,", "italic": true}, {"text": " ", "italic": true}, {"text": "C.", "italic": true}, {"text": " ", "italic": true}, {"text": "albicans,", "italic": true}, {"text": " ", "italic": true}, {"text": "Bacterial Vaginosis, Neisseria", "italic": true}, {"text": " ", "italic": true}, {"text": "gonorrhoeae and Chlamydia", "italic": true}, {"text": " ", "italic": true}, {"text": "trachomatis.", "italic": true}]}, {"id": "body-12275", "type": "heading", "style": "Heading4", "text": "Clinical Presentation", "runs": [{"text": "Clinical"}, {"text": " "}, {"text": "Presentation"}], "level": 4}, {"id": "body-12276", "type": "paragraph", "style": "ListParagraph", "text": "Abnormal vaginal discharge,", "runs": [{"text": "Abnormal"}, {"text": " "}, {"text": "vaginal"}, {"text": " "}, {"text": "discharge,"}], "list": {"level": 1, "numberingId": "1374"}}, {"id": "body-12277", "type": "paragraph", "style": "ListParagraph", "text": "Burning or painful micturition,", "runs": [{"text": "Burning"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "painful"}, {"text": " "}, {"text": "micturition,"}], "list": {"level": 1, "numberingId": "1374"}}, {"id": "body-12278", "type": "paragraph", "style": "ListParagraph", "text": "Itchy vulva,", "runs": [{"text": "Itchy"}, {"text": " "}, {"text": "vulva,"}], "list": {"level": 1, "numberingId": "1374"}}, {"id": "body-12280", "type": "paragraph", "style": "ListParagraph", "text": "Increased frequency and urgency of micturition and/or painful coitus.", "runs": [{"text": "Increased"}, {"text": " "}, {"text": "frequency"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "urgency"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "micturition and/or painful coitus."}], "list": {"level": 0, "numberingId": "1374"}}, {"id": "body-12283-textbox1-00001", "type": "paragraph", "style": "Normal", "text": "Note", "runs": [{"text": "Note", "bold": true}]}, {"id": "body-12283-textbox1-00002", "type": "paragraph", "style": "BodyText", "text": "A spontaneous complaint of abnormal vaginal discharge is most commonly due to a vaginal infection.", "runs": [{"text": "A"}, {"text": " "}, {"text": "spontaneous"}, {"text": " "}, {"text": "complaint"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "abnormal"}, {"text": " "}, {"text": "vaginal"}, {"text": " "}, {"text": "discharge"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "most"}, {"text": " "}, {"text": "commonly"}, {"text": " "}, {"text": "due"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "vaginal"}, {"text": " "}, {"text": "infection."}], "list": {"level": 0, "numberingId": "1390"}}, {"id": "body-12283-textbox1-00003", "type": "paragraph", "style": "Normal", "text": "T. vaginalis, C. albicans and Bacterial Vaginosis are the commonest causes of vaginal infection while", "runs": [{"text": "T.", "italic": true}, {"text": " ", "italic": true}, {"text": "vaginalis,", "italic": true}, {"text": " ", "italic": true}, {"text": "C.", "italic": true}, {"text": " ", "italic": true}, {"text": "albicans", "italic": true}, {"text": " ", "italic": true}, {"text": "and"}, {"text": " "}, {"text": "Bacterial", "italic": true}, {"text": " ", "italic": true}, {"text": "Vaginosis", "italic": true}, {"text": " ", "italic": true}, {"text": "are"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "commonest"}, {"text": " "}, {"text": "causes"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "vaginal"}, {"text": " "}, {"text": "infection"}, {"text": " "}, {"text": "while"}], "list": {"level": 0, "numberingId": "1390"}}, {"id": "body-12283-textbox1-00004", "type": "paragraph", "style": "Normal", "text": "Neisseria gonorrhoeae and Chlamydia trachomatis cause cervical infection.", "runs": [{"text": "Neisseria", "italic": true}, {"text": " ", "italic": true}, {"text": "gonorrhoeae", "italic": true}, {"text": " ", "italic": true}, {"text": "and"}, {"text": " "}, {"text": "Chlamydia", "italic": true}, {"text": " ", "italic": true}, {"text": "trachomatis", "italic": true}, {"text": " ", "italic": true}, {"text": "cause"}, {"text": " "}, {"text": "cervical"}, {"text": " "}, {"text": "infection."}], "list": {"level": 0, "numberingId": "1390"}}, {"id": "body-12283-textbox1-00005", "type": "paragraph", "style": "BodyText", "text": "The clinical detection of cervical infection is difficult because a large proportion of women with gonococcal or chlamydia infections are asymptomatic.", "runs": [{"text": "The clinical detection of cervical infection is difficult because a large proportion of women with gonococcal or chlamydia infections are asymptomatic."}], "list": {"level": 0, "numberingId": "1390"}}, {"id": "body-12283-textbox1-00006", "type": "paragraph", "style": "BodyText", "text": "Vaginal discharge is therefore highly indicative of vaginal infection, but poorly predictive for cervical infection", "runs": [{"text": "Vaginal"}, {"text": " "}, {"text": "discharge"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "therefore"}, {"text": " "}, {"text": "highly"}, {"text": " "}, {"text": "indicative"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "vaginal"}, {"text": " "}, {"text": "infection,"}, {"text": " "}, {"text": "but"}, {"text": " "}, {"text": "poorly"}, {"text": " "}, {"text": "predictive"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "cervical"}, {"text": " "}, {"text": "infection"}], "list": {"level": 0, "numberingId": "1390"}}, {"id": "body-12283-textbox1-00007", "type": "paragraph", "style": "BodyText", "text": "Due to the high prevalence of gonorrhea and chlamydia, all women presenting with VDS should receive treatment for both vaginal and cervical infections.", "runs": [{"text": "Due"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "high"}, {"text": " "}, {"text": "prevalence"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "gonorrhea"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "chlamydia,"}, {"text": " "}, {"text": "all"}, {"text": " "}, {"text": "women"}, {"text": " "}, {"text": "presenting"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "VDS"}, {"text": " "}, {"text": "should"}, {"text": " "}, {"text": "receive treatment for both vaginal and cervical infections."}], "list": {"level": 0, "numberingId": "1390"}}, {"id": "body-12283-textbox1-00008", "type": "paragraph", "style": "BodyText", "text": "Delayed or inadequate treatment of VDS may result to endometritis, salpingitis, oophoritis or ectopic pregnancy.", "runs": [{"text": "Delayed"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "inadequate"}, {"text": " "}, {"text": "treatment"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "VDS"}, {"text": " "}, {"text": "may"}, {"text": " "}, {"text": "result"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "endometritis,"}, {"text": " "}, {"text": "salpingitis,"}, {"text": " "}, {"text": "oophoritis"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "ectopic"}, {"text": " "}, {"text": "pregnancy."}], "list": {"level": 0, "numberingId": "1390"}}, {"id": "body-12283-textbox1-00009", "type": "paragraph", "style": "BodyText", "text": "Gonococcal or chlamydial cervical infection may be asymptomatic", "runs": [{"text": "Gonococcal"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "chlamydial"}, {"text": " "}, {"text": "cervical"}, {"text": " "}, {"text": "infection"}, {"text": " "}, {"text": "may"}, {"text": " "}, {"text": "be"}, {"text": " "}, {"text": "asymptomatic"}], "list": {"level": 0, "numberingId": "1390"}}, {"id": "body-12285", "type": "paragraph", "style": "Normal", "text": "Investigations", "runs": [{"text": "Investigations", "bold": true}]}, {"id": "body-12286", "type": "paragraph", "style": "ListParagraph", "text": "Wet preparation", "runs": [{"text": "Wet"}, {"text": " "}, {"text": "preparation"}], "list": {"level": 1, "numberingId": "1374"}}, {"id": "body-12287", "type": "paragraph", "style": "ListParagraph", "text": "Gram stain", "runs": [{"text": "Gram"}, {"text": " "}, {"text": "stain"}], "list": {"level": 1, "numberingId": "1374"}}, {"id": "body-12288", "type": "paragraph", "style": "ListParagraph", "text": "Culture and Sensitivity", "runs": [{"text": "Culture"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "Sensitivity"}], "list": {"level": 1, "numberingId": "1374"}}, {"id": "body-12289", "type": "paragraph", "style": "ListParagraph", "text": "Fluorescent Microscopy", "runs": [{"text": "Fluorescent"}, {"text": " "}, {"text": "Microscopy"}], "list": {"level": 1, "numberingId": "1374"}}, {"id": "body-12290", "type": "paragraph", "style": "ListParagraph", "text": "Pap test (Papanicolau test)", "runs": [{"text": "Pap"}, {"text": " "}, {"text": "test"}, {"text": " "}, {"text": "(Papanicolau"}, {"text": " "}, {"text": "test)"}], "list": {"level": 1, "numberingId": "1374"}}, {"id": "body-12292", "type": "paragraph", "style": "ListParagraph", "text": "ELISA", "runs": [{"text": "ELISA"}], "list": {"level": 0, "numberingId": "1374"}}, {"id": "body-12293", "type": "paragraph", "style": "ListParagraph", "text": "Quantitative or qualitative PCR", "runs": [{"text": "Quantitative"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "qualitative"}, {"text": " "}, {"text": "PCR"}], "list": {"level": 0, "numberingId": "1374"}}, {"id": "body-12294", "type": "paragraph", "style": "ListParagraph", "text": "NB starts simple to complex", "runs": [{"text": "NB"}, {"text": " "}, {"text": "starts"}, {"text": " "}, {"text": "simple"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "complex"}], "list": {"level": 0, "numberingId": "1374"}}, {"id": "body-12297", "type": "paragraph", "style": "Normal", "text": "Management of VDS (see flow chart 12.2)", "runs": [{"text": "Management"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "VDS ("}, {"text": "see", "bold": true}, {"text": " ", "bold": true}, {"text": "flow", "bold": true}, {"text": " ", "bold": true}, {"text": "chart", "bold": true}, {"text": " ", "bold": true}, {"text": "12.2", "bold": true}, {"text": ")"}]}], "source": {"file": "medical.docx", "chapter": "Sexually transmitted infections", "start": "body-12267", "end": "body-