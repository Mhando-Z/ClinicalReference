}, {"text": "to"}, {"text": " "}, {"text": "anoxia from severe overdose) and at least 1 of the following signs and symptoms:"}]}, {"id": "body-26810", "type": "paragraph", "style": "ListParagraph", "text": "Feeling drowsy or losing consciousness", "runs": [{"text": "Feeling"}, {"text": " "}, {"text": "drowsy"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "losing"}, {"text": " "}, {"text": "consciousness"}], "list": {"level": 4, "numberingId": "352"}}, {"id": "body-26811", "type": "paragraph", "style": "ListParagraph", "text": "Slurring of speech", "runs": [{"text": "Slurring"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "speech"}], "list": {"level": 4, "numberingId": "352"}}, {"id": "body-26812", "type": "paragraph", "style": "ListParagraph", "text": "Impairments in attention or memory", "runs": [{"text": "Impairments"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "attention"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "memory"}], "list": {"level": 4, "numberingId": "352"}}, {"id": "body-26813", "type": "paragraph", "style": "ListParagraph", "text": "There must also be significant problematic behavioral or psychological changes that have arisen during or shortly after the usage.", "runs": [{"text": "There"}, {"text": " "}, {"text": "must"}, {"text": " "}, {"text": "also"}, {"text": " "}, {"text": "be"}, {"text": " "}, {"text": "significant"}, {"text": " "}, {"text": "problematic"}, {"text": " "}, {"text": "behavioral"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "psychological"}, {"text": " "}, {"text": "changes"}, {"text": " "}, {"text": "that"}, {"text": " "}, {"text": "have"}, {"text": " "}, {"text": "arisen"}, {"text": " "}, {"text": "during"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "shortly"}, {"text": " "}, {"text": "after the usage."}], "list": {"level": 4, "numberingId": "352"}}, {"id": "body-26815", "type": "heading", "style": "Heading4", "text": "Non-Pharmacological Management", "ru