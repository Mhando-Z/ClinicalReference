{"id": "section-body-26662", "title": "Acute Stress Disorder and Post-Traumatic Stress Disorder", "chapterId": "chapter-twenty-three", "blocks": [{"id": "body-26662", "type": "heading", "style": "Heading2", "text": "Acute Stress Disorder and Post-Traumatic Stress Disorder", "runs": [{"text": "Acute"}, {"text": " "}, {"text": "Stress"}, {"text": " "}, {"text": "Disorder"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "Post-Traumatic"}, {"text": " "}, {"text": "Stress"}, {"text": " "}, {"text": "Disorder"}], "level": 2, "list": {"level": 1, "numberingId": "359"}}, {"id": "body-26663", "type": "paragraph", "style": "BodyText", "text": "Acute stress and post-traumatic stress disorder arise in response to stressful events. The patient should have experienced the event as life threatening or as a physical threat to themselves or others, at which time they felt fear and helplessness.", "runs": [{"text": "Acute"}, {"text": " "}, {"text": "stress"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "post-traumatic"}, {"text": " "}, {"text": "stress"}, {"text": " "}, {"text": "disorder"}, {"text": " "}, {"text": "arise"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "response"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "stressful"}, {"text": " "}, {"text": "events."}, {"text": " "}, {"text": "The"}, {"text": " "}, {"text": "patient"}, {"text": " "}, {"text": "should"}, {"text": " "}, {"text": "have"}, {"text": " "}, {"text": "experienced"}, {"text": " "}, {"text": "the event as life threatening or as a physical threat to themselves or others, at which time they felt fear and helplessness."}]}, {"id": "body-26665", "type": "heading", "style": "Heading4", "text": "Clinical Presentation", "runs": [{"text": "Clinical"}, {"text": " "}, {"text": "Presentation"}], "level": 4}, {"id": "body-26666", "type": "paragraph", "style": "ListParagraph", "text": "Re-experiencing of the event, e.g. flashbacks, dreams", "runs": [{"text": "Re-experiencing"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "event,"}, {"text": " "}, {"text": "e.g."}, {"text": " "}, {"text": "flashbacks,"}, {"text": " "}, {"text": "dreams"}], "list": {"level": 0, "numberingId": "357"}}, {"id": "body-26667", "type": "paragraph", "style": "ListParagraph", "text": "Avoidance of situations associated with the event", "runs": [{"text": "Avoidance"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "situations"}, {"text": " "}, {"text": "associated"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "event"}], "list": {"level": 0, "numberingId": "357"}}, {"id": "body-26668", "type": "paragraph", "style": "ListParagraph", "text": "Features of anxiety or increased arousal, e.g. hyper vigilance, heightened startle response and insomnia", "runs": [{"text": "Features"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "anxiety"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "increased"}, {"text": " "}, {"text": "arousal,"}, {"text": " "}, {"text": "e.g."}, {"text": " "}, {"text": "hyper"}, {"text": " "}, {"text": "vigilance,"}, {"text": " "}, {"text": "heightened"}, {"text": " "}, {"text": "startle"}, {"text": " "}, {"text": "response"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "insomnia"}], "list": {"level": 0, "numberingId": "357"}}, {"id": "body-26669", "type": "paragraph", "style": "BodyText", "text": "The conditions are symptomatically similar but differ with regard to the duration and time of onset of symptoms. The symptoms of acute stress disorder arise within 4 weeks of the event and last up to 4 weeks, whereas the symptoms post-traumatic stress disorder last longer than 4 weeks, and may arise more than 4 weeks after the traumatic incident.", "runs": [{"text": "The"}, {"text": " "}, {"text": "conditions"}, {"text": " "}, {"text": "are"}, {"text": " "}, {"text": "symptomatically"}, {"text": " "}, {"text": "similar"}, {"text": 