 {"text": "and"}, {"text": " "}, {"text": "may"}, {"text": " "}, {"text": "undergo"}, {"text": " "}, {"text": "an"}, {"text": " "}, {"text": "invasive "}, {"text": "procedure."}], "list": {"level": 4, "numberingId": "1835"}}, {"id": "body-02730", "type": "paragraph", "style": "ListParagraph", "text": "Emergency treatment of acute bleeding caused by severe thrombocytopenia needs immediate platelet transfusion.", "runs": [{"text": "Emergency"}, {"text": " "}, {"text": "treatment"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "acute"}, {"text": " "}, {"text": "bleeding"}, {"text": " "}, {"text": "caused"}, {"text": " "}, {"text": "by"}, {"text": " "}, {"text": "severe"}, {"text": " "}, {"text": "thrombocytopenia"}, {"text": " "}, {"text": "needs"}, {"text": " "}, {"text": "immediate"}, {"text": " "}, {"text": "platelet"}, {"text": " "}, {"text": "transfusion."}], "list": {"level": 4, "numberingId": "1835"}}, {"id": "body-02732", "type": "heading", "style": "Heading4", "text": "Pharmacological Management", "runs": [{"text": "Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-02734", "type": "paragraph", "style": "BodyText", "text": "A: prednisolone (PO) 1mg/kg 24hourly for 3-6 weeks, then taper 10mg weekly (for all patients with platelet counts below 30 X109/l)", "runs": [{"text": "A: ", "bold": true}, {"text": "prednisolone (PO) 1mg/kg 24hourly for 3-6 weeks, then taper 10mg weekly (for all patients with platelet counts below 30 "}, {"text": "X109/l)"}]}, {"id": "body-02735", "type": "paragraph", "style": "Heading3", "text": "OR", "runs": [{"text": "OR"}], "level": 3, "conjunction": true}, {"id": "body-02736", "type": "paragraph", "style": "BodyText", "text": "B: dexamethasone (IV) 40mg in 500ml 0.9% sodium chloride running for 4 hours once a day for 4 days. If no response;", "runs": [{"text": "B:", "bold": true}, {"text": " ", "bold": true}, {"text": "dexamethasone"}, {"text": " "}, {"text": "(IV)"}, {"text": " "}, {"text":