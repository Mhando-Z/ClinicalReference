: "Fibrates:"}], "list": {"level": 0, "numberingId": "874"}}, {"id": "body-20541", "type": "paragraph", "style": "ListParagraph", "text": "Should be used in mixed hyperlipidemias which have not responded adequately to diet or other therapy.", "runs": [{"text": "Should"}, {"text": " "}, {"text": "be"}, {"text": " "}, {"text": "used"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "mixed"}, {"text": " "}, {"text": "hyperlipidemias"}, {"text": " "}, {"text": "which"}, {"text": " "}, {"text": "have"}, {"text": " "}, {"text": "not"}, {"text": " "}, {"text": "responded"}, {"text": " "}, {"text": "adequately"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "diet"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "other"}, {"text": " "}, {"text": "therapy."}], "list": {"level": 1, "numberingId": "874"}}, {"id": "body-20542", "type": "paragraph", "style": "ListParagraph", "text": "Are more effective in lowering triglycerides and increasing HDL, but less effective in lowering cholesterol.", "runs": [{"text": "Are"}, {"text": " "}, {"text": "more"}, {"text": " "}, {"text": "effective"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "lowering"}, {"text": " "}, {"text": "triglycerides"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "increasing"}, {"text": " "}, {"text": "HDL,"}, {"text": " "}, {"text": "but"}, {"text": " "}, {"text": "less"}, {"text": " "}, {"text": "effective"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "lowering"}, {"text": " "}, {"text": "cholesterol."}], "list": {"level": 1, "numberingId": "874"}}, {"id": "body-20543", "type": "paragraph", "style": "ListParagraph", "text": "Should be used with caution in combination with statins.", "runs": [{"text": "Should"}, {"text": " "}, {"text": "be"}, {"text": " "}, {"text": "used"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "caution"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "combination"}, {"text": " "}, {"text": "with"}, {"text":