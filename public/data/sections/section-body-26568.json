", "runs": [{"text": "Note:", "bold": true}]}, {"id": "body-26598-textbox1-00002", "type": "paragraph", "style": "BodyText", "text": "Prolonged treatment with benzodiazepines often leads to tolerance and withdrawal symptoms if the medicine is discontinued abruptly", "runs": [{"text": "Prolonged"}, {"text": " "}, {"text": "treatment"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "benzodiazepines"}, {"text": " "}, {"text": "often"}, {"text": " "}, {"text": "leads"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "tolerance"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "withdrawal"}, {"text": " "}, {"text": "symptoms"}, {"text": " "}, {"text": "if"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "medicine"}, {"text": " "}, {"text": "is discontinued abruptly"}], "list": {"level": 0, "numberingId": "362"}}, {"id": "body-26598-textbox1-00003", "type": "paragraph", "style": "BodyText", "text": "Avoid combining more than one benzodiazepine.", "runs": [{"text": "Avoid"}, {"text": " "}, {"text": "combining"}, {"text": " "}, {"text": "more"}, {"text": " "}, {"text": "than"}, {"text": " "}, {"text": "one"}, {"text": " "}, {"text": "benzodiazepine."}], "list": {"level": 0, "numberingId": "362"}}, {"id": "body-26600", "type": "paragraph", "style": "BodyText", "text": "Referral: Refer to the next level if there is lack of improvement with treatment.", "runs": [{"text": "Referral:", "bold": true}, {"text": " ", "bold": true}, {"text": "Refer"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "next"}, {"text": " "}, {"text": "level"}, {"text": " "}, {"text": "if"}, {"text": " "}, {"text": "there"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "lack"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "improvement"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "treatment."}]}], "source": {"file": "medical.docx", "chapter": "Mental health conditions", "start": "body-26568", "