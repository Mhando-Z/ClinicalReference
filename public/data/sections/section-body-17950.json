": "reserved"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "non-displaced"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "minimally"}, {"text": " "}, {"text": "displaced"}, {"text": " "}, {"text": "fractures"}, {"text": " "}, {"text": "(e.g.,"}, {"text": " "}, {"text": "nasal,"}, {"text": " "}, {"text": "condylar,"}, {"text": " "}, {"text": "pediatric,"}, {"text": " "}, {"text": "body"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "mandible)."}, {"text": " "}, {"text": "Midface bones"}, {"text": " "}, {"text": "(nasal"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "zygoma)"}, {"text": " "}, {"text": "closed"}, {"text": " "}, {"text": "reduction"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "best"}, {"text": " "}, {"text": "within"}, {"text": " "}, {"text": "7–10"}, {"text": " "}, {"text": "days"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "adults,"}, {"text": " "}, {"text": "sooner"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "children."}, {"text": " "}, {"text": "For"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "mandibular"}, {"text": " "}, {"text": "fractures closed reduction should be carried as soon as possible."}]}, {"id": "body-17986", "type": "paragraph", "style": "BodyText", "text": "Maxillomandibular fixation (MMF)/intermaxillary fixation (IMF): Establishes occlusion, used in closed or open techniques for mandible and midface stability. Duration typically 4–8 weeks, or shorter with rigid fixation. Use arch bars, interdental wires, or bone screws; treatment Modalities", "runs": [{"text": "Maxillomandibular fixation (MMF)/intermaxillary fixation (IMF):"}, {"text": " "}, {"text": "Establishes occlusion, used in closed or open techniques for mandible and midface stability. Duration typically 4–8 weeks, or shorter with rigid fixation. Use arch bars, interdental wires, or bone screws; treatment Modalities"}]}, {"id": "body-17988", "type": "heading", "style": "Heading4", "text": "Open Reduction and Internal Fixation (ORIF):", "runs": [{"text": "Open"}, {"text": " "}, {"text": "Reduction"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "Internal"}, {"text": " "}, {"text": "Fixation"}, {"text": " "}, {"text": "(ORIF):"}], "level": 4, "list": {"level": 0, "numberingId": "1111"}}, {"id": "body-17989", "type": "paragraph", "style": "BodyText", "text": "Indicated for displaced, unstable, comminuted, or load-bearing fractures (mandible, Le Fort, ZMC). Aim is to achieve anatomical reduction, occlusion restoration, facial contour.", "runs": [{"text": "Indicated"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "displaced,"}, {"text": " "}, {"text": "unstable,"}, {"text": " "}, {"text": "comminuted,"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "load-bearing"}, {"text": " "}, {"text": "fractures"}, {"text": " "}, {"text": "(mandible,"}, {"text": " "}, {"text": "Le"}, {"text": " "}, {"text": "Fort,"}, {"text": " "}, {"text": "ZMC)."}, {"text": " "}, {"text": "Aim"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "achieve"}, {"text": " "}, {"text": "anatomical reduction, occlusion restoration, facial contour."}]}, {"id": "body-17990", "type": "paragraph", "style": "BodyText", "text": "Utilize titanium miniplates, reconstruction plates, 3D plates, lag screws, biodegradable implants as appropriate. Choose incision and approach based on location (intraoral for symphysis/body; extraoral like Gillies for zygoma).", "runs": [{"text": "Utilize titanium miniplates, reconstruction plates, 3D plates, lag screws, biodegradable implants as appropriate. Choose"}, {"text": " "}, {"text": "incision"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "approach"}, {"text": " "}, {"text": "based"}, {"text": " "}, {"text": "on"}, {"text": " "}, {"text": "location"}, {"text": " "}, {"text": "(intraoral"}, {"text": " "}, {"text": "for"}, {"text": " "}, 