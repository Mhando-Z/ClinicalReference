ccurs"}, {"text": " "}, {"text": "mostly"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "second"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "fourth"}, {"text": " "}, {"text": "decades"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "life"}], "list": {"level": 4, "numberingId": "1107"}}, {"id": "body-18102", "type": "paragraph", "style": "ListParagraph", "text": "Clinically indistinguishable from ameloblastoma, but on aspiration while ameloblastoma yields", "runs": [{"text": "Clinically"}, {"text": " "}, {"text": "indistinguishable"}, {"text": " "}, {"text": "from"}, {"text": " "}, {"text": "ameloblastoma,"}, {"text": " "}, {"text": "but"}, {"text": " "}, {"text": "on"}, {"text": " "}, {"text": "aspiration"}, {"text": " "}, {"text": "while"}, {"text": " "}, {"text": "ameloblastoma"}, {"text": " "}, {"text": "yields"}], "list": {"level": 4, "numberingId": "1107"}}, {"id": "body-18103", "type": "paragraph", "style": "ListParagraph", "text": "straw-colored or yellow fluid Odontogenic myxoma may not yield anything due to the thick mucoid clear contents of the tumour.", "runs": [{"text": "straw-colored"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "yellow"}, {"text": " "}, {"text": "fluid"}, {"text": " "}, {"text": "Odontogenic"}, {"text": " "}, {"text": "myxoma"}, {"text": " "}, {"text": "may"}, {"text": " "}, {"text": "not"}, {"text": " "}, {"text": "yield"}, {"text": " "}, {"text": "anything"}, {"text": " "}, {"text": "due"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "thick"}, {"text": " "}, {"text": "mucoid"}, {"text": " "}, {"text": "clear contents of the tumour."}], "list": {"level": 4, "numberingId": "1107"}}, {"id": "body-18104", "type": "paragraph", "style": "ListParagraph", "text": "The radiographic appearance; typically, it has honeycomb appearance, although", "runs": [{"text": "The"}, {"text": " "}, {"text": "radiographic"}, {"text": " "}