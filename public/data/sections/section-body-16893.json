{"id": "section-body-16893", "title": "Metastatic Lymphadenopathy and Neck Masses", "chapterId": "chapter-fifteen", "tocLevel": 4, "tocPath": ["APPROACH TO PATIENTS WITH EMERGENCY CONDITIONS", "EAR, NOSE AND THROAT/HEAD AND NECK DISEASES", "ENT Neoplasms", "Metastatic Lymphadenopathy and Neck Masses"], "blocks": [{"id": "body-16893", "type": "heading", "style": "Heading4", "text": "Metastatic Lymphadenopathy and Neck Masses", "runs": [{"text": "Metastatic"}, {"text": " "}, {"text": "Lymphadenopathy"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "Neck"}, {"text": " "}, {"text": "Masses"}], "level": 4, "list": {"level": 2, "numberingId": "1219"}}, {"id": "body-16894", "type": "paragraph", "style": "BodyText", "text": "Cervical lymph nodes are a common site of metastases for malignant tumors that originate at primary sites in the head and neck. Primary lymphoma in neck nodes must be considered in any differential diagnosis. Sometimes the origin might be unknown", "runs": [{"text": "Cervical lymph nodes are a common site of metastases for malignant tumors that originate at primary sites in the head and neck. Primary lymphoma in neck nodes must be considered in any differential diagnosis. Sometimes the origin might be "}, {"text": "unknown"}]}, {"id": "body-16896", "type": "heading", "style": "Heading4", "text": "Clinical Presentation", "runs": [{"text": "Clinical"}, {"text": " "}, {"text": "Presentation"}], "level": 4}, {"id": "body-16897", "type": "paragraph", "style": "BodyText", "text": "Neck mass unilateral or bilateral, Neck ulcer.", "runs": [{"text": "Neck"}, {"text": " "}, {"text": "mass"}, {"text": " "}, {"text": "unilateral"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "bilateral,"}, {"text": " "}, {"text": "Neck"}, {"text": " "}, {"text": "ulcer."}]}, {"id": "body-16898-textbox1-00001", "type": "paragraph", "style": "Normal", "text": "Note:", "runs": [{"text": "Note:", "bold": true}]}, {"id": "body-16898-textbox1-00002", "type": "paragr