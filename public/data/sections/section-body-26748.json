{"id": "section-body-26748", "title": "Opioid Use Disorder DSM-5 - Diagnostic criteria", "chapterId": "chapter-twenty-three", "tocLevel": 4, "tocPath": ["APPROACH TO PATIENTS WITH EMERGENCY CONDITIONS", "MENTAL HEALTH CONDITIONS", "Substance Related Disorder", "Opioid Use Disorder"], "blocks": [{"id": "body-26748", "type": "heading", "style": "Heading4", "text": "Opioid Use Disorder DSM-5 - Diagnostic criteria", "runs": [{"text": "Opioid"}, {"text": " "}, {"text": "Use"}, {"text": " "}, {"text": "Disorder DSM-5 - Diagnostic criteria"}], "level": 4, "list": {"level": 3, "numberingId": "359"}}, {"id": "body-26749", "type": "paragraph", "style": "BodyText", "text": "It states that there must be problematic usage of opioid that has led to significant impairments in terms of functioning over a 12-month period. The rest of the criteria are similar to that of alcohol use disorder", "runs": [{"text": "It states that there must be problematic usage of opioid that has led to significant impairments in terms of functioning over a 12-month period. The rest of the criteria are similar to that of alcohol use disorder"}]}, {"id": "body-26751", "type": "heading", "style": "Heading4", "text": "Non-Pharmacological Management", "runs": [{"text": "Non-Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-26752", "type": "paragraph", "style": "ListParagraph", "text": "Motivational interviewing", "runs": [{"text": "Motivational"}, {"text": " "}, {"text": "interviewing"}], "list": {"level": 4, "numberingId": "359"}}, {"id": "body-26753", "type": "paragraph", "style": "ListParagraph", "text": "Therapeutic group therapy in a structured environment is helpful for helping individuals with their addiction.", "runs": [{"text": "Therapeutic"}, {"text": " "}, {"text": "group"}, {"text": " "}, {"text": "therapy"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "structured"}, {"text": " "}, {"text": "environment"}, {"text": " "}, 