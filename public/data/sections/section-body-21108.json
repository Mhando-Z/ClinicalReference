{"id": "section-body-21108", "title": "Unstable Angina (UA)", "chapterId": "chapter-twenty", "tocLevel": 4, "tocPath": ["APPROACH TO PATIENTS WITH EMERGENCY CONDITIONS", "CARDIOVASCULAR DISEASE CONDITIONS", "Acute Coronary Syndrome", "Unstable Angina (UA)"], "blocks": [{"id": "body-21108", "type": "heading", "style": "Heading4", "text": "Unstable Angina (UA)", "runs": [{"text": "Unstable"}, {"text": " "}, {"text": "Angina"}, {"text": " "}, {"text": "(UA)"}], "level": 4, "list": {"level": 2, "numberingId": "781"}}, {"id": "body-21109", "type": "paragraph", "style": "BodyText", "text": "Unstable angina is a medical emergency and if untreated can progress to Non-ST Elevation Myocardial Infarction (NSTEMI)", "runs": [{"text": "Unstable"}, {"text": " "}, {"text": "angina"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "medical"}, {"text": " "}, {"text": "emergency"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "if"}, {"text": " "}, {"text": "untreated"}, {"text": " "}, {"text": "can"}, {"text": " "}, {"text": "progress"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "Non-ST"}, {"text": " "}, {"text": "Elevation"}, {"text": " "}, {"text": "Myocardial"}, {"text": " "}, {"text": "Infarction"}, {"text": " "}, {"text": "(NSTEMI)"}]}, {"id": "body-21110", "type": "heading", "style": "Heading4", "text": "Diagnostic Criteria", "runs": [{"text": "Diagnostic"}, {"text": " "}, {"text": "Criteria"}], "level": 4}, {"id": "body-21111", "type": "paragraph", "style": "BodyText", "text": "Presents as chest pain or discomfort like stable angina but with the following additional characteristics:", "runs": [{"text": "Presents"}, {"text": " "}, {"text": "as"}, {"text": " "}, {"text": "chest"}, {"text": " "}, {"text": "pain"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "discomfort"}, {"text": " "}, {"text": "like"}, {"text": " "}, {"text": "stable"}, {"text": " "}, {"text": "angina"}, {"text": " "}, {"text": "but"}, {"t