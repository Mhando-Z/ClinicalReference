{"id": "section-body-17286", "title": "Dry Socket", "chapterId": "chapter-sixteen", "tocLevel": 4, "tocPath": ["APPROACH TO PATIENTS WITH EMERGENCY CONDITIONS", "ORAL AND MAXILLOFACIAL CONDITIONS", "Post Extraction Complications", "Dry Socket"], "blocks": [{"id": "body-17286", "type": "heading", "style": "Heading4", "text": "Dry Socket", "runs": [{"text": "Dry"}, {"text": " "}, {"text": "Socket"}], "level": 4, "list": {"level": 2, "numberingId": "1146"}}, {"id": "body-17287", "type": "paragraph", "style": "BodyText", "text": "This is a post extraction complication due to failure to form a clot (dry socket). The condition is very painful, and it differs from an infected socket by lack of clotting and levels of severity of pain.", "runs": [{"text": "This is a post extraction complication due to failure to form a clot (dry socket). The condition is very painful, and it differs from an infected socket by lack of clotting and levels of severity of pain."}]}, {"id": "body-17289", "type": "heading", "style": "Heading4", "text": "Clinical Presentation", "runs": [{"text": "Clinical"}, {"text": " "}, {"text": "Presentation"}], "level": 4}, {"id": "body-17290", "type": "paragraph", "style": "ListParagraph", "text": "Severe pain 2–4 days’ post- extraction", "runs": [{"text": "Severe"}, {"text": " "}, {"text": "pain"}, {"text": " "}, {"text": "2–4"}, {"text": " "}, {"text": "days’"}, {"text": " "}, {"text": "post-"}, {"text": " "}, {"text": "extraction"}], "list": {"level": 3, "numberingId": "1146"}}, {"id": "body-17291", "type": "paragraph", "style": "ListParagraph", "text": "Pain exacerbated by entry of air on the site", "runs": [{"text": "Pain"}, {"text": " "}, {"text": "exacerbated"}, {"text": " "}, {"text": "by"}, {"text": " "}, {"text": "entry"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "air"}, {"text": " "}, {"text": "on"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "site"}], "list": {"level": 3, "numberingId": "1146"}}, {"id": "body-17292", "ty