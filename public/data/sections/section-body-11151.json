ts"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "Thrombosis"}, {"text": " "}, {"text": "such"}, {"text": " "}, {"text": "as"}, {"text": " "}, {"text": "stroke"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "pulmonary"}, {"text": " "}, {"text": "embolism"}, {"text": " "}, {"text": "need"}, {"text": " "}, {"text": "therapeutic"}, {"text": " "}, {"text": "anticoagulation. "}, {"text": "C: ", "bold": true}, {"text": "unfractionated heparin (SC) 5,000 bolus and subsequent 15,000–20,000 doses at 12hourly "}, {"text": "intervals"}]}, {"id": "body-11176", "type": "paragraph", "style": "Heading3", "text": "OR", "runs": [{"text": "OR"}], "level": 3, "conjunction": true}, {"id": "body-11177", "type": "paragraph", "style": "BodyText", "text": "D: low molecular weight heparin (SC) 1mg/kg 12hour", "runs": [{"text": "D:", "bold": true}, {"text": " ", "bold": true}, {"text": "low"}, {"text": " "}, {"text": "molecular"}, {"text": " "}, {"text": "weight"}, {"text": " "}, {"text": "heparin"}, {"text": " "}, {"text": "(SC)"}, {"text": " "}, {"text": "1mg/kg"}, {"text": " "}, {"text": "12hour"}]}, {"id": "body-11179-textbox1-00001", "type": "paragraph", "style": "BodyText", "text": "Note: Warfarin should be avoided in pregnancy due to the risk of teratogenicity. The aPTT needs to be checked and is best done midway between the 12hourly doses, 24hourly. A target of 1.5-2.5 times the control should be aimed", "runs": [{"text": "Note:", "bold": true}, {"text": " ", "bold": true}, {"text": "Warfarin"}, {"text": " "}, {"text": "should"}, {"text": " "}, {"text": "be"}, {"text": " "}, {"text": "avoided"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "pregnancy"}, {"text": " "}, {"text": "due"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "risk"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "teratogenicity."}, {"text": " "}, {"text": "The"}, {"text": " "}, {"text": "aPTT"}, {"text": " "}, {"text": "needs"},