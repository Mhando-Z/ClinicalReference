{"id": "section-body-25579", "title": "Low-grade Gliomas (LGGs) Clinical Presentation", "chapterId": "chapter-twenty-two", "tocLevel": 4, "tocPath": ["APPROACH TO PATIENTS WITH EMERGENCY CONDITIONS", "MALIGNANT DISEASE CONDITIONS", "Central Nervous System Malignancies", "Low-grade Gliomas (LGGs) Clinical Presentation"], "blocks": [{"id": "body-25579", "type": "heading", "style": "Heading4", "text": "Low-grade Gliomas (LGGs) Clinical Presentation", "runs": [{"text": "Low-grade"}, {"text": " "}, {"text": "Gliomas"}, {"text": " "}, {"text": "(LGGs)"}, {"text": " "}, {"text": "Clinical"}, {"text": " "}, {"text": "Presentation"}], "level": 4, "list": {"level": 3, "numberingId": "534"}}, {"id": "body-25580", "type": "paragraph", "style": "ListParagraph", "text": "Seizures are common", "runs": [{"text": "Seizures"}, {"text": " "}, {"text": "are"}, {"text": " "}, {"text": "common"}], "list": {"level": 4, "numberingId": "534"}}, {"id": "body-25581", "type": "paragraph", "style": "ListParagraph", "text": "progressive neurologic symptoms depending on site of tumor", "runs": [{"text": "progressive"}, {"text": " "}, {"text": "neurologic"}, {"text": " "}, {"text": "symptoms"}, {"text": " "}, {"text": "depending"}, {"text": " "}, {"text": "on"}, {"text": " "}, {"text": "site"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "tumor"}], "list": {"level": 4, "numberingId": "534"}}, {"id": "body-25582", "type": "heading", "style": "Heading4", "text": "Investigations", "runs": [{"text": "Investigations"}], "level": 4}, {"id": "body-25583", "type": "paragraph", "style": "ListParagraph", "text": "CT or MRI should be done in diagnosis of Gliomas.", "runs": [{"text": "CT"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "MRI"}, {"text": " "}, {"text": "should"}, {"text": " "}, {"text": "be"}, {"text": " "}, {"text": "done"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "diagnosis"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "Gliomas."}], "list": {"lev