{"id": "section-body-01524", "title": "Hypocalcemia", "chapterId": "chapter-one", "tocLevel": 4, "tocPath": ["APPROACH TO PATIENTS WITH EMERGENCY CONDITIONS", "The Concept of Emergency Care and Resuscitation", "Electrolyte disturbances", "Hypocalcemia"], "blocks": [{"id": "body-01524", "type": "heading", "style": "Heading4", "text": "Hypocalcemia", "runs": [{"text": "Hypocalcemia"}], "level": 4, "list": {"level": 2, "numberingId": "1855"}}, {"id": "body-01525", "type": "paragraph", "style": "BodyText", "text": "Hypocalcemia is defined as a total serum calcium concentration below 8.8 mg/dL (< 2.20 mmol/L) in the presence of normal plasma protein concentrations, or as a serum ionized calcium concentration below 4.7 mg/dL (< 1.17 mmol/L). Reference ranges for serum calcium vary by age and sex. Causes include reduced absorption, renal failure, hypothyroidism, medications,", "runs": [{"text": "Hypocalcemia is defined as a total serum calcium concentration below 8.8 mg/dL (< 2.20 mmol/L) in the presence of normal plasma protein concentrations, or as a serum ionized calcium concentration below 4.7 mg/dL (< 1.17 mmol/L). Reference "}, {"text": "ranges"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "serum calcium vary"}, {"text": " "}, {"text": "by"}, {"text": " "}, {"text": "age and sex."}, {"text": " "}, {"text": "Causes"}, {"text": " "}, {"text": "include reduced absorption,"}, {"text": " "}, {"text": "renal"}, {"text": " "}, {"text": "failure,"}, {"text": " "}, {"text": "hypothyroidism,"}, {"text": " "}, {"text": "medications,"}]}, {"id": "body-01526", "type": "heading", "style": "Heading4", "text": "Clinical Presentations", "runs": [{"text": "Clinical"}, {"text": " "}, {"text": "Presentations"}], "level": 4}, {"id": "body-01529", "type": "paragraph", "style": "ListParagraph", "text": "Paresthesias\t(mouth, fingertips)", "runs": [{"text": "Paresthesias"}, {"text": "\t"}, {"text": "(mouth, fingertips)"}], "list": {"level": 3, "numberingId": "1855"}}, {"id": "b