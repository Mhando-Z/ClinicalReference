{"id": "section-body-15218", "title": "Dry Eye Syndrome/Keratoconjunctivitis Sicca", "chapterId": "chapter-fourteen", "blocks": [{"id": "body-15218", "type": "heading", "style": "Heading2", "text": "Dry Eye Syndrome/Keratoconjunctivitis Sicca", "runs": [{"text": "Dry"}, {"text": " "}, {"text": "Eye"}, {"text": " "}, {"text": "Syndrome/Keratoconjunctivitis"}, {"text": " "}, {"text": "Sicca"}], "level": 2, "list": {"level": 1, "numberingId": "1271"}}, {"id": "body-15219", "type": "paragraph", "style": "BodyText", "text": "It occurs when there is inadequate tear volume, poor quality tears or functional disorders of tear drainage.", "runs": [{"text": "It"}, {"text": " "}, {"text": "occurs"}, {"text": " "}, {"text": "when"}, {"text": " "}, {"text": "there"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "inadequate"}, {"text": " "}, {"text": "tear"}, {"text": " "}, {"text": "volume,"}, {"text": " "}, {"text": "poor"}, {"text": " "}, {"text": "quality"}, {"text": " "}, {"text": "tears"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "functional"}, {"text": " "}, {"text": "disorders"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "tear"}, {"text": " "}, {"text": "drainage."}]}, {"id": "body-15221", "type": "heading", "style": "Heading4", "text": "Clinical Presentation", "runs": [{"text": "Clinical"}, {"text": " "}, {"text": "Presentation"}], "level": 4}, {"id": "body-15222", "type": "paragraph", "style": "ListParagraph", "text": "Feelings of dryness, grittiness, burning and foreign body sensation, usually worse during the day", "runs": [{"text": "Feelings"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "dryness,"}, {"text": " "}, {"text": "grittiness,"}, {"text": " "}, {"text": "burning"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "foreign"}, {"text": " "}, {"text": "body"}, {"text": " "}, {"text": "sensation,"}, {"text": " "}, {"text": "usually"}, {"text": " "}, {"text": "worse"}, {"text": " "}, {"text": "during"}, {"tex