{"id": "section-body-01816", "title": "High spinal or total spinal anesthesia:", "chapterId": "chapter-two", "tocLevel": 4, "tocPath": ["APPROACH TO PATIENTS WITH EMERGENCY CONDITIONS", "ANAESTHESIA AND CRITICAL CARE", "Anaesthesia", "High spinal or total spinal anesthesia:"], "blocks": [{"id": "body-01816", "type": "heading", "style": "Heading4", "text": "High spinal or total spinal anesthesia:", "runs": [{"text": "High"}, {"text": " "}, {"text": "spinal"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "total"}, {"text": " "}, {"text": "spinal"}, {"text": " "}, {"text": "anesthesia:"}], "level": 4, "list": {"level": 3, "numberingId": "1850"}}, {"id": "body-01817", "type": "paragraph", "style": "BodyText", "text": "A high neuraxial block is a sensorimotor block that has reached a spinal segmental level higher than that required to achieve surgical anaesthesia (sensory level T3 and above). Local anesthetic agent spreads too high in the spinal cord, blocking cardio accelerator nerves and respiratory muscles, causing difficulty in breathing, severe hypotension and cardiac dysfunction.", "runs": [{"text": "A"}, {"text": " "}, {"text": "high"}, {"text": " "}, {"text": "neuraxial"}, {"text": " "}, {"text": "block"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "sensorimotor"}, {"text": " "}, {"text": "block"}, {"text": " "}, {"text": "that"}, {"text": " "}, {"text": "has"}, {"text": " "}, {"text": "reached"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "spinal"}, {"text": " "}, {"text": "segmental"}, {"text": " "}, {"text": "level"}, {"text": " "}, {"text": "higher"}, {"text": " "}, {"text": "than"}, {"text": " "}, {"text": "that"}, {"text": " "}, {"text": "required"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "achieve surgical"}, {"text": " "}, {"text": "anaesthesia"}, {"text": " "}, {"text": "(sensory"}, {"text": " "}, {"text": "level"}, {"text": " "}, {"text": "T3"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "above)."}, {"text": " "}, {"text": "Local"}, {"text": " "}, {"text": "anesthetic"}, {"text": " "}, {"text": "agent"}, {"text": " "}, {"text": "spreads"}, {"text": " "}, {"text": "too"}, {"text": " "}, {"text": "high"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "spinal"}, {"text": " "}, {"text": "cord,"}, {"text": " "}, {"text": "blocking"}, {"text": " "}, {"text": "cardio accelerator nerves and respiratory muscles, causing difficulty in breathing, severe hypotension and cardiac dysfunction."}]}, {"id": "body-01818", "type": "paragraph", "style": "ListParagraph", "text": "Anticipate and reassure the patient.", "runs": [{"text": "Anticipate"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "reassure"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "patient."}], "list": {"level": 4, "numberingId": "1850"}}, {"id": "body-01819", "type": "paragraph", "style": "ListParagraph", "text": "Declare emergency and call for help. Position the head elevated to slow further spread.", "runs": [{"text": "Declare"}, {"text": " "}, {"text": "emergency"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "call"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "help."}, {"text": " "}, {"text": "Position"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "head"}, {"text": " "}, {"text": "elevated"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "slow"}, {"text": " "}, {"text": "further"}, {"text": " "}, {"text": "spread."}], "list": {"level": 4, "numberingId": "1850"}}, {"id": "body-01820", "type": "paragraph", "style": "ListParagraph", "text": "Ensure the wedge is placed properly.", "runs": [{"text": "Ensure"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "wedge"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "placed"}, {"text": " "}, {"text": "properly."}], "list": {"level": 4, "numberingId": "1850"}}, {"id": "body-01821", "type": "paragraph", "style": "ListParagraph", "text": "Use ABC approach, give Oxygen 100% by face mask or intubate (rapid sequence) with a hypnotic and muscle relaxant and ventilate if apneic.", "runs": [{"text": "Use ABC"}, {"text": " "}, {"text": "approach,"}, {"text": " "}, {"text": "give"}, {"text": " "}, {"text": "Oxygen"}, {"text": " "}, {"text": "100%"}, {"text": " "}, {"text": "by"}, {"text": " "}, {"text": "face"}, {"text": " "}, {"text": "mask"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "intubate"}, {"text": " "}, {"text": "(rapid"}, {"text": " "}, {"text": "sequence)"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "hypnotic"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "muscle relaxant and ventilate if apneic."}], "list": {"level": 4, "numberingId": "1850"}}, {"id": "body-01822", "type": "paragraph", "style": "ListParagraph", "text": "Give rapid fluid infusion and add vasopressors- ephedrine, phenylephrine or double-diluted epinephrine (adrenaline)/baby epinephrine (adrenaline) (10mcg/ml).", "runs": [{"text": "Give"}, {"text": " "}, {"text": "rapid"}, {"text": " "}, {"text": "fluid"}, {"text": " "}, {"text": "infusion"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "add"}, {"text": " "}, {"text": "vasopressors-"}, {"text": " "}, {"text": "ephedrine,"}, {"text": " "}, {"text": "phenylephrine"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "double-diluted"}, {"text": " "}, {"text": "epinephrine (adrenaline)/baby epinephrine (adrenaline) (10mcg/ml)."}], "list": {"level": 4, "numberingId": "1850"}}, {"id": "body-01823", "type": "paragraph", "style": "ListParagraph", "text": "If hypotension persists, consider vasopressor infusion.", "runs": [{"text": "If"}, {"text": " "}, {"text": "hypotension"}, {"text": " "}, {"text": "persists,"}, {"text": " "}, {"text": "consider"}, {"text": " "}, {"text": "vasopressor"}, {"text": " "}, {"text": "infusion."}], "list": {"level": 4, "numberingId": "1850"}}, 