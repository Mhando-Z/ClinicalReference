text": " "}, {"text": "and"}, {"text": " "}, {"text": "TB"}, {"text": " "}, {"text": "co-"}, {"text": "infection"}]}], "colspan": 1, "rowspan": 1, "column": 0}, {"blocks": [{"id": "body-05030-r3-c2-00002", "type": "paragraph", "style": "TableParagraph", "text": "A: AZT/3TC+ LPV/r*", "runs": [{"text": "A:", "bold": true}, {"text": " ", "bold": true}, {"text": "AZT/3TC+"}, {"text": " "}, {"text": "LPV/r*"}]}, {"id": "body-05030-r3-c2-00003", "type": "paragraph", "style": "TableParagraph", "text": "*Double dose of LPV/r to 800/200 mg", "runs": [{"text": "*Double"}, {"text": " "}, {"text": "dose"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "LPV/r"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "800/200 mg"}]}], "colspan": 1, "rowspan": 1, "column": 1}, {"blocks": [], "colspan": 1, "rowspan": 1, "column": 2}], "header": false}], "columns": 3}, {"id": "body-05031-textbox1-00001", "type": "paragraph", "style": "Normal", "text": "Note:", "runs": [{"text": "Note:", "bold": true}]}, {"id": "body-05031-textbox1-00002", "type": "paragraph", "style": "BodyText", "text": "Addition of DTG to failing PI based 2nd line regimen is not recommended because the client is considered to be on DTG monotherapy leading to development of DTG resistance, which compromises DTG efficacy and its future use", "runs": [{"text": "Addition"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "DTG"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "failing"}, {"text": " "}, {"text": "PI"}, {"text": " "}, {"text": "based"}, {"text": " "}, {"text": "2"}, {"text": "nd", "vertical": "superscript"}, {"text": " "}, {"text": "line"}, {"text": " "}, {"text": "regimen"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "not"}, {"text": " "}, {"text": "recommended"}, {"text": " "}, {"text": "because"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "client"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "considered"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "be"}, {"text": " "}, {"text": "on DTG"}, {"text": " "}, {"text": "monotherapy"}, {"text": " "}, {"text": "leading"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "development"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "DTG"}, {"text": " "}, {"text": "resistance,"}, {"text": " "}, {"text": "which"}, {"text": " "}, {"text": "compromises"}, {"text": " "}, {"text": "DTG"}, {"text": " "}, {"text": "efficacy"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "its"}, {"text": " "}, {"text": "future"}, {"text": " "}, {"text": "use"}], "list": {"level": 0, "numberingId": "1731"}}, {"id": "body-05031-textbox1-00003", "type": "paragraph", "style": "BodyText", "text": "Delayed diagnosis of treatment failure results in accumulation of resistance associated mutations (RAMs). Some of these RAMs compromise efficacy of drugs with similar resistance patterns for future use such as cross resistance between Abacavir (ABC) and TDF, and Atazanavir (ATV) and Darunavir (DRV). HCP should therefore exercise early detection and manage treatment failure.", "runs": [{"text": "Delayed diagnosis of treatment failure results in accumulation of resistance associated mutations (RAMs). Some of"}, {"text": " "}, {"text": "these"}, {"text": " "}, {"text": "RAMs"}, {"text": " "}, {"text": "compromise"}, {"text": " "}, {"text": "efficacy"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "drugs"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "similar"}, {"text": " "}, {"text": "resistance"}, {"text": " "}, {"text": "patterns"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "future"}, {"text": " "}, {"text": "use"}, {"text": " "}, {"text": "such"}, {"text": " "}, {"text": "as"}, {"text": " "}, {"text": "cross"}, {"text": " "}, {"text": "resistance between Abacavir (ABC) and TDF, and Atazanavir (ATV) and Darunavir (DRV). HCP should therefore exercise early detection and manage treatment failure."}], "list": {"level": 0, "numberingId": "1731"}}, {"id": "body-05031-textbox1-00004", "type": "paragraph", "style": "BodyText", "text": "RoC who received a PI-based regimen as their first line of treatment can be switched to a DTG-based regimen as a potential option for their second line of treatment.", "runs": [{"text": "RoC"}, {"text": " "}, {"text": "who"}, {"text": " "}, {"text": "received"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "PI-based"}, {"text": " "}, {"text": "regimen"}, {"text": " "}, {"text": "as"}, {"text": " "}, {"text": "their"}, {"text": " "}, {"text": "first"}, {"text": " "}, {"text": "line"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "treatment"}, {"text": " "}, {"text": "can"}, {"text": " "}, {"text": "be"}, {"text": " "}, {"text": "switched"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "DTG-based"}, {"text": " "}, {"text": "regimen"}, {"text": " "}, {"text": "as a potential option for their second line of treatment."}], "list": {"level": 0, "numberingId": "1731"}}], "source": {"file": "medical.docx", "chapter": "Management of hiv and aids", "start": "body-05026", "end": "body-05031-textbox1-00004"}}