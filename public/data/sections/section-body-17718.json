{"id": "section-body-17718", "title": "Cervicofacial necrotizing fasciitis", "chapterId": "chapter-sixteen", "blocks": [{"id": "body-17718", "type": "heading", "style": "Heading2", "text": "Cervicofacial necrotizing fasciitis", "runs": [{"text": "Cervicofacial"}, {"text": " "}, {"text": "necrotizing"}, {"text": " "}, {"text": "fasciitis"}], "level": 2, "list": {"level": 1, "numberingId": "1126"}}, {"id": "body-17719", "type": "paragraph", "style": "BodyText", "text": "Necrotizing fasciitis (NF) is a life-threatening polymicrobial soft tissue infection characterized by rapid and progressive necrotizing process of the subcutaneous tissues, fats and fascial planes, with resulting skin gangrene and systemic toxicity.", "runs": [{"text": "Necrotizing"}, {"text": " "}, {"text": "fasciitis"}, {"text": " "}, {"text": "(NF)"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "life-threatening"}, {"text": " "}, {"text": "polymicrobial"}, {"text": " "}, {"text": "soft"}, {"text": " "}, {"text": "tissue"}, {"text": " "}, {"text": "infection"}, {"text": " "}, {"text": "characterized"}, {"text": " "}, {"text": "by"}, {"text": " "}, {"text": "rapid"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "progressive necrotizing process of the subcutaneous tissues, fats and fascial planes, with resulting skin gangrene and systemic toxicity."}]}, {"id": "body-17722", "type": "heading", "style": "Heading4", "text": "Clinical Presentation", "runs": [{"text": "Clinical"}, {"text": " "}, {"text": "Presentation"}], "level": 4}, {"id": "body-17723", "type": "paragraph", "style": "ListParagraph", "text": "Toothache or recent dental infection/extraction", "runs": [{"text": "Toothache"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "recent"}, {"text": " "}, {"text": "dental"}, {"text": " "}, {"text": "infection/extraction"}], "list": {"level": 0, "numberingId": "1115"}}, {"id": "body-17724", "type": "paragraph", "style": "ListParagraph", "text