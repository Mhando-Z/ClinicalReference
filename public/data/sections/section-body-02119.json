{"id": "section-body-02119", "title": "Pain Management (Acute and Chronic Pain Management)", "chapterId": "chapter-two", "blocks": [{"id": "body-02119", "type": "heading", "style": "Heading2", "text": "Pain Management (Acute and Chronic Pain Management)", "runs": [{"text": "Pain"}, {"text": " "}, {"text": "Management"}, {"text": " "}, {"text": "(Acute"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "Chronic"}, {"text": " "}, {"text": "Pain"}, {"text": " "}, {"text": "Management)"}], "level": 2, "list": {"level": 1, "numberingId": "1850"}}, {"id": "body-02120", "type": "paragraph", "style": "BodyText", "text": "Pain is an unpleasant sensory and emotional experience associated with actual or potential tissue damage. The relationship between pain (subjective) and actual or potential tissue damage (objective) is influenced by socio-cultural context as well as the nervous system.", "runs": [{"text": "Pain"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "an"}, {"text": " "}, {"text": "unpleasant"}, {"text": " "}, {"text": "sensory"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "emotional"}, {"text": " "}, {"text": "experience"}, {"text": " "}, {"text": "associated"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "actual"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "potential"}, {"text": " "}, {"text": "tissue"}, {"text": " "}, {"text": "damage."}, {"text": " "}, {"text": "The"}, {"text": " "}, {"text": "relationship between pain (subjective) and actual or potential tissue damage (objective) is influenced by socio-cultural context as well as the nervous system."}]}, {"id": "body-02122", "type": "heading", "style": "Heading4", "text": "Perioperative Analgesia:", "runs": [{"text": "Perioperative"}, {"text": " "}, {"text": "Analgesia:"}], "level": 4}, {"id": "body-02123", "type": "paragraph", "style": "BodyText", "text": "Multimodal approach; IM/ IV analgesics and/or a central neuraxial or locoregional anaesthetic block