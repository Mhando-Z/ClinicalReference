entifying"}, {"text": " "}, {"text": "bone"}, {"text": " "}, {"text": "marrow"}, {"text": " "}, {"text": "edema"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "early"}, {"text": " "}, {"text": "erosions."}], "list": {"level": 5, "numberingId": "105"}}, {"id": "body-29125", "type": "heading", "style": "Heading4", "text": "Diagnosis", "runs": [{"text": "Diagnosis"}], "level": 4}, {"id": "body-29126", "type": "paragraph", "style": "BodyText", "text": "RA is classified by ACR/EULAR 2010 criteria with a score ≥6/10 based on joints, serology, inflammation markers, and symptom duration.", "runs": [{"text": "RA"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "classified"}, {"text": " "}, {"text": "by"}, {"text": " "}, {"text": "ACR/EULAR"}, {"text": " "}, {"text": "2010"}, {"text": " "}, {"text": "criteria"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "score"}, {"text": " "}, {"text": "≥6/10"}, {"text": " "}, {"text": "based"}, {"text": " "}, {"text": "on"}, {"text": " "}, {"text": "joints,"}, {"text": " "}, {"text": "serology,"}, {"text": " "}, {"text": "inflammation"}, {"text": " "}, {"text": "markers,"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "symptom "}, {"text": "duration."}]}, {"id": "body-29128", "type": "heading", "style": "Heading4", "text": "Treatment consideration", "runs": [{"text": "Treatment"}, {"text": " "}, {"text": "consideration"}], "level": 4}, {"id": "body-29129", "type": "paragraph", "style": "ListParagraph", "text": "Assess disease activity using the Disease Activity Score in 28 joints (DAS28), Clinical Disease Activity Index (CDAI), and Simplified Disease Activity Index (SDAI)", "runs": [{"text": "Assess disease activity using the Disease"}, {"text": " "}, {"text": "Activity Score in 28 joints (DAS28), Clinical Disease"}, {"text": " "}, {"text": "Activity Index (CDAI), and Simplified Disease Activity Index (SDAI)"}], "list": {"level": 4, "numberingId": "105"}}, {"id": "