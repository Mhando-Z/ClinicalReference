commended"}]}, {"id": "body-14744", "type": "paragraph", "style": "BodyText", "text": "S: triamcinolone (subtenon) 20mg stat, it can be repeated after 4 weeks if need arise.", "runs": [{"text": "S:", "bold": true}, {"text": " ", "bold": true}, {"text": "triamcinolone"}, {"text": " "}, {"text": "(subtenon)"}, {"text": " "}, {"text": "20mg"}, {"text": " "}, {"text": "stat,"}, {"text": " "}, {"text": "it"}, {"text": " "}, {"text": "can"}, {"text": " "}, {"text": "be"}, {"text": " "}, {"text": "repeated"}, {"text": " "}, {"text": "after"}, {"text": " "}, {"text": "4"}, {"text": " "}, {"text": "weeks"}, {"text": " "}, {"text": "if"}, {"text": " "}, {"text": "need"}, {"text": " "}, {"text": "arise."}]}, {"id": "body-14745", "type": "paragraph", "style": "Heading3", "text": "OR", "runs": [{"text": "OR"}], "level": 3, "conjunction": true}, {"id": "body-14746", "type": "paragraph", "style": "BodyText", "text": "S: methotrexate 20mg weekly (PO) in collaboration with an ocular oncologist", "runs": [{"text": "S:", "bold": true}, {"text": " ", "bold": true}, {"text": "methotrexate"}, {"text": " "}, {"text": "20mg"}, {"text": " "}, {"text": "weekly"}, {"text": " "}, {"text": "(PO)"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "collaboration"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "an"}, {"text": " "}, {"text": "ocular"}, {"text": " "}, {"text": "oncologist"}]}, {"id": "body-14747", "type": "paragraph", "style": "Heading3", "text": "AND", "runs": [{"text": "AND"}], "level": 3, "conjunction": true}, {"id": "body-14748", "type": "paragraph", "style": "BodyText", "text": "Pupil dilating eye drops", "runs": [{"text": "Pupil"}, {"text": " "}, {"text": "dilating"}, {"text": " "}, {"text": "eye"}, {"text": " drops"}]}, {"id": "body-14749", "type": "paragraph", "style": "BodyText", "text": "B: atropine eye drops or ointment 1% 12hourly in the affected eye", "runs": [{"text": "B:", "bold": true}, {"text": " ", "bold": true}, {"text": "atropine"}, {"text": " 