}, {"text": "grade"}, {"text": " "}, {"text": "fever,"}, {"text": " "}, {"text": "39°C"}], "list": {"level": 0, "numberingId": "1518"}}, {"id": "body-08725", "type": "paragraph", "style": "ListParagraph", "text": "Right upper quadrant pain,", "runs": [{"text": "Right"}, {"text": " "}, {"text": "upper"}, {"text": " "}, {"text": "quadrant"}, {"text": " "}, {"text": "pain,"}], "list": {"level": 0, "numberingId": "1518"}}, {"id": "body-08726", "type": "paragraph", "style": "ListParagraph", "text": "Tender and enlarged liver", "runs": [{"text": "Tender"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "enlarged"}, {"text": " "}, {"text": "liver"}], "list": {"level": 0, "numberingId": "1518"}}, {"id": "body-08728", "type": "paragraph", "style": "ListParagraph", "text": "Positive imaging evidence of liver abscess", "runs": [{"text": "Positive"}, {"text": " "}, {"text": "imaging"}, {"text": " "}, {"text": "evidence"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "liver"}, {"text": " "}, {"text": "abscess"}], "list": {"level": 0, "numberingId": "1529"}}, {"id": "body-08729", "type": "paragraph", "style": "ListParagraph", "text": "Serological evidence of E. histolytica antibodies or antigens", "runs": [{"text": "Serological evidence of "}, {"text": "E. histolytica ", "italic": true}, {"text": "antibodies or antigens"}], "list": {"level": 0, "numberingId": "1529"}}, {"id": "body-08731", "type": "heading", "style": "Heading4", "text": "Pharmacological Management", "runs": [{"text": "Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-08732", "type": "paragraph", "style": "BodyText", "text": "B: metronidazole (IV) 800mg 8hourly for 10days.", "runs": [{"text": "B:", "bold": true}, {"text": " ", "bold": true}, {"text": "metronidazole"}, {"text": " "}, {"text": "(IV)"}, {"text": " "}, {"text": "800mg"}, {"text": " "}, {"text": "8hourly"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "10days."}]}, {"id": "body-08733", "t