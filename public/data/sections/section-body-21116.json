{"id": "section-body-21116", "title": "Non-ST Elevation Myocardial Infarction (NSTEMI)", "chapterId": "chapter-twenty", "tocLevel": 4, "tocPath": ["APPROACH TO PATIENTS WITH EMERGENCY CONDITIONS", "CARDIOVASCULAR DISEASE CONDITIONS", "Acute Coronary Syndrome", "Non-ST Elevation Myocardial Infarction (NSTEMI)"], "blocks": [{"id": "body-21116", "type": "heading", "style": "Heading4", "text": "Non-ST Elevation Myocardial Infarction (NSTEMI)", "runs": [{"text": "Non-ST"}, {"text": " "}, {"text": "Elevation"}, {"text": " "}, {"text": "Myocardial"}, {"text": " "}, {"text": "Infarction"}, {"text": " "}, {"text": "(NSTEMI)"}], "level": 4, "list": {"level": 2, "numberingId": "781"}}, {"id": "body-21117", "type": "paragraph", "style": "BodyText", "text": "Non-ST Elevation Myocardial Infarction is a medical emergency characterized with chest pain that is increasing in frequency and/or severity or occurring at rest, associated with elevated cardiac enzymes and ST segment depression or T wave inversion or normal ECG.", "runs": [{"text": "Non-ST Elevation Myocardial Infarction is a medical emergency characterized with chest pain that is increasing in frequency and/or"}, {"text": " "}, {"text": "severity"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "occurring"}, {"text": " "}, {"text": "at"}, {"text": " "}, {"text": "rest,"}, {"text": " "}, {"text": "associated"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "elevated"}, {"text": " "}, {"text": "cardiac"}, {"text": " "}, {"text": "enzymes"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "ST"}, {"text": " "}, {"text": "segment"}, {"text": " "}, {"text": "depression"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "T"}, {"text": " "}, {"text": "wave"}, {"text": " "}, {"text": "inversion or normal ECG."}]}, {"id": "body-21119", "type": "heading", "style": "Heading4", "text": "Diagnostic Criteria", "runs": [{"text": "Diagnostic"}, {"text": " "}, {"text": "Criteria"}], "level": 4}, {"id": "body-21120", "type": "paragraph", "style": "BodyText", "text": "Presents with typical chest pain with the following additional characteristics.", "runs": [{"text": "Presents"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "typical"}, {"text": " "}, {"text": "chest"}, {"text": " "}, {"text": "pain"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "following"}, {"text": " "}, {"text": "additional"}, {"text": " "}, {"text": "characteristics."}]}, {"id": "body-21121", "type": "paragraph", "style": "ListParagraph", "text": "Electrocardiogram (ECG) may show ST segment depression or transient ST segment elevation, or normal ECG does not exclude the diagnosis (serial ECG is important).", "runs": [{"text": "Electrocardiogram (ECG) may show ST segment depression or transient ST segment elevation, or normal ECG does not exclude the diagnosis (serial ECG is important)."}], "list": {"level": 0, "numberingId": "685"}}, {"id": "body-21122", "type": "paragraph", "style": "ListParagraph", "text": "Raised Cardiac Biomarker’s – Total Creatine Kinase (Total-CK), Creatine Kinase - MB (CK- MB) and standard/highly sensitive Troponin I or T.", "runs": [{"text": "Raised Cardiac Biomarker’s – Total Creatine Kinase (Total-CK), Creatine Kinase - MB (CK- MB) and standard/highly sensitive Troponin I or T."}], "list": {"level": 0, "numberingId": "685"}}, {"id": "body-21123", "type": "heading", "style": "Heading4", "text": "Non-Pharmacological Management", "runs": [{"text": "Non-Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-21124", "type": "paragraph", "style": "BodyText", "text": "Both UA and NSTEMI are medical emergencies with the same pathophysiological progressive instability of CAD, which share similar management approach.", "runs": [{"text": "Both UA and NSTEMI are medical"}, {"text": " "}, {"text": "emergencies with the same pathophysiological"}, {"text": " "}, {"text": "progressive instability of CAD, which share similar management approach."}]}, {"id": "body-21125", "type": "paragraph", "style": "BodyText", "text": "Supportive Therapy", "runs": [{"text": "Supportive"}, {"text": " "}, {"text": "Therapy"}]}, {"id": "body-21126", "type": "paragraph", "style": "ListParagraph", "text": "Admit patient into high dependent ward/ICU/CCU for hemodynamic monitoring, bed rest in Fowler’s position and reassurance.", "runs": [{"text": "Admit"}, {"text": " "}, {"text": "patient"}, {"text": " "}, {"text": "into"}, {"text": " "}, {"text": "high"}, {"text": " "}, {"text": "dependent"}, {"text": " "}, {"text": "ward/ICU/CCU"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "hemodynamic"}, {"text": " "}, {"text": "monitoring,"}, {"text": " "}, {"text": "bed"}, {"text": " "}, {"text": "rest"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "Fowler’s"}, {"text": " "}, {"text": "position"}, {"text": " "}, {"text": "and "}, {"text": "reassurance."}], "list": {"level": 0, "numberingId": "685"}}, {"id": "body-21127", "type": "paragraph", "style": "ListParagraph", "text": "Oxygen via nasal blog cannula or face mask if saturation < 92%.", "runs": [{"text": "Oxygen"}, {"text": " "}, {"text": "via"}, {"text": " "}, {"text": "nasal"}, {"text": " "}, {"text": "blog"}, {"text": " "}, {"text": "cannula"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "face"}, {"text": " "}, {"text": "mask"}, {"text": " "}, {"text": "if"}, {"text": " "}, {"text": "saturation"}, {"text": " "}, {"text": "<"}, {"text": " "}, {"text": "92%."}], "list": {"level": 0, "numberingId": "685"}}, {"id": "body-21128", "type": "paragraph", "style": "ListParagraph", "text": "Establish Peripheral Intravenous line for intravenous fluid or drug administration.", "runs": [{"text": "Establish"}, {"text": " "}, {"text": "Peripheral"}, {"text": " "}, {"text": "Intravenous"}, {"text": " "}, {"text": "line"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "intravenous"}, {"text": " "}, {"text": "flui