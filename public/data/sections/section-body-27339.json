"settings"}, {"text": " "}, {"text": "but"}, {"text": " "}, {"text": "becomes"}, {"text": " "}, {"text": "mute"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "specific"}, {"text": " "}, {"text": "situations"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "around"}, {"text": " "}, {"text": "certain "}, {"text": "people"}], "list": {"level": 0, "numberingId": "330"}}], "colspan": 1, "rowspan": 1, "column": 1}], "header": false}], "columns": 2}, {"id": "body-27360", "type": "paragraph", "style": "BodyText", "text": "Management of Anxiety Disorders in Children treatment plan that works best for the child and family should be developed with a multidisciplinary approach. In the treatment of very young children, involving parents and other important caregivers is crucial, and when appropriate, the school can also be included in the management process.", "runs": [{"text": "Management"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "Anxiety"}, {"text": " "}, {"text": "Disorders"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "Children"}, {"text": " "}, {"text": "treatment"}, {"text": " "}, {"text": "plan"}, {"text": " "}, {"text": "that"}, {"text": " "}, {"text": "works"}, {"text": " "}, {"text": "best"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "child"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "family"}, {"text": " "}, {"text": "should"}, {"text": " "}, {"text": "be"}, {"text": " "}, {"text": "developed"}, {"text": " "}, {"text": "with a"}, {"text": " "}, {"text": "multidisciplinary"}, {"text": " "}, {"text": "approach."}, {"text": " "}, {"text": "In"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "treatment"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "very"}, {"text": " "}, {"text": "young"}, {"text": " "}, {"text": "children,"}, {"text": " "}, {"text": "involving"}, {"text": " "}, {"text": "parents"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "other"}, {"text": " "}, {"text": "important"}, {"text": " "}, {"text": "caregivers"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "crucial, and when appropriate, the school can also be included in the management process."}]}, {"id": "body-27362", "type": "paragraph", "style": "BodyText", "text": "The Mainstay of treatment of mild to moderate anxiety disorders in children is psychotherapy. Various psychotherapeutic interventions are effective, including:", "runs": [{"text": "The"}, {"text": " "}, {"text": "Mainstay"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "treatment"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "mild"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "moderate"}, {"text": " "}, {"text": "anxiety"}, {"text": " "}, {"text": "disorders"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "children"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "psychotherapy."}, {"text": " "}, {"text": "Various"}, {"text": " "}, {"text": "psychotherapeutic interventions are effective, including:"}]}, {"id": "body-27364", "type": "paragraph", "style": "ListParagraph", "text": "Cognitive behaviour therapy (CBT),", "runs": [{"text": "Cognitive"}, {"text": " "}, {"text": "behaviour"}, {"text": " "}, {"text": "therapy"}, {"text": " "}, {"text": "(CBT),"}], "list": {"level": 1, "numberingId": "332"}}, {"id": "body-27365", "type": "paragraph", "style": "ListParagraph", "text": "Problem-solving therapy,", "runs": [{"text": "Problem-solving"}, {"text": " "}, {"text": "therapy,"}], "list": {"level": 1, "numberingId": "332"}}, {"id": "body-27366", "type": "paragraph", "style": "ListParagraph", "text": "Psychodynamic psychotherapy,", "runs": [{"text": "Psychodynamic"}, {"text": " "}, {"text": "psychotherapy,"}], "list": {"level": 1, "numberingId": "332"}}, {"id": "body-27367", "type": "paragraph", "style": "ListParagraph", "text": "\nFamily therapy,", "runs": [{"text": "\n"}, {"text": "Family"}, {"text": " "}, {"text": "therapy,"}], "list": {"level": 1, "numberingId": "332"}}, {"id": "body-27368", "type": "paragraph", "style": "ListParagraph", "text": "Relaxation techniques.", "runs": [{"text": "Relaxation"}, {"text": " "}, {"text": "techniques."}], "list": {"level": 1, "numberingId": "332"}}, {"id": "body-27371", "type": "paragraph", "style": "BodyText", "text": "It's important to tailor the supportive therapy approach to each child's unique needs and consider the severity of their anxiety symptoms. Additionally, involving parents and caregivers in the therapeutic process enhances the overall effectiveness of anxiety management strategies for children", "runs": [{"text": "It's important to tailor the supportive therapy approach to each child's unique needs and consider the severity of their anxiety symptoms. Additionally, involving parents and caregivers in the therapeutic process enhances the overall effectiveness of anxiety management strategies for children"}]}, {"id": "body-27373", "type": "heading", "style": "Heading4", "text": "Pharmacological Management", "runs": [{"text": "Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-27374", "type": "paragraph", "style": "BodyText", "text": "Medication is only prescribed for severe anxiety. A combination of medication and psychotherapy has better outcomes than either of the interventions alone", "runs": [{"text": "Medication is only prescribed for severe anxiety. A combination of medication and psychotherapy has better outcomes than either of the interventions alone"}]}, {"id": "body-27376", "type": "paragraph", "style": "BodyText", "text": "S: fluoxetine (PO), 10-40mg", "runs": [{"text": "S:", "bold": true}, {"text": " ", "bold": true}, {"text": "fluoxetine"}, {"text": " "}, {"text": "(PO),"}, {"text": " "}, {"text": "10-"}, {"text": "40mg"}]}, {"id": "body-27377", "type": "paragraph", "style": "Heading3", "text": "OR", "runs": [{"text": "OR"}], "level": 3, "conjunction": true}, {"id":