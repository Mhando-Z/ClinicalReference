{"id": "section-body-07591", "title": "Whooping Cough", "chapterId": "chapter-nine", "tocLevel": 4, "tocPath": ["APPROACH TO PATIENTS WITH EMERGENCY CONDITIONS", "RESPIRATORY DISEASE CONDITIONS", "Other Respiratory Infections", "Whooping Cough"], "blocks": [{"id": "body-07591", "type": "heading", "style": "Heading4", "text": "Whooping Cough", "runs": [{"text": "Whooping"}, {"text": " "}, {"text": "Cough"}], "level": 4, "list": {"level": 2, "numberingId": "1603"}}, {"id": "body-07592", "type": "paragraph", "style": "BodyText", "text": "It is a highly infectious childhood disease caused by Bordetella pertussis. It is most severe in young infants who have not yet been immunized.", "runs": [{"text": "It"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "highly"}, {"text": " "}, {"text": "infectious"}, {"text": " "}, {"text": "childhood"}, {"text": " "}, {"text": "disease"}, {"text": " "}, {"text": "caused"}, {"text": " "}, {"text": "by"}, {"text": " "}, {"text": "Bordetella", "italic": true}, {"text": " ", "italic": true}, {"text": "pertussis", "italic": true}, {"text": "."}, {"text": " "}, {"text": "It"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "most"}, {"text": " "}, {"text": "severe"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "young"}, {"text": " "}, {"text": "infants"}, {"text": " "}, {"text": "who"}, {"text": " "}, {"text": "have"}, {"text": " "}, {"text": "not"}, {"text": " "}, {"text": "yet been immunized."}]}, {"id": "body-07594", "type": "heading", "style": "Heading4", "text": "Clinical Presentation", "runs": [{"text": "Clinical"}, {"text": " "}, {"text": "Presentation"}], "level": 4}, {"id": "body-07595", "type": "paragraph", "style": "BodyText", "text": "Paroxysmal cough associated with a whoop, Fever, Nasal discharge.", "runs": [{"text": "Paroxysmal"}, {"text": " "}, {"text": "cough"}, {"text": " "}, {"text": "associated"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "whoop,"}, {"text": " "}, {"text": "Fever,"}, {"text": " "}, {"text": "Nasal"}, {"text": " "}, {"text": "discharge."}]}, {"id": "body-07597", "type": "heading", "style": "Heading4", "text": "Non-Pharmacological Management", "runs": [{"text": "Non-Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-07598", "type": "paragraph", "style": "ListParagraph", "text": "Place the child head down and prone, or on the side, to prevent any inhaling of vomitus and to aid expectoration of secretions.", "runs": [{"text": "Place the child head down and prone,"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "on the side,"}, {"text": " "}, {"text": "to prevent"}, {"text": " "}, {"text": "any"}, {"text": " "}, {"text": "inhaling of"}, {"text": " "}, {"text": "vomitus"}, {"text": " "}, {"text": "and to aid expectoration of "}, {"text": "secretions."}], "list": {"level": 0, "numberingId": "1597"}}, {"id": "body-07599", "type": "paragraph", "style": "ListParagraph", "text": "Care for the airway but avoid, as far as possible, any procedure that could trigger coughing, such as application of suction, throat examination", "runs": [{"text": "Care for the airway but avoid, as far as possible, any procedure that could trigger coughing, such as application of suction, throat examination"}], "list": {"level": 0, "numberingId": "1597"}}, {"id": "body-07600", "type": "paragraph", "style": "ListParagraph", "text": "Do not give cough suppressants, sedatives, mucolytic agents or anti-histamines.", "runs": [{"text": "Do"}, {"text": " "}, {"text": "not"}, {"text": " "}, {"text": "give"}, {"text": " "}, {"text": "cough"}, {"text": " "}, {"text": "suppressants,"}, {"text": " "}, {"text": "sedatives,"}, {"text": " "}, {"text": "mucolytic"}, {"text": " "}, {"text": "agents"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "anti-"}, {"text": "histamines."}], "list": {"level": 0, "numberingId": "1597"}}, {"id": "body-07601", "type": "paragraph", "style": "ListParagraph", "text": "If the child has fever (>38.50C) give paracetamol.", "runs": [{"text": "If"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "child"}, {"text": " "}, {"text": "has"}, {"text": " "}, {"text": "fever"}, {"text": " "}, {"text": "(>38.5"}, {"text": "0", "vertical": "superscript"}, {"text": "C)"}, {"text": " "}, {"text": "give"}, {"text": " "}, {"text": "paracetamol."}], "list": {"level": 0, "numberingId": "1597"}}, {"id": "body-07602", "type": "paragraph", "style": "ListParagraph", "text": "Encourage breastfeeding or oral fluids", "runs": [{"text": "Encourage"}, {"text": " "}, {"text": "breastfeeding"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "oral"}, {"text": " "}, {"text": "fluids"}], "list": {"level": 0, "numberingId": "1597"}}, {"id": "body-07603", "type": "paragraph", "style": "ListParagraph", "text": "Whooping cough is preventable by immunization with pertussis vaccine contained in DPT- Hep B-Hib vaccine at week 6, 10 and 14.", "runs": [{"text": "Whooping cough is preventable by immunization with pertussis vaccine contained in DPT- Hep B-Hib vaccine at week 6, 10 and 14."}], "list": {"level": 0, "numberingId": "1597"}}, {"id": "body-07604", "type": "paragraph", "style": "ListParagraph", "text": "Give oxygen to children who have spells of apnoea or cyanosis, or severe paroxysms of coughing.", "runs": [{"text": "Give"}, {"text": " "}, {"text": "oxygen"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "children"}, {"text": " "}, {"text": "who"}, {"text": " "}, {"text": "have"}, {"text": " "}, {"text": "spells"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "apnoea"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "cyanosis,"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "severe"}, {"text": " "}, {"text": "paroxysms"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "coughing."}], "list": {"level": 0, "numberingId": "1597"}}, {"id": "body-07605", "type": "paragraph", "style": "ListParagraph", "text": "Use nasal prongs, not a nasopharyngeal catheter or nasal catheter which can provoke coughing.", "runs": [{"text": "Use"}, {"text": " "}, {"text": "nasal"}, {"text": " "}, {"text": "prongs,"}, {"text": " "}, {"text": "not"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "nasopharyngeal"}, {"text": " "}, {"text": "catheter"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "nasal"}, {"text": " "}, {"text": "catheter"}, {"text": " "}, {"text": "which"}, {"text": " "}, {"text": "can"}, {"text": " "}, {"text": "provoke"}, {"text": " "}, {"text": "coughing."}], "list": {"level": 0, "numberingId": "1597"}}, {"id": "body-07606", "type": "heading", "style": "Heading4", "text": "Pharmacological Management", "runs": [{"text": "Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-07607", "type": "paragraph", "style": "BodyText", "text": "A: erythromycin (PO) 12.5 mg/kg 6hourly for 10days.", "runs": [{"text": "A:", "bold": true}, {"text": " ", "bold": true}, {"text": "erythromycin"}, {"text": " "}, {"text": "(PO)"}, {"text": " "}, {"text": "12.5"}, {"text": " "}, {"text": "mg/kg"}, {"text": " "}, {"text": "6hourly"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "10days."}]}, {"id": "body-07608", "type": "paragraph", "style": "BodyText", "text": "This does not shorten the illness but reduces the period of infectiousness If there is fever", "runs": [{"text": "This"}, {"text": " "}, {"text": "does"}, {"text": " "}, {"text": "not"}, {"text": " "}, {"text": "shorten"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "illness"}, {"text": " "}, {"text": "but"}, {"text": " "}, {"text": "reduces"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "period"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "infectiousness If there is fever"}]}, {"id": "body-07610", "type": "paragraph", "style": "BodyText", "text": "In Children older than age 2 months:", "runs": [{"text": "In"}, {"text": " "}, {"text": "Children"}, {"text": " "}, {"text": "older"}, {"text": " "}, {"text": "than"}, {"text": " "}, {"text": "age"}, {"text": " "}, {"text": "2"}, {"text": " "}, {"text": "months:"}]}, {"id": "body-07611", "type": "paragraph", "style": "BodyText", "text": "A: trimethoprim + sulfamethoxazole (FDC) (PO) 8mg+40mg/kg 12hourly for 7-14days", "runs": [{"text": "A:", "bold": true}, {"text": " ", "bold": true}, {"text": "trimethoprim"}, {"text": " "}, {"text": "+"}, {"text": " "}, {"text": "sulfamethoxazole"}, {"text": " "}, {"text": "(FDC)"}, {"text": " "}, {"text": "(PO)"}, {"text": " "}, {"text": "8mg+40mg/kg"}, {"text": " "}, {"text": "12hourly"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "7-"}, {"text": "14days"}]}], "source": {"file": "medical.docx", "chapter": "Respiratory disease conditions", "start": "body-07591", "end": "body-07611"}}