acological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-13057", "type": "paragraph", "style": "BodyText", "text": "A: benzoyl peroxide (topical) 10% 24hourly for 4-8 weeks", "runs": [{"text": "A:", "bold": true}, {"text": " ", "bold": true}, {"text": "benzoyl"}, {"text": " "}, {"text": "peroxide"}, {"text": " "}, {"text": "(topical)"}, {"text": " "}, {"text": "10%"}, {"text": " "}, {"text": "24hourly"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "4-8"}, {"text": " "}, {"text": "weeks"}]}, {"id": "body-13058", "type": "paragraph", "style": "Heading3", "text": "OR", "runs": [{"text": "OR"}], "level": 3, "conjunction": true}, {"id": "body-13059", "type": "paragraph", "style": "BodyText", "text": "S: tretinoin cream (topical) 0.5% at night for 4-8 week", "runs": [{"text": "S", "bold": true}, {"text": ":"}, {"text": " "}, {"text": "tretinoin"}, {"text": " "}, {"text": "cream"}, {"text": " "}, {"text": "(topical)"}, {"text": " "}, {"text": "0.5%"}, {"text": " "}, {"text": "at"}, {"text": " "}, {"text": "night"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "4-8"}, {"text": " week"}]}, {"id": "body-13060", "type": "paragraph", "style": "Heading3", "text": "OR", "runs": [{"text": "OR"}], "level": 3, "conjunction": true}, {"id": "body-13061", "type": "paragraph", "style": "BodyText", "text": "S: imiquimod cream (topical) 3 times per week for 8-16 weeks", "runs": [{"text": "S:", "bold": true}, {"text": " ", "bold": true}, {"text": "imiquimod"}, {"text": " "}, {"text": "cream"}, {"text": " "}, {"text": "(topical)"}, {"text": " "}, {"text": "3"}, {"text": " "}, {"text": "times"}, {"text": " "}, {"text": "per"}, {"text": " "}, {"text": "week"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "8-16"}, {"text": " "}, {"text": "weeks"}]}], "source": {"file": "medical.docx", "chapter": "Skin diseases", "start": "body-13040", "end": "body-13061"}}