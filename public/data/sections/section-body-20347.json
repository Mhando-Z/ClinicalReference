 or SC) 1mg stat adults, children/adolescents 0.02 -0.03mg/kg/dose may be repeated after 15min", "runs": [{"text": "S:", "bold": true}, {"text": " ", "bold": true}, {"text": "glucagon"}, {"text": " "}, {"text": "(IM"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "SC)"}, {"text": " "}, {"text": "1mg"}, {"text": " "}, {"text": "stat"}, {"text": " "}, {"text": "adults,"}, {"text": " "}, {"text": "children/adolescents"}, {"text": " "}, {"text": "0.02"}, {"text": " "}, {"text": "-0.03mg/kg/dose"}, {"text": " "}, {"text": "may"}, {"text": " "}, {"text": "be"}, {"text": " "}, {"text": "repeated"}, {"text": " "}, {"text": "after"}, {"text": " "}, {"text": "15min"}]}, {"id": "body-20391", "type": "paragraph", "style": "BodyText", "text": "Neonatal hyperinsulinemia hypoglycemia 1mg/dose (SC) stat, continuous IV infusion 1-20mcg/kg/hour. Refer to neonatal chapter for diazoxide", "runs": [{"text": "Neonatal"}, {"text": " "}, {"text": "hyperinsulinemia"}, {"text": " "}, {"text": "hypoglycemia"}, {"text": " "}, {"text": "1mg/dose"}, {"text": " "}, {"text": "(SC)"}, {"text": " "}, {"text": "stat,"}, {"text": " "}, {"text": "continuous"}, {"text": " "}, {"text": "IV"}, {"text": " "}, {"text": "infusion"}, {"text": " "}, {"text": "1-20mcg/kg/hour."}, {"text": " "}, {"text": "Refer"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "neonatal chapter for diazoxide"}]}, {"id": "body-20392-textbox1-00001", "type": "paragraph", "style": "BodyText", "text": "Note: If IV access is impossible, consider nasogastric tube or rectal glucose", "runs": [{"text": "Note:", "bold": true}, {"text": " ", "bold": true}, {"text": "If"}, {"text": " "}, {"text": "IV"}, {"text": " "}, {"text": "access"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "impossible,"}, {"text": " "}, {"text": "consider"}, {"text": " "}, {"text": "nasogastric"}, {"text": " "}, {"text": "tube"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "rectal"}, {"text": " "}, {"text": "glucose"}]}, {"id": "body-20394", "type": "heading", "style": "Heading4", "text": "On Recovery", "runs": [{"text": "On"}, {"text": " "}, {"text": "Recovery"}], "level": 4}, {"id": "body-20395", "type": "paragraph", "style": "ListParagraph", "text": "Give long-acting carbohydrate snack e.g. a piece of bread", "runs": [{"text": "Give"}, {"text": " "}, {"text": "long-acting"}, {"text": " "}, {"text": "carbohydrate"}, {"text": " "}, {"text": "snack"}, {"text": " "}, {"text": "e.g."}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "piece"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "bread"}], "list": {"level": 1, "numberingId": "878"}}, {"id": "body-20396", "type": "paragraph", "style": "ListParagraph", "text": "Identify the cause of hypoglycemia and correct it", "runs": [{"text": "Identify"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "cause"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "hypoglycemia"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "correct"}, {"text": " "}, {"text": "it"}], "list": {"level": 1, "numberingId": "878"}}, {"id": "body-20397", "type": "paragraph", "style": "ListParagraph", "text": "If hypoglycemia is a result of long acting sulphonylureas, insulin or alcohol, frequently monitor blood glucose (2hourly) and give IV dextrose infusion (5–10%) for 12– 24 hours", "runs": [{"text": "If hypoglycemia is a result of long acting sulphonylureas, insulin or alcohol, frequently monitor blood glucose (2hourly) and give IV dextrose infusion (5–10%) for 12– 24 hours"}], "list": {"level": 1, "numberingId": "878"}}, {"id": "body-20398", "type": "paragraph", "style": "ListParagraph", "text": "If patient is not responding look for another cause or refer.", "runs": [{"text": "If"}, {"text": " "}, {"text": "patient"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "not"}, {"text": " "}, {"text": "responding"}, {"text": " "}, {"text": "look"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "another"}, {"text":