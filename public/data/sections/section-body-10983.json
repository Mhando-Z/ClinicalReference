{"id": "section-body-10983", "title": "Chronic Hypertension", "chapterId": "chapter-eleven", "tocLevel": 4, "tocPath": ["APPROACH TO PATIENTS WITH EMERGENCY CONDITIONS", "OBSTETRICS, GYNECOLOGY AND CONTRACEPTION", "Antenatal Care", "Chronic Hypertension"], "blocks": [{"id": "body-10983", "type": "heading", "style": "Heading4", "text": "Chronic Hypertension", "runs": [{"text": "Chronic"}, {"text": " "}, {"text": "Hypertension"}], "level": 4, "list": {"level": 3, "numberingId": "1452"}}, {"id": "body-10984", "type": "paragraph", "style": "BodyText", "text": "This is hypertension that is present at the booking visit or before 20 weeks or if the woman is already hypertensive before conception. Most women with chronic hypertension are asymptomatic. New onset chronic hypertension should have further evaluation to find underlying cause e.g., renal artery stenosis, chronic renal disease, Cushing syndrome etc.", "runs": [{"text": "This is hypertension that is present at the booking visit or before 20 weeks or if the woman is already hypertensive before conception. Most women with chronic hypertension are asymptomatic. New onset chronic hypertension should have further evaluation to find underlying cause e.g., renal artery stenosis, chronic renal disease, Cushing syndrome etc."}]}, {"id": "body-10986", "type": "heading", "style": "Heading4", "text": "Pharmacological Management", "runs": [{"text": "Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-10987", "type": "paragraph", "style": "BodyText", "text": "A: methyldopa (PO) 250–500mg 8hourly", "runs": [{"text": "A:", "bold": true}, {"text": " ", "bold": true}, {"text": "methyldopa"}, {"text": " "}, {"text": "(PO)"}, {"text": " "}, {"text": "250–500mg"}, {"text": " "}, {"text": "8hourly"}]}, {"id": "body-10988", "type": "paragraph", "style": "Heading3", "text": "AND", "runs": [{"text": "AND"}], "level": 3, "conjunction": true}, {"id": "body-10989", "type": "paragraph", "style": "BodyText", "text": "A: nifedipine (PO) 20mg 12hourly", "runs": [{"text": "A:", "bold": true}, {"text": " ", "bold": true}, {"text": "nifedipine"}, {"text": " "}, {"text": "(PO)"}, {"text": " "}, {"text": "20mg"}, {"text": " "}, {"text": "12hourly"}]}, {"id": "body-10991", "type": "paragraph", "style": "BodyText", "text": "For eclampsia prophylaxis, consider adding:", "runs": [{"text": "For"}, {"text": " "}, {"text": "eclampsia"}, {"text": " "}, {"text": "prophylaxis,"}, {"text": " "}, {"text": "consider"}, {"text": " "}, {"text": "adding:"}]}, {"id": "body-10992", "type": "paragraph", "style": "BodyText", "text": "A: acetylsalicylic acid 75 mg 24hourly", "runs": [{"text": "A:", "bold": true}, {"text": " ", "bold": true}, {"text": "acetylsalicylic"}, {"text": " "}, {"text": "acid"}, {"text": " "}, {"text": "75"}, {"text": " "}, {"text": "mg"}, {"text": " "}, {"text": "24hourly"}]}, {"id": "body-10993", "type": "paragraph", "style": "Heading3", "text": "AND", "runs": [{"text": "AND"}], "level": 3, "conjunction": true}, {"id": "body-10994", "type": "paragraph", "style": "BodyText", "text": "C: calcium + vitamin D 1 tab/1 cap 24hourly", "runs": [{"text": "C:", "bold": true}, {"text": " ", "bold": true}, {"text": "calcium"}, {"text": " "}, {"text": "+"}, {"text": " "}, {"text": "vitamin"}, {"text": " "}, {"text": "D"}, {"text": " "}, {"text": "1"}, {"text": " "}, {"text": "tab/1"}, {"text": " "}, {"text": "cap"}, {"text": " "}, {"text": "24hourly"}]}], "source": {"file": "medical.docx", "chapter": "Obstetrics, gynecology and contraception", "start": "body-10983", "end": "body-10994"}}