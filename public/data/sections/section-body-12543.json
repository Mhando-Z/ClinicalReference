"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "late"}, {"text": " "}, {"text": "syphilis"}, {"text": " "}, {"text": "3"}, {"text": " "}, {"text": "doses"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "benzathine"}, {"text": " "}, {"text": "benzylpenicillin"}, {"text": " "}, {"text": "should"}, {"text": " "}, {"text": "be"}, {"text": " "}, {"text": "provided."}]}, {"id": "body-12558", "type": "heading", "style": "Heading4", "text": "Congenital Syphilis", "runs": [{"text": "Congenital"}, {"text": " "}, {"text": "Syphilis"}], "level": 4, "list": {"level": 2, "numberingId": "1397"}}, {"id": "body-12559", "type": "paragraph", "style": "BodyText", "text": "All infants born to sero-positive mothers should be treated with a single intramuscular dose of benzathine benzylpenicillin, 50000IU/kg whether the mothers were treated during pregnancy (with or without penicillin).", "runs": [{"text": "All"}, {"text": " "}, {"text": "infants"}, {"text": " "}, {"text": "born"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "sero-positive"}, {"text": " "}, {"text": "mothers"}, {"text": " "}, {"text": "should"}, {"text": " "}, {"text": "be"}, {"text": " "}, {"text": "treated"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "single"}, {"text": " "}, {"text": "intramuscular"}, {"text": " "}, {"text": "dose"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "benzathine"}, {"text": " "}, {"text": "benzylpenicillin, 50000IU/kg whether the mothers were treated during pregnancy (with or without penicillin)."}]}, {"id": "body-12561", "type": "heading", "style": "Heading4", "text": "Pharmacological Management", "runs": [{"text": "Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-12562", "type": "paragraph", "style": "BodyText", "text": "Treatment regimens for early congenital syphilis (up to 2 years of age), and Infants with abnormal cerebrospinal fluid:", "runs": [{"text": "Treatment"}, {"text": " "}, {"text": "regimens"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "early"}, {"text": " "}, {"text": "congenital"}, {"text": " "}, {"text": "syphilis"}, {"text": " "}, {"text": "(up"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "2"}, {"text": " "}, {"text": "years"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "age),"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "Infants"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "abnormal"}, {"text": " "}, {"text": "cerebrospinal"}, {"text": " "}, {"text": "fluid:"}]}, {"id": "body-12563", "type": "paragraph", "style": "BodyText", "text": "A: benzylpenicillin (IV) 100000–150000IU/kg/day administered as 50000IU/kg/dose 12hourly, for the first 7days and every 8hourly thereafter for a total of 10days", "runs": [{"text": "A: ", "bold": true}, {"text": "benzylpenicillin (IV) 100000–150000IU/kg/day administered as 50000IU/kg/dose 12hourly, for the first 7days and every"}, {"text": " "}, {"text": "8hourly thereafter for a total of 10days"}]}, {"id": "body-12565", "type": "paragraph", "style": "BodyText", "text": "For congenital syphilis in children 2 or more years", "runs": [{"text": "For"}, {"text": " "}, {"text": "congenital"}, {"text": " "}, {"text": "syphilis"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "children"}, {"text": " "}, {"text": "2"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "more"}, {"text": " "}, {"text": "years"}]}, {"id": "body-12566", "type": "paragraph", "style": "BodyText", "text": "A: benzylpenicillin (IV or IM) 200000 – 300000IU/kg/day administered as 50000IU/kg every 4–6hourly for 10–14days", "runs": [{"text": "A:", "bold": true}, {"text": " ", "bold": true}, {"text": "benzylpenicillin"}, {"text": " "}, {"text": "(IV"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "IM)"}, {"text": " "}, {"text": "200000"}, {"text": " "}, {"text": "–"}, {"text": " "}, {"text": "300000IU/kg/day"}, {"text": " "}, {"text": "administered"}, {"text": " "}, {"text": "as"}, {"text": " "}, {"text": "50000IU/kg"}, {"text": " "}, {"text": "every"}, {"text": " "}, {"text": "4–6hourly"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "10–14days"}]}, {"id": "body-12567", "type": "paragraph", "style": "Heading3", "text": "OR", "runs": [{"text": "OR"}], "level": 3, "conjunction": true}, {"id": "body-12568", "type": "paragraph", "style": "BodyText", "text": "A: erythromycin (PO) 7.5–12.5 mg/kg 6hourly for 30days.", "runs": [{"text": "A:", "bold": true}, {"text": " ", "bold": true}, {"text": "erythromycin"}, {"text": " "}, {"text": "(PO)"}, {"text": " "}, {"text": "7.5–12.5"}, {"text": " "}, {"text": "mg/kg"}, {"text": " "}, {"text": "6hourly"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "30days."}]}, {"id": "body-12569", "type": "paragraph", "style": "BodyText", "text": "As an alternative regimen for penicillin allergic patients, after the first month of life", "runs": [{"text": "As"}, {"text": " "}, {"text": "an"}, {"text": " "}, {"text": "alternative"}, {"text": " "}, {"text": "regimen"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "penicillin"}, {"text": " "}, {"text": "allergic"}, {"text": " "}, {"text": "patients,"}, {"text": " "}, {"text": "after"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "first"}, {"text": " "}, {"text": "month"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "life"}]}, {"id": "body-12571", "type": "heading", "style": "Heading4", "text": "Syphilis and HIV Infection", "runs": [{"text": "Syphilis"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "HIV"}, {"text": " "}, {"text": "Infection"}], "level": 4, "list": {"level": 2, "numberingId": "1397"}}, {"id": "body-12572", "type": "paragraph", "style": "BodyText", "text": "All patients with syphilis should be encouraged to undergo testing for HIV because of the high frequency of dual infection and its implications for clinical assessment and management.", "runs": [{"text": "All patients with syphilis should be encouraged to undergo testing for HIV because of the high frequency of dual infection and its implications for clinical assessment and management."}]}, {"id": "body-12574", "type": "heading", "style": "Heading4", "text": "Genital Warts (Venereal Warts)", "runs": [{"text": "Genital"}, {"text": " "}, {"text": "Warts"}, {"text": " "}, {"text": "(Venereal"}, {"text": " "}, {"text": "Warts)"}], "level": 4, "list": {"level": 2, "numberingId": "1397"}}, {"id": "body-12575", "type": "paragraph", "style": "BodyText", "text": "Human papilloma virus (HPV) is a common sexually transmitted pathogen. Genital warts are painless but may lead to serious complications. The removal of the lesion does not mean cure of the infection. No treatment is completely satisfactory. Recommended regimens for venereal warts are as follows:", "runs": [{"text": "Human papilloma virus (HPV)"}, {"text": " "}, {"text": "is a common sexually transmitted pathogen."}, {"text": " "}, {"text": "Genital"}, {"text": " "}, {"text": "warts are painless but"}, {"text": " "}, {"text": "may lead to serious complications. The removal of the lesion does not mean cure of the infection. No treatment is completely satisfactory. Recommended regimens for venereal warts are as follows:"}]}, {"id": "body-12577", "type": "heading", "style": "Heading4", "text": "Pharmacological Management", "runs": [{"text": "Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-12578", "type": "paragraph", "style": "BodyText", "text": "D: podophyllin 10–25% in compound tincture of benzoin, applied carefully to the warts, avoiding normal tissue. External genital and perianal warts should be washed thoroughly 4–6 hourly after the application of podophyllin.", "runs": [{"text": "D:", "bold": true}, {"text": " ", "bold": true}, {"text": "podophyllin"}, {"text": " "}, {"text": "10–25%"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "compound"}, {"text": " "}, {"text": "tincture"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "benzoin,"}, {"text": " "}, {"text": "applied"}, {"text": " "}, {"text": "carefully"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "warts,"}, {"text": " "}, {"text": "avoiding"}, {"text": " "}, {"text": "normal"}, {"text": " "}, {"text": "tissue."}, {"text": " "}, {"text": "External"}, {"text": " "}, {"text": "genital and perianal warts should be washed thoroughly 4–6 hourly after the application of podophyllin."}]}, {"id": "body-12580", "type": "paragraph", "style": "BodyText", "text": "Podophyllin applied to warts on vaginal or anal epithelial surfaces should be allowed to dry before removing the speculum or anoscope. Treatment should be repeated at weekly intervals.", "runs": [{"text": "Podophyllin applied to warts on vaginal or anal epithelial surfaces should be allowed to dry before removing the speculum or anoscope. Treatment should be repeated at weekly intervals."}]}, {"id": "body-12582", "type": "paragraph", "style": "BodyText", "text": "Other treatment approaches Available at Referral level Health Facility", "runs": [{"text": "Other"}, {"text": " "}, {"text": "treatment"}, {"text": " "}, {"text": "approaches"}, {"text": " "}, {"text": "Available"}, {"text": " "}, {"text": "at"}, {"text": " "}, {"text": "Referral"}, {"text": " "}, {"text": "level"}, {"text": " "}, {"text": "Health"}, {"text": " "}, {"text": "Facility"}]}, {"id": "body-12583", "type": "paragraph", "style": "BodyText", "text": "Cryotherapy with liquid nitrogen, solid carbon dioxide, or a cryoprobe. Repeat applications every 1-2 weeks OR Electrosurgery OR Surgical removal", "runs": [{"text": "Cryotherapy"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "liquid"}, {"text": " "}, {"text": "nitrogen,"}, {"text": " "}, {"text": "solid"}, {"text": " "}, {"text": "carbon"}, {"text": " "}, {"text": "dioxide,"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"te