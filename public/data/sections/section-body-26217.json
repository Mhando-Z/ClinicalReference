{"id": "section-body-26217", "title": "Neuroleptic Malignant Syndrome (NMS)", "chapterId": "chapter-twenty-three", "blocks": [{"id": "body-26217", "type": "heading", "style": "Heading2", "text": "Neuroleptic Malignant Syndrome (NMS)", "runs": [{"text": "Neuroleptic"}, {"text": " "}, {"text": "Malignant"}, {"text": " "}, {"text": "Syndrome"}, {"text": " "}, {"text": "(NMS)"}], "level": 2, "list": {"level": 1, "numberingId": "381"}}, {"id": "body-26218", "type": "paragraph", "style": "BodyText", "text": "It is a syndrome caused by the use of high dose of antipsychotics; potent antipsychotics (e.g. haloperidol) and antipsychotics that are given via the intravenous or intramuscular routes.", "runs": [{"text": "It is a syndrome caused by the use of high dose of antipsychotics; potent antipsychotics (e.g. haloperidol) and antipsychotics that are given via the intravenous or intramuscular routes."}]}, {"id": "body-26221", "type": "heading", "style": "Heading4", "text": "Clinical Presentation", "runs": [{"text": "Clinical"}, {"text": " "}, {"text": "Presentation"}], "level": 4}, {"id": "body-26222", "type": "paragraph", "style": "ListParagraph", "text": "Muscle rigidity,", "runs": [{"text": "Muscle"}, {"text": " "}, {"text": "rigidity,"}], "list": {"level": 2, "numberingId": "381"}}, {"id": "body-26223", "type": "paragraph", "style": "ListParagraph", "text": "Fever,", "runs": [{"text": "Fever,"}], "list": {"level": 2, "numberingId": "381"}}, {"id": "body-26224", "type": "paragraph", "style": "ListParagraph", "text": "Altered consciousness,", "runs": [{"text": "Altered"}, {"text": " "}, {"text": "consciousness,"}], "list": {"level": 2, "numberingId": "381"}}, {"id": "body-26225", "type": "paragraph", "style": "ListParagraph", "text": "Mutism,", "runs": [{"text": "Mutism,"}], "list": {"level": 2, "numberingId": "381"}}, {"id": "body-26226", "type": "paragraph", "style": "ListParagraph", "text": "Dysphagia,", "runs": [{"text": "Dysphagia,"}], "list": {"level": 2, "numberingId"