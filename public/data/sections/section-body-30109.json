{"id": "section-body-30109", "title": "Fibromyalgia", "chapterId": "chapter-twenty-six", "blocks": [{"id": "body-30109", "type": "heading", "style": "Heading2", "text": "Fibromyalgia", "runs": [{"text": "Fibromyalgia"}], "level": 2, "list": {"level": 1, "numberingId": "105"}}, {"id": "body-30110", "type": "paragraph", "style": "BodyText", "text": "Fibromyalgia is a chronic pain syndrome characterized by widespread musculoskeletal pain lasting ≥3 months, associated with fatigue, sleep disturbance, and cognitive dysfunction.", "runs": [{"text": "Fibromyalgia"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "chronic"}, {"text": " "}, {"text": "pain"}, {"text": " "}, {"text": "syndrome"}, {"text": " "}, {"text": "characterized"}, {"text": " "}, {"text": "by"}, {"text": " "}, {"text": "widespread"}, {"text": " "}, {"text": "musculoskeletal"}, {"text": " "}, {"text": "pain"}, {"text": " "}, {"text": "lasting"}, {"text": " "}, {"text": "≥3"}, {"text": " "}, {"text": "months,"}, {"text": " "}, {"text": "associated"}, {"text": " "}, {"text": "with fatigue, sleep disturbance, and cognitive dysfunction."}]}, {"id": "body-30111", "type": "paragraph", "style": "BodyText", "text": "It is a disorder of central pain processing (central sensitization) rather than peripheral inflammation.", "runs": [{"text": "It"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "disorder"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "central"}, {"text": " "}, {"text": "pain"}, {"text": " "}, {"text": "processing"}, {"text": " "}, {"text": "(central"}, {"text": " "}, {"text": "sensitization)"}, {"text": " "}, {"text": "rather"}, {"text": " "}, {"text": "than"}, {"text": " "}, {"text": "peripheral"}, {"text": " "}, {"text": "inflammation."}]}, {"id": "body-30113", "type": "heading", "style": "Heading4", "text": "Diagnosis", "runs": [{"text": "Diagnosis"}], "level": 4}, {"id": "body-30114", "type": "paragraph", "style": "BodyText", "text": "The 2016 Revised ACR Fibromyalgia Diagnostic Criteria assist in diagnosing fibromyalgia. Tender point examination is no longer required; diagnosis is based on the Widespread Pain Index (WPI) and Symptom Severity Score (SSS) with symptoms present for at least 3 months.", "runs": [{"text": "The 2016 Revised ACR Fibromyalgia Diagnostic Criteria assist in diagnosing fibromyalgia. Tender point examination is no longer required; diagnosis is based on the Widespread Pain Index (WPI) and Symptom Severity Score (SSS) with symptoms present for at least 3 months."}]}, {"id": "body-30116", "type": "heading", "style": "Heading4", "text": "Investigations", "runs": [{"text": "Investigations"}], "level": 4}, {"id": "body-30117", "type": "paragraph", "style": "BodyText", "text": "Laboratory testing should be limited to excluding alternative diagnoses when clinically indicated.", "runs": [{"text": "Laboratory"}, {"text": " "}, {"text": "testing"}, {"text": " "}, {"text": "should"}, {"text": " "}, {"text": "be"}, {"text": " "}, {"text": "limited"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "excluding"}, {"text": " "}, {"text": "alternative"}, {"text": " "}, {"text": "diagnoses"}, {"text": " "}, {"text": "when"}, {"text": " "}, {"text": "clinically"}, {"text": " "}, {"text": "indicated."}]}, {"id": "body-30118", "type": "paragraph", "style": "ListParagraph", "text": "ESR and CRP", "runs": [{"text": "ESR"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "CRP"}], "list": {"level": 0, "numberingId": "64"}}, {"id": "body-30119", "type": "paragraph", "style": "ListParagraph", "text": "CK levels", "runs": [{"text": "CK"}, {"text": " "}, {"text": "levels"}], "list": {"level": 0, "numberingId": "64"}}, {"id": "body-30120", "type": "paragraph", "style": "ListParagraph", "text": "Thyroid function testing", "runs": [{"text": "Thyroid"}, {"text": " "}, {"text": "function"}, {"text": " "}, {"text": "testing"}], "list": {"level": 0, "numberingId": "64"}}, {"id": "body-30121", "type": "paragraph", "style": "ListParagraph", "text": "Vitamin D testing may be considered in selected patients.", "runs": [{"text": "Vitamin"}, {"text": " "}, {"text": "D"}, {"text": " "}, {"text": "testing"}, {"text": " "}, {"text": "may"}, {"text": " "}, {"text": "be"}, {"text": " "}, {"text": "considered"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "selected"}, {"text": " "}, {"text": "patients."}], "list": {"level": 0, "numberingId": "64"}}, {"id": "body-30122", "type": "paragraph", "style": "ListParagraph", "text": "Autoimmune serology should not be ordered routinely unless clinical suspicion exists.", "runs": [{"text": "Autoimmune"}, {"text": " "}, {"text": "serology"}, {"text": " "}, {"text": "should"}, {"text": " "}, {"text": "not"}, {"text": " "}, {"text": "be"}, {"text": " "}, {"text": "ordered"}, {"text": " "}, {"text": "routinely"}, {"text": " "}, {"text": "unless"}, {"text": " "}, {"text": "clinical"}, {"text": " "}, {"text": "suspicion"}, {"text": " "}, {"text": "exists."}], "list": {"level": 0, "numberingId": "64"}}, {"id": "body-30123", "type": "heading", "style": "Heading4", "text": "Management", "runs": [{"text": "Management"}], "level": 4}, {"id": "body-30124", "type": "paragraph", "style": "BodyText", "text": "Fibromyalgia management should be multimodal and individualized, prioritizing non-pharmacological therapy first, with medications added for persistent moderate to severe symptoms.", "runs": [{"text": "Fibromyalgia"}, {"text": " "}, {"text": "management"}, {"text": " "}, {"text": "should"}, {"text": " "}, {"text": "be"}, {"text": " "}, {"text": "multimodal"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "individualized,"}, {"text": " "}, {"text": "prioritizing"}, {"text": " "}, {"text": "non-pharmacological"}, {"text": " "}, {"text": "therapy"}, {"text": " "}, {"text": "first,"}, {"text": " "}, {"text": "with medications added for persistent moderate to severe symptoms."}]}, {"id": "body-30126", "type": "heading", "style": "Heading4", "text": "Non pharmacological management", "runs": [{"text": "Non"}, {"text": " "}, {"text": "pharmacological"}, {"text": " "}, {"text": "management"}], "level": 4}, {"id": "body-30127", "type": "paragraph", "style": "ListParagraph", "text": "Patients should receive structured education about the condition.", "runs": [{"text": "Patients"}, {"text": " "}, {"text": "should"}, {"text": " "}, {"text": "receive"}, {"text": " "}, {"text": "structured"}, {"text": " "}, {"text": "education"}, {"text": " "}, {"text": "about"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "condition."}], "list": {"level": 0, "numberingId": "64"}}, {"id": "body-30128", "type": "paragraph", "style": "ListParagraph", "text": "Regular graded aerobic exercise and Strength training is strongly recommended.", "runs": [{"text": "Regular"}, {"text": " "}, {"text": "graded"}, {"text": " "}, {"text": "aerobic"}, {"text": " "}, {"text": "exercise"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "Strength"}, {"text": " "}, {"text": "training"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "strongly"}, {"text": " "}, {"text": "recommended."}], "list": {"level": 0, "numberingId": "64"}}, {"id": "body-30129", "type": "paragraph", "style": "ListParagraph", "text": "Cognitive Behavioral Therapy (CBT).", "runs": [{"text": "Cognitive"}, {"text": " "}, {"text": "Behavioral"}, {"text": " "}, {"text": "Therapy"}, {"text": " "}, {"text": "(CBT)."}], "list": {"level": 0, "numberingId": "64"}}, {"id": "body-30130", "type": "paragraph", "style": "ListParagraph", "text": "Encourage sleep hygiene measures.", "runs": [{"text": "Encourage"}, {"text": " "}, {"text": "sleep"}, {"text": " "}, {"text": "hygiene"}, {"text": " "}, {"text": "measures."}], "list": {"level": 0, "numberingId": "64"}}, {"id": "body-30131", "type": "paragraph", "style": "ListParagraph", "text": "Stress reduction strategies.", "runs": [{"text": "Stress"}, {"text": " "}, {"text": "reduction"}, {"text": " "}, {"text": "strategies."}], "list": {"level": 0, "numberingId": "64"}}, {"id": "body-30133", "type": "heading", "style": "Heading4", "text": "Pharmacological Management", "runs": [{"text": "Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-30134", "type": "paragraph", "style": "BodyText", "text": "S: duloxetine (PO) 30mg-60mg 24 hourly", "runs": [{"text": "S:", "bold": true}, {"text": " ", "bold": true}, {"text": "duloxetine"}, {"text": " "}, {"text": "(PO)"}, {"text": " "}, {"text": "30mg-60mg"}, {"text": " "}, {"text": "24"}, {"text": " "}, {"text": "hourly"}]}, {"id": "body-30135", "type": "paragraph", "style": "Heading3", "text": "OR", "runs": [{"text": "OR"}], "level": 3, "conjunction": true}, {"id": "body-30136", "type": "paragraph", "style": "BodyText", "text": "A: amitriptyline (PO) 25mg 24 hourly", "runs": [{"text": "A:", "bold": true}, {"text": " ", "bold": true}, {"text": "amitriptyline"}, {"text": " "}, {"text": "(PO)"}, {"text": " "}, {"text": "25mg"}, {"text": " "}, {"text": "24"}, {"text": " "}, {"text": "hourly"}]}], "source": {"file": "medical.docx", "chapter": "Rheumatological disorders", "start": "body-30109", "end": "body-30136"}}