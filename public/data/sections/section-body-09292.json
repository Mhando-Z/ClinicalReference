{"id": "section-body-09292", "title": "Pseudomembranous Colitis", "chapterId": "chapter-ten", "tocLevel": 4, "tocPath": ["APPROACH TO PATIENTS WITH EMERGENCY CONDITIONS", "GASTROINTESTINAL DISEASE CONDITIONS", "Diseases of the Intestine", "Pseudomembranous Colitis"], "blocks": [{"id": "body-09292", "type": "heading", "style": "Heading4", "text": "Pseudomembranous Colitis", "runs": [{"text": "Pseudomembranous"}, {"text": " "}, {"text": "Colitis"}], "level": 4, "list": {"level": 2, "numberingId": "1531"}}, {"id": "body-09293", "type": "paragraph", "style": "BodyText", "text": "This condition is caused by Clostridium difficile, a gram positive, anaerobic bacterium causing antibiotic associated diarrhoea as a result of altered bacterial flora and release of enterotoxins.", "runs": [{"text": "This condition is caused by Clostridium difficile, a gram positive, anaerobic bacterium causing antibiotic associated diarrhoea as a result of altered bacterial flora and release of enterotoxins."}]}, {"id": "body-09295", "type": "heading", "style": "Heading4", "text": "Clinical Presentation", "runs": [{"text": "Clinical"}, {"text": " "}, {"text": "Presentation"}], "level": 4}, {"id": "body-09296", "type": "paragraph", "style": "ListParagraph", "text": "Bloody Diarrhea", "runs": [{"text": "Bloody"}, {"text": " "}, {"text": "Diarrhea"}], "list": {"level": 0, "numberingId": "1500"}}, {"id": "body-09297", "type": "paragraph", "style": "ListParagraph", "text": "Abdominal cramps and tenderness", "runs": [{"text": "Abdominal"}, {"text": " "}, {"text": "cramps"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "tenderness"}], "list": {"level": 0, "numberingId": "1500"}}, {"id": "body-09298", "type": "paragraph", "style": "ListParagraph", "text": "Nausea, fever, dehydration", "runs": [{"text": "Nausea,"}, {"text": " "}, {"text": "fever,"}, {"text": " "}, {"text": "dehydration"}], "list": {"level": 0, "numberingId": "1500"}}, {"id": "body-09300", "type": "heading", "style": "Heading4", "text": "Investigations", "runs": [{"text": "Investigations"}], "level": 4}, {"id": "body-09301", "type": "paragraph", "style": "ListParagraph", "text": "Lower endoscopic pathognomonic findings of pseudomembranous yellowish plaques overlying the ulcerated and friable rectal sigmoid colon mucosa", "runs": [{"text": "Lower endoscopic pathognomonic findings of pseudomembranous yellowish plaques overlying the ulcerated and"}, {"text": " "}, {"text": "friable rectal sigmoid colon mucosa"}], "list": {"level": 0, "numberingId": "1500"}}, {"id": "body-09302", "type": "paragraph", "style": "ListParagraph", "text": "Laboratory evidence of C. difficile toxin A-B isolation from cultured stool samples (Toxin B) OR ELISA assay (Toxin A)", "runs": [{"text": "Laboratory"}, {"text": " "}, {"text": "evidence"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "C.", "italic": true}, {"text": " ", "italic": true}, {"text": "difficile", "italic": true}, {"text": " ", "italic": true}, {"text": "toxin"}, {"text": " "}, {"text": "A-B"}, {"text": " "}, {"text": "isolation"}, {"text": " "}, {"text": "from"}, {"text": " "}, {"text": "cultured"}, {"text": " "}, {"text": "stool"}, {"text": " "}, {"text": "samples"}, {"text": " "}, {"text": "(Toxin"}, {"text": " "}, {"text": "B)"}, {"text": " "}, {"text": "OR"}, {"text": " "}, {"text": "ELISA"}, {"text": " "}, {"text": "assay"}, {"text": " "}, {"text": "(Toxin"}, {"text": " "}, {"text": "A)"}], "list": {"level": 0, "numberingId": "1500"}}, {"id": "body-09304", "type": "heading", "style": "Heading4", "text": "Pharmacological Treatment", "runs": [{"text": "Pharmacological"}, {"text": " "}, {"text": "Treatment"}], "level": 4}, {"id": "body-09305", "type": "paragraph", "style": "BodyText", "text": "Stop the causative antibiotics", "runs": [{"text": "Stop"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "causative"}, {"text": " "}, {"text": "antibiotics"}]}, {"id": "body-09306", "type": "paragraph", "style": "BodyText", "text": "A: metronidazole (PO) 400mg 8hourly for 10-14days", "runs": [{"text": "A", "bold": true}, {"text": ":"}, {"text": " "}, {"text": "metronidazole"}, {"text": " "}, {"text": "(PO)"}, {"text": " "}, {"text": "400mg"}, {"text": " "}, {"text": "8hourly"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "10-"}, {"text": "14days"}]}, {"id": "body-09307", "type": "paragraph", "style": "Heading3", "text": "OR", "runs": [{"text": "OR"}], "level": 3, "conjunction": true}, {"id": "body-09308", "type": "paragraph", "style": "BodyText", "text": "S: vancomycin (PO) Adults, 125mg–500mg 6hourly for 10-14days", "runs": [{"text": "S", "bold": true}, {"text": ":"}, {"text": " "}, {"text": "vancomycin"}, {"text": " "}, {"text": "(PO)"}, {"text": " "}, {"text": "Adults,"}, {"text": " "}, {"text": "125mg–500mg"}, {"text": " "}, {"text": "6hourly"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "10-"}, {"text": "14days"}]}, {"id": "body-09309-textbox1-00001", "type": "paragraph", "style": "Normal", "text": "Note", "runs": [{"text": "Note", "bold": true}]}, {"id": "body-09309-textbox1-00002", "type": "paragraph", "style": "BodyText", "text": "Resuscitative and supportive management should be instituted as for UC above. Refer to next level of care with adequate expertise and facilities for all suspected cases for initial evaluation and management and cases presenting with acute complications such as Toxic mega colon", "runs": [{"text": "Resuscitative and supportive management should be instituted as for UC above. Refer to next level of care with adequate expertise and facilities for all suspected cases for initial evaluation and management and cases presenting with acute complications such as Toxic mega colon"}]}], "source": {"file": "medical.docx", "chapter": "Gastrointestinal disease conditions", "start": "body-09292", "end": "body-09309-textbox1-00002"}}