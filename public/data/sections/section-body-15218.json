, "list": {"level": 0, "numberingId": "1231"}}, {"id": "body-15231", "type": "paragraph", "style": "ListParagraph", "text": "Slit lamp biomicroscopy", "runs": [{"text": "Slit"}, {"text": " "}, {"text": "lamp"}, {"text": " "}, {"text": "biomicroscopy"}], "list": {"level": 0, "numberingId": "1231"}}, {"id": "body-15232", "type": "paragraph", "style": "ListParagraph", "text": "Tear meniscus height (meniscometry)", "runs": [{"text": "Tear"}, {"text": " "}, {"text": "meniscus"}, {"text": " "}, {"text": "height"}, {"text": " "}, {"text": "(meniscometry)"}], "list": {"level": 0, "numberingId": "1231"}}, {"id": "body-15236", "type": "heading", "style": "Heading4", "text": "Non-Pharmacological Management", "runs": [{"text": "Non-Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-15237", "type": "paragraph", "style": "ListParagraph", "text": "Control symptoms and look for secondary causes for treatment such as MGDs.", "runs": [{"text": "Control symptoms and look for secondary causes for treatment such as MGDs."}], "list": {"level": 0, "numberingId": "1231"}}, {"id": "body-15238", "type": "paragraph", "style": "ListParagraph", "text": "Educate patients to avoid unprescribed eye medications which may worsen the dryness and control their environmental factors by e.g., blinking frequently during visual attentive tasks and the use of 20-20-20 rule avoid air conditioners directly on the face.", "runs": [{"text": "Educate patients to avoid unprescribed eye medications"}, {"text": " "}, {"text": "which"}, {"text": " "}, {"text": "may worsen"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "dryness and control their environmental factors by e.g., blinking frequently during visual attentive tasks and the use of 20-20-20 rule avoid air conditioners directly on the face."}], "list": {"level": 0, "numberingId": "1231"}}, {"id": "body-15240", "type": "paragraph", "style": "ListParagraph", "text": "Use humidifier in areas with low humidity", "runs": [{"text": "Use"}, {"text": " "}, {"text": "humidifier"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "areas"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "low"}, {"text": " "}, {"text": "humidity"}], "list": {"level": 0, "numberingId": "1231"}}, {"id": "body-15241", "type": "paragraph", "style": "ListParagraph", "text": "Punctal plugins to decrease tear drainage", "runs": [{"text": "Punctal"}, {"text": " "}, {"text": "plugins"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "decrease"}, {"text": " "}, {"text": "tear"}, {"text": " "}, {"text": "drainage"}], "list": {"level": 0, "numberingId": "1231"}}, {"id": "body-15242", "type": "paragraph", "style": "ListParagraph", "text": "Tear conserving interventions such as punctal plugs or nighttime masks/goggles", "runs": [{"text": "Tear"}, {"text": " "}, {"text": "conserving"}, {"text": " "}, {"text": "interventions"}, {"text": " "}, {"text": "such"}, {"text": " "}, {"text": "as"}, {"text": " "}, {"text": "punctal plugs or nighttime masks/goggles"}], "list": {"level": 0, "numberingId": "1231"}}, {"id": "body-15243", "type": "paragraph", "style": "ListParagraph", "text": "Bandage Contact Lenses can be used as well", "runs": [{"text": "Bandage"}, {"text": " "}, {"text": "Contact"}, {"text": " "}, {"text": "Lenses"}, {"text": " "}, {"text": "can"}, {"text": " "}, {"text": "be"}, {"text": " "}, {"text": "used"}, {"text": " "}, {"text": "as"}, {"text": " "}, {"text": "well"}], "list": {"level": 0, "numberingId": "1231"}}, {"id": "body-15244", "type": "paragraph", "style": "ListParagraph", "text": "Specialty contact lenses such as scleral lenses", "runs": [{"text": "Specialty"}, {"text": " "}, {"text": "contact"}, {"text": " "}, {"text": "lenses"}, {"text": " "}, {"text": "such"}, {"text": " "}, {"text": "as"}, {"text": " "}, {"text": "scleral"}, {"text": " "}, {"text": "lenses"}], "list": {"level": 0, "numberingId": "1231"}}, {"id": "body-15247", "type": "heading", "style": "Heading4", "text