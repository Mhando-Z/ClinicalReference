{"id": "section-body-15614", "title": "Mastoiditis with Sub-Periosteal Abscess", "chapterId": "chapter-fifteen", "tocLevel": 4, "tocPath": ["APPROACH TO PATIENTS WITH EMERGENCY CONDITIONS", "EAR, NOSE AND THROAT/HEAD AND NECK DISEASES", "Trauma of the Pinna", "Mastoiditis with Sub-Periosteal Abscess"], "blocks": [{"id": "body-15614", "type": "heading", "style": "Heading4", "text": "Mastoiditis with Sub-Periosteal Abscess", "runs": [{"text": "Mastoiditis"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "Sub-Periosteal"}, {"text": " "}, {"text": "Abscess"}], "level": 4, "list": {"level": 3, "numberingId": "1219"}}, {"id": "body-15615", "type": "paragraph", "style": "BodyText", "text": "It is due to infection of the mastoid air cells in the middle ear, a complication of chronic suppurative otitis media. It presents as a fluctuant painful swelling on the post auricular area. The overlying skin is also inflamed.", "runs": [{"text": "It"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "due"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "infection"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "mastoid"}, {"text": " "}, {"text": "air"}, {"text": " "}, {"text": "cells"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "middle"}, {"text": " "}, {"text": "ear,"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "complication"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "chronic"}, {"text": " "}, {"text": "suppurative"}, {"text": " "}, {"text": "otitis"}, {"text": " "}, {"text": "media."}, {"text": " "}, {"text": "It"}, {"text": " "}, {"text": "presents"}, {"text": " "}, {"text": "as a fluctuant painful swelling on the post auricular area. The overlying skin is also inflamed."}]}, {"id": "body-15617", "type": "heading", "style": "Heading4", "text": "Non-Pharmacological Management", "runs": [{"text": "Non-Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-15618", "type": "paragraph", "style": "BodyText", "text": "Aspirate the swelling before incision and drainage, and then refer for mastoidectomy at a zonal/national hospital", "runs": [{"text": "Aspirate"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "swelling"}, {"text": " "}, {"text": "before"}, {"text": " "}, {"text": "incision"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "drainage,"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "then"}, {"text": " "}, {"text": "refer"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "mastoidectomy"}, {"text": " "}, {"text": "at"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "zonal/national"}, {"text": " "}, {"text": "hospital"}]}, {"id": "body-15620", "type": "heading", "style": "Heading4", "text": "Pharmacological Management", "runs": [{"text": "Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-15621", "type": "paragraph", "style": "BodyText", "text": "C: ciprofloxacin ear drops, 3drops, 12hourly for 14days", "runs": [{"text": "C:", "bold": true}, {"text": " ", "bold": true}, {"text": "ciprofloxacin"}, {"text": " "}, {"text": "ear"}, {"text": " "}, {"text": "drops,"}, {"text": " "}, {"text": "3drops,"}, {"text": " "}, {"text": "12hourly"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "14days"}]}, {"id": "body-15622", "type": "paragraph", "style": "Heading3", "text": "AND", "runs": [{"text": "AND"}], "level": 3, "conjunction": true}, {"id": "body-15623", "type": "paragraph", "style": "BodyText", "text": "Intravenous antibiotics are required due to the severity and risk of intracranial complications", "runs": [{"text": "Intravenous"}, {"text": " "}, {"text": "antibiotics"}, {"text": " "}, {"text": "are"}, {"text": " "}, {"text": "required"}, {"text": " "}, {"text": "due"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "severity"}, {"text": " "}, {"t