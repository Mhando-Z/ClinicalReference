}, {"text": " "}, {"text": "tests"}, {"text": " "}, {"text": "(ALT/AST)"}], "list": {"level": 0, "numberingId": "120"}}, {"id": "body-28910", "type": "paragraph", "style": "ListParagraph", "text": "Renal function tests (urea, creatinine)", "runs": [{"text": "Renal"}, {"text": " "}, {"text": "function"}, {"text": " "}, {"text": "tests"}, {"text": " "}, {"text": "(urea,"}, {"text": " "}, {"text": "creatinine)"}], "list": {"level": 0, "numberingId": "120"}}, {"id": "body-28911", "type": "paragraph", "style": "ListParagraph", "text": "Creatine\tkinase\t(if\tprolonged immobilization/rhabdomyolysis suspected)", "runs": [{"text": "Creatine"}, {"text": "\t"}, {"text": "kinase"}, {"text": "\t"}, {"text": "(if"}, {"text": "\t"}, {"text": "prolonged "}, {"text": "immobilization/rhabdomyolysis suspected)"}], "list": {"level": 0, "numberingId": "120"}}, {"id": "body-28913", "type": "heading", "style": "Heading4", "text": "Non-Pharmacological Management", "runs": [{"text": "Non-Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-28914", "type": "paragraph", "style": "ListParagraph", "text": "Assess and secure airway", "runs": [{"text": "Assess"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "secure"}, {"text": " "}, {"text": "airway"}], "list": {"level": 0, "numberingId": "120"}}, {"id": "body-28915", "type": "paragraph", "style": "ListParagraph", "text": "Provide assisted ventilation if required", "runs": [{"text": "Provide"}, {"text": " "}, {"text": "assisted"}, {"text": " "}, {"text": "ventilation"}, {"text": " "}, {"text": "if"}, {"text": " "}, {"text": "required"}], "list": {"level": 0, "numberingId": "120"}}, {"id": "body-28916", "type": "paragraph", "style": "ListParagraph", "text": "Intubate patients unable to protect airway", "runs": [{"text": "Intubate"}, {"text": " "}, {"text": "patients"}, {"text": " "}, {"text": "unable"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "protect"}, {"text": " "}, {"text": "airway"}], "list": {"level": 0, "numberingId": "120"}}, {"id": "body-28918", "type": "paragraph", "style": "ListParagraph", "text": "Arterial blood gas", "runs": [{"text": "Arterial"}, {"text": " "}, {"text": "blood"}, {"text": " "}, {"text": "gas"}], "list": {"level": 0, "numberingId": "125"}}, {"id": "body-28919", "type": "paragraph", "style": "ListParagraph", "text": "Blood glucose", "runs": [{"text": "Blood"}, {"text": " "}, {"text": "glucose"}], "list": {"level": 0, "numberingId": "125"}}, {"id": "body-28920", "type": "paragraph", "style": "ListParagraph", "text": "ECG (recommended in all suspected overdoses, especially Methadone overdose due to QT prolongation)", "runs": [{"text": "ECG (recommended in all suspected overdoses, especially Methadone overdose due to QT "}, {"text": "prolongation)"}], "list": {"level": 0, "numberingId": "125"}}, {"id": "body-28924", "type": "paragraph", "style": "ListParagraph", "text": "Administer supplemental oxygen", "runs": [{"text": "Administer"}, {"text": " "}, {"text": "supplemental"}, {"text": " "}, {"text": "oxygen"}], "list": {"level": 0, "numberingId": "125"}}, {"id": "body-28925", "type": "paragraph", "style": "ListParagraph", "text": "Continuous pulse oximetry and cardiac monitoring", "runs": [{"text": "Continuous"}, {"text": " "}, {"text": "pulse"}, {"text": " "}, {"text": "oximetry"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "cardiac"}, {"text": " "}, {"text": "monitoring"}], "list": {"level": 0, "numberingId": "125"}}, {"id": "body-28928", "type": "heading", "style": "Heading4", "text": "Pharmacological Management", "runs": [{"text": "Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-28929", "type": "paragraph", "style": "ListParagraph", "text": "hypo-ventilating patient with spontaneous ventilation", "runs": [{"text": "hypo-ventilating"}, {"text": " "}, {"text": "patient"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "spontaneous"}, {"text": " "}, {"text": "ventilation"}], "list": {"level": 0, "numberingId": "124"}}, {"id": "body-28931", "type": "paragraph", "style": "BodyText", "text": "Adults and children >20 kg", "runs": [{"text": "Adults"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "children"}, {"text": " "}, {"text": ">20"}, {"text": " "}, {"text": "kg"}]}, {"id": "body-28932", "type": "paragraph", "style": "BodyText", "text": "B: naloxone (IV) 0.4–0.5 mg initially, repeat every 2–3 minutes and titrate upward until respiratory rate ≥12 breaths/min and adequate ventilation is achieved. Maximum cumulative dose typically 10 mg.", "runs": [{"text": "B: ", "bold": true}, {"text": "naloxone (IV) 0.4–0.5 mg initially, repeat every 2–3 minutes and titrate upward until respiratory rate ≥12 breaths/min and adequate ventilation is achieved. Maximum cumulative dose typically 10 mg."}]}, {"id": "body-28933", "type": "paragraph", "style": "BodyText", "text": "Children <20 kg", "runs": [{"text": "Children"}, {"text": " "}, {"text": "<20"}, {"text": " kg"}]}, {"id": "body-28934", "type": "paragraph", "style": "BodyText", "text": "B: naloxone (IV) 0.01 mg/kg initially (maximum 2 mg/dose); may increase to 0.1 mg/kg if inadequate response.", "runs": [{"text": "B:", "bold": true}, {"text": " ", "bold": true}, {"text": "naloxone"}, {"text": " "}, {"text": "(IV)"}, {"text": " "}, {"text": "0.01"}, {"text": " "}, {"text": "mg/kg"}, {"text": " "}, {"text": "initially"}, {"text": " "}, {"text": "(maximum"}, {"text": " "}, {"text": "2"}, {"text": " "}, {"text": "mg/dose);"}, {"text": " "}, {"text": "may"}, {"text": " "}, {"text": "increase"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "0.1"}, {"text": " "}, {"text": "mg/kg"}, {"text": " "}, {"text": "if"}, {"text": " "}, {"text": "inadequate"}, {"text": " "}, {"text": "response."}]}, {"id": "body-28935-textbox1-00001", "type": "paragraph", "style": "Normal", "text": "Note", "runs": [{"text": "Note", "bold": true}]}, {"id": "body-28935-textbox1-00002", "type": "paragraph", "style": "BodyText", "text": "Before administering Naloxone, ensure airway support and provide 100% oxygen or assist ventilation using a bag- valve-mask in patients with respiratory depression or apnea until adequate spontaneous breathing resumes.", "runs": [{"text": "Before administering Naloxone, ensure airway support and provide 100% oxygen or assist ventilation using a bag- valve-mask in patients with respiratory depression or apnea until adequate spontaneous breathing resumes."}], "list": {"level": 0, "numberingId": "123"}}, {"id": "body-28935-textbox1-00003", "type": "paragraph", "style": "BodyText", "text": "Usual initial dose of Naloxone: Adults: 0.4–2 mg IV, Children: 0.1 mg/kg IV (maximum 2 mg per dose)", "runs": [{"text": "Usual"}, {"text": " "}, {"text": "initial"}, {"text": " "}, {"text": "dose"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "Naloxone:"}, {"text": " "}, {"text": "Adults:"}, {"text": " "}, {"text": "0.4–2"}, {"text": " "}, {"text": "mg"}, {"text": " "}, {"text": "IV,"}, {"text": " "}, {"text": "Children:"}, {"text": " "}, {"text": "0.1"}, {"text": " "}, {"text": "mg/kg"}, {"text": " "}, {"text": "IV"}, {"text": " "}, {"text": "(maximum"}, {"text": " "}, {"text": "2"}, {"text": " "}, {"text": "mg"}, {"text": " "}, {"text": "per"}, {"text": " "}, {"text": "dose)"}], "list": {"level": 0, "numberingId": "123"}}, {"id": "body-28935-textbox1-00004", "type": "paragraph", "style": "BodyText", "text": "In suspected chronic opioid users, Naloxone should be administered slowly and titrated carefully to avoid precipitating acute withdrawal and sudden return of severe pain: Start with 0.04–0.1 mg IV, Repeat every 1–3 minutes as needed until adequate ventilation is restored", "runs": [{"text": "In suspected chronic opioid users, Naloxone should be administered slowly and titrated carefully to avoid precipitating acute withdrawal and sudden return of severe pain: Start with 0.04–0.1 mg IV,"}, {"text": " "}, {"text": "Repeat every 1–3 minutes as needed until adequate ventilation is restored"}], "list": {"level": 0, "numberingId": "123"}}, {"id": "body-28935-textbox1-00005", "type": "paragraph", "style": "BodyText", "text": "The goal of Naloxone therapy is restoration of adequate respiratory function, not necessarily full consciousness.", "runs": [{"text": "The"}, {"text": " "}, {"text": "goal"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "Naloxone"}, {"text": " "}, {"text": "therapy"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "restoration"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "adequate"}, {"text": " "}, {"text": "respiratory"}, {"text": " "}, {"text": "function,"}, {"text": " "}, {"text": "not"}, {"text": " "}, {"text": "necessarily"}, {"text": " "}, {"text": "full"}, {"text": " "}, {"text": "consciousness."}], "list": {"level": 0, "numberingId": "123"}}, {"id": "body-28935-textbox1-00006", "type": "paragraph", "style": "BodyText", "text": "Onset of action is usually within 1–2 minutes IV, with peak response occurring within 3–8 minutes.", "runs": [{"text": "Onset"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "action"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "usually"}, {"text": " "}, {"text": "within"}, {"text": " "}, {"text": "1–2"}, {"text": " "}, {"text": "minutes"}, {"text": " "}, {"text": "IV,"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "peak"}, {"text": " "}, {"text": "response"}, {"text": " "}, {"text": "occurring"}, {"text": " "}, {"text": "within"}, {"text": " "}, {"text": "3–8"}, {"text": " "}, {"text": "minutes."}], "list": {"level": 0, "numberingId": "123"}}, {"id": "body-28935-textbox1-00007", "type": "paragraph", "style": "BodyText", "text": "Repeat doses may be required if signs of opioid toxicity persist or recur, particularly with long-acting opioids such as Methadone or Buprenorphine.", "runs": [{"text": "Repeat"}, {"text": " "}, {"text": "doses"}, {"text": " "}, {"text": "may"}, {"text": " "}, {"text": "be"}, {"text": " "}, {"text": "required"}, {"text": " "}, {"text": "if"}, {"text": " "}, {"text": "signs"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "opioid"}, {"text": " "}, {"text": "toxicity"}, {"text": " "}, {"text": "persist"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "recur,"}, {"text": " "}, {"text": "particularly"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "long-acting"}, {"text": " "}, {"text": "opioids"}, {"text": " "}, {"text": "such"}, {"text": " "}, {"text": "as Methadone or Buprenorphine."}], "list": {"level": 0, "numberingId": "123"}}, {"id": "body-28935-textbox1-00008", "type": "paragraph", "style": "BodyText", "text": "Some patients may require continuous naloxone infusion due to the shorter half-life of Naloxone compared with long- acting opioids.", "runs": [{"text": "Some"}, {"text": " "}, {"text": "patients"}, {"text": " "}, {"text": "may"}, {"text": " "}, {"text": "require"}, {"text": " "}, {"text": "continuous"}, {"text": " "}, {"text": "naloxone"}, {"text": " "}, {"text": "infusion"}, {"text": " "}, {"text": "due"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "shorter"}, {"text": " "}, {"text": "half-life"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "Naloxone"}, {"text": " "}, {"text": "compared"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "long- acting opioids."}], "list": {"level": 0, "numberingId": "123"}}, {"id": "body-28935-textbox1-00009", "type": "paragraph", "style": "BodyText", "text": "Patients with Buprenorphine toxicity may show incomplete response to standard naloxone doses and may require higher doses, prolonged monitoring, and ventilatory support.", "runs": [{"text": "Patients with Buprenorphine toxicity may show incomplete response to standard naloxone doses and may require higher doses, prolonged monitoring, and ventilatory support."}], "list": {"level": 0, "numberingId": "123"}}, {"id": "body-28935-te