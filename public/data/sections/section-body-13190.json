{"id": "section-body-13190", "title": "Seborrheic Eczema (Dermatitis)", "chapterId": "chapter-thirteen", "tocLevel": 4, "tocPath": ["APPROACH TO PATIENTS WITH EMERGENCY CONDITIONS", "SKIN DISEASES", "Eczema (Dermatitis)", "Seborrheic Eczema (Dermatitis)"], "blocks": [{"id": "body-13190", "type": "heading", "style": "Heading4", "text": "Seborrheic Eczema (Dermatitis)", "runs": [{"text": "Seborrheic"}, {"text": " "}, {"text": "Eczema"}, {"text": " "}, {"text": "(Dermatitis)"}], "level": 4, "list": {"level": 2, "numberingId": "1368"}}, {"id": "body-13191", "type": "paragraph", "style": "BodyText", "text": "It is a chronic, relapsing, and usually mild form of dermatitis confined to skin regions with high sebum production and the large body folds. It is associated with the commensal yeast Malassezia.", "runs": [{"text": "It"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "chronic,"}, {"text": " "}, {"text": "relapsing,"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "usually"}, {"text": " "}, {"text": "mild"}, {"text": " "}, {"text": "form"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "dermatitis"}, {"text": " "}, {"text": "confined"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "skin"}, {"text": " "}, {"text": "regions"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "high"}, {"text": " "}, {"text": "sebum"}, {"text": " "}, {"text": "production"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "large body folds. It is associated with the commensal yeast Malassezia."}]}, {"id": "body-13193", "type": "heading", "style": "Heading4", "text": "Clinical Presentation:", "runs": [{"text": "Clinical"}, {"text": " "}, {"text": "Presentation:"}], "level": 4}, {"id": "body-13194", "type": "paragraph", "style": "ListParagraph", "text": "Erythematous patches or plaques with greasy-looking", "runs": [{"text": "Erythematous"}, {"text": " "}, {"text": "patches"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "plaques"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "greasy-"}, {"text": "looking"}], "list": {"level": 0, "numberingId": "1335"}}, {"id": "body-13195", "type": "paragraph", "style": "ListParagraph", "text": "Distributed on areas rich in sebaceous glands, such as the scalp, ear, face, chest, back and the intertriginous area", "runs": [{"text": "Distributed"}, {"text": " "}, {"text": "on"}, {"text": " "}, {"text": "areas"}, {"text": " "}, {"text": "rich"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "sebaceous"}, {"text": " "}, {"text": "glands,"}, {"text": " "}, {"text": "such"}, {"text": " "}, {"text": "as"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "scalp,"}, {"text": " "}, {"text": "ear,"}, {"text": " "}, {"text": "face,"}, {"text": " "}, {"text": "chest,"}, {"text": " "}, {"text": "back"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "the intertriginous area"}], "list": {"level": 0, "numberingId": "1335"}}, {"id": "body-13197", "type": "heading", "style": "Heading4", "text": "Pharmacological Management", "runs": [{"text": "Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-13198", "type": "paragraph", "style": "BodyText", "text": "A: clotrimazole cream (topical) 12 hourly for 4-6weeks", "runs": [{"text": "A:", "bold": true}, {"text": " ", "bold": true}, {"text": "clotrimazole"}, {"text": " "}, {"text": "cream"}, {"text": " "}, {"text": "(topical)"}, {"text": " "}, {"text": "12"}, {"text": " "}, {"text": "hourly"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "4-"}, {"text": "6weeks"}]}, {"id": "body-13199", "type": "paragraph", "style": "Heading3", "text": "OR", "runs": [{"text": "OR"}], "level": 3, "conjunction": true}, {"id": "body-13200", "type": "paragraph", "style": "BodyText", "text": "C: miconazole cream (topical) 12 hourly for 4-6weeks", "runs": [{"text": "C:", "bold": true}, {"text": " ", "bold": true}, {"text": "miconazole"}, {"text": " "}, {"text": "cream"}, {"text": " "}, {"text": "(topical)"}, {"text": " "}, {"text": "12"}, {"text": " "}, {"text": "hourly"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "4-"}, {"text": "6weeks"}]}, {"id": "body-13201", "type": "paragraph", "style": "Heading3", "text": "OR", "runs": [{"text": "OR"}], "level": 3, "conjunction": true}, {"id": "body-13202", "type": "paragraph", "style": "BodyText", "text": "C: ketoconazole shampoo (topical) 3 times per week for not less than 3 months", "runs": [{"text": "C:", "bold": true}, {"text": " ", "bold": true}, {"text": "ketoconazole"}, {"text": " "}, {"text": "shampoo"}, {"text": " "}, {"text": "(topical)"}, {"text": " "}, {"text": "3"}, {"text": " "}, {"text": "times"}, {"text": " "}, {"text": "per"}, {"text": " "}, {"text": "week"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "not"}, {"text": " "}, {"text": "less"}, {"text": " "}, {"text": "than"}, {"text": " "}, {"text": "3"}, {"text": " "}, {"text": "months"}]}, {"id": "body-13203", "type": "paragraph", "style": "Heading3", "text": "AND", "runs": [{"text": "AND"}], "level": 3, "conjunction": true}, {"id": "body-13204", "type": "paragraph", "style": "BodyText", "text": "A: hydrocortisone cream (topical) 12 hourly for 4-16weeks", "runs": [{"text": "A:", "bold": true}, {"text": " ", "bold": true}, {"text": "hydrocortisone"}, {"text": " "}, {"text": "cream"}, {"text": " "}, {"text": "(topical)"}, {"text": " "}, {"text": "12"}, {"text": " "}, {"text": "hourly"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "4-"}, {"text": "16weeks"}]}, {"id": "body-13205", "type": "paragraph", "style": "Heading3", "text": "OR", "runs": [{"text": "OR"}], "level": 3, "conjunction": true}, {"id": "body-13206", "type": "paragraph", "style": "BodyText", "text": "C: betamethasone valerate cream/ointment 12hourly for 4-6 weeks", "runs": [{"text": "C:", "bold": true}, {"text": " ", "bold": true}, {"text": "betamethasone"}, {"text": " "}, {"text": "valerate"}, {"text": " "}, {"text": "cream/ointment"}, {"text": " "}, {"text": "12hourly"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "4-6"}, {"text": " "}, {"text": "weeks"}]}, {"id": "body-13207", "type": "paragraph", "style": "Heading3", "text": "OR", "runs": [{"text": "OR"}], "level": 3, "conjunction": true}, {"id": "body-13208", "type": "paragraph", "style": "BodyText", "text": "S: tacrolimus Ointment (topical) (face or skin folds) 12 hourly for 4-6 weeks", "runs": [{"text": "S:", "bold": true}, {"text": " ", "bold": true}, {"text": "tacrolimus"}, {"text": " "}, {"text": "Ointment"}, {"text": " "}, {"text": "(topical)"}, {"text": " "}, {"text": "(face"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "skin"}, {"text": " "}, {"text": "folds)"}, {"text": " "}, {"text": "12"}, {"text": " "}, {"text": "hourly"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "4-6"}, {"text": " "}, {"text": "weeks"}]}, {"id": "body-13210", "type": "heading", "style": "Heading2", "text": "Anaphylaxis", "runs": [{"text": "Anaphylaxis"}], "level": 2, "list": {"level": 1, "numberingId": "1368"}}, {"id": "body-13211", "type": "paragraph", "style": "BodyText", "text": "It is an acute and often life-threatening immunologic reaction, frequently heralded by scalp pruritus, diffuse erythema, urticaria, or angioedema. Bronchospasm, laryngeal edema, hyperperistalsis, hypotension, and cardiac arrhythmia may occur. Antibiotics (especially penicillin), other drugs, and radiographic contrast agents are the most common causes of serious anaphylactic reactions.", "runs": [{"text": "It"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "an"}, {"text": " "}, {"text": "acute"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "often"}, {"text": " "}, {"text": "life-threatening"}, {"text": " "}, {"text": "immunologic"}, {"text": " "}, {"text": "reaction,"}, {"text": " "}, {"text": "frequently"}, {"text": " "}, {"text": "heralded"}, {"text": " "}, {"text": "by"}, {"text": " "}, {"text": "scalp"}, {"text": " "}, {"text": "pruritus,"}, {"text": " "}, {"text": "diffuse"}, {"text": " "}, {"text": "erythema,"}, {"text": " "}, {"text": "urticaria, or"}, {"text": " "}, {"text": "angioedema."}, {"text": " "}, {"text": "Bronchospasm,"}, {"text": " "}, {"text": "laryngeal"}, {"text": " "}, {"text": "edema,"}, {"text": " "}, {"text": "hyperperistalsis,"}, {"text": " "}, {"text": "hypotension,"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "cardiac"}, {"text": " "}, {"text": "arrhythmia"}, {"text": " "}, {"text": "may"}, {"text": " "}, {"text": "occur."}, {"text": " "}, {"text": "Antibiotics (especially penicillin), other drugs, and radiographic contrast agents are the most common causes of serious anaphylactic "}, {"text": "reactions."}]}, {"id": "body-13213", "type": "paragraph", "style": "BodyText", "text": "Management: Refer to chapter on approach to patients with emergency conditions", "runs": [{"text": "Management:", "bold": true}, {"text": " ", "bold": true}, {"text": "Refer"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "chapter"}, {"text": " "}, {"text": "on"}, {"text": " "}, {"text": "approach"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "patients"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "emergency"}, {"text": " "}, {"text": "conditions"}]}, {"id": "body-13215", "type": "heading", "style": "Heading2", "text": "Papulosquamous and Lichenoid Disorder", "runs": [{"text": "Papulosquamous"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "Lichenoid"}, {"text": " "}, {"text": "Disorder"}], "level": 2, "list": {"level": 1, "numberingId": "1368"}}], "source": {"file": "medical.docx", "chapter": "Skin diseases", "start": "body-13190", "end": "body-13215"}}