{"id": "section-body-01855", "title": "Anesthesia in Diabetic Patient", "chapterId": "chapter-two", "tocLevel": 4, "tocPath": ["APPROACH TO PATIENTS WITH EMERGENCY CONDITIONS", "ANAESTHESIA AND CRITICAL CARE", "Anaesthesia", "Anesthesia in Diabetic Patient"], "blocks": [{"id": "body-01855", "type": "heading", "style": "Heading4", "text": "Anesthesia in Diabetic Patient", "runs": [{"text": "Anesthesia"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "Diabetic"}, {"text": " "}, {"text": "Patient"}], "level": 4, "list": {"level": 3, "numberingId": "1850"}}, {"id": "body-01856", "type": "paragraph", "style": "BodyText", "text": "Perioperative Hyperglycemia is associated with increased risk of infection, medical complications and death. The following shall be considered;", "runs": [{"text": "Perioperative Hyperglycemia is associated with increased risk of infection, medical complications and death. The following shall be considered;"}]}, {"id": "body-01857", "type": "paragraph", "style": "ListParagraph", "text": "Ideally, the elective patient should have a preoperative glycated haemoglobin less than 9% or a fasting blood glucose level of 10 mmol/l or random blood glucose of 13 mmol/l.", "runs": [{"text": "Ideally,"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "elective"}, {"text": " "}, {"text": "patient"}, {"text": " "}, {"text": "should"}, {"text": " "}, {"text": "have"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "preoperative"}, {"text": " "}, {"text": "glycated"}, {"text": " "}, {"text": "haemoglobin"}, {"text": " "}, {"text": "less"}, {"text": " "}, {"text": "than"}, {"text": " "}, {"text": "9%"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "fasting"}, {"text": " "}, {"text": "blood"}, {"text": " "}, {"text": "glucose level of 10 mmol/l or random blood glucose of 13 mmol/l."}], "list": {"level": 4, "numberingId": "1850"}}, {"id": "body-01858", "type": "paragraph", "style": "ListParagraph", "text": "Screen for nephropathy, cardiac disease, retinopathy and neuropathy and inform the surgical team.", "runs": [{"text": "Screen"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "nephropathy,"}, {"text": " "}, {"text": "cardiac"}, {"text": " "}, {"text": "disease,"}, {"text": " "}, {"text": "retinopathy"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "neuropathy"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "inform"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "surgical"}, {"text": " "}, {"text": "team."}], "list": {"level": 4, "numberingId": "1850"}}, {"id": "body-01859", "type": "paragraph", "style": "ListParagraph", "text": "If on oral hypoglycemic therapy and well controlled, and surgery is minor, omit therapy on the morning of surgery and resume therapy when eating normally.", "runs": [{"text": "If on oral hypoglycemic therapy and well controlled, and surgery is minor, omit therapy on the morning of surgery and resume therapy when eating normally."}], "list": {"level": 4, "numberingId": "1850"}}, {"id": "body-01860", "type": "paragraph", "style": "ListParagraph", "text": "If on insulin, adjust depending on the type of surgery and expected fasting period as follows:", "runs": [{"text": "If"}, {"text": " "}, {"text": "on"}, {"text": " "}, {"text": "insulin,"}, {"text": " "}, {"text": "adjust"}, {"text": " "}, {"text": "depending"}, {"text": " "}, {"text": "on"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "type"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "surgery"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "expected"}, {"text": " "}, {"text": "fasting"}, {"text": " "}, {"text": "period"}, {"text": " "}, {"text": "as"}, {"text": " "}, {"text": "follows:"}], "list": {"level": 4, "numberingId": "1850"}}, {"id": "body-01862", "type": "paragraph", "style": "BodyText", "text": "Minor surgery (duration < 3hours)", "runs": [{"text": "Minor"}, {"text": " "}, {"text": "surgery"}, {"text": " "}, {"text": "(duration"}, {"text": " "}, {"text": "<"}, {"text": " "}, {"text": "3hours)"}]}, {"id": "body-01863", "type": "paragraph", "style": "BodyText", "text": "Insulin: in the morning, intermediate–acting insulin, 1/2 to 2/3 of the total daily dose.", "runs": [{"text": "Insulin:"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "morning,"}, {"text": " "}, {"text": "intermediate–acting"}, {"text": " "}, {"text": "insulin,"}, {"text": " "}, {"text": "1/2"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "2/3"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "total"}, {"text": " "}, {"text": "daily"}, {"text": " "}, {"text": "dose."}]}, {"id": "body-01864", "type": "paragraph", "style": "ListParagraph", "text": "If blood glucose is above 20 mmol/l, give a small dose of short–acting insulin.", "runs": [{"text": "If"}, {"text": " "}, {"text": "blood"}, {"text": " "}, {"text": "glucose"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "above"}, {"text": " "}, {"text": "20"}, {"text": " "}, {"text": "mmol/l,"}, {"text": " "}, {"text": "give"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "small"}, {"text": " "}, {"text": "dose"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "short–acting"}, {"text": " "}, {"text": "insulin."}], "list": {"level": 4, "numberingId": "1850"}}, {"id": "body-01865", "type": "paragraph", "style": "ListParagraph", "text": "In the evening, give intermediate–acting insulin, 1/3 of the daily dose. Fluid: 5% dextrose (IV), volume according to age.", "runs": [{"text": "In the evening, give intermediate–acting insulin, 1/3 of the daily dose. Fluid: 5% dextrose (IV), volume according to "}, {"text": "age."}], "list": {"level": 4, "numberingId": "1850"}}, {"id": "body-01867", "type": "paragraph", "style": "BodyText", "text": "Blood glucose monitoring: every 1–2 hours, target values between 10–14 mmol/l.", "runs": [{"text": "Bl