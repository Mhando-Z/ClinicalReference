ency"}, {"text": " "}, {"text": "treatments"}, {"text": " "}, {"text": "only."}], "list": {"level": 0, "numberingId": "1082"}}, {"id": "body-18326", "type": "paragraph", "style": "ListParagraph", "text": "Avoid routine radiographs.", "runs": [{"text": "Avoid"}, {"text": " "}, {"text": "routine"}, {"text": " "}, {"text": "radiographs."}], "list": {"level": 0, "numberingId": "1082"}}, {"id": "body-18327", "type": "paragraph", "style": "ListParagraph", "text": "They should be used selectively and only whenever they are needed.", "runs": [{"text": "They"}, {"text": " "}, {"text": "should"}, {"text": " "}, {"text": "be"}, {"text": " "}, {"text": "used"}, {"text": " "}, {"text": "selectively"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "only"}, {"text": " "}, {"text": "whenever"}, {"text": " "}, {"text": "they"}, {"text": " "}, {"text": "are"}, {"text": " "}, {"text": "needed."}], "list": {"level": 0, "numberingId": "1082"}}, {"id": "body-18328", "type": "heading", "style": "Heading4", "text": "For the second trimester (13-24weeks)", "runs": [{"text": "For"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "second"}, {"text": " "}, {"text": "trimester"}, {"text": " "}, {"text": "(13-"}, {"text": "24weeks)"}], "level": 4}, {"id": "body-18329", "type": "paragraph", "style": "ListParagraph", "text": "During the second trimester, the organogenesis is complete, and the risk to the fetus is low.", "runs": [{"text": "During"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "second"}, {"text": " "}, {"text": "trimester,"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "organogenesis"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "complete,"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "risk"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "fetus"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "low."}], "list": {"level": 0, "numberingId": "1082"}}, {"id": "body-18330", "type": "paragraph", "style": "ListParagraph", "text": "The mother has also had time to adjust to her pregnancy, and the fetus has not grown to a potentially uncomfortable size that would make it difficult for the mother to remain still for long periods.", "runs": [{"text": "The"}, {"text": " "}, {"text": "mother"}, {"text": " "}, {"text": "has"}, {"text": " "}, {"text": "also"}, {"text": " "}, {"text": "had"}, {"text": " "}, {"text": "time"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "adjust"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "her"}, {"text": " "}, {"text": "pregnancy,"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "fetus"}, {"text": " "}, {"text": "has"}, {"text": " "}, {"text": "not"}, {"text": " "}, {"text": "grown"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "potentially"}, {"text": " "}, {"text": "uncomfortable size that would make it difficult for the mother to remain still for long periods."}], "list": {"level": 0, "numberingId": "1082"}}, {"id": "body-18332", "type": "heading", "style": "Heading4", "text": "Recommendations", "runs": [{"text": "Recommendations"}], "level": 4}, {"id": "body-18333", "type": "paragraph", "style": "ListParagraph", "text": "Maintenance of oral hygiene and plaque control.", "runs": [{"text": "Maintenance"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "oral"}, {"text": " "}, {"text": "hygiene"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "plaque"}, {"text": " "}, {"text": "control."}], "list": {"level": 0, "numberingId": "1082"}}, {"id": "body-18334", "type": "paragraph", "style": "ListParagraph", "text": "It’s safe to perform scaling, polishing and curettage if necessary.", "runs": [{"text": "It’s"}, {"text": " "}, {"text": "safe"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "perform"}, {"text": " "}, {"text": "scaling,"}, {"text": " "}, {"