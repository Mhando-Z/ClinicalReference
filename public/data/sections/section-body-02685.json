{"id": "section-body-02685", "title": "Von Willebrand Disease (VWD)", "chapterId": "chapter-three", "tocLevel": 4, "tocPath": ["APPROACH TO PATIENTS WITH EMERGENCY CONDITIONS", "HAEMATOLOGY AND BLOOD TRANSFUSION", "Bleeding Disorders", "Von Willebrand Disease (VWD)"], "blocks": [{"id": "body-02685", "type": "heading", "style": "Heading4", "text": "Von Willebrand Disease (VWD)", "runs": [{"text": "Von"}, {"text": " "}, {"text": "Willebrand"}, {"text": " "}, {"text": "Disease"}, {"text": " "}, {"text": "(VWD)"}], "level": 4, "list": {"level": 2, "numberingId": "1835"}}, {"id": "body-02686", "type": "paragraph", "style": "BodyText", "text": "Von Willebrand Disease is an inherited disease due to a deficiency of vWF. It is the commonest bleeding disorder in the population, especially in women.", "runs": [{"text": "Von"}, {"text": " "}, {"text": "Willebrand"}, {"text": " "}, {"text": "Disease"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "an"}, {"text": " "}, {"text": "inherited"}, {"text": " "}, {"text": "disease"}, {"text": " "}, {"text": "due"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "deficiency"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "vWF."}, {"text": " "}, {"text": "It"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "commonest"}, {"text": " "}, {"text": "bleeding"}, {"text": " "}, {"text": "disorder"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "the population, especially in women."}]}, {"id": "body-02688", "type": "heading", "style": "Heading4", "text": "Clinical Presentation", "runs": [{"text": "Clinical"}, {"text": " "}, {"text": "Presentation"}], "level": 4}, {"id": "body-02689", "type": "paragraph", "style": "BodyText", "text": "History of easy bruising, Menorrhagia, Gum bleeding, Joint bleeding in severe cases", "runs": [{"text": "History"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "easy"}, {"text": " "}, {"text": "brui