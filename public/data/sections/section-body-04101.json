{"text": "of"}, {"text": " "}, {"text": "Mpox"}, {"text": " "}, {"text": "can"}, {"text": " "}, {"text": "present"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "either"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "following"}, {"text": " "}, {"text": "spectrum"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "symptoms."}]}, {"id": "body-04113", "type": "paragraph", "style": "BodyText", "text": "Acute onset of fever (>38.5°C), headache, myalgia (muscle pain/body aches), back pain, profound weakness, or fatigue OR", "runs": [{"text": "Acute"}, {"text": " "}, {"text": "onset"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "fever"}, {"text": " "}, {"text": "(>38.5°C),"}, {"text": " "}, {"text": "headache,"}, {"text": " "}, {"text": "myalgia"}, {"text": " "}, {"text": "(muscle"}, {"text": " "}, {"text": "pain/body"}, {"text": " "}, {"text": "aches),"}, {"text": " "}, {"text": "back"}, {"text": " "}, {"text": "pain,"}, {"text": " "}, {"text": "profound"}, {"text": " "}, {"text": "weakness,"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "fatigue "}, {"text": "OR"}]}, {"id": "body-04114", "type": "paragraph", "style": "BodyText", "text": "A person presenting with an unexplained acute skin rash, mucosal lesions or lymphadenopathy (swollen lymph nodes). Ano- rectal lesions can also manifest as ano-rectal inflammation (proctitis), pain and/or bleeding", "runs": [{"text": "A"}, {"text": " "}, {"text": "person"}, {"text": " "}, {"text": "presenting"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "an"}, {"text": " "}, {"text": "unexplained"}, {"text": " "}, {"text": "acute"}, {"text": " "}, {"text": "skin"}, {"text": " "}, {"text": "rash,"}, {"text": " "}, {"text": "mucosal"}, {"text": " "}, {"text": "lesions"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "lymphadenopathy"}, {"text": " "}, {"text": "(swollen"}, {"text": " "}, {"text": "lymph"}, {"text": " "}, {"text": "nodes)."}, {"text": " "}, {"text": "Ano- rectal lesions can also manifest as ano-rectal inflammation (proctitis), pain and/or bleeding"}]}, {"id": "body-04116", "type": "paragraph", "style": "BodyText", "text": "Probable: A suspected case with one or more of the following:", "runs": [{"text": "Probable:", "bold": true}, {"text": " ", "bold": true}, {"text": "A"}, {"text": " "}, {"text": "suspected"}, {"text": " "}, {"text": "case"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "one"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "more"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "following:"}]}, {"id": "body-04117", "type": "paragraph", "style": "ListParagraph", "text": "Has an epidemiological link to a probable or confirmed case of Mpox in the 21 days before symptom onset?", "runs": [{"text": "Has"}, {"text": " "}, {"text": "an"}, {"text": " "}, {"text": "epidemiological"}, {"text": " "}, {"text": "link"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "probable"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "confirmed"}, {"text": " "}, {"text": "case"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "Mpox"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "21"}, {"text": " "}, {"text": "days"}, {"text": " "}, {"text": "before"}, {"text": " "}, {"text": "symptom"}, {"text": " "}, {"text": "onset?"}], "list": {"level": 0, "numberingId": "1770"}}, {"id": "body-04118", "type": "paragraph", "style": "ListParagraph", "text": "Has had multiple and/or casual sexual partners in the 21 days before symptom onset", "runs": [{"text": "Has"}, {"text": " "}, {"text": "had"}, {"text": " "}, {"text": "multiple"}, {"text": " "}, {"text": "and/or"}, {"text": " "}, {"text": "casual"}, {"text": " "}, {"text": "sexual"}, {"text": " "}, {"text": "partners"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "21"}, {"text": " "}, {"text": "days"}, {"text": " "}, {"text": "before"}, {"text": " "}, {"text": "symptom"}, {"text": " "}, {"text": "onset"}], "list": {"level": 0, "numberingId": "1770"}}, {"id": "body-04119", "type": "paragraph", "style": "ListParagraph", "text": "Has a positive test result for orthopoxviral infection (e.g., OPXV-specific PCR without MPXV-specific PCR or sequencing).", "runs": [{"text": "Has"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "positive"}, {"text": " "}, {"text": "test"}, {"text": " "}, {"text": "result"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "orthopoxviral"}, {"text": " "}, {"text": "infection"}, {"text": " "}, {"text": "(e.g.,"}, {"text": " "}, {"text": "OPXV-specific"}, {"text": " "}, {"text": "PCR"}, {"text": " "}, {"text": "without"}, {"text": " "}, {"text": "MPXV-specific"}, {"text": " "}, {"text": "PCR"}, {"text": " "}, {"text": "or "}, {"text": "sequencing)."}], "list": {"level": 0, "numberingId": "1770"}}, {"id": "body-04120", "type": "paragraph", "style": "BodyText", "text": "Confirmed: A person with laboratory confirmed MPXV infection by detection of unique sequences of viral DNA by real-time polymerase chain reaction (PCR) and/or sequencing.", "runs": [{"text": "Confirmed:", "bold": true}, {"text": " ", "bold": true}, {"text": "A"}, {"text": " "}, {"text": "person with laboratory confirmed MPXV infection by detection of unique sequences of viral DNA"}, {"text": " "}, {"text": "by real-time polymerase chain reaction (PCR) and/or sequencing."}]}, {"id": "body-04122", "type": "heading", "style": "Heading4", "text": "Transmission", "runs": [{"text": "Transmission"}], "level": 4}, {"id": "body-04123", "type": "paragraph", "style": "BodyText", "text": "Mpox spreads from person to person mainly through close contact with someone who has Mpox, including members of a household. Close contact includes skin-to-skin (such as touching or sex) and mouth-to-mouth or mouth-to-skin contact (such as kissing), and it can also include being face-to-face with someone who has Mpox (such as talking or breathing close to one another, which can generate infectious respiratory particles). People can also contract Mpox from contaminated objects such as clothing or linen, through needle injuries in health care, or in community settings such as tattoo parlours. During pregnancy or birth, the virus may be passed to the baby. Contracting Mpox during pregnancy can be dangerous for the fetus or newborn infant and can lead to loss of the pregnancy, stillbirth, death of the newborn, or complications for the parent.", "runs": [{"text": "Mpox spreads from person to person mainly through close contact with someone who has Mpox, including members of a household."}, {"text": " "}, {"text": "Close"}, {"text": " "}, {"text": "contact"}, {"text": " "}, {"text": "includes"}, {"text": " "}, {"text": "skin-to-skin"}, {"text": " "}, {"text": "(such"}, {"text": " "}, {"text": "as"}, {"text": " "}, {"text": "touching"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "sex)"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "mouth-to-mouth"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "mouth-to-skin"}, {"text": " "}, {"text": "contact"}, {"text": " "}, {"text": "(such as"}, {"text": " "}, {"text": "kissing),"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "it"}, {"text": " "}, {"text": "can"}, {"text": " "}, {"text": "also"}, {"text": " "}, {"text": "include"}, {"text": " "}, {"text": "being"}, {"text": " "}, {"text": "face-to-face"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "someone"}, {"text": " "}, {"text": "who"}, {"text": " "}, {"text": "has"}, {"text": " "}, {"text": "Mpox"}, {"text": " "}, {"text": "(such"}, {"text": " "}, {"text": "as"}, {"text": " "}, {"text": "talking"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "breathing"}, {"text": " "}, {"text": "close"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text