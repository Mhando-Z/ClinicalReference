{"id": "section-body-18411", "title": "Temporomandibular Joint (TMJ) Dislocation.", "chapterId": "chapter-sixteen", "tocLevel": 4, "tocPath": ["APPROACH TO PATIENTS WITH EMERGENCY CONDITIONS", "ORAL AND MAXILLOFACIAL CONDITIONS", "Temporal Mandibular Disorder and Chronic Orofacial Pain", "Temporomandibular Joint (TMJ) Dislocation."], "blocks": [{"id": "body-18411", "type": "heading", "style": "Heading4", "text": "Temporomandibular Joint (TMJ) Dislocation.", "runs": [{"text": "Temporomandibular"}, {"text": " "}, {"text": "Joint"}, {"text": " "}, {"text": "(TMJ)"}, {"text": " "}, {"text": "Dislocation."}], "level": 4, "list": {"level": 2, "numberingId": "1126"}}, {"id": "body-18412", "type": "paragraph", "style": "BodyText", "text": "TMJ dislocation occurs when the mandibular condyle moves out of its normal position in the glenoid fossa of the temporal bone, typically anterior to the articular eminence. It can be unilateral or bilateral and is often painful and distressing for the patient.", "runs": [{"text": "TMJ"}, {"text": " "}, {"text": "dislocation"}, {"text": " "}, {"text": "occurs"}, {"text": " "}, {"text": "when"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "mandibular"}, {"text": " "}, {"text": "condyle"}, {"text": " "}, {"text": "moves"}, {"text": " "}, {"text": "out"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "its"}, {"text": " "}, {"text": "normal"}, {"text": " "}, {"text": "position"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "glenoid"}, {"text": " "}, {"text": "fossa"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "temporal"}, {"text": " "}, {"text": "bone, typically anterior to the articular eminence. It can be unilateral or bilateral and is often painful and distressing for the patient."}]}, {"id": "body-18414", "type": "heading", "style": "Heading4", "text": "Clinical Presentation", "runs": [{"text": "Clinical"}, {"text": " "}, {"text": "