{"id": "section-body-12201", "title": "Lymphogranuloma Venereum (LGV)", "chapterId": "chapter-twelve", "blocks": [{"id": "body-12201", "type": "heading", "style": "Heading2", "text": "Lymphogranuloma Venereum (LGV)", "runs": [{"text": "Lymphogranuloma"}, {"text": " "}, {"text": "Venereum"}, {"text": " "}, {"text": "(LGV)"}], "level": 2, "list": {"level": 1, "numberingId": "1397"}}, {"id": "body-12202", "type": "paragraph", "style": "BodyText", "text": "A sexually transmitted infection caused by invasive strains (L1, L2, L3) of Chlamydia trachomatis. It is characterized by transient genital lesions followed by painful lymphadenopathy or proctocolitis.", "runs": [{"text": "A"}, {"text": " "}, {"text": "sexually"}, {"text": " "}, {"text": "transmitted"}, {"text": " "}, {"text": "infection"}, {"text": " "}, {"text": "caused"}, {"text": " "}, {"text": "by"}, {"text": " "}, {"text": "invasive"}, {"text": " "}, {"text": "strains"}, {"text": " "}, {"text": "(L1,"}, {"text": " "}, {"text": "L2,"}, {"text": " "}, {"text": "L3)"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "Chlamydia"}, {"text": " "}, {"text": "trachomatis."}, {"text": " "}, {"text": "It"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "characterized"}, {"text": " "}, {"text": "by"}, {"text": " "}, {"text": "transient genital lesions followed by painful lymphadenopathy or proctocolitis."}]}, {"id": "body-12204", "type": "heading", "style": "Heading4", "text": "Clinical Presentation", "runs": [{"text": "Clinical"}, {"text": " "}, {"text": "Presentation"}], "level": 4}, {"id": "body-12205", "type": "paragraph", "style": "BodyText", "text": "Painful inguinal buboes, genital ulcers, rectal pain and discharge.", "runs": [{"text": "Painful"}, {"text": " "}, {"text": "inguinal"}, {"text": " "}, {"text": "buboes,"}, {"text": " "}, {"text": "genital"}, {"text": " "}, {"text": "ulcers,"}, {"text": " "}, {"text": "rectal"}, {"text": " "}, {"text": "pain"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "discharge."}]}, {"id": "body-12207", "type": "heading", "style": "Heading4", "text": "Investigations", "runs": [{"text": "Investigations"}], "level": 4}, {"id": "body-12208", "type": "paragraph", "style": "BodyText", "text": "NAAT for C. trachomatis serovars L1-L3, PCR.", "runs": [{"text": "NAAT"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "C."}, {"text": " "}, {"text": "trachomatis"}, {"text": " "}, {"text": "serovars"}, {"text": " "}, {"text": "L1-L3,"}, {"text": " "}, {"text": "PCR."}]}, {"id": "body-12210", "type": "heading", "style": "Heading4", "text": "Pharmacological Management", "runs": [{"text": "Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-12211", "type": "paragraph", "style": "BodyText", "text": "A: doxycycline (PO) 100mg 12hourly for 21 days. Surgical drainage of buboes if necessary.", "runs": [{"text": "A:", "bold": true}, {"text": " ", "bold": true}, {"text": "doxycycline"}, {"text": " "}, {"text": "(PO)"}, {"text": " "}, {"text": "100mg"}, {"text": " "}, {"text": "12hourly"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "21"}, {"text": " "}, {"text": "days. Surgical drainage of buboes if necessary."}]}], "source": {"file": "medical.docx", "chapter": "Sexually transmitted infections", "start": "body-12201", "end": "body-12211"}}