{"id": "section-body-03136", "title": "Prevention", "chapterId": "chapter-four", "tocLevel": 4, "tocPath": ["APPROACH TO PATIENTS WITH EMERGENCY CONDITIONS", "MANAGEMENT OF HIV AND AIDS", "Management of Adult and Adolescent Living with HIV with Antiretroviral Therapy", "Prevention of vertical transmission of HIV, Syphilis and Hepatitis B"], "blocks": [{"id": "body-03136", "type": "heading", "style": "Heading4", "text": "Prevention", "runs": [{"text": "Prevention"}], "level": 4}, {"id": "body-03137", "type": "paragraph", "style": "ListParagraph", "text": "Drink treated or boiled water from safe sources (taps, decontaminated deep wells, bottles)", "runs": [{"text": "Drink"}, {"text": " "}, {"text": "treated"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "boiled"}, {"text": " "}, {"text": "water"}, {"text": " "}, {"text": "from"}, {"text": " "}, {"text": "safe"}, {"text": " "}, {"text": "sources"}, {"text": " "}, {"text": "(taps,"}, {"text": " "}, {"text": "decontaminated"}, {"text": " "}, {"text": "deep"}, {"text": " "}, {"text": "wells,"}, {"text": " "}, {"text": "bottles)"}], "list": {"level": 0, "numberingId": "1791"}}, {"id": "body-03138", "type": "paragraph", "style": "ListParagraph", "text": "Boil water or treat to kill bacteria and make it safe for drinking and for other domestic uses", "runs": [{"text": "Boil"}, {"text": " "}, {"text": "water"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "treat"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "kill"}, {"text": " "}, {"text": "bacteria"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "make"}, {"text": " "}, {"text": "it"}, {"text": " "}, {"text": "safe"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "drinking"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "other"}, {"text": " "}, {"text": "domestic"}, {"text": " uses"}], "list": {"level": 0, "numberingId": "1791"}}, {"id": "body-03139", "type": "paragraph", "style": "ListParagraph", "text": "Wash hands with liquid soap and running water after visiting the toilet, before preparing foods, and before eating", "runs": [{"text": "Wash"}, {"text": " "}, {"text": "hands"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "liquid"}, {"text": " "}, {"text": "soap"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "running"}, {"text": " "}, {"text": "water"}, {"text": " "}, {"text": "after"}, {"text": " "}, {"text": "visiting"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "toilet,"}, {"text": " "}, {"text": "before"}, {"text": " "}, {"text": "preparing"}, {"text": " "}, {"text": "foods,"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "before"}, {"text": " "}, {"text": "eating"}], "list": {"level": 0, "numberingId": "1791"}}, {"id": "body-03140", "type": "paragraph", "style": "ListParagraph", "text": "DO NOT eat uncooked food from the street and do not eat cooked food that is no longer hot", "runs": [{"text": "DO"}, {"text": " "}, {"text": "NOT"}, {"text": " "}, {"text": "eat"}, {"text": " "}, {"text": "uncooked"}, {"text": " "}, {"text": "food"}, {"text": " "}, {"text": "from"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "street"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "do"}, {"text": " "}, {"text": "not"}, {"text": " "}, {"text": "eat"}, {"text": " "}, {"text": "cooked"}, {"text": " "}, {"text": "food"}, {"text": " "}, {"text": "that"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "no"}, {"text": " "}, {"text": "longer"}, {"text": " hot"}], "list": {"level": 0, "numberingId": "1791"}}, {"id": "body-03141", "type": "paragraph", "style": "ListParagraph", "text": "DO NOT eat street prepared fruits. Always eat home prepared fresh fruits", "runs": [{"text": "DO"}, {"text": " "}, {"text": "NOT"}, {"text": " "}, {"text": "eat"}, {"text": " "}, {"text": "street"}, {"text": " "}, {"text": "prepared"}, {"text": " "}, {"text": "fruits."}, {"text": " "}, {"text": "Always"}, {"text": " "}, {"text": "eat"}, {"text": " "}, {"text": "home"}, {"text": " "}, {"text": "prepared"}, {"text": " "}, {"text": "fresh"}, {"text": " "}, {"text": "fruits"}], "list": {"level": 0, "numberingId": "1791"}}, {"id": "body-03143", "type": "heading", "style": "Heading4", "text": "Pharmacological Management", "runs": [{"text": "Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-03144", "type": "paragraph", "style": "BodyText", "text": "Cholera requires immediate treatment because the disease can cause death within hours. There are three elements of treatment: Rehydration, Antibiotic Treatment, Zinc and Folic Acid Supplements.", "runs": [{"text": "Cholera requires immediate treatment because the disease can cause death within hours. There are three elements of treatment: Rehydration, Antibiotic Treatment, Zinc and Folic Acid Supplements."}]}, {"id": "body-03146", "type": "heading", "style": "Heading4", "text": "Rehydration", "runs": [{"text": "Rehydration"}], "level": 4, "list": {"level": 0, "numberingId": "1800"}}, {"id": "body-03148", "type": "paragraph", "style": "BodyText", "text": "Assess the patient's level of dehydration as per National Guidelines for Prevention and Control of Cholera. It is of paramount importance to make correct diagnosis and administer the right treatment.", "runs": [{"text": "Assess"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "patient's"}, {"text": " "}, {"text": "level"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "dehydration"}, {"text": " "}, {"text": "as"}, {"text": " "}, {"text": "per"}, {"text": " "}, {"text": "National"}, {"text": " "}, {"text": "Guidelines"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "Prevention"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "Control"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "Cholera."}, {"text": " "}, {"text": "It"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "paramount importance to make correct diagnosis and administer the right treatment."}]}, {"id": "body-03149", "type": "paragraph", "style": "ListParagraph", "text": "Plan A: No dehydration,", "runs": [{"text": "Plan"}, {"text": " "}, {"text": "A:"}, {"text": " "}, {"text": "No"}, {"text": " "}, {"text": "dehydration,"}], "list": {"level": 1, "numberingId": "1800"}}, {"id": "body-03150", "type": "paragraph", "style": "ListParagraph", "text": "Plan B: Moderate dehydration and", "runs": [{"text": "Plan"}, {"text": " "}, {"text": "B:"}, {"text": " "}, {"text": "Moderate"}, {"text": " "}, {"text": "dehydration"}, {"text": " "}, {"text": "and"}], "list": {"level": 1, "numberingId": "1800"}}, {"id": "body-03151", "type": "paragraph", "style": "ListParagraph", "text": "Plan C: Severe dehydration.", "runs": [{"text": "Plan"}, {"text": " "}, {"text": "C:"}, {"text": " "}, {"text": "Severe"}, {"text": " "}, {"text": "dehydration."}], "list": {"level": 1, "numberingId": "1800"}}, {"id": "body-03153", "type": "heading", "style": "Heading4", "text": "For Severe dehydration:", "runs": [{"text": "For"}, {"text": " "}, {"text": "Severe"}, {"text": " "}, {"text": "dehydration:"}], "level": 4}, {"id": "body-03154", "type": "paragraph", "style": "ListParagraph", "text": "Administer intravenous (IV) fluid immediately to replace fluid deficit; Use Ringer Lactate solution or, if that is not available, 0.9% sodium chloride solution. Give 100 ml/kg IV in 3 hours, 30 ml/kg as rapidly as possible (within 30 min) then 70 ml/kg in the next 2.5 hours.", "runs": [{"text": "Administer intravenous (IV) fluid immediately to replace fluid deficit; Use Ringer Lactate solution or, if that is not available, 0.9% sodium chloride solution. Give 100 ml/kg IV in 3 hours, 30 ml/kg as rapidly as possible (within 30 min) then 70 ml/kg in the next 2.5 hours."}], "list": {"level": 1, "numberingId": "1800"}}, {"id": "body-03155", "type": "paragraph", "style": "ListParagraph", "text": "After the initial 30 ml/kg has been administered, the radial pulse should be strong and blood pressure should be normal. If the pulse is not yet strong, continue to give IV fluid rapidly. Administer ORS solution (about 5 ml/kg/hour) as soon as the patient can drink, in addition to IV fluid.", "runs": [{"text": "After the initial 30 ml/kg has been administered, the radial pulse should be strong and blood pressure should be normal. If the pulse is not yet strong, continue to give IV fluid rapidly."}, {"text": " "}, {"text": "Administer ORS solution (about 5 ml/kg/hour) as soon as the patient can drink, in addition to IV fluid."}], "list": {"level": 1, "numberingId": "1800"}}, {"id": "body-03156", "type": "paragraph", "style": "ListParagraph", "text": "If the patient can drink, begin giving A: oral rehydration salt solution (ORS) by mouth while the drip is being set up; ORS can provide the potassium, bicarbonate, and glucose that saline solution lacks.", "runs": [{"text": "If the patient can drink, begin giving"}, {"text": " "}, {"text": "A: oral rehydration salt solution (ORS) by mouth while the drip is being set up; ORS can provide the potassium, bicarbonate, and glucose that saline solution lacks."}], "list": {"level": 1, "numberingId": "1800"}}, {"id": "body-03157", "type": "heading", "style": "Heading4", "text": "Antibiotic treatment", "runs": [{"text": "Antibiotic"}, {"text": " "}, {"text": "treatment"}], "level": 4, "list": {"level": 0, "numberingId": "1800"}}, {"id": "body-03159", "type": "paragraph", "style": "BodyText", "text": "Antibiotic treatment to patients with severe dehydration is as follows:", "runs": [{"text": "Antibiotic"}, {"text": " "}, {"text": "treatment"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "patients"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "severe"}, {"text": " "}, {"text": "dehydration"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "as"}, {"text": " "}, {"text": "follows:"}]}, {"id": "body-03161", "type": "paragraph", "style": "BodyText", "text": "Adults (Not for pregnant women)", "runs": [{"text": "Adults"}, {"text": " "}, {"text": "(Not"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "pregnant"}, {"text": " "}, {"text": "women)"}]}, {"id": "body-03163", "type": "paragraph", "style": "BodyText", "text": "A: doxycycline (PO) 300 mg start", "runs": [{"text": "A:", "bold": true}, {"text": " ", "bold": true}, {"text": "doxycycline"}, {"text": " "}, {"text": "(PO)"}, {"text": " "}, {"text": "300"}, {"text": " "}, {"text": "mg"}, {"text": " "}, {"text": "start"}]}, {"id": "body-03164", "type": "paragraph", "style": "Heading3", "text": "OR", "runs": [{"text": "OR"}], "level": 3, "conjunction": true}, {"id": "body-03165", "type": "paragraph", "style": "BodyText", "text": "A: ciprofloxacin (PO) 1g stat then 500mg (PO) 12 hourly for 7 days", "runs": [{"text": "A:", "bold": true}, {"text": " ", "bold": true}, {"text": "ciprofloxacin"}, {"text": " "}, {"text": "(PO)"}, {"text": " "}, {"text": "1g"}, {"text": " "}, {"text": "stat"}, {"text": " "}, {"text": "then"}, {"text": " "}, {"text": "500mg"}, {"text": " "}, {"text": "(PO)"}, {"text": " "}, {"text": "12"}, {"text": " "}, {"text": "hourly"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "7"}, {"text": " days"}]}, {"id": "body-03166", "type": "paragraph", "style": "Heading3", "text": "OR", "runs": [{"text": "OR"}], "level": 3, "conjunction": true}, {"id": "body-03167", "type": "paragraph", "style": "BodyText", "text": "B: azithromycin (PO) 500mg once a day for 7 days Expectant mothers:", "runs": [{"text": "B:", "bold": true}, {"text": " ", "bold": true}, {"text": "azithromycin"}, {"text": " "}, {"text": "(PO)"}, {"text": " "}, {"text": "500mg"}, {"text": " "}, {"text": "once"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "day"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "7"}, {"text": " "}, {"text": "days Expectant mothers:"}]}, {"id": "body-03168", "type": "paragraph", "style":