ype": "paragraph", "style": "ListParagraph", "text": "VDRL", "runs": [{"text": "VDRL"}], "list": {"level": 0, "numberingId": "1260"}}, {"id": "body-14725", "type": "paragraph", "style": "ListParagraph", "text": "HIV Testing", "runs": [{"text": "HIV"}, {"text": " "}, {"text": "Testing"}], "list": {"level": 0, "numberingId": "1260"}}, {"id": "body-14728", "type": "heading", "style": "Heading4", "text": "Pharmacological Management", "runs": [{"text": "Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-14729", "type": "paragraph", "style": "BodyText", "text": "Treatment for uveitis is mainly steroids and specific treatment according to the cause. This should be initiated in a facility where workup and close monitoring can be done.", "runs": [{"text": "Treatment"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "uveitis"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "mainly"}, {"text": " "}, {"text": "steroids"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "specific"}, {"text": " "}, {"text": "treatment"}, {"text": " "}, {"text": "according"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "cause."}, {"text": " "}, {"text": "This"}, {"text": " "}, {"text": "should"}, {"text": " "}, {"text": "be"}, {"text": " "}, {"text": "initiated"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "facility"}, {"text": " "}, {"text": "where workup and close monitoring can be done."}]}, {"id": "body-14731", "type": "paragraph", "style": "BodyText", "text": "Steroidal Anti-inflammatory medicines", "runs": [{"text": "Steroidal"}, {"text": " "}, {"text": "Anti-inflammatory"}, {"text": " "}, {"text": "medicines"}]}, {"id": "body-14733", "type": "paragraph", "style": "BodyText", "text": "D: dexamethasone 1% eye drops, 1–3hourly in the affected eye for 4-6weeks", "runs": [{"text": "D:", "bold": true}, {"text": " ", "bold": true}, {"text": "dexamethasone"}, {"text": " "}, {"text": "1%"}, {"text": " "}, {"text": "eye"}, {"text": " "}, {"text": "drops,"}, {"text": " "}, {"text": "1–3hourly"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "affected"}, {"text": " "}, {"text": "eye"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "4-"}, {"text": "6weeks"}]}, {"id": "body-14734", "type": "paragraph", "style": "Heading3", "text": "OR", "runs": [{"text": "OR"}], "level": 3, "conjunction": true}, {"id": "body-14735", "type": "paragraph", "style": "BodyText", "text": "D: prednisolone 0.5% or 1 % eye drops, 1–3hourly in the affected eye for 6weeks", "runs": [{"text": "D:", "bold": true}, {"text": " ", "bold": true}, {"text": "prednisolone"}, {"text": " "}, {"text": "0.5%"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "1"}, {"text": " "}, {"text": "%"}, {"text": " "}, {"text": "eye"}, {"text": " "}, {"text": "drops,"}, {"text": " "}, {"text": "1–3hourly"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "affected"}, {"text": " "}, {"text": "eye"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "6weeks"}]}, {"id": "body-14736", "type": "paragraph", "style": "Heading3", "text": "OR", "runs": [{"text": "OR"}], "level": 3, "conjunction": true}, {"id": "body-14737", "type": "paragraph", "style": "BodyText", "text": "D: betamethasone 1% eye drops, 1–3hourly in the affected eye for 4-6weeks", "runs": [{"text": "D:", "bold": true}, {"text": " ", "bold": true}, {"text": "betamethasone"}, {"text": " "}, {"text": "1%"}, {"text": " "}, {"text": "eye"}, {"text": " "}, {"text": "drops,"}, {"text": " "}, {"text": "1–3hourly"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "affected"}, {"text": " "}, {"text": "eye"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "4-"}, {"text": "6weeks"}]}, {"id": "body-14738", "type": "paragraph", "style": "Heading3", "text": "AND", "runs": [{"text":