{"id": "section-body-16393", "title": "Pharyngotonsillitis", "chapterId": "chapter-fifteen", "tocLevel": 4, "tocPath": ["APPROACH TO PATIENTS WITH EMERGENCY CONDITIONS", "EAR, NOSE AND THROAT/HEAD AND NECK DISEASES", "Throat Conditions", "Pharyngotonsillitis"], "blocks": [{"id": "body-16393", "type": "heading", "style": "Heading4", "text": "Pharyngotonsillitis", "runs": [{"text": "Pharyngotonsillitis"}], "level": 4, "list": {"level": 2, "numberingId": "1219"}}, {"id": "body-16394", "type": "paragraph", "style": "BodyText", "text": "Acute inflammation of the pharynx and/or tonsils, commonly viral; bacterial cases often due to Group A Streptococcus (GAS). It is a frequent cause of outpatient visits in children aged 3–15 years.", "runs": [{"text": "Acute inflammation of the pharynx and/or tonsils, commonly viral; bacterial cases often due to Group A Streptococcus (GAS). It is a frequent cause of outpatient visits in children aged 3–15 years."}]}, {"id": "body-16397", "type": "heading", "style": "Heading4", "text": "Clinical Presentation", "runs": [{"text": "Clinical"}, {"text": " "}, {"text": "Presentation"}], "level": 4}, {"id": "body-16398", "type": "paragraph", "style": "ListParagraph", "text": "Fever, Sore throat or pain on swallowing, red/swollen tonsils, with or without exudate, Enlarged, tender anterior cervical lymph nodes.", "runs": [{"text": "Fever, Sore throat or pain on swallowing, red/swollen tonsils, with or without exudate, Enlarged, tender anterior cervical lymph nodes."}], "list": {"level": 0, "numberingId": "1173"}}, {"id": "body-16400", "type": "paragraph", "style": "ListParagraph", "text": "Headache, abdominal pain, vomiting (in GAS)", "runs": [{"text": "Headache,"}, {"text": " "}, {"text": "abdominal"}, {"text": " "}, {"text": "pain,"}, {"text": " "}, {"text": "vomiting"}, {"text": " "}, {"text": "(in"}, {"text": " "}, {"text": "GAS)"}], "list": {"level": 0, "numberingId": "1173"}}, {"id": "body-16401", "type": "paragraph", "style": "ListParagraph"