{"id": "section-body-17638", "title": "Ludwig’s Angina", "chapterId": "chapter-sixteen", "blocks": [{"id": "body-17638", "type": "heading", "style": "Heading2", "text": "Ludwig’s Angina", "runs": [{"text": "Ludwig’s"}, {"text": " "}, {"text": "Angina"}], "level": 2, "list": {"level": 1, "numberingId": "1126"}}, {"id": "body-17639", "type": "paragraph", "style": "BodyText", "text": "This is a serious life-threatening generalized septic cellulitis of the fascia spaces found on the floor of the mouth and tongue. It is an extension of infection from mandibular molar teeth into the floor of the mouth covering the submandibular, sublingual, and submental spaces bilaterally.", "runs": [{"text": "This"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "serious"}, {"text": " "}, {"text": "life-threatening"}, {"text": " "}, {"text": "generalized"}, {"text": " "}, {"text": "septic"}, {"text": " "}, {"text": "cellulitis"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "fascia"}, {"text": " "}, {"text": "spaces"}, {"text": " "}, {"text": "found"}, {"text": " "}, {"text": "on"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "floor"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "mouth"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "tongue."}, {"text": " "}, {"text": "It is"}, {"text": " "}, {"text": "an"}, {"text": " "}, {"text": "extension"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "infection"}, {"text": " "}, {"text": "from"}, {"text": " "}, {"text": "mandibular"}, {"text": " "}, {"text": "molar"}, {"text": " "}, {"text": "teeth"}, {"text": " "}, {"text": "into"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "floor"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "mouth"}, {"text": " "}, {"text": "covering"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "submandibular,"}, {"text": " "}, {"text": "sublingual,"}, {"text": " "}, {"text": "and submental spaces bilaterally."}]}, {"id": "body-17642", "type": "heading", "style": "Heading4", "text": "Clinical Presentation", "runs": [{"text": "Clinical"}, {"text": " "}, {"text": "Presentation"}], "level": 4}, {"id": "body-17643", "type": "paragraph", "style": "ListParagraph", "text": "Brawny induration", "runs": [{"text": "Brawny"}, {"text": " "}, {"text": "induration"}], "list": {"level": 0, "numberingId": "1117"}}, {"id": "body-17644", "type": "paragraph", "style": "ListParagraph", "text": "Tissues are swollen, board like, not pitted and no fluctuance", "runs": [{"text": "Tissues"}, {"text": " "}, {"text": "are"}, {"text": " "}, {"text": "swollen,"}, {"text": " "}, {"text": "board"}, {"text": " "}, {"text": "like,"}, {"text": " "}, {"text": "not"}, {"text": " "}, {"text": "pitted"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "no "}, {"text": "fluctuance"}], "list": {"level": 0, "numberingId": "1117"}}, {"id": "body-17645", "type": "paragraph", "style": "ListParagraph", "text": "Respiratory distress", "runs": [{"text": "Respiratory"}, {"text": " "}, {"text": "distress"}], "list": {"level": 0, "numberingId": "1117"}}, {"id": "body-17646", "type": "paragraph", "style": "ListParagraph", "text": "Dysphagia", "runs": [{"text": "Dysphagia"}], "list": {"level": 0, "numberingId": "1117"}}, {"id": "body-17648", "type": "paragraph", "style": "ListParagraph", "text": "Tissues may become gangrenous with a peculiar lifeless appearance on cutting", "runs": [{"text": "Tissues"}, {"text": " "}, {"text": "may"}, {"text": " "}, {"text": "become"}, {"text": " "}, {"text": "gangrenous"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "peculiar lifeless appearance on cutting"}], "list": {"level": 0, "numberingId": "1117"}}, {"id": "body-17649", "type": "paragraph", "style": "ListParagraph", "text": "Three fascia spaces are involved bilaterally (submandibular, submental, and sublingual)", "runs": [{"text": "Three"}, {"text": " "}, {"text": "fascia"}, {"text": " "}, {"text": "spaces"}, {"text": " "}, {"text": "are"}, {"text": " "}, {"text": "involved"}, {"text": " "}, {"text": "bilaterally (submandibular, submental, and sublingual)"}], "list": {"level": 0, "numberingId": "1117"}}, {"id": "body-17652", "type": "heading", "style": "Heading4", "text": "Investigations", "runs": [{"text": "Investigations"}], "level": 4}, {"id": "body-17653", "type": "paragraph", "style": "BodyText", "text": "Routine investigations", "runs": [{"text": "Routine"}, {"text": " "}, {"text": "investigations"}]}, {"id": "body-17654", "type": "paragraph", "style": "ListParagraph", "text": "Blood Glucose (Fasting/Random)", "runs": [{"text": "Blood"}, {"text": " "}, {"text": "Glucose"}, {"text": " "}, {"text": "(Fasting/Random)"}], "list": {"level": 1, "numberingId": "1117"}}, {"id": "body-17655", "type": "paragraph", "style": "ListParagraph", "text": "Renal Function Tests", "runs": [{"text": "Renal"}, {"text": " "}, {"text": "Function"}, {"text": " "}, {"text": "Tests"}], "list": {"level": 1, "numberingId": "1117"}}, {"id": "body-17656", "type": "paragraph", "style": "ListParagraph", "text": "Complete Blood Count (CBC)", "runs": [{"text": "Complete"}, {"text": " "}, {"text": "Blood"}, {"text": " "}, {"text": "Count"}, {"text": " "}, {"text": "(CBC)"}], "list": {"level": 1, "numberingId": "1117"}}, {"id": "body-17659", "type": "paragraph", "style": "BodyText", "text": "Specific investigations", "runs": [{"text": "Specific"}, {"text": " "}, {"text": "investigations"}]}, {"id": "body-17660", "type": "paragraph", "style": "ListParagraph", "text": "OPG, CBCT, CT Scan", "runs": [{"text": "OPG,"}, {"text": " "}, {"text": "CBCT,"}, {"text": " "}, {"text": "CT"}, {"text": " "}, {"text": "Scan"}], "list": {"level": 1, "numberingId": "1117"}}, {"id": "body-17661", "type": "paragraph", "style": "ListParagraph", "text": "Chest X-ray", "runs": [{"text": "Chest"}, {"text": " "}, {"text": "X-"}, {"text": "ray"}], "list": {"level": 1, "numberingId": "1117"}}, {"id": "body-17662", "type": "paragraph", "style": "ListParagraph", "text": "Pus swab for Culture and sensitivity", "runs": [{"text": "Pus"}, {"text": " "}, {"text": "swab"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "Culture"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "sensitivity"}], "list": {"level": 1, "numberingId": "1117"}}, {"id": "body-17664", "type": "heading", "style": "Heading4", "text": "Non-Pharmacological Management", "runs": [{"text": "Non-Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-17665", "type": "paragraph", "style": "ListParagraph", "text": "Incision and drainage are done (even in absence of pus) to relieve the pressure and allow irrigation", "runs": [{"text": "Incision"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "drainage"}, {"text": " "}, {"text": "are"}, {"text": " "}, {"text": "done"}, {"text": " "}, {"text": "(even"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "absence"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "pus)"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "relieve"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "pressure"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "allow"}, {"text": " "}, {"text": "irrigation"}], "list": {"level": 1, "numberingId": "1117"}}, {"id": "body-17666", "type": "paragraph", "style": "ListParagraph", "text": "Only when the airway distress is significant and there is evidence that it is not relieved by incision and drainage then tracheostomy is needed.", "runs": [{"text": "Only"}, {"text": " "}, {"text": "when"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "airway"}, {"text": " "}, {"text": "distress"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "significant"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "there"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "evidence"}, {"text": " "}, {"text": "that"}, {"text": " "}, {"text": "it"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "not"}, {"text": " "}, {"text": "relieved"}, {"text": " "}, {"text": "by"}, {"text": " "}, {"text": "incision"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "drainage"}, {"text": " "}, {"text": "then tracheostomy is needed."}], "list": {"level": 1, "numberingId": "1117"}}, {"id": "body-17667", "type": "paragraph", "style": "ListParagraph", "text": "Patient should be admitted for Supportive care During incision and drainage pus should be taken for culture and sensitivity. Offending tooth should be removed at the same sitting if the patient can open the mouth.", "runs": [{"text": "Patient"}, {"text": " "}, {"text": "should"}, {"text": " "}, {"text": "be"}, {"text": " "}, {"text": "admitted"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "Supportive"}, {"text": " "}, {"text": "care"}, {"text": " "}, {"text": "During"}, {"text": " "}, {"text": "incision"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "drainage"}, {"text": " "}, {"text": "pus"}, {"text": " "}, {"text": "should"}, {"text": " "}, {"text": "be"}, {"text": " "}, {"text": "taken"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "culture"}, {"text": " "}, {"text": "and sensitivity. Offending tooth should be removed at the same sitting if the patient can open the mouth."}], "list": {"level": 1, "numberingId": "1117"}}, {"id": "body-17669", "type": "heading", "style": "Heading4", "text": "Pharmacological Management", "runs": [{"text": "Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-17670", "type": "paragraph", "style": "BodyText", "text": "B: ceftriaxone (IV) 1g 24hourly for 5days", "runs": [{"text": "B:", "bold": true}, {"text": " ", "bold": true}, {"text": "ceftriaxone"}, {"text": " "}, {"text": "(IV)"}, {"text": " "}, {"text": "1g"}, {"text": " "}, {"text": "24hourly"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "5days"}]}, {"id": "body-17671", "type": "paragraph", "style": "Heading3", "text": "OR", "runs": [{"text": "OR"}], "level": 3, "conjunction": true}, {"id": "body-17672", "type": "paragraph", "style": "BodyText", "text": "B: amoxicillin + clavulanic acid (FDC) (PO) 625mg 12-8hourly for 5days", "runs": [{"text": "B:", "bold": true}, {"text": " ", "bold": true}, {"text": "amoxicillin"}, {"text": " "}, {"text": "+"}, {"text": " "}, {"text": "clavulanic"}, {"text": " "}, {"text": "acid"}, {"text": " "}, {"text": "(FDC)"}, {"text": " "}, {"text": "(PO)"}, {"text": " "}, {"text": "625mg"}, {"text": " "}, {"text": "12-8hourly"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "5days"}]}, {"id": "body-17673", "type": "paragraph", "style": "Heading3", "text": "AND", "runs": [{"text": "AND"}], "level": 3, "conjunction": true}, {"id": "body-17674", "type": "paragraph", "style": "BodyText", "text": "B: metronidazole (IV) 500mg 8hourly for 5days", "runs": [{"text": "B:", "bold": true}, {"text": " ", "bold": true}, {"text": "metronidazole"}, {"text": " "}, {"text": "(IV)"}, {"text": " "}, {"text": "500mg"}, {"text": " "}, {"text": "8hourly"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "5days"}]}, {"id": "body-17676", "type": "paragraph", "style": "BodyText", "text": "If allergic to penicillin use", "runs": [{"text": "If"}, {"text": " "}, {"text": "allergic"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "penicillin"}, {"text": " "}, {"text": "use"}]}, {"id": "body-17677", "type": "paragraph", "style": "BodyText", "text": "A: erythromycin (PO) 500mg 6hourly for 5days", "runs": [{"text": "A:", "bold": true}, {"text": " ", "bold": true}, {"text": "erythromycin"}, {"text": " "}, {"text": "(PO)"}, {"text": " "}, {"text": "500mg"}, {"text": " "}, {"text": "6hourly"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "5days"}]}, {"id": "body-17679", "type": "paragraph", "style": "BodyText", "text": "Once the patient can swallow, replace IV medication with oral treatment.", "runs": [{"text": "Once"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "patient"}, {"text": " "}, {"text": "can"}, {"text": " "}, {"text": "swallow,"}, {"text": " "}, {"text": "replace"}, {"text": " "}, {"text": "IV"}, {"text": " "}, {"text": "medication"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "oral"}, {"text": " "}, {"text": "treatment."}]}, {"id": "body-17680-textbox1-00001", "type": "paragraph", "style": "BodyText", "text": "Note: For this condition and other life-threatening oral conditions consultation of available specialists (especially oral and maxillofacial surgeons) should go parallel with life saving measures.", "runs": [{"text": "Note: ", "bold": true}, {"text": "For this condition and other life-threatening oral conditions consultation of available specialists (especially oral and maxillofacial surgeons) should go parallel with life saving measures."}]}], "source": {"file": "medical.docx", "chapter": "Oral and maxillofacial conditions", "start": "body-17638", "end": "body-17680-textbox1-00001"}}