-05131", "type": "paragraph", "style": "Normal", "text": "When changing treatment, the following should be observed:", "runs": [{"text": "When changing", "bold": true}, {"text": " ", "bold": true}, {"text": "treatment, the", "bold": true}, {"text": " ", "bold": true}, {"text": "following", "bold": true}, {"text": " ", "bold": true}, {"text": "should", "bold": true}, {"text": " ", "bold": true}, {"text": "be", "bold": true}, {"text": " ", "bold": true}, {"text": "observed:", "bold": true}]}, {"id": "body-05132", "type": "paragraph", "style": "ListParagraph", "text": "Never change a single drug in the combination if the reason for changing is treatment failure. Change at least two drugs, preferably change all three drugs", "runs": [{"text": "Never"}, {"text": " "}, {"text": "change"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "single"}, {"text": " "}, {"text": "drug"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "combination"}, {"text": " "}, {"text": "if"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "reason"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "changing"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "treatment failure. Change at least two drugs, preferably change all three drugs"}], "list": {"level": 0, "numberingId": "1700"}}, {"id": "body-05133", "type": "paragraph", "style": "ListParagraph", "text": "If changing due to toxicity, change only the drug suspected to be causing the problem.", "runs": [{"text": "If"}, {"text": " "}, {"text": "changing"}, {"text": " "}, {"text": "due"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "toxicity,"}, {"text": " "}, {"text": "change"}, {"text": " "}, {"text": "only"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "drug"}, {"text": " "}, {"text": "suspected"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "be"}, {"text": " "}, {"text": "causing"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text"