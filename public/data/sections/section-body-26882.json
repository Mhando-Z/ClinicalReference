{"id": "section-body-26882", "title": "Alcohol Withdrawal Delirium (Delirium Tremens)", "chapterId": "chapter-twenty-three", "tocLevel": 4, "tocPath": ["APPROACH TO PATIENTS WITH EMERGENCY CONDITIONS", "MENTAL HEALTH CONDITIONS", "Substance Related Disorder", "Alcohol Withdrawal Delirium (Delirium Tremens)"], "blocks": [{"id": "body-26882", "type": "heading", "style": "Heading4", "text": "Alcohol Withdrawal Delirium (Delirium Tremens)", "runs": [{"text": "Alcohol"}, {"text": " "}, {"text": "Withdrawal"}, {"text": " "}, {"text": "Delirium"}, {"text": " "}, {"text": "(Delirium"}, {"text": " "}, {"text": "Tremens)"}], "level": 4, "list": {"level": 3, "numberingId": "349"}}, {"id": "body-26883", "type": "paragraph", "style": "BodyText", "text": "Delirium typically occurs 2–3 days following cessation of prolonged alcohol intake, reaching a peak at around 5 days. However, some withdrawal symptoms, such as tremor, may start within 12 hours.", "runs": [{"text": "Delirium"}, {"text": " "}, {"text": "typically"}, {"text": " "}, {"text": "occurs"}, {"text": " "}, {"text": "2–3"}, {"text": " "}, {"text": "days"}, {"text": " "}, {"text": "following"}, {"text": " "}, {"text": "cessation"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "prolonged"}, {"text": " "}, {"text": "alcohol"}, {"text": " "}, {"text": "intake,"}, {"text": " "}, {"text": "reaching"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "peak"}, {"text": " "}, {"text": "at"}, {"text": " "}, {"text": "around"}, {"text": " "}, {"text": "5"}, {"text": " "}, {"text": "days."}, {"text": " "}, {"text": "However, some withdrawal symptoms, such as tremor, may start within 12 hours."}]}, {"id": "body-26885", "type": "heading", "style": "Heading4", "text": "Clinical presentation", "runs": [{"text": "Clinical"}, {"text": " "}, {"text": "presentation"}], "level": 4}, {"id": "body-26886", "type": "paragraph", "style": "ListParagraph", "text": "Visual hallucinations", "runs": [{"text": "Visual"}, {"text": " "}, {"text": "hallucinations"}], "list": {"level": 4, "numberingId": "349"}}, {"id": "body-26887", "type": "paragraph", "style": "ListParagraph", "text": "Delusions", "runs": [{"text": "Delusions"}], "list": {"level": 4, "numberingId": "349"}}, {"id": "body-26888", "type": "paragraph", "style": "ListParagraph", "text": "Disorientation, fluctuating level of consciousness", "runs": [{"text": "Disorientation,"}, {"text": " "}, {"text": "fluctuating"}, {"text": " "}, {"text": "level"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "consciousness"}], "list": {"level": 4, "numberingId": "349"}}, {"id": "body-26889", "type": "paragraph", "style": "ListParagraph", "text": "Agitation", "runs": [{"text": "Agitation"}], "list": {"level": 4, "numberingId": "349"}}, {"id": "body-26890", "type": "paragraph", "style": "ListParagraph", "text": "Tonic-clonic seizures", "runs": [{"text": "Tonic-clonic"}, {"text": " "}, {"text": "seizures"}], "list": {"level": 4, "numberingId": "349"}}, {"id": "body-26891", "type": "paragraph", "style": "ListParagraph", "text": "Tachycardia, and Hypertension.", "runs": [{"text": "Tachycardia, and Hypertension."}], "list": {"level": 4, "numberingId": "349"}}, {"id": "body-26893", "type": "paragraph", "style": "BodyText", "text": "It is important to consider alternative diagnoses, especially true in cases with an atypical presentation.", "runs": [{"text": "It"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "important"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "consider"}, {"text": " "}, {"text": "alternative"}, {"text": " "}, {"text": "diagnoses,"}, {"text": " "}, {"text": "especially"}, {"text": " "}, {"text": "true"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "cases"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "an"}, {"text": " "}, {"text": "atypical"}, {"text": " "}, {"text": "presentation."}]}, {"id": "body-26894", "type": "paragraph", "style": "BodyText", "text": "Similar symptoms may occur following withdrawal from other sedative hypnotic agents. Mortality varies from 1–5%.", "runs": [{"text": "Similar"}, {"text": " "}, {"text": "symptoms"}, {"text": " "}, {"text": "may"}, {"text": " "}, {"text": "occur"}, {"text": " "}, {"text": "following"}, {"text": " "}, {"text": "withdrawal"}, {"text": " "}, {"text": "from"}, {"text": " "}, {"text": "other"}, {"text": " "}, {"text": "sedative"}, {"text": " "}, {"text": "hypnotic"}, {"text": " "}, {"text": "agents."}, {"text": " "}, {"text": "Mortality"}, {"text": " "}, {"text": "varies"}, {"text": " "}, {"text": "from"}, {"text": " "}, {"text": "1–5%."}]}, {"id": "body-26897", "type": "heading", "style": "Heading4", "text": "General Measures", "runs": [{"text": "General"}, {"text": " "}, {"text": "Measures"}], "level": 4}, {"id": "body-26898", "type": "paragraph", "style": "ListParagraph", "text": "See section 23.2: Delirium with perceptual disturbances.", "runs": [{"text": "See section 23.2: Delirium with perceptual "}, {"text": "disturbances."}], "list": {"level": 4, "numberingId": "349"}}, {"id": "body-26899", "type": "paragraph", "style": "ListParagraph", "text": "Cardiac monitoring and oximetry should be used when administering large doses of benzodiazepines.", "runs": [{"text": "Cardiac monitoring and oximetry should be used when administering large doses of "}, {"text": "benzodiazepines."}], "list": {"level": 4, "numberingId": "349"}}, {"id": "body-26900", "type": "paragraph", "style": "ListParagraph", "text": "Assess for infections and other comorbid conditions.", "runs": [{"text": "Assess for infections and other comorbid "}, {"text": "conditions."}], "list": {"level": 4, "numberingId": "349"}}, {"id": "body-26902", "type": "paragraph", "style": "ListParagraph", "text": "Ensure adequate hydration. Overhydration is a common error made in this setting.", "runs": [{"text": "Ensure adequate hydration. Overhydration is a common error made in this setting."}], "list": {"level": 0, "numberingId": "348"}}, {"id": "body-26903", "type": "paragraph", "style": "ListParagraph", "text": "Correct abnormalities of electrolytes.", "runs": [{"text": "Correct"}, {"text": " "}, {"text": "abnormalities"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "electrolytes."}], "list": {"level": 0, "numberingId": "348"}}, {"id": "body-26904", "type": "paragraph", "style": "ListParagraph", "text": "Nutritional support.", "runs": [{"text": "Nutritional"}, {"text": " "}, {"text": "support."}], "list": {"level": 0, "numberingId": "348"}}, {"id": "body-26905", "type": "paragraph", "style": "ListParagraph", "text": "Consider referring appropriate patients to a rehabilitation Programme after recovery from delirium tremens.", "runs": [{"text": "Consider referring appropriate patients to a rehabilitation Programme after recovery from delirium tremens."}], "list": {"level": 0, "numberingId": "348"}}, {"id": "body-26907", "type": "paragraph", "style": "BodyText", "text": "Administer medicine doses according to severity of symptoms. These patients may require high doses of benzodiazepines because of hepatic enzyme induction.", "runs": [{"text": "Administer medicine doses according to severity of symptoms. These patients may require high doses of benzodiazepines"}, {"text": " "}, {"text": "because of hepatic enzyme induction."}]}, {"id": "body-26909", "type": "paragraph", "style": "BodyText", "text": "A: diazepam, slow IV, 10 mg (Not IM). Repeat dose after 5–10 minutes if required. If this dose is not sufficient, use 10 mg every 5–10 minutes for another 1–2 doses.", "runs": [{"text": "A:", "bold": true}, {"text": " ", "bold": true}, {"text": "diazepam,"}, {"text": " "}, {"text": "slow"}, {"text": " "}, {"text": "IV,"}, {"text": " "}, {"text": "10"}, {"text": " "}, {"text": "mg"}, {"text": " "}, {"text": "(Not"}, {"text": " "}, {"text": "IM)."}, {"text": " "}, {"text": "Repeat"}, {"text": " "}, {"text": "dose"}, {"text": " "}, {"text": "after"}, {"text": " "}, {"text": "5–10"}, {"text": " "}, {"text": "minutes"}, {"text": " "}, {"text": "if"}, {"text": " "}, {"text": "required."}, {"text": " "}, {"text": "If"}, {"text": " "}, {"text": "this"}, {"text": " "}, {"text": "dose"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "not"}, {"text": " "}, {"text": "sufficient,"}, {"text": " "}, {"text": "use"}, {"text": " "}, {"text": "10"}, {"text": " "}, {"text": "mg"}, {"text": " "}, {"text": "every 5–10 minutes for another 1–2 doses."}]}, {"id": "body-26911", "type": "paragraph", "style": "BodyText", "text": "If patient is not yet sedated, continue with doses of 20 mg until this occurs. Usual initial dose is 10–20 mg, but up to 60 mg is occasionally required.", "runs": [{"text": "If patient is not yet sedated, continue with doses of 20 mg until this occurs. Usual initial dose is 10–20 mg, but up to 60 mg is occasionally required."}]}, {"id": "body-26912", "type": "paragraph", "style": "Heading3", "text": "OR", "runs": [{"text": "OR"}], "level": 3, "conjunction": true}, {"id": "body-26913", "type": "paragraph", "style": "BodyText", "text": "Where intravenous access is not possible:", "runs": [{"text": "Where"}, {"text": " "}, {"text": "intravenous"}, {"text": " "}, {"text": "access"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "not"}, {"text": " "}, {"text": "possible:"}]}, {"id": "body-26914", "type": "paragraph", "style": "BodyText", "text": "S: clonazepam (IM), 2 mg as a single dose. If no response, repeat dose after 60 minutes until patient is sedated. Repeat dose regularly to maintain mild sedation.", "runs": [{"text": "S:", "bold": true}, {"text": " ", "bold": true}, {"text": "clonazepam"}, {"text": " "}, {"text": "(IM),"}, {"text": " "}, {"text": "2"}, {"text": " "}, {"text": "mg"}, {"text": " "}, {"text": "as"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "single"}, {"text": " "}, {"text": "dose."}, {"text": " "}, {"text": "If"}, {"text": " "}, {"text": "no"}, {"text": " "}, {"text": "response,"}, {"text": " "}, {"text": "repeat"}, {"text": " "}, {"text": "dose"}, {"text": " "}, {"text": "after"}, {"text": " "}, {"text": "60"}, {"text": " "}, {"text": "minutes"}, {"text": " "}, {"text": "until"}, {"text": " "}, {"text": "patient"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "sedated."}, {"text": " "}, {"text": "Repeat"}, {"text": " "}, {"text": "dose regularly to maintain mild sedation."}]}, {"id": "body-26915", "type": "paragraph", "style": "Heading3", "text": "OR", "runs": [{"text": "OR"}], "level": 3, "conjunction": true}, {"id": "body-26916", "type": "paragraph", "style": "BodyText", "text": "C: lorazepam (IM), 1–4 mg every 30–60 minutes until patient is sedated. Repeat dose regularly to maintain mild sedation", "runs": [{"text": "C:", "bold": true}, {"text": " ", "bold": true}, {"text": "lorazepam"}, {"text": " "}, {"text": "(IM),"}, {"text": " "}, {"text": "1–4"}, {"text": " "}, {"text": "mg"}, {"text": " "}, {"text": "every"}, {"text": " "}, {"text": "30–60"}, {"text": " "}, {"text": "minutes"}, {"text": " "}, {"text": "until"}, {"text": " "}, {"text": "patient"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "sedated."}, {"text": " "}, {"text": "Repeat"}, {"text": " "}, {"text": "dose"}, {"text": " "}, {"text": "regularly"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "maintain"}, {"text": " "}, {"text": "mild"}, {"text": " "}, {"text": "sedation"}]}, {"id": "body-26918", "type": "paragraph", "style": "BodyText", "text": "Once patient is sedated, i.e. light somnolence, maintain mild sedation with:", "runs": [{"text": "Once"}, {"text": " "}, {"text": "patient"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "sedated,"}, {"text": " "}, {"text": "i.e."}, {"text": " "}, {"text": "light"}, {"text": " "}, {"text": "somnolence,"}, {"text": " "}, {"text": "maintain"}, {"text": " "}, {"text": "mild"}, {"text": " "}, {"text": "sedation"}, {"text": " "}, {"text": "with:"}]}, {"id": "body-26919", "type": "paragraph", "style": "BodyText", "text": "C: diazepam (PO), 5–20 mg. Repeat dose regularly to maintain mild sedation.", "runs": [{"text": "C:", "bold": true}, {"text": " ", "bold": true}, {"text": "diazepam"}, {"text": " "}, {"text": "(PO),"}, {"text": " "}, {"text": "5–20"}, {"text": " "}, {"text": "mg."}, {"text": " "}, {"text": "Repeat"}, {"text": " "}, {"text": "dose"}, {"text": " "}, {"text": "regularly"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "maintain"}, {"text": " "}, {"text": "mild"}, {"text": " "}, {"text": "sedation."}]}, {"id": "body-26920-textbox1-00001", "type": "paragraph", "style": "Normal", "text": "Caution", "runs": [{"text": "Caution", "bold": true}]}, {"id": "body-26920-textbox1-00002", "type": "paragraph", "style": "BodyText", "text": "Benzodiazepines, especially diazepam IV, can cause respiratory depression. Monitor patients closely as benzodiazepines can exacerbate an abnormal mental state or mask important neurological signs of deterioration.", "runs": [{"text": "Benzodiazepines,"}, {"text": " "}, {"text": "especially"}, {"text": " "}, {"text": "diazepam"}, {"text": " "}, {"text": "IV,"}, {"text": " "}, {"text": "can"}, {"text": " "}, {"text": "cause"}, {"text": " "}, {"text": "respiratory"}, {"text": " "}, {"text": "depression."}, {"text": " "}, {"text": "Monitor"}, {"text": " "}, {"text": "patients"}, {"text": " "}, {"text": "closely"}, {"text": " "}, {"text": "as"}, {"text": " "}, {"text": "benzodiazepines can exacerbate an abnormal mental state or mask important neurological signs of deterioration."}]}, {"id": "body-26922", "type": "paragraph", "style": "BodyText", "text": "Neuroleptic medicines, e.g. haloperidol, are associated with a reduced seizure threshold. Consider only for severe agitation and restlessness persisting after adequate doses of benzodiazepines.", "runs": [{"text": "Neuroleptic medicines, e.g. haloperidol, are associated with a reduced seizure threshold. Consider only for severe agitation and restlessness persisting after adequate doses of benzodiazepines."}]}, {"id": "body-26923", "type": "paragraph", "style": "BodyText", "text": "B: haloperidol (IV/IM), 0.5–5 mg. Repeat after 4–8 hours as required to a maximum of 20 mg/day. Once patient has responded and is able to take oral medication:", "runs": [{"text": "B", "bold": true}, {"text": ":"}, {"text": " "}, {"text": "haloperidol"}, {"text": " "}, {"text": "(IV/IM),"}, {"text": " "}, {"text": "0.5–5"}, {"text": " "}, {"text": "mg."}, {"text": " "}, {"text": "Repeat"}, {"text": " "}, {"text": "after"}, {"text": " "}, {"text": "4–8"}, {"text": " "}, {"text": "hours"}, {"text": " "}, {"text": "as"}, {"text": " "}, {"text": "required"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "maximum"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "20"}, {"text": " "}, {"text": "mg/day. Once patient has responded and is able to take oral medication:"}]}, {"id": "body-26924", "type": "paragraph", "style": "BodyText", "text": "B: haloperidol (PO), 0.75–5 mg 4–8 hourly.", "runs": [{"text": "B:", "bold": true}, {"text": " ", "bold": true}, {"text": "haloperidol"}, {"text": " "}, {"text": "(PO),"}, {"text": " "}, {"text": "0.75–5"}, {"text": " "}, {"text": "mg"}, {"text": " "}, {"text": "4–8"}, {"text": " "}, {"text": "hourly."}]}, {"id": "body-26925", "type": "paragraph", "style": "Heading3", "text": "OR", "runs": [{"text": "OR"}], "level": 3, "conjunction": true}, {"id": "body-26926", "type": "paragraph", "style": "BodyText", "text": "S: aripiprazole (PO) 10-15 mg 24 hourly (titrating depending to individual response)", "runs": [{"text": "S:", "bold": true}, {"text": " ", "bold": true}, {"text": "aripiprazole"}, {"text": " "}, {"text": "(PO)"}, {"text": " "}, {"text": "10-15"}, {"text": " "}, {"text": "mg"}, {"text": " "}, {"text": "24"}, {"text": " "}, {"text": "hourly"}, {"text": " "}, {"text": "(titrating"}, {"text": " "}, {"text": "depending"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "individual"}, {"text": " "}, {"text": "response)"}]}, {"id": "body-26927", "type": "paragraph", "style": "Heading3", "text": "OR", "runs": [{"text": "OR"}], "level": 3, "conjunction": true}, {"id": "body-26928", "type": "paragraph", "style": "BodyText", "text": "S: olanzapine (PO) 5-10mg 24 hourly (maximum dose 20mg/day)", "runs": [{"text": "S:", "bold": true}, {"text": " ", "bold": true}, {"text": "olanzapine"}, {"text": " "}, {"text": "(PO)"}, {"text": " "}, {"text": "5-10mg"}, {"text": " "}, {"text": "24"}, {"text": " "}, {"text": "hourly"}, {"text": " "}, {"text": "(maximum"}, {"text": " "}, {"text": "dose"}, {"text": " "}, {"text": "20mg/day)"}]}, {"id": "body-26929", "type": "paragraph", "style": "Heading3", "text": "OR", "runs": [{"text": "OR"}], "level": 3, "conjunction": true}, {"id": "body-26930", "type": "paragraph", "style": "BodyText", "text": "S: risperidone (PO) 1mg 12 hourly (maximum 6mg/day)", "runs": [{"text": "S:", "bold": true}, {"text": " ", "bold": true}, {"text": "risperidone"}, {"text": " "}, {"text": "(PO)"}, {"text": " "}, {"text": "1mg"}, {"text": " "}, {"text": "12"}, {"text": " "}, {"text": "hourly"}, {"text": " "}, {"text": "(maximum"}, {"text": " "}, {"text": "6mg/day)"}]}, {"id": "body-26932", "type": "paragraph", "style": "BodyText", "text": "When administering glucose-containing fluids:", "runs": [{"text": "When"}, {"text": " "}, {"text": "administering"}, {"text": " "}, {"text": "glucose-containing"}, {"text": " "}, {"text": "fluids:"}]}, {"id": "body-26933", "type": "paragraph", "style": "BodyText", "text": "C: thiamine, (PO/IM) 300 mg daily.", "runs": [{"text": "C:", "bold": true}, {"text": " ", "bold": true}, {"text": "thiamine,"}, {"text": " "}, {"text": "(PO/IM)"}, {"text": " "}, {"text": "300"}, {"text": " "}, {"text": "mg"}, {"text": " "}, {"text": "daily."}]}, {"id": "body-26934", "type": "paragraph", "style": "Heading3", "text": "OR", "runs": [{"text": "OR"}], "level": 3, "conjunction": true}, {"id": "body-26935", "type": "paragraph", "style": "BodyText", "text": "A: vitamin B Complex (IV) 1ampoule in 500ml 5% Dextrose", "runs": [{"text": "A:", "bold": true}, {"text": " ", "bold": true}, {"text": "vitamin"}, {"text": " "}, {"text": "B"}, {"text": " "}, {"text": "Complex"}, {"text": " "}, {"text": "(IV)"}, {"text": " "}, {"text": "1ampoule"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "500ml"}, {"text": " "}, {"text": "5%"}, {"text": " "}, {"text": "Dextrose"}]}, {"id": "body-26937", "type": "paragraph", "style": "BodyText", "text": "Relapse prevention following detoxification", "runs": [{"text": "Relapse"}, {"text": " "}, {"text": "prevention"}, {"text": " "}, {"text": "following"}, {"text": " "}, {"text": "detoxification"}]}, {"id": "body-26938", "type": "paragraph", "style": "BodyText", "text": "S: naltrexone (PO) 50mg 24hourly, and should be titrated, according to response", "runs": [{"text": "S:", "bold": true}, {"text": " ", "bold": true}, {"text": "naltrexone"}, {"text": " "}, {"text": "(PO)"}, {"text": " "}, {"text": "50mg"}, {"text": " "}, {"text": "24hourly,"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "should"}, {"text": " "}, {"text": "be"}, {"text": " "}, {"text": "titrated,"}, {"text": " "}, {"text": "according"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "response"}]}], "source": {"file": "medical.docx", "chapter": "Mental health conditions", "start": "body-26882", "end": "body-26938"}}