{"id": "section-body-28655", "title": "Kerosene (Paraffin) Poisoning", "chapterId": "chapter-twenty-five", "tocLevel": 4, "tocPath": ["APPROACH TO PATIENTS WITH EMERGENCY CONDITIONS", "POISONING", "Specific poisons", "Kerosene (Paraffin) Poisoning"], "blocks": [{"id": "body-28655", "type": "heading", "style": "Heading4", "text": "Kerosene (Paraffin) Poisoning", "runs": [{"text": "Kerosene"}, {"text": " "}, {"text": "(Paraffin)"}, {"text": " "}, {"text": "Poisoning"}], "level": 4, "list": {"level": 2, "numberingId": "154"}}, {"id": "body-28656", "type": "paragraph", "style": "BodyText", "text": "Kerosene poisoning commonly affects children. The primary target organ is the respiratory system, and aspiration leads to chemical pneumonitis which may be bilateral and interstitial.", "runs": [{"text": "Kerosene poisoning commonly affects children. The primary target organ is the respiratory system, and aspiration leads to"}, {"text": " "}, {"text": "chemical pneumonitis which may be bilateral and interstitial."}]}, {"id": "body-28657", "type": "paragraph", "style": "BodyText", "text": "Vomiting after ingestion is associated with increased risk of aspiration pneumonitis. CNS symptoms are usually secondary to hypoxia.", "runs": [{"text": "Vomiting after ingestion is associated with increased risk of aspiration pneumonitis. CNS symptoms are usually secondary to "}, {"text": "hypoxia."}]}, {"id": "body-28660", "type": "heading", "style": "Heading4", "text": "Non-Pharmacological Management", "runs": [{"text": "Non-Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-28661", "type": "paragraph", "style": "ListParagraph", "text": "Immediately remove the child from the source of exposure.", "runs": [{"text": "Immediately"}, {"text": " "}, {"text": "remove"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "child"}, {"text": " "}, {"text": "from"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "source"}, {"text": " "}, {"text": "of "}, {"text": "exposure."}], "list": {"level": 0, "numberingId": "115"}}, {"id": "body-28662", "type": "paragraph", "style": "ListParagraph", "text": "Ensure airway patency and maintain ABC as first priority.", "runs": [{"text": "Ensure airway patency and maintain ABC as first "}, {"text": "priority."}], "list": {"level": 0, "numberingId": "115"}}, {"id": "body-28663", "type": "paragraph", "style": "ListParagraph", "text": "Remove contaminated clothing and wash skin thoroughly with soap and water.", "runs": [{"text": "Remove"}, {"text": " "}, {"text": "contaminated"}, {"text": " "}, {"text": "clothing"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "wash"}, {"text": " "}, {"text": "skin thoroughly with soap and water."}], "list": {"level": 0, "numberingId": "115"}}, {"id": "body-28664", "type": "paragraph", "style": "ListParagraph", "text": "Monitor oxygen saturation using pulse oximetry where available.", "runs": [{"text": "Monitor"}, {"text": " "}, {"text": "oxygen"}, {"text": " "}, {"text": "saturation"}, {"text": " "}, {"text": "using"}, {"text": " "}, {"text": "pulse"}, {"text": " "}, {"text": "oximetry where available."}], "list": {"level": 0, "numberingId": "115"}}, {"id": "body-28665", "type": "paragraph", "style": "ListParagraph", "text": "Administer supplemental oxygen if hypoxia or respiratory distress is present.", "runs": [{"text": "Administer"}, {"text": " "}, {"text": "supplemental"}, {"text": " "}, {"text": "oxygen"}, {"text": " "}, {"text": "if"}, {"text": " "}, {"text": "hypoxia"}, {"text": " "}, {"text": "or respiratory distress is present."}], "list": {"level": 0, "numberingId": "115"}}, {"id": "body-28667", "type": "paragraph", "style": "ListParagraph", "text": "Provide respiratory support: Intubation and mechanical ventilation if severe hypoxia, respiratory distress, or reduced consciousness.", "runs": [{"text": "Provide respiratory support: Intubation and mechanical ventilation if severe hypoxia, respiratory distress, or reduced consciousness."}], "list": {"level": 0, "numberingId": "144"}}, {"id": "body-28668", "type": "paragraph", "style": "ListParagraph", "text": "Do NOT perform gastric lavage routinely due to high risk of aspiration pneumonitis.", "runs": [{"text": "Do NOT perform gastric lavage routinely due to high risk of aspiration pneumonitis."}], "list": {"level": 0, "numberingId": "144"}}, {"id": "body-28669", "type": "paragraph", "style": "ListParagraph", "text": "Gastric lavage may only be considered:", "runs": [{"text": "Gastric"}, {"text": " "}, {"text": "lavage"}, {"text": " "}, {"text": "may"}, {"text": " "}, {"text": "only"}, {"text": " "}, {"text": "be"}, {"text": " "}, {"text": "considered:"}], "list": {"level": 0, "numberingId": "144"}}, {"id": "body-28670", "type": "paragraph", "style": "ListParagraph", "text": "If a large ingestion occurred within 1 hour, and", "runs": [{"text": "If"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "large"}, {"text": " "}, {"text": "ingestion"}, {"text": " "}, {"text": "occurred"}, {"text": " "}, {"text": "within"}, {"text": " "}, {"text": "1"}, {"text": " "}, {"text": "hour,"}, {"text": " "}, {"text": "and"}], "list": {"level": 1, "numberingId": "144"}}, {"id": "body-28671", "type": "paragraph", "style": "ListParagraph", "text": "Airway is protected by expert endotracheal intubation.", "runs": [{"text": "Airway is protected by expert endotracheal "}, {"text": "intubation."}], "list": {"level": 1, "numberingId": "144"}}, {"id": "body-28674", "type": "heading", "style": "Heading4", "text": "Pharmacological Management", "runs": [{"text": "Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-28675", "type": "paragraph", "style": "BodyText", "text": "Supportive fluid therapy (ONLY if shock or significant dehydration is present):", "runs": [{"text": "Supportive"}, {"text": " "}, {"text": "fluid"}, {"text": " "}, {"text": "therapy"}, {"text": " "}, {"text": "(ONLY"}, {"text": " "}, {"text": "if"}, {"text": " "}, {"text": "shock"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "significant"}, {"text": " "}, {"text": "dehydration"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "present):"}]}, {"id": "body-28676", "type": "paragraph", "style": "BodyText", "text": "A: sodium lactate compound (ringer’s lactate)(Ringer’s Lactate) IV infusion 30 mL/kg IV bolus stat,", "runs": [{"text": "A:", "bold": true}, {"text": " ", "bold": true}, {"text": "sodium"}, {"text": " "}, {"text": "lactate"}, {"text": " "}, {"text": "compound"}, {"text": " "}, {"text": "(ringer’s"}, {"text": " "}, {"text": "lactate)(Ringer’s"}, {"text": " "}, {"text": "Lactate)"}, {"text": " "}, {"text": "IV"}, {"text": " "}, {"text": "infusion"}, {"text": " "}, {"text": "30"}, {"text": " "}, {"text": "mL/kg"}, {"text": " "}, {"text": "IV"}, {"text": " "}, {"text": "bolus"}, {"text": " "}, {"text": "stat,"}]}, {"id": "body-28677", "type": "paragraph", "style": "Heading3", "text": "OR", "runs": [{"text": "OR"}], "level": 3, "conjunction": true}, {"id": "body-28678", "type": "paragraph", "style": "BodyText", "text": "A: sodium Chloride 0.9% IV infusion 30 mL/kg IV bolus stat,", "runs": [{"text": "A:", "bold": true}, {"text": " ", "bold": true}, {"text": "sodium"}, {"text": " "}, {"text": "Chloride"}, {"text": " "}, {"text": "0.9%"}, {"text": " "}, {"text": "IV"}, {"text": " "}, {"text": "infusion"}, {"text": " "}, {"text": "30"}, {"text": " "}, {"text": "mL/kg"}, {"text": " "}, {"text": "IV"}, {"text": " "}, {"text": "bolus"}, {"text": " "}, {"text": "stat,"}]}, {"id": "body-28679", "type": "heading", "style": "Heading3", "text": "THEN", "runs": [{"text": "THEN"}], "level": 3}, {"id": "body-28680", "type": "paragraph", "style": "BodyText", "text": "Reassess, may continue guided fluid replacement up to 2 L over 24 hours in adults, or weight-based maintenance in children.", "runs": [{"text": "Reassess,"}, {"text": " "}, {"text": "may"}, {"text": " "}, {"text": "continue"}, {"text": " "}, {"text": "guided"}, {"text": " "}, {"text": "fluid"}, {"text": " "}, {"text": "replacement"}, {"text": " "}, {"text": "up"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "2"}, {"text": " "}, {"text": "L"}, {"text": " "}, {"text": "over"}, {"text": " "}, {"text": "24"}, {"text": " "}, {"text": "hours"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "adults,"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "weight-based"}, {"text": " "}, {"text": "maintenance"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "children."}]}, {"id": "body-28681-textbox1-00001", "type": "paragraph", "style": "Normal", "text": "Note:", "runs": [{"text": "Note:", "bold": true}]}, {"id": "body-28681-textbox1-00002", "type": "paragraph", "style": "BodyText", "text": "There is no evidence supporting the routine use of corticosteroids in kerosene (paraffin) poisoning; therefore, they are not recommended.", "runs": [{"text": "There is no evidence supporting the routine use of corticosteroids in kerosene (paraffin) poisoning; therefore, they are not recommended."}], "list": {"level": 0, "numberingId": "143"}}, {"id": "body-28681-textbox1-00003", "type": "paragraph", "style": "BodyText", "text": "No specific antidote exists for kerosene poisoning.", "runs": [{"text": "No"}, {"text": " "}, {"text": "specific"}, {"text": " "}, {"text": "antidote"}, {"text": " "}, {"text": "exists"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "kerosene"}, {"text": " "}, {"text": "poisoning."}], "list": {"level": 0, "numberingId": "143"}}, {"id": "body-28681-textbox1-00004", "type": "paragraph", "style": "BodyText", "text": "Antibiotics are not routine (only if secondary bacterial infection develops)", "runs": [{"text": "Antibiotics"}, {"text": " "}, {"text": "are"}, {"text": " "}, {"text": "not"}, {"text": " "}, {"text": "routine"}, {"text": " "}, {"text": "(only"}, {"text": " "}, {"text": "if"}, {"text": " "}, {"text": "secondary"}, {"text": " "}, {"text": "bacterial"}, {"text": " "}, {"text": "infection"}, {"text": " "}, {"text": "develops)"}], "list": {"level": 0, "numberingId": "143"}}, {"id": "body-28681-textbox1-00005", "type": "paragraph", "style": "BodyText", "text": "Mainstay of treatment is supportive respiratory care", "runs": [{"text": "Mainstay"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "treatment"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "supportive"}, {"text": " "}, {"text": "respiratory"}, {"text": " "}, {"text": "care"}], "list": {"level": 0, "numberingId": "143"}}, {"id": "body-28681-textbox1-00006", "type": "paragraph", "style": "BodyText", "text": "Hypoxia is the main cause of CNS symptoms", "runs": [{"text": "Hypoxia"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "main"}, {"text": " "}, {"text": "cause"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "CNS"}, {"text": " "}, {"text": "symptoms"}], "list": {"level": 0, "numberingId": "143"}}], "source": {"file": "medical.docx", "chapter": "Poisoning", "start": "body-28655", "end": "body-28681-textbox1-00006"}}