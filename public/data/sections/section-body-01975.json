{"id": "section-body-01975", "title": "Obstetric Anaesthesia General anaesthesia (GA)", "chapterId": "chapter-two", "tocLevel": 4, "tocPath": ["APPROACH TO PATIENTS WITH EMERGENCY CONDITIONS", "ANAESTHESIA AND CRITICAL CARE", "Anaesthesia", "Obstetric Anaesthesia"], "blocks": [{"id": "body-01975", "type": "heading", "style": "Heading4", "text": "Obstetric Anaesthesia General anaesthesia (GA)", "runs": [{"text": "Obstetric"}, {"text": " "}, {"text": "Anaesthesia "}, {"text": "General anaesthesia (GA)"}], "level": 4, "list": {"level": 3, "numberingId": "1850"}}, {"id": "body-01976", "type": "paragraph", "style": "BodyText", "text": "Preparation: Prevent aspiration pneumonitis (Refer to premedication section).", "runs": [{"text": "Preparation:"}, {"text": " "}, {"text": "Prevent"}, {"text": " "}, {"text": "aspiration"}, {"text": " "}, {"text": "pneumonitis"}, {"text": " "}, {"text": "(Refer"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "premedication"}, {"text": " "}, {"text": "section)."}]}, {"id": "body-01977", "type": "paragraph", "style": "ListParagraph", "text": "Antibiotic prophylaxis: before skin incision as guided by guidelines.", "runs": [{"text": "Antibiotic"}, {"text": " "}, {"text": "prophylaxis:"}, {"text": " "}, {"text": "before"}, {"text": " "}, {"text": "skin"}, {"text": " "}, {"text": "incision"}, {"text": " "}, {"text": "as"}, {"text": " "}, {"text": "guided"}, {"text": " "}, {"text": "by"}, {"text": " "}, {"text": "guidelines."}], "list": {"level": 4, "numberingId": "1850"}}, {"id": "body-01978", "type": "paragraph", "style": "ListParagraph", "text": "In view of potential difficult airway, ALL equipment for difficult airway including supraglottic airway devices (SGAs), and video laryngoscopes when available in addition to routine airway equipment. Have small-sized ETT 6.0 and 6.5 cuffed with a stylet.", "runs": [{"text": "In view of potential difficult airway,"}, {"text": " "}, {"text": "ALL"}, {"text": " "}, {"text": "equipment for diffi