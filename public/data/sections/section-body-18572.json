{"id": "section-body-18572", "title": "Septic Arthritis", "chapterId": "chapter-seventeen", "tocLevel": 4, "tocPath": ["APPROACH TO PATIENTS WITH EMERGENCY CONDITIONS", "MUSCULOSKELETAL DISORDERS", "Infections", "Septic Arthritis"], "blocks": [{"id": "body-18572", "type": "heading", "style": "Heading4", "text": "Septic Arthritis", "runs": [{"text": "Septic Arthritis"}], "level": 4, "list": {"level": 2, "numberingId": "1048"}}, {"id": "body-18574", "type": "paragraph", "style": "ListParagraph", "text": "Reconstruction procedure is done after eradication of infection depending on the size of the defect, these include:", "runs": [{"text": "Reconstruction"}, {"text": " "}, {"text": "procedure"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "done"}, {"text": " "}, {"text": "after"}, {"text": " "}, {"text": "eradication of infection depending on the size of the defect, these include:"}], "list": {"level": 0, "numberingId": "1045"}}, {"id": "body-18575", "type": "paragraph", "style": "ListParagraph", "text": "Shortening for small defects", "runs": [{"text": "Shortening"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "small"}, {"text": " "}, {"text": "defects"}], "list": {"level": 1, "numberingId": "1045"}}, {"id": "body-18576", "type": "paragraph", "style": "ListParagraph", "text": "Bone graft for small defects up to 2 cm", "runs": [{"text": "Bone"}, {"text": " "}, {"text": "graft"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "small"}, {"text": " "}, {"text": "defects"}, {"text": " "}, {"text": "up"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "2"}, {"text": " "}, {"text": "cm"}], "list": {"level": 1, "numberingId": "1045"}}, {"id": "body-18577", "type": "paragraph", "style": "ListParagraph", "text": "Mascullate procedure up to 2 to 8cm defect", "runs": [{"text": "Mascullate"}, {"text": " "}, {"text": "procedure"}, {"text": " "}, {"text": "up"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "2 to 8cm defect"}], "list":