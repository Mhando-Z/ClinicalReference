ose, cheeks, upper lip area, and chin", "runs": [{"text": "May"}, {"text": " "}, {"text": "affect"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "forehead,"}, {"text": " "}, {"text": "nose,"}, {"text": " "}, {"text": "cheeks,"}, {"text": " "}, {"text": "upper lip area, and chin"}], "list": {"level": 0, "numberingId": "1323"}}, {"id": "body-13447", "type": "heading", "style": "Heading4", "text": "Non-Pharmacological Management", "runs": [{"text": "Non-Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-13448", "type": "paragraph", "style": "ListParagraph", "text": "Sun protection by wearing a wide-brimmed hat", "runs": [{"text": "Sun"}, {"text": " "}, {"text": "protection"}, {"text": " "}, {"text": "by"}, {"text": " "}, {"text": "wearing"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "wide-brimmed"}, {"text": " "}, {"text": "hat"}], "list": {"level": 0, "numberingId": "1323"}}, {"id": "body-13449", "type": "paragraph", "style": "ListParagraph", "text": "Camouflage if desired", "runs": [{"text": "Camouflage"}, {"text": " "}, {"text": "if"}, {"text": " "}, {"text": "desired"}], "list": {"level": 0, "numberingId": "1323"}}, {"id": "body-13451", "type": "heading", "style": "Heading4", "text": "Pharmacological Management", "runs": [{"text": "Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-13452-textbox1-00001", "type": "paragraph", "style": "Normal", "text": "Alternative Therapies: S: laser therapy’", "runs": [{"text": "Alternative", "bold": true}, {"text": " ", "bold": true}, {"text": "Therapies: S: ", "bold": true}, {"text": "laser therapy’"}]}, {"id": "body-13452-textbox1-00002", "type": "paragraph", "style": "Normal", "text": "OR", "runs": [{"text": "OR", "bold": true}], "conjunction": true}, {"id": "body-13452-textbox1-00003", "type": "paragraph", "style": "Normal", "text": "S: chemical Peels", "runs": [{"text": "S:", "bold": true}, {"text": " ", "bold": true}, {"text": "chemi