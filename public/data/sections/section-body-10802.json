{"id": "section-body-10802", "title": "Postpartum Hemorrhage (PPH)", "chapterId": "chapter-eleven", "blocks": [{"id": "body-10802", "type": "heading", "style": "Heading2", "text": "Postpartum Hemorrhage (PPH)", "runs": [{"text": "Postpartum"}, {"text": " "}, {"text": "Hemorrhage"}, {"text": " "}, {"text": "(PPH)"}], "level": 2, "list": {"level": 1, "numberingId": "1452"}}, {"id": "body-10803", "type": "paragraph", "style": "BodyText", "text": "It is abnormal uterine bleeding following delivery through 6 weeks (42 days). It is sub classified in to Primary and Secondary PPH", "runs": [{"text": "It is abnormal uterine bleeding following delivery through 6 weeks (42 days). It is sub classified in to Primary and Secondary "}, {"text": "PPH"}]}, {"id": "body-10804", "type": "heading", "style": "Heading4", "text": "Primary Postpartum Haemorrhage", "runs": [{"text": "Primary"}, {"text": " "}, {"text": "Postpartum"}, {"text": " "}, {"text": "Haemorrhage"}], "level": 4, "list": {"level": 2, "numberingId": "1452"}}, {"id": "body-10805", "type": "paragraph", "style": "BodyText", "text": "It is typically loss of more than 500 ml of blood from the genital tract after vaginal delivery or more than 1000 ml after Caesarean section in the first 24 hours. OR it is any amount of blood loss after delivery that would result in hemodynamic instability.", "runs": [{"text": "It"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "typically"}, {"text": " "}, {"text": "loss"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "more"}, {"text": " "}, {"text": "than"}, {"text": " "}, {"text": "500"}, {"text": " "}, {"text": "ml"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "blood"}, {"text": " "}, {"text": "from"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "genital"}, {"text": " "}, {"text": "tract"}, {"text": " "}, {"text": "after"}, {"text": " "}, {"text": "vaginal"}, {"text": " "}, {"text": "delivery"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "more"}, {"text": " "}, {"text": "than"}, {"text": " "}, {"text": "1000"}, {"text": " "}, {"text": "ml"}, {"text": " "}, {"text": "after"}, {"text": " "}, {"text": "Caesarean section in the first 24 hours. OR it is any amount of blood loss after delivery that would result in hemodynamic instability."}]}, {"id": "body-10808", "type": "heading", "style": "Heading4", "text": "Management of PPH at Dispensary and Health center", "runs": [{"text": "Management"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "PPH"}, {"text": " "}, {"text": "at"}, {"text": " "}, {"text": "Dispensary"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "Health"}, {"text": " "}, {"text": "center"}], "level": 4}, {"id": "body-10809", "type": "paragraph", "style": "ListParagraph", "text": "Insert 2 large bore cannula IV line, start rapid infusion with sodium lactate compound (ringer’s lactate)or sodium chloride", "runs": [{"text": "Insert 2 large bore cannula IV line, start rapid infusion with sodium lactate compound (ringer’s lactate)or sodium chloride"}], "list": {"level": 0, "numberingId": "1436"}}, {"id": "body-10810", "type": "paragraph", "style": "ListParagraph", "text": "Start oxytocin (IV) 20IU in 500mls NS at a rate for 20drops per minute", "runs": [{"text": "Start"}, {"text": " "}, {"text": "oxytocin"}, {"text": " "}, {"text": "(IV)"}, {"text": " "}, {"text": "20IU"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "500mls"}, {"text": " "}, {"text": "NS"}, {"text": " "}, {"text": "at"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "rate"}, {"text": " "}, {"text": "for 20drops per minute"}], "list": {"level": 0, "numberingId": "1436"}}, {"id": "body-10812", "type": "paragraph", "style": "ListParagraph", "text": "Ensure no retained placental tissues", "runs": [{"text": "Ensure"}, {"text": " "}, {"text": "no"}, {"text": " "}, {"text": "retained"}, {"text": " "}, {"text": "placental"}, {"text": " "}, {"text": "tissues"}], "list": {"level": 0, "numberingId": "1436"}}, {"id": "body-10813", "type": "paragraph", "style": "ListParagraph", "text": "Clamp or ligate bleeding perineal tears if any.", "runs": [{"text": "Clamp"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "ligate"}, {"text": " "}, {"text": "bleeding"}, {"text": " "}, {"text": "perineal"}, {"text": " "}, {"text": "tears"}, {"text": " "}, {"text": "if"}, {"text": " "}, {"text": "any."}], "list": {"level": 0, "numberingId": "1436"}}, {"id": "body-10814", "type": "paragraph", "style": "ListParagraph", "text": "Massage the uterus", "runs": [{"text": "Massage"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "uterus"}], "list": {"level": 0, "numberingId": "1436"}}, {"id": "body-10815", "type": "paragraph", "style": "ListParagraph", "text": "Insert Urethral catheter", "runs": [{"text": "Insert"}, {"text": " "}, {"text": "Urethral"}, {"text": " "}, {"text": "catheter"}], "list": {"level": 0, "numberingId": "1436"}}, {"id": "body-10818", "type": "paragraph", "style": "BodyText", "text": "Referral: If bleeding continues, immediately refer the patient to the hospital with an escort of a skilled health attendant. Maintain IV infusion during transfer.", "runs": [{"text": "Referral:", "bold": true}, {"text": " ", "bold": true}, {"text": "If"}, {"text": " "}, {"text": "bleeding"}, {"text": " "}, {"text": "continues,"}, {"text": " "}, {"text": "immediately"}, {"text": " "}, {"text": "refer"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "patient"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "hospital"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "an"}, {"text": " "}, {"text": "escort"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "skilled"}, {"text": " "}, {"text": "health"}, {"text": " "}, {"text": "attendant."}, {"text": " "}, {"text": "Maintain IV infusion during transfer."}]}, {"id": "body-10820", "type": "heading", "style": "Heading4", "text": "Management of PPH at the hospital- at a comprehensive obstruction facility", "runs": [{"text": "Management"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "PPH"}, {"text": " "}, {"text": "at"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "hospital-"}, {"text": " "}, {"text": "at"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "comprehensive"}, {"text": " "}, {"text": "obstruction"}, {"text": " "}, {"text": "facility"}], "level": 4}, {"id": "body-10821", "type": "paragraph", "style": "ListParagraph", "text": "Shout for help and mobilize resources", "runs": [{"text": "Shout"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "help"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "mobilize"}, {"text": " "}, {"text": "resources"}], "list": {"level": 1, "numberingId": "1436"}}, {"id": "body-10822", "type": "paragraph", "style": "ListParagraph", "text": "Obtain blood samples for Hb, blood grouping and cross matching", "runs": [{"text": "Obtain"}, {"text": " "}, {"text": "blood"}, {"text": " "}, {"text": "samples"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "Hb,"}, {"text": " "}, {"text": "blood"}, {"text": " "}, {"text": "grouping"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "cross"}, {"text": " "}, {"text": "matching"}], "list": {"level": 1, "numberingId": "1436"}}, {"id": "body-10823", "type": "paragraph", "style": "ListParagraph", "text": "Insert 2 large bore cannulas and start infusing compound sodium chloride or sodium chloride (IV) rapidly", "runs": [{"text": "Insert"}, {"text": " "}, {"text": "2"}, {"text": " "}, {"text": "large"}, {"text": " "}, {"text": "bore"}, {"text": " "}, {"text": "cannulas"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "start"}, {"text": " "}, {"text": "infusing"}, {"text": " "}, {"text": "compound"}, {"text": " "}, {"text": "sodium"}, {"text": " "}, {"text": "chloride"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "sodium"}, {"text": " "},