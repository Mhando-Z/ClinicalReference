 "list": {"level": 0, "numberingId": "412"}}, {"id": "body-25123-textbox1-00003", "type": "paragraph", "style": "Normal", "text": "Treatment with goserelin and bicalutamide may be given up to 2 years depending on patient condition and Prostate Specific Antigen (PSA) levels", "runs": [{"text": "Treatment"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "goserelin"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "bicalutamide"}, {"text": " "}, {"text": "may"}, {"text": " "}, {"text": "be"}, {"text": " "}, {"text": "given"}, {"text": " "}, {"text": "up"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "2"}, {"text": " "}, {"text": "years"}, {"text": " "}, {"text": "depending"}, {"text": " "}, {"text": "on"}, {"text": " "}, {"text": "patient"}, {"text": " "}, {"text": "condition"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "Prostate"}, {"text": " "}, {"text": "Specific Antigen (PSA) levels"}], "list": {"level": 0, "numberingId": "412"}}, {"id": "body-25125", "type": "heading", "style": "Heading4", "text": "Chemotherapy", "runs": [{"text": "Chemotherapy"}], "level": 4}, {"id": "body-25126", "type": "paragraph", "style": "BodyText", "text": "Recommended chemotherapy regimens for hormonal refractory prostate cancer are:", "runs": [{"text": "Recommended"}, {"text": " "}, {"text": "chemotherapy"}, {"text": " "}, {"text": "regimens"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "hormonal"}, {"text": " "}, {"text": "refractory"}, {"text": " "}, {"text": "prostate"}, {"text": " "}, {"text": "cancer"}, {"text": " "}, {"text": "are:"}]}, {"id": "body-25127", "type": "paragraph", "style": "BodyText", "text": "S: docetaxel (IV) 75mg/m2 2 hours’ infusion day 1 given every 21 days for 6 cycles. It is mainly reserved in hormonal refractory prostate cancer.", "runs": [{"text": "S:", "bold": true}, {"text": " ", "bold": true}, {"text": "docetaxel"}, {"text": " "}, {"text": "(IV)"}, {"text": " "}, {"text": "75mg/m2"}, {"text": " "}, 