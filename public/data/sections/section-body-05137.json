r tumors” in patients responding to anti- retroviral therapy (ART) includes:", "runs": [{"text": "A"}, {"text": " "}, {"text": "typical"}, {"text": " "}, {"text": "presentation"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "“opportunistic"}, {"text": " "}, {"text": "infections"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "tumors”"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "patients"}, {"text": " "}, {"text": "responding"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "anti-"}, {"text": " "}, {"text": "retroviral"}, {"text": " "}, {"text": "therapy"}, {"text": " "}, {"text": "(ART)"}, {"text": " "}, {"text": "includes:"}]}, {"id": "body-05150", "type": "paragraph", "style": "ListParagraph", "text": "Localized disease e.g., lymph nodes, liver, spleen", "runs": [{"text": "Localized"}, {"text": " "}, {"text": "disease"}, {"text": " "}, {"text": "e.g.,"}, {"text": " "}, {"text": "lymph"}, {"text": " "}, {"text": "nodes,"}, {"text": " "}, {"text": "liver,"}, {"text": " "}, {"text": "spleen"}], "list": {"level": 0, "numberingId": "1699"}}, {"id": "body-05151", "type": "paragraph", "style": "ListParagraph", "text": "Exaggerated inflammatory reaction e.g., severe fever, with exclusion of other causes of painful lesions", "runs": [{"text": "Exaggerated"}, {"text": " "}, {"text": "inflammatory"}, {"text": " "}, {"text": "reaction"}, {"text": " "}, {"text": "e.g.,"}, {"text": " "}, {"text": "severe"}, {"text": " "}, {"text": "fever,"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "exclusion"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "other"}, {"text": " "}, {"text": "causes"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "painful"}, {"text": " "}, {"text": "lesions"}], "list": {"level": 0, "numberingId": "1699"}}, {"id": "body-05152", "type": "paragraph", "style": "ListParagraph", "text": "Atypical inflammatory response in affected tissues e.g., granulomas, suppuration, necrosis, perivascular