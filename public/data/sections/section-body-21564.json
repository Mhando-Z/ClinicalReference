{"id": "section-body-21564", "title": "Chronic Heart Failure", "chapterId": "chapter-twenty", "blocks": [{"id": "body-21564", "type": "heading", "style": "Heading2", "text": "Chronic Heart Failure", "runs": [{"text": "Chronic"}, {"text": " "}, {"text": "Heart"}, {"text": " "}, {"text": "Failure"}], "level": 2, "list": {"level": 1, "numberingId": "781"}}, {"id": "body-21565", "type": "paragraph", "style": "BodyText", "text": "Patients who have had HF as defined above for some times are often said to have ‘Chronic Heart Failure’. A treated patient with symptoms and signs that have remained generally unchanged for at least 1 month is said to be ‘Stable chronic heart failure’", "runs": [{"text": "Patients who have had HF as defined above for some times are often said to have ‘Chronic Heart Failure’. A treated patient "}, {"text": "with"}, {"text": " "}, {"text": "symptoms"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "signs"}, {"text": " "}, {"text": "that"}, {"text": " "}, {"text": "have"}, {"text": " "}, {"text": "remained"}, {"text": " "}, {"text": "generally"}, {"text": " "}, {"text": "unchanged"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "at"}, {"text": " "}, {"text": "least"}, {"text": " "}, {"text": "1"}, {"text": " "}, {"text": "month"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "said"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "be"}, {"text": " "}, {"text": "‘Stable"}, {"text": " "}, {"text": "chronic"}, {"text": " "}, {"text": "heart"}, {"text": " "}, {"text": "failure’"}]}, {"id": "body-21567", "type": "heading", "style": "Heading4", "text": "Diagnostic Criteria", "runs": [{"text": "Diagnostic"}, {"text": " "}, {"text": "Criteria"}], "level": 4}, {"id": "body-21568", "type": "paragraph", "style": "BodyText", "text": "The diagnosis of chronic heart failure requires the following features:", "runs": [{"text": "The"}, {"text": " "}, {"text": "diagnosis"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "chronic"}, {"text": " "}, {"text": "heart"}, {"text": " "}, {"text": "failure"}, {"text": " "}, {"text": "requires"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "following"}, {"text": " "}, {"text": "features:"}]}, {"id": "body-21569", "type": "paragraph", "style": "ListParagraph", "text": "Symptoms of heart failure, typically breathlessness or fatigue, at rest or during exertion", "runs": [{"text": "Symptoms"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "heart"}, {"text": " "}, {"text": "failure,"}, {"text": " "}, {"text": "typically"}, {"text": " "}, {"text": "breathlessness"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "fatigue,"}, {"text": " "}, {"text": "at"}, {"text": " "}, {"text": "rest"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "during"}, {"text": " "}, {"text": "exertion"}], "list": {"level": 0, "numberingId": "739"}}, {"id": "body-21570", "type": "paragraph", "style": "ListParagraph", "text": "Objective evidence of cardiac dysfunction preferably by Echocardiography (Systolic and/or Diastolic)", "runs": [{"text": "Objective"}, {"text": " "}, {"text": "evidence"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "cardiac"}, {"text": " "}, {"text": "dysfunction"}, {"text": " "}, {"text": "preferably"}, {"text": " "}, {"text": "by"}, {"text": " "}, {"text": "Echocardiography"}, {"text": " "}, {"text": "(Systolic"}, {"text": " "}, {"text": "and/or"}, {"text": " "}, {"text": "Diastolic)"}], "list": {"level": 0, "numberingId": "739"}}, {"id": "body-21571", "type": "paragraph", "style": "ListParagraph", "text": "A clinical response to treatment is supportive but not sufficient for diagnosis.", "runs": [{"text": "A"}, {"text": " "}, {"text": "clinical"}, {"text": " "}, {"text": "response"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "treatment"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "supportive"}, {"text": " "}, {"text": "but"}, {"text": " "}, {"text": "not"}, {"text": " "},