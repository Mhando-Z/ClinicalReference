{"text": " "}, {"text": "classification"}, {"text": " "}, {"text": "criterion;"}, {"text": " "}, {"text": "however,"}, {"text": " "}, {"text": "diagnosis"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "based"}, {"text": " "}, {"text": "on"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "presence"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "confirmed"}, {"text": " "}, {"text": "IBD"}, {"text": " "}, {"text": "(Crohn’s"}, {"text": " "}, {"text": "disease"}, {"text": " "}, {"text": "or ulcerative colitis), clinical features of arthritis, and the absence of RF and anti-CCP antibodies."}]}, {"id": "body-29476", "type": "heading", "style": "Heading4", "text": "Non-Pharmacological Management", "runs": [{"text": "Non-Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-29477", "type": "paragraph", "style": "ListParagraph", "text": "Physical therapy: Improves mobility and function, especially in axial involvement", "runs": [{"text": "Physical"}, {"text": " "}, {"text": "therapy:"}, {"text": " "}, {"text": "Improves"}, {"text": " "}, {"text": "mobility"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "function,"}, {"text": " "}, {"text": "especially"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "axial"}, {"text": " "}, {"text": "involvement"}], "list": {"level": 3, "numberingId": "105"}}, {"id": "body-29478", "type": "paragraph", "style": "ListParagraph", "text": "Nutritional support: Address malnutrition or deficiencies associated with IBD", "runs": [{"text": "Nutritional"}, {"text": " "}, {"text": "support:"}, {"text": " "}, {"text": "Address"}, {"text": " "}, {"text": "malnutrition"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "deficiencies"}, {"text": " "}, {"text": "associated"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "IBD"}], "list": {"level": 3, "numberingId": "105"}}, {"id": "body-29479", "type": "paragraph", "style": "ListParagraph", "text": "Management of underlying IBD: Control of intestinal inflammation often improves joint symptoms", "runs": [{"text": "Management"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "underlying"}, {"text": " "}, {"text": "IBD:"}, {"text": " "}, {"text": "Control"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "intestinal"}, {"text": " "}, {"text": "inflammation"}, {"text": " "}, {"text": "often"}, {"text": " "}, {"text": "improves"}, {"text": " "}, {"text": "joint"}, {"text": " "}, {"text": "symptoms"}], "list": {"level": 3, "numberingId": "105"}}, {"id": "body-29480", "type": "heading", "style": "Heading4", "text": "Pharmacological Management", "runs": [{"text": "Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-29481", "type": "paragraph", "style": "ListParagraph", "text": "Non-Steroidal Anti-Inflammatory Drugs (NSAIDs) may ease joint symptoms but can worsen IBD. Use the lowest effective dose briefly. Prefer COX-2 inhibitors for lower GI risk.", "runs": [{"text": "Non-Steroidal Anti-Inflammatory Drugs (NSAIDs) may ease joint symptoms but can worsen IBD. Use the lowest effective"}, {"text": " "}, {"text": "dose briefly. Prefer COX-2 inhibitors for lower GI risk."}], "list": {"level": 0, "numberingId": "92"}}, {"id": "body-29482", "type": "paragraph", "style": "BodyText", "text": "D: meloxicam (PO) 7.5–15mg 24hourly (selective at lower dosages)", "runs": [{"text": "D:", "bold": true}, {"text": " ", "bold": true}, {"text": "meloxicam"}, {"text": " "}, {"text": "(PO)"}, {"text": " "}, {"text": "7.5–15mg"}, {"text": " "}, {"text": "24hourly"}, {"text": " "}, {"text": "(selective"}, {"text": " "}, {"text": "at"}, {"text": " "}, {"text": "lower"}, {"text": " "}, {"text": "dosages)"}]}, {"id": "body-29483", "type": "paragraph", "style": "Heading3", "text": "OR", "runs": [{"text": "OR"}], "level": 3, "conjunction": true}, {"id": "body-29484", "type": "paragraph", "style": "BodyText", "text": "C: celecoxib (PO) 100-200mg 12 hourly",