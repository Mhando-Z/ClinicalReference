{"id": "section-body-18087", "title": "Adenomatoid odontogenic Tumors (AOT) Clinical Presentation.", "chapterId": "chapter-sixteen", "tocLevel": 4, "tocPath": ["APPROACH TO PATIENTS WITH EMERGENCY CONDITIONS", "ORAL AND MAXILLOFACIAL CONDITIONS", "Tumours and Tumour-Like Conditions of Oral Cavity and Facial Region", "Adenomatoid odontogenic Tumors (AOT) Clinical Presentation."], "blocks": [{"id": "body-18087", "type": "heading", "style": "Heading4", "text": "Adenomatoid odontogenic Tumors (AOT) Clinical Presentation.", "runs": [{"text": "Adenomatoid"}, {"text": " "}, {"text": "odontogenic"}, {"text": " "}, {"text": "Tumors"}, {"text": " "}, {"text": "(AOT)"}, {"text": " "}, {"text": "Clinical"}, {"text": " "}, {"text": "Presentation."}], "level": 4, "list": {"level": 3, "numberingId": "1108"}}, {"id": "body-18088", "type": "paragraph", "style": "ListParagraph", "text": "Usually occur in the second and third decades", "runs": [{"text": "Usually"}, {"text": " "}, {"text": "occur"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "second"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "third"}, {"text": " "}, {"text": "decades"}], "list": {"level": 4, "numberingId": "1108"}}, {"id": "body-18089", "type": "paragraph", "style": "ListParagraph", "text": "Usually encountered incidentally", "runs": [{"text": "Usually"}, {"text": " "}, {"text": "encountered"}, {"text": " "}, {"text": "incidentally"}], "list": {"level": 4, "numberingId": "1108"}}, {"id": "body-18090", "type": "paragraph", "style": "ListParagraph", "text": "It has a female predilection", "runs": [{"text": "It"}, {"text": " "}, {"text": "has"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "female"}, {"text": " "}, {"text": "predilection"}], "list": {"level": 4, "numberingId": "1108"}}, {"id": "body-18091", "type": "paragraph", "style": "ListParagraph", "text": "Two thirds of the cases occur in the anterior maxilla, one third occur in the anterior mandible, and it is never found posterior to the premolars", "runs": [{"text": "Two"}, {"text": " "}, {"text": "thirds"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "cases"}, {"text": " "}, {"text": "occur"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "anterior"}, {"text": " "}, {"text": "maxilla,"}, {"text": " "}, {"text": "one"}, {"text": " "}, {"text": "third"}, {"text": " "}, {"text": "occur"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "anterior"}, {"text": " "}, {"text": "mandible,"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "it"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "never found posterior to the premolars"}], "list": {"level": 4, "numberingId": "1108"}}, {"id": "body-18092", "type": "paragraph", "style": "ListParagraph", "text": "Two thirds of the cases are associated with an impacted tooth (usually the cuspid) Present with mild swelling or in association with a clinically missing tooth", "runs": [{"text": "Two"}, {"text": " "}, {"text": "thirds"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "cases"}, {"text": " "}, {"text": "are"}, {"text": " "}, {"text": "associated"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "an"}, {"text": " "}, {"text": "impacted"}, {"text": " "}, {"text": "tooth"}, {"text": " "}, {"text": "(usually"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "cuspid)"}, {"text": " "}, {"text": "Present"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "mild"}, {"text": " "}, {"text": "swelling"}, {"text": " "}, {"text": "or in association with a clinically missing tooth"}], "list": {"level": 4, "numberingId": "1108"}}, {"id": "body-18094", "type": "heading", "style": "Heading4", "text": "Investigations", "runs": [{"text": "Investigations"}], "level": 4}, {"id": "body-18095", "type": "paragraph", "style": "BodyText