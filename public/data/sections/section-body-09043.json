ocks": [{"id": "body-09070-r3-c3-00005", "type": "paragraph", "style": "TableParagraph", "text": "14 days", "runs": [{"text": "14"}, {"text": " "}, {"text": "days"}]}], "colspan": 1, "rowspan": 1, "column": 2}], "header": false}], "columns": 3}, {"id": "body-09072", "type": "paragraph", "style": "Normal", "text": "Treatment failure", "runs": [{"text": "Treatment", "bold": true}, {"text": " ", "bold": true}, {"text": "failure", "bold": true}]}, {"id": "body-09073", "type": "paragraph", "style": "BodyText", "text": "H. pylori treatment failure is defined as the positive stool antigen test or urease breath test 5 weeks after the last dose of eradication therapy. Antimicrobial susceptibility testing (AST) should be performed after (two) treatment failures. This is associated with higher eradication rates compared with individuals without AST. After treatment failure, the treatment should be individualized following the culture and sensitivity of the gastric biopsy or PCR.", "runs": [{"text": "H. pylori treatment failure is defined as the positive stool antigen test or urease breath test 5 weeks after the last dose of eradication therapy. Antimicrobial susceptibility testing (AST) should be performed after (two) treatment failures. This is associated with higher eradication rates compared with individuals without AST. After treatment failure, the treatment should be individualized following the culture and sensitivity of the gastric biopsy or PCR."}]}], "source": {"file": "medical.docx", "chapter": "Gastrointestinal disease conditions", "start": "body-09043", "end": "body-09073"}}