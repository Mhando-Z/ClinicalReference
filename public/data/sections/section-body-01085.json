{"id": "section-body-01085", "title": "Approach to Pain", "chapterId": "chapter-one", "blocks": [{"id": "body-01085", "type": "heading", "style": "Heading2", "text": "Approach to Pain", "runs": [{"text": "Approach"}, {"text": " "}, {"text": "to"}, {"text": " Pain"}], "level": 2, "list": {"level": 1, "numberingId": "1890"}}, {"id": "body-01086", "type": "paragraph", "style": "BodyText", "text": "Pain is an unpleasant sensation or emotional experience associated with actual or potential tissue damage, or described in terms of such damage. Any pain of moderate or higher intensity is accompanied by anxiety and the urge to escape or terminate the feeling. Pain is subjective and unique perceptual experience with multiple dimensions that may not directly be observed by others or measured by physiological tests. Assessment is almost entirely self-reported.", "runs": [{"text": "Pain is an unpleasant sensation or emotional experience associated with actual or potential tissue damage, or described in terms"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "such"}, {"text": " "}, {"text": "damage."}, {"text": " "}, {"text": "Any"}, {"text": " "}, {"text": "pain"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "moderate"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "higher"}, {"text": " "}, {"text": "intensity"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "accompanied"}, {"text": " "}, {"text": "by"}, {"text": " "}, {"text": "anxiety"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "urge"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "escape"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "terminate the feeling. Pain is subjective and unique perceptual experience with multiple dimensions that may not directly be observed by others or measured by physiological tests. Assessment is almost entirely self-reported."}]}, {"id": "body-01087", "type": "heading", "style": "Heading4", "text": "Assessment of pain.", "runs": [{"text": "Assessment"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "pain."}], "level": 4}, {"id": "body-01088", "type": "paragraph", "style": "BodyText", "text": "Self-report is the key to pain assessment. In non- or preverbal children, facial expression is the most valid indicator of pain; therefore, use the faces pain scale to assess severity. Pain should be assessed by:", "runs": [{"text": "Self-report"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "key"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "pain"}, {"text": " "}, {"text": "assessment."}, {"text": " "}, {"text": "In"}, {"text": " "}, {"text": "non-"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "preverbal"}, {"text": " "}, {"text": "children,"}, {"text": " "}, {"text": "facial"}, {"text": " "}, {"text": "expression"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "most"}, {"text": " "}, {"text": "valid"}, {"text": " "}, {"text": "indicator of pain; therefore, use the faces pain scale to assess severity. Pain should be assessed by:"}]}, {"id": "body-01090", "type": "paragraph", "style": "ListParagraph", "text": "Duration", "runs": [{"text": "Duration"}], "list": {"level": 0, "numberingId": "1875"}}, {"id": "body-01091", "type": "paragraph", "style": "ListParagraph", "text": "Severity, e.g., does the patient wake up because of the pain", "runs": [{"text": "Severity,"}, {"text": " "}, {"text": "e.g.,"}, {"text": " "}, {"text": "does"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "patient"}, {"text": " "}, {"text": "wake up because of the pain"}], "list": {"level": 0, "numberingId": "1875"}}, {"id": "body-01092", "type": "paragraph", "style": "ListParagraph", "text": "Site", "runs": [{"text": "Site"}], "list": {"level": 0, "numberingId": "1875"}}, {"id": "body-01093", "type": "paragraph", "style": "ListParagraph", "text": "Characteristics,\te.g.\tstabbing, throbbing, crushing, cramp-like", "runs": [{"text": "Characteristics,"}, {"text": "\t"}, {"text": "e.g."}, {"text": "\t"}, {"text": "stabbing, "}, {"text": "throbbing, crushing, cramp-like"}], "list": {"level": 0, "numberingId": "1875"}}, {"id": "body-01094", "type": "paragraph", "style": "ListParagraph", "text": "Persistent or intermittent", "runs": [{"text": "Persistent"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "intermittent"}], "list": {"level": 0, "numberingId": "1875"}}, {"id": "body-01095", "type": "paragraph", "style": "ListParagraph", "text": "\nRelieving or aggravating factors", "runs": [{"text": "\n"}, {"text": "Relieving"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "aggravating"}, {"text": " "}, {"text": "factors"}], "list": {"level": 0, "numberingId": "1875"}}, {"id": "body-01096", "type": "paragraph", "style": "ListParagraph", "text": "Accompanying symptoms", "runs": [{"text": "Accompanying"}, {"text": " "}, {"text": "symptoms"}], "list": {"level": 0, "numberingId": "1875"}}, {"id": "body-01097", "type": "paragraph", "style": "ListParagraph", "text": "Distribution of pain", "runs": [{"text": "Distribution"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "pain"}], "list": {"level": 0, "numberingId": "1875"}}, {"id": "body-01098", "type": "paragraph", "style": "ListParagraph", "text": "In children, pain can be assessed by a child’s crying voice, posture, movement and colour", "runs": [{"text": "In"}, {"text": " "}, {"text": "children,"}, {"text": " "}, {"text": "pain"}, {"text": " "}, {"text": "can"}, {"text": " "}, {"text": "be"}, {"text": " "}, {"text": "assessed"}, {"text": " "}, {"text": "by a child’s crying voice, posture, movement and colour"}], "list": {"level": 0, "numberingId": "1875"}}], "source": {"file": "medical.docx", "chapter": "Approach to patients with emergency conditions", "start": "body-01085", "end": "body-01098"}}