yText", "text": "Note: Fundoscopic examination is mandatory for all patients before initiation of anthelminthic therapy.", "runs": [{"text": "Note:", "bold": true}, {"text": " ", "bold": true}, {"text": "Fundoscopic"}, {"text": " "}, {"text": "examination"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "mandatory", "bold": true}, {"text": " ", "bold": true}, {"text": "for"}, {"text": " "}, {"text": "all"}, {"text": " "}, {"text": "patients"}, {"text": " "}, {"text": "before"}, {"text": " "}, {"text": "initiation"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "anthelminthic"}, {"text": " "}, {"text": "therapy."}]}, {"id": "body-05995", "type": "heading", "style": "Heading4", "text": "Viral infections", "runs": [{"text": "Viral"}, {"text": " "}, {"text": "infections"}], "level": 4, "list": {"level": 2, "numberingId": "1652"}}, {"id": "body-05996", "type": "paragraph", "style": "BodyText", "text": "Viral infections of the nervous system are mainly caused by Herpes simplex virus (HSV) and Human immunodeficiency virus (HIV). (Refer to section on viral infections and HIV)", "runs": [{"text": "Viral"}, {"text": " "}, {"text": "infections"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "nervous"}, {"text": " "}, {"text": "system"}, {"text": " "}, {"text": "are"}, {"text": " "}, {"text": "mainly"}, {"text": " "}, {"text": "caused"}, {"text": " "}, {"text": "by"}, {"text": " "}, {"text": "Herpes", "italic": true}, {"text": " ", "italic": true}, {"text": "simplex", "italic": true}, {"text": " ", "italic": true}, {"text": "virus"}, {"text": " "}, {"text": "(HSV)"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "Human"}, {"text": " "}, {"text": "immunodeficiency"}, {"text": " "}, {"text": "virus (HIV). (Refer to section on viral infections and HIV)"}]}], "source": {"file": "medical.docx", "chapter": "Nervous system disease conditions", "start": "body-05966", "end": "body-05996"}}