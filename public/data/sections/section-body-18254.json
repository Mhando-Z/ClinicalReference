t": "cortical "}, {"text": "plate."}], "list": {"level": 0, "numberingId": "1086"}}, {"id": "body-18271", "type": "heading", "style": "Heading4", "text": "Investigations", "runs": [{"text": "Investigations"}], "level": 4}, {"id": "body-18272", "type": "paragraph", "style": "BodyText", "text": "Radiographically, they usually present as a well-defined and unilocular radiolucency surrounding the crown of an unerupted or impacted tooth within the mandible.", "runs": [{"text": "Radiographically,"}, {"text": " "}, {"text": "they"}, {"text": " "}, {"text": "usually"}, {"text": " "}, {"text": "present"}, {"text": " "}, {"text": "as"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "well-defined"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "unilocular"}, {"text": " "}, {"text": "radiolucency"}, {"text": " "}, {"text": "surrounding"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "crown"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "an"}, {"text": " "}, {"text": "unerupted"}, {"text": " "}, {"text": "or impacted tooth within the mandible."}]}, {"id": "body-18274", "type": "heading", "style": "Heading4", "text": "Radicular (Apical) cyst", "runs": [{"text": "Radicular"}, {"text": " "}, {"text": "(Apical)"}, {"text": " "}, {"text": "cyst"}], "level": 4, "list": {"level": 2, "numberingId": "1126"}}, {"id": "body-18275", "type": "paragraph", "style": "BodyText", "text": "Radicular cyst is an inflammatory jaw cyst originating from epithelial remnants of the periodontal ligament because of inflammation that is generally a consequence of pulp necrosis.", "runs": [{"text": "Radicular"}, {"text": " "}, {"text": "cyst"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "an"}, {"text": " "}, {"text": "inflammatory"}, {"text": " "}, {"text": "jaw"}, {"text": " "}, {"text": "cyst"}, {"text": " "}, {"text": "originating"}, {"text": " "}, {"text": "from"}, {"text": " "}, {"text": "epithelial"}, {"text": " "}, {"text": "remnants"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "periodontal"}, {"text": " "}, {"text": "ligament"}, {"text": " "}, {"text": "because"}, {"text": " "}, {"text": "of inflammation that is generally a consequence of pulp necrosis."}]}, {"id": "body-18276", "type": "paragraph", "style": "BodyText", "text": "The resulting cyst commonly involves the apex of the affected tooth either by dental caries or trauma.", "runs": [{"text": "The"}, {"text": " "}, {"text": "resulting"}, {"text": " "}, {"text": "cyst"}, {"text": " "}, {"text": "commonly"}, {"text": " "}, {"text": "involves"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "apex"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "affected"}, {"text": " "}, {"text": "tooth"}, {"text": " "}, {"text": "either"}, {"text": " "}, {"text": "by"}, {"text": " "}, {"text": "dental"}, {"text": " "}, {"text": "caries"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "trauma."}]}, {"id": "body-18278", "type": "heading", "style": "Heading4", "text": "Investigations", "runs": [{"text": "Investigations"}], "level": 4}, {"id": "body-18279", "type": "paragraph", "style": "ListParagraph", "text": "Take OPG or Skull X-ray, the cysts appear as rounded, radiolucent areas sharply demarcated from normal.", "runs": [{"text": "Take"}, {"text": " "}, {"text": "OPG"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "Skull"}, {"text": " "}, {"text": "X-ray,"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "cysts"}, {"text": " "}, {"text": "appear"}, {"text": " "}, {"text": "as"}, {"text": " "}, {"text": "rounded,"}, {"text": " "}, {"text": "radiolucent"}, {"text": " "}, {"text": "areas"}, {"text": " "}, {"text": "sharply"}, {"text": " "}, {"text": "demarcated"}, {"text": " "}, {"text": "from"}, {"text": " "}, {"text": "normal."}], "list": {"level": 0, "numberingId": "1085"}}, {"id": "body-18280", "type": "paragraph", "style": "ListParagraph", "text": "Apical periodontal cysts are associated with the roots of dead teeth bone by a thin, radiopaque, limiting line of compact or cortical bone.", "runs": [{"text": "Apical"}, {"text": " "}, {"text": "periodontal"}, {"text": " "}, {"text": "cysts"}, {"text": " "}, {"text": "are"}, {"text": " "}, {"text": "associated"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "roots"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "dead"}, {"text": " "}, {"text": "teeth"}, {"text": " "}, {"text": "bone"}, {"text": " "}, {"text": "by"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "thin,"}, {"text": " "}, {"text": "radiopaque,"}, {"text": " "}, {"text": "limiting"}, {"text": " "}, {"text": "line"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "compact or cortical bone."}], "list": {"level": 0, "numberingId": "1085"}}, {"id": "body-18282", "type": "heading", "style": "Heading4", "text": "Non Pharmacological Management", "runs": [{"text": "Non"}, {"text": " "}, {"text": "Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-18283", "type": "paragraph", "style": "BodyText", "text": "Dental cystectomy under local or general anesthesia.", "runs": [{"text": "Dental"}, {"text": " "}, {"text": "cystectomy"}, {"text": " "}, {"text": "under"}, {"text": " "}, {"text": "local"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "general"}, {"text": " "}, {"text": "anesthesia."}]}, {"id": "body-18285", "type": "heading", "style": "Heading4", "text": "Globulomaxillary cyst", "runs": [{"text": "Globulomaxillary"}, {"text": " "}, {"text": "cyst"}], "level": 4, "list": {"level": 2, "numberingId": "1126"}}, {"id": "body-18286", "type": "paragraph", "style": "BodyText", "text": "The globulomaxillary cyst is a cyst that appears between a maxillary lateral incisor and the adjacent canine. It often causes the roots of adjacent teeth to diverge.", "runs": [{"text": "The"}, {"text": " "}, {"text": "