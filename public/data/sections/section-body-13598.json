{"id": "section-body-13598", "title": "Infantile Hemangioma", "chapterId": "chapter-thirteen", "blocks": [{"id": "body-13598", "type": "heading", "style": "Heading2", "text": "Infantile Hemangioma", "runs": [{"text": "Infantile"}, {"text": " "}, {"text": "Hemangioma"}], "level": 2, "list": {"level": 1, "numberingId": "1368"}}, {"id": "body-13599", "type": "paragraph", "style": "BodyText", "text": "Benign vascular tumour which appears at birth as a mark and continues growing till 6-12 months, then starts involuting. May be part of PHACE(S) syndrome or LUMBAR syndrome.", "runs": [{"text": "Benign vascular tumour which appears at birth as a mark and continues growing till 6-12 months, then starts involuting. May be part of PHACE(S) syndrome or LUMBAR syndrome."}]}, {"id": "body-13601", "type": "heading", "style": "Heading4", "text": "Clinical Presentation", "runs": [{"text": "Clinical"}, {"text": " "}, {"text": "Presentation"}], "level": 4}, {"id": "body-13602", "type": "paragraph", "style": "ListParagraph", "text": "A patch of telangiectasias with surrounding pallor at birth", "runs": [{"text": "A"}, {"text": " "}, {"text": "patch"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "telangiectasias"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "surrounding"}, {"text": " "}, {"text": "pallor"}, {"text": " "}, {"text": "at"}, {"text": " "}, {"text": "birth"}], "list": {"level": 0, "numberingId": "1316"}}, {"id": "body-13603", "type": "paragraph", "style": "ListParagraph", "text": "80% of cases present as a single lesion only, 20% lesions are multiple", "runs": [{"text": "80%"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "cases"}, {"text": " "}, {"text": "present"}, {"text": " "}, {"text": "as"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "single"}, {"text": " "}, {"text": "lesion"}, {"text": " "}, {"text": "only,"}, {"text": " "}, {"text": "20%"}, {"text": " "}, {"text": "lesions"}, {"text": " "}, {"text": "are"}, {"text": " "}