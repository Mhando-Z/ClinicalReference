{"id": "section-body-05998", "title": "Herpes simplex encephalitis", "chapterId": "chapter-eight", "tocLevel": 4, "tocPath": ["APPROACH TO PATIENTS WITH EMERGENCY CONDITIONS", "SKIN DISEASES", "Viral Infections", "Herpes Simplex"], "blocks": [{"id": "body-05998", "type": "heading", "style": "Heading4", "text": "Herpes simplex encephalitis", "runs": [{"text": "Herpes"}, {"text": " "}, {"text": "simplex"}, {"text": " "}, {"text": "encephalitis"}], "level": 4}, {"id": "body-05999", "type": "paragraph", "style": "BodyText", "text": "Most of cases in adults are caused by HSV-1, a small number are caused by HSV-2 usually in immunosuppressed states or in neonates. It should be suspected in all patients not responding to antibiotics/other treatments.", "runs": [{"text": "Most of cases in adults are caused by HSV-1, a small number are caused by HSV-2 usually in immunosuppressed states or in neonates. It should be suspected in all patients not responding to antibiotics/other treatments."}]}, {"id": "body-06001", "type": "paragraph", "style": "ListParagraph", "text": "Early features are fever, headache & altered consciousness which may develop gradually over days or rapidly over hours", "runs": [{"text": "Early"}, {"text": " "}, {"text": "features"}, {"text": " "}, {"text": "are"}, {"text": " "}, {"text": "fever,"}, {"text": " "}, {"text": "headache"}, {"text": " "}, {"text": "&"}, {"text": " "}, {"text": "altered"}, {"text": " "}, {"text": "consciousness"}, {"text": " "}, {"text": "which"}, {"text": " "}, {"text": "may"}, {"text": " "}, {"text": "develop"}, {"text": " "}, {"text": "gradually"}, {"text": " "}, {"text": "over"}, {"text": " "}, {"text": "days"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "rapidly"}, {"text": " "}, {"text": "over "}, {"text": "hours"}], "list": {"level": 3, "numberingId": "1652"}}, {"id": "body-06002", "type": "paragraph", "style": "ListParagraph", "text": "The most common manifestations are personality change, dysphasia, behavioral disturbance, and occasional psychotic features", "runs": [{"text": "The"}, {"text": " "}, {"text": "most"}, {"text": " "}, {"text": "common"}, {"text": " "}, {"text": "manifestations"}, {"text": " "}, {"text": "are"}, {"text": " "}, {"text": "personality"}, {"text": " "}, {"text": "change,"}, {"text": " "}, {"text": "dysphasia,"}, {"text": " "}, {"text": "behavioral"}, {"text": " "}, {"text": "disturbance,"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "occasional psychotic features"}], "list": {"level": 3, "numberingId": "1652"}}, {"id": "body-06003", "type": "paragraph", "style": "ListParagraph", "text": "Focal or generalized seizures", "runs": [{"text": "Focal"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "generalized"}, {"text": " "}, {"text": "seizures"}], "list": {"level": 3, "numberingId": "1652"}}, {"id": "body-06004", "type": "heading", "style": "Heading4", "text": "Investigations", "runs": [{"text": "Investigations"}], "level": 4}, {"id": "body-06005", "type": "paragraph", "style": "ListParagraph", "text": "Lumbar puncture--CSF is under increased pressure and may appear normal or show a mild-moderate lymphocytosis, a mild-moderate elevated protein levels and normal or decreased glucose.", "runs": [{"text": "Lumbar"}, {"text": " "}, {"text": "puncture--CSF"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "under"}, {"text": " "}, {"text": "increased"}, {"text": " "}, {"text": "pressure"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "may"}, {"text": " "}, {"text": "appear"}, {"text": " "}, {"text": "normal"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "show"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "mild-moderate lymphocytosis, a mild-moderate elevated protein levels and normal or decreased glucose."}], "list": {"level": 3, "numberingId": "1652"}}, {"id": "body-06006", "type": "paragraph", "style": "ListParagraph", "text": "CSF PCR", "runs": [{"text": "CSF"}, {"text": " "}, {"text": "PCR"}], "list": {"level": 3, "numberingId": "1652"}}, {"id": "body-06007", "type": "paragraph", "style": "ListParagraph", "text": "HSV1+HSV2 CSF Rapid test", "runs": [{"text": "HSV1+HSV2"}, {"text": " "}, {"text": "CSF"}, {"text": " "}, {"text": "Rapid"}, {"text": " "}, {"text": "test"}], "list": {"level": 3, "numberingId": "1652"}}, {"id": "body-06008", "type": "paragraph", "style": "ListParagraph", "text": "MRI—demonstrate predominant involvement of the limbic system structures, medial temporal lobes, and insular cortex", "runs": [{"text": "MRI"}, {"text": "—", "bold": true}, {"text": "demonstrate predominant involvement of the limbic system structures, medial temporal lobes, and insular"}, {"text": " "}, {"text": "cortex"}], "list": {"level": 3, "numberingId": "1652"}}, {"id": "body-06010", "type": "heading", "style": "Heading4", "text": "Non-Pharmacological Management", "runs": [{"text": "Non-Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-06011", "type": "paragraph", "style": "BodyText", "text": "Provide supportive therapy as for unconscious patients", "runs": [{"text": "Provide"}, {"text": " "}, {"text": "supportive"}, {"text": " "}, {"text": "therapy"}, {"text": " "}, {"text": "as"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "unconscious"}, {"text": " "}, {"text": "patients"}]}, {"id": "body-06013", "type": "heading", "style": "Heading4", "text": "Pharmacological Management", "runs": [{"text": "Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-06014", "type": "paragraph", "style": "BodyText", "text": "B: acyclovir (IV/PO) 10–15mg/kg 8hourly for 14–21days", "runs": [{"text": "B:", "bold": true}, {"text": " ", "bold": true}, {"text": "acyclovir"}, {"text": " "}, {"text": "(IV/PO)"}, {"text": " "}, {"text": "10–15mg/kg"}, {"text": " "}, {"text": "8hourly"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "14–21days"}]}, {"id": "body-06016", "type": "heading", "style": "Heading2", "text": "Initial Management of Stroke", "runs": [{"text": "Initial"}, {"text": " "}, {"text": "Management"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "Stroke"}], "level": 2, "list": {"level": 1, "numberingId": "1659"}}], "source": {"file": "medical.docx", "chapter": "Nervous system disease conditions", "start": "body-05998", "end": "body-06016"}}