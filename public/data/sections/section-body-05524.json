": "considered"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "treatment"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "TB"}, {"text": " "}, {"text": "patients:"}]}, {"id": "body-05533", "type": "heading", "style": "Heading4", "text": "Pregnancy and Breastfeeding", "runs": [{"text": "Pregnancy"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "Breastfeeding"}], "level": 4, "list": {"level": 2, "numberingId": "1669"}}, {"id": "body-05534", "type": "paragraph", "style": "BodyText", "text": "TB medicines are safe during pregnancy and breastfeeding; therefore, all pregnant women confirmed with TB disease should receive the standard regimen accordingly", "runs": [{"text": "TB"}, {"text": " "}, {"text": "medicines"}, {"text": " "}, {"text": "are"}, {"text": " "}, {"text": "safe"}, {"text": " "}, {"text": "during"}, {"text": " "}, {"text": "pregnancy"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "breastfeeding;"}, {"text": " "}, {"text": "therefore,"}, {"text": " "}, {"text": "all"}, {"text": " "}, {"text": "pregnant"}, {"text": " "}, {"text": "women"}, {"text": " "}, {"text": "confirmed"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "TB"}, {"text": " "}, {"text": "disease"}, {"text": " "}, {"text": "should receive the standard regimen accordingly"}]}, {"id": "body-05536", "type": "heading", "style": "Heading4", "text": "Oral contraceptives", "runs": [{"text": "Oral"}, {"text": " "}, {"text": "contraceptives"}], "level": 4, "list": {"level": 2, "numberingId": "1669"}}, {"id": "body-05537", "type": "paragraph", "style": "BodyText", "text": "Rifampicin interacts with oral contraceptives and reduces the efficacy of this contraception. higher dose of estrogen (50mcg) or a change to other contraceptive methods is recommended", "runs": [{"text": "Rifampicin"}, {"text": " "}, {"text": "interacts"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "oral"}, {"text": " "}, {"text": "contraceptives"}, {"text": " "}, {"