{"text": " "}, {"text": "and"}, {"text": " "}, {"text": "18"}, {"text": " "}, {"text": "months"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "measles-endemic regions (Tanzania) and at 12–15 months in non-endemic regions."}], "list": {"level": 1, "numberingId": "1777"}}, {"id": "body-03919", "type": "paragraph", "style": "ListParagraph", "text": "Accelerated immunization activities have had a major impact on reducing measles deaths.", "runs": [{"text": "Accelerated"}, {"text": " "}, {"text": "immunization"}, {"text": " "}, {"text": "activities"}, {"text": " "}, {"text": "have"}, {"text": " "}, {"text": "had"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "major"}, {"text": " "}, {"text": "impact"}, {"text": " "}, {"text": "on"}, {"text": " "}, {"text": "reducing"}, {"text": " "}, {"text": "measles"}, {"text": " "}, {"text": "deaths."}], "list": {"level": 1, "numberingId": "1777"}}, {"id": "body-03920", "type": "paragraph", "style": "ListParagraph", "text": "The World Health Organization (WHO) defines measles elimination as “the absence of endemic measles virus transmission in a defined geographical area (e.g., region or country) for at least 12 months in the presence of a surveillance system that has been verified to be performing well.", "runs": [{"text": "The World Health Organization (WHO) defines measles elimination as “the absence of endemic measles virus transmission in a defined geographical area (e.g., region or country) for at least 12 months in the presence of a surveillance system that has been verified to be performing well."}], "list": {"level": 1, "numberingId": "1777"}}], "source": {"file": "medical.docx", "chapter": "Notifiable diseases", "start": "body-03877", "end": "body-03920"}}