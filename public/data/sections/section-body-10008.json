{"id": "section-body-10008", "title": "Spontaneous Bacterial Peritonitis", "chapterId": "chapter-ten", "tocLevel": 4, "tocPath": ["APPROACH TO PATIENTS WITH EMERGENCY CONDITIONS", "GASTROINTESTINAL DISEASE CONDITIONS", "Disorders of The Liver and Biliary Tract", "Spontaneous Bacterial Peritonitis"], "blocks": [{"id": "body-10008", "type": "heading", "style": "Heading4", "text": "Spontaneous Bacterial Peritonitis", "runs": [{"text": "Spontaneous"}, {"text": " "}, {"text": "Bacterial"}, {"text": " "}, {"text": "Peritonitis"}], "level": 4, "list": {"level": 3, "numberingId": "1531"}}, {"id": "body-10009", "type": "paragraph", "style": "BodyText", "text": "Spontaneous bacterial peritonitis is an acute bacterial infection of ascitic fluid in the absence of a contagious cause of infection (e.g., intestinal perforation or abscess)", "runs": [{"text": "Spontaneous"}, {"text": " "}, {"text": "bacterial"}, {"text": " "}, {"text": "peritonitis"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "an"}, {"text": " "}, {"text": "acute"}, {"text": " "}, {"text": "bacterial"}, {"text": " "}, {"text": "infection"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "ascitic"}, {"text": " "}, {"text": "fluid"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "absence"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "contagious"}, {"text": " "}, {"text": "cause"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "infection (e.g., intestinal perforation or abscess)"}]}, {"id": "body-10011", "type": "heading", "style": "Heading4", "text": "Clinical Presentation", "runs": [{"text": "Clinical"}, {"text": " "}, {"text": "Presentation"}], "level": 4}, {"id": "body-10012", "type": "paragraph", "style": "ListParagraph", "text": "Fever and chills", "runs": [{"text": "Fever"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "chills"}], "list": {"level": 0, "numberingId": "1461"}}, {"id": "body-10013", "type": "paragraph", "style": "ListParagraph", "text": "Abdominal pain or discomfort", "runs": [{"text": "Abdominal"}, {"text": " "}, {"text": "pain"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "discomfort"}], "list": {"level": 0, "numberingId": "1461"}}, {"id": "body-10014", "type": "paragraph", "style": "ListParagraph", "text": "Worsening or unexplained encephalopathy", "runs": [{"text": "Worsening"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "unexplained"}, {"text": " "}, {"text": "encephalopathy"}], "list": {"level": 0, "numberingId": "1461"}}, {"id": "body-10015", "type": "paragraph", "style": "ListParagraph", "text": "Diarrhea", "runs": [{"text": "Diarrhea"}], "list": {"level": 0, "numberingId": "1461"}}, {"id": "body-10017", "type": "heading", "style": "Heading4", "text": "Investigations", "runs": [{"text": "Investigations"}], "level": 4}, {"id": "body-10018", "type": "paragraph", "style": "ListParagraph", "text": "Ascites that does not improve following administration of diuretic medication", "runs": [{"text": "Ascites"}, {"text": " "}, {"text": "that"}, {"text": " "}, {"text": "does"}, {"text": " "}, {"text": "not"}, {"text": " "}, {"text": "improve"}, {"text": " "}, {"text": "following"}, {"text": " "}, {"text": "administration"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "diuretic"}, {"text": " "}, {"text": "medication"}], "list": {"level": 0, "numberingId": "1461"}}, {"id": "body-10019", "type": "paragraph", "style": "ListParagraph", "text": "Worsening or new-onset renal failure", "runs": [{"text": "Worsening"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "new-onset"}, {"text": " "}, {"text": "renal"}, {"text": " "}, {"text": "failure"}], "list": {"level": 0, "numberingId": "1461"}}, {"id": "body-10020", "type": "paragraph", "style": "ListParagraph", "text": "Ileus", "runs": [{"text": "Ileus"}], "list": {"level": 0, "numberingId": "1461"}}, {"id": "body-10021", "type": "paragraph", "style": "BodyText", "text": "Diagnosis of Spontaneous bacterial peritonitis is based on the demonstration of an absolute number of polymorphonuclear cells in ascitic fluid equal to or greater than 250/mm3", "runs": [{"text": "Diagnosis"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "Spontaneous"}, {"text": " "}, {"text": "bacterial"}, {"text": " "}, {"text": "peritonitis"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "based"}, {"text": " "}, {"text": "on"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "demonstration"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "an"}, {"text": " "}, {"text": "absolute"}, {"text": " "}, {"text": "number"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "polymorphonuclear"}, {"text": " "}, {"text": "cells in ascitic fluid equal to or greater than 250/mm3"}]}, {"id": "body-10023", "type": "heading", "style": "Heading4", "text": "Pharmacological Management", "runs": [{"text": "Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-10024", "type": "paragraph", "style": "BodyText", "text": "Community Acquired Spontaneous bacterial peritonitis", "runs": [{"text": "Community"}, {"text": " "}, {"text": "Acquired"}, {"text": " "}, {"text": "Spontaneous"}, {"text": " "}, {"text": "bacterial"}, {"text": " "}, {"text": "peritonitis"}]}, {"id": "body-10025", "type": "paragraph", "style": "BodyText", "text": "B: ceftriaxone (IV) 1g 12-24 hourly for 5- 10days", "runs": [{"text": "B:", "bold": true}, {"text": " ", "bold": true}, {"text": "ceftriaxone"}, {"text": " "}, {"text": "(IV)"}, {"text": " "}, {"text": "1g"}, {"text": " "}, {"text": "12-24"}, {"text": " "}, {"text": "hourly"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "5-"}, {"text": " "}, {"text": "10days"}]}, {"id": "body-10026", "type": "paragraph", "style": "Heading3", "text": "OR", "runs": [{"text": "OR"}], "level": 3, "conjunction": true}, {"id": "body-10027", "type": "paragraph", "style": "BodyText", "text": "C: amoxicillin-clavulanic acid (FDC) (IV) 1-2g 6-8hours for 5-10days", "runs": [{"text": "C:", "bold": true}, {"text": " ", "bold": true}, {"text": "amoxicillin-clavulanic"}, {"text": " "}, {"text": "acid"}, {"text": " "}, {"text": "(FDC)"}, {"text": " "}, {"text": "(IV)"}, {"text": " "}, {"text": "1-2g"}, {"text": " "}, {"text": "6-8hours"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "5-"}, {"text": "10days"}]}, {"id": "body-10028", "type": "paragraph", "style": "Heading3", "text": "OR", "runs": [{"text": "OR"}], "level": 3, "conjunction": true}, {"id": "body-10029", "type": "paragraph", "style": "BodyText", "text": "C: ciprofloxacin (IV) 200mg 12hourly for 5–10days", "runs": [{"text": "C:", "bold": true}, {"text": " ", "bold": true}, {"text": "ciprofloxacin"}, {"text": " "}, {"text": "(IV)"}, {"text": " "}, {"text": "200mg"}, {"text": " "}, {"text": "12hourly"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "5–10days"}]}, {"id": "body-10030", "type": "paragraph", "style": "Heading3", "text": "AND", "runs": [{"text": "AND"}], "level": 3, "conjunction": true}, {"id": "body-10031", "type": "paragraph", "style": "BodyText", "text": "S: administration of albumin dose is 1.5 g/kg on day 1 and 1 g/kg on day 3", "runs": [{"text": "S:", "bold": true}, {"text": " ", "bold": true}, {"text": "administration"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "albumin"}, {"text": " "}, {"text": "dose"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "1.5"}, {"text": " "}, {"text": "g/kg"}, {"text": " "}, {"text": "on"}, {"text": " "}, {"text": "day"}, {"text": " "}, {"text": "1"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "1"}, {"text": " "}, {"text": "g/kg"}, {"text": " "}, {"text": "on"}, {"text": " "}, {"text": "day"}, {"text": " "}, {"text": "3"}]}, {"id": "body-10033", "type": "paragraph", "style": "BodyText", "text": "For Nosocomial Spontaneous bacterial peritonitis", "runs": [{"text": "For"}, {"text": " "}, {"text": "Nosocomial"}, {"text": " "}, {"text": "Spontaneous"}, {"text": " "}, {"text": "bacterial"}, {"text": " "}, {"text": "peritonitis"}]}, {"id": "body-10034", "type": "paragraph", "style": "BodyText", "text": "S: meropenem (IV) 1gm 8hourly for 5-7days", "runs": [{"text": "S:", "bold": true}, {"text": " ", "bold": true}, {"text": "meropenem"}, {"text": " "}, {"text": "(IV)"}, {"text": " "}, {"text": "1gm"}, {"text": " "}, {"text": "8hourly"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "5-"}, {"text": "7days"}]}, {"id": "body-10036", "type": "paragraph", "style": "BodyText", "text": "Spontaneous bacterial peritonitis prophylaxis", "runs": [{"text": "Spontaneous"}, {"text": " "}, {"text": "bacterial"}, {"text": " "}, {"text": "peritonitis"}, {"text": " "}, {"text": "prophylaxis"}]}, {"id": "body-10037", "type": "paragraph", "style": "BodyText", "text": "Prophylaxis should be continuous until the disappearance of ascites (i.e., patients with alcoholic hepatitis), death, or transplant.", "runs": [{"text": "Prophylaxis"}, {"text": " "}, {"text": "should"}, {"text": " "}, {"text": "be"}, {"text": " "}, {"text": "continuous"}, {"text": " "}, {"text": "until"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "disappearance"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "ascites"}, {"text": " "}, {"text": "(i.e.,"}, {"text": " "}, {"text": "patients"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "alcoholic"}, {"text": " "}, {"text": "hepatitis),"}, {"text": " "}, {"text": "death,"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "transplant."}]}, {"id": "body-10039", "type": "paragraph", "style": "BodyText", "text": "A: ciprofloxacin (PO) 400mg 24hourly for 10-14days", "runs": [{"text": "A:", "bold": true}, {"text": " ", "bold": true}, {"text": "ciprofloxacin"}, {"text": " "}, {"text": "(PO)"}, {"text": " "}, {"text": "400mg"}, {"text": " "}, {"text": "24hourly"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "10-