{"id": "section-body-18441", "title": "Trigeminal Neuralgia", "chapterId": "chapter-sixteen", "tocLevel": 4, "tocPath": ["APPROACH TO PATIENTS WITH EMERGENCY CONDITIONS", "ORAL AND MAXILLOFACIAL CONDITIONS", "Temporal Mandibular Disorder and Chronic Orofacial Pain", "Trigeminal Neuralgia"], "blocks": [{"id": "body-18441", "type": "heading", "style": "Heading4", "text": "Trigeminal Neuralgia", "runs": [{"text": "Trigeminal Neuralgia"}], "level": 4, "list": {"level": 3, "numberingId": "1126"}}, {"id": "body-18442", "type": "paragraph", "style": "BodyText", "text": "A sudden, usually unilateral, severe, brief, stabbing, recurrent pain in the distribution of one or more branches of the fifth cranial nerve.", "runs": [{"text": "A"}, {"text": " "}, {"text": "sudden,"}, {"text": " "}, {"text": "usually"}, {"text": " "}, {"text": "unilateral,"}, {"text": " "}, {"text": "severe,"}, {"text": " "}, {"text": "brief,"}, {"text": " "}, {"text": "stabbing,"}, {"text": " "}, {"text": "recurrent"}, {"text": " "}, {"text": "pain"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "distribution"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "one"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "more"}, {"text": " "}, {"text": "branches"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "fifth"}, {"text": " "}, {"text": "cranial "}, {"text": "nerve."}]}, {"id": "body-18444", "type": "heading", "style": "Heading4", "text": "Clinical Presentation", "runs": [{"text": "Clinical"}, {"text": " "}, {"text": "Presentation"}], "level": 4}, {"id": "body-18445", "type": "paragraph", "style": "ListParagraph", "text": "Episodes of severe, shooting, or stabbing pain that may feel like an electric shock.", "runs": [{"text": "Episodes"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "severe,"}, {"text": " "}, {"text": "shooting,"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "stabbing"}