yle": "TableParagraph", "text": "Cycloserine", "runs": [{"text": "Cycloserine"}]}], "colspan": 1, "rowspan": 1, "column": 0}, {"blocks": [{"id": "body-27963-r9-c2-00002", "type": "paragraph", "style": "TableParagraph", "text": "Supplement with Vitamin B6", "runs": [{"text": "Supplement"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "Vitamin"}, {"text": " "}, {"text": "B6"}]}], "colspan": 1, "rowspan": 1, "column": 1}, {"blocks": [{"id": "body-27963-r9-c3-00002", "type": "paragraph", "style": "TableParagraph", "text": "Alcohol", "runs": [{"text": "Alcohol"}]}], "colspan": 1, "rowspan": 1, "column": 2}, {"blocks": [{"id": "body-27963-r9-c4-00002", "type": "paragraph", "style": "TableParagraph", "text": "Neurological side effects, irritability", "runs": [{"text": "Neurological"}, {"text": " "}, {"text": "side"}, {"text": " "}, {"text": "effects,"}, {"text": " "}, {"text": "irritability"}]}], "colspan": 1, "rowspan": 1, "column": 3}], "header": false}], "columns": 4}, {"id": "body-27966", "type": "paragraph", "style": "Normal", "text": "Energy", "runs": [{"text": "Energy", "bold": true}]}, {"id": "body-27967", "type": "paragraph", "style": "BodyText", "text": "Most patients with chronic tuberculosis, HIV and AIDS are malnourished, energy needs are increased in order to minimize weight loss and achieve a desirable weight. An additional 300- 500 kcal (35 -40 kcal per ideal body weight) is recommended. This will help in protein sparing.", "runs": [{"text": "Most patients with chronic tuberculosis, HIV and AIDS are malnourished, energy needs are increased in order to minimize weight loss and achieve a desirable weight. An additional 300- 500 kcal (35 -40 kcal per ideal body weight) is recommended. This will help in protein sparing."}]}, {"id": "body-27969", "type": "heading", "style": "Heading4", "text": "Protein", "runs": [{"text": "Protein"}], "level": 4}, {"id": "body-27970", "type": "paragraph", "style": "BodyText", "text": "An intake of 1.2- 1.5 g of protein per kg body weight is required to generate serum albumin levels per day, due to tissue wasting and repair of worn-out tissues.", "runs": [{"text": "An"}, {"text": " "}, {"text": "intake"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "1.2-"}, {"text": " "}, {"text": "1.5"}, {"text": " "}, {"text": "g"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "protein"}, {"text": " "}, {"text": "per"}, {"text": " "}, {"text": "kg"}, {"text": " "}, {"text": "body"}, {"text": " "}, {"text": "weight"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "required"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "generate"}, {"text": " "}, {"text": "serum"}, {"text": " "}, {"text": "albumin"}, {"text": " "}, {"text": "levels"}, {"text": " "}, {"text": "per"}, {"text": " "}, {"text": "day,"}, {"text": " "}, {"text": "due"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "tissue"}, {"text": " "}, {"text": "wasting and repair of worn-out tissues."}]}, {"id": "body-27972", "type": "heading", "style": "Heading4", "text": "Fats/ oils", "runs": [{"text": "Fats/"}, {"text": " "}, {"text": "oils"}], "level": 4}, {"id": "body-27973", "type": "paragraph", "style": "BodyText", "text": "These should provide 25-30% or less of the total energy requirements of an individual.", "runs": [{"text": "These"}, {"text": " "}, {"text": "should"}, {"text": " "}, {"text": "provide"}, {"text": " "}, {"text": "25-30%"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "less"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "total"}, {"text": " "}, {"text": "energy"}, {"text": " "}, {"text": "requirements"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "an"}, {"text": " "}, {"text": "individual."}]}, {"id": "body-27975", "type": "heading", "style": "Heading4", "text": "Vitamins and minerals", "runs": [{"text": "Vitamins"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "minerals"}], "level": 4}, {"id": "body-27976", "type": "paragraph", "style": "BodyText", "text": "The body should be provided with liberal amounts of vitamins and minerals. In TB conversion of beta carotene to retinol is affected in the intestinal mucosa. The client should be supplemented with vitamin A (as per the National Vitamin A supplementation schedule) and encouraged to eat vitamin A rich food. Patients on isoniazid should ideally be supplemented with 10mg of pyridoxine B6 daily since the drug inhibits its absorption. Additional amounts of vitamin C is recommended in the diet to facilitate healing of lesions. Other antioxidants (Vit A, C, and E, folic acid, zinc and selenium) neutralize free radicals and prevent the production of peroxides from lipids.", "runs": [{"text": "The body should be provided with liberal amounts of vitamins and minerals. In TB conversion of beta carotene to retinol is affected in the intestinal mucosa. The client should be supplemented with vitamin A (as per the National Vitamin A supplementation schedule) and encouraged to eat vitamin A rich food. Patients on isoniazid should ideally be supplemented with"}, {"text": " "}, {"text": "10mg"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "pyridoxine"}, {"text": " "}, {"text": "B6"}, {"text": " "}, {"text": "daily"}, {"text": " "}, {"text": "since"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "drug"}, {"text": " "}, {"text": "inhibits"}, {"text": " "}, {"text": "its"}, {"text": " "}, {"text": "absorption."}, {"text": " "}, {"text": "Additional"}, {"text": " "}, {"text": "amounts"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "vitamin"}, {"text": " "}, {"text": "C"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "recommended"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "the diet"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "facilitate"}, {"text": " "}, {"text": "healing"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "lesions."}, {"text": " "}, {"text": "Other"}, {"text": " "}, {"text": "antioxidants"}, {"text": " "}, {"text": "(Vit"}, {"text": " "}, {"text": "A,"}, {"text": " "}, {"text": "C,"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "E,"}, {"text": " "}, {"text": "folic"}, {"text": " "}, {"text": "acid,"}, {"text": " "}, {"text": "zinc"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "selenium)"}, {"text": " "}, {"text": "neutralize"}, {"text": " "}, {"text": "free"}, {"text": " "}, {"text": "radicals"}, {"text": " "}, {"text": "and prevent the production of peroxides from lipids."}]}, {"id": "body-27978", "type": "heading", "style": "Heading4", "text": "Water", "runs": [{"text": "Water"}], "level": 4}, {"id": "body-27979", "type": "paragraph", "style": "BodyText", "text": "At least 8 glasses or more of safe drinking water per day", "runs": [{"text": "At"}, {"text": " "}, {"text": "least"}, {"text": " "}, {"text": "8"}, {"text": " "}, {"text": "glasses"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "more"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "safe"}, {"text": " "}, {"text": "drinking"}, {"text": " "}, {"text": "water"}, {"text": " "}, {"text": "per"}, {"text": " "}, {"text": "day"}]}], "source": {"file": "medical.docx", "chapter": "Nutrition disorders", "start": "body-27944", "end": "body-27979"}}