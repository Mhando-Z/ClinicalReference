{"id": "section-body-05676", "title": "Treatment of Leprosy in Special Cases", "chapterId": "chapter-seven", "tocLevel": 4, "tocPath": ["APPROACH TO PATIENTS WITH EMERGENCY CONDITIONS", "TUBERCULOSIS AND LEPROSY", "General Treatment of Leprosy", "Treatment of Leprosy in Special Cases"], "blocks": [{"id": "body-05676", "type": "heading", "style": "Heading4", "text": "Treatment of Leprosy in Special Cases", "runs": [{"text": "Treatment"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "Leprosy"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "Special"}, {"text": " "}, {"text": "Cases"}], "level": 4, "list": {"level": 2, "numberingId": "1669"}}, {"id": "body-05677", "type": "paragraph", "style": "BodyText", "text": "Tuberculosis: Patients suffering from both tuberculosis and leprosy require appropriate anti- Tuberculosis therapy in addition to the MDT. Rifampicin must be given in the dose required for the treatment of tuberculosis. Once the intensive phase of anti TB treatment is completed, the patient should continue with his/her monthly rifampicin for leprosy treatment.", "runs": [{"text": "Tuberculosis:", "bold": true}, {"text": " ", "bold": true}, {"text": "Patients"}, {"text": " "}, {"text": "suffering"}, {"text": " "}, {"text": "from"}, {"text": " "}, {"text": "both"}, {"text": " "}, {"text": "tuberculosis"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "leprosy"}, {"text": " "}, {"text": "require"}, {"text": " "}, {"text": "appropriate"}, {"text": " "}, {"text": "anti-"}, {"text": " "}, {"text": "Tuberculosis"}, {"text": " "}, {"text": "therapy"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "addition to"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "MDT."}, {"text": " "}, {"text": "Rifampicin"}, {"text": " "}, {"text": "must"}, {"text": " "}, {"text": "be"}, {"text": " "}, {"text": "given"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "dose"}, {"text": " "}, {"text": "