se chapter 12", "runs": [{"text": "Sexual", "bold": true}, {"text": " ", "bold": true}, {"text": "Transmitted", "bold": true}, {"text": " ", "bold": true}, {"text": "disease", "bold": true}, {"text": " ", "bold": true}, {"text": "chapter", "bold": true}, {"text": " ", "bold": true}, {"text": "12", "bold": true}]}, {"id": "body-14936-textbox1-00007", "type": "paragraph", "style": "Normal", "text": "Urgently refer neonates with abundant purulent discharge, swollen eyelids, corneal haziness, or no improvement within 2 days of treatment.", "runs": [{"text": "Urgently"}, {"text": " "}, {"text": "refer"}, {"text": " "}, {"text": "neonates"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "abundant"}, {"text": " "}, {"text": "purulent"}, {"text": " "}, {"text": "discharge,"}, {"text": " "}, {"text": "swollen"}, {"text": " "}, {"text": "eyelids,"}, {"text": " "}, {"text": "corneal"}, {"text": " "}, {"text": "haziness,"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "no"}, {"text": " "}, {"text": "improvement"}, {"text": " "}, {"text": "within"}, {"text": " "}, {"text": "2 days of treatment."}], "list": {"level": 0, "numberingId": "1252"}}, {"id": "body-14938", "type": "heading", "style": "Heading2", "text": "Structural Abnormalities of the Eye", "runs": [{"text": "Structural"}, {"text": " "}, {"text": "Abnormalities"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "the"}, {"text": " Eye"}], "level": 2, "list": {"level": 1, "numberingId": "1271"}}, {"id": "body-14939", "type": "paragraph", "style": "BodyText", "text": "These includes:", "runs": [{"text": "These"}, {"text": " "}, {"text": "includes:"}]}, {"id": "body-14940", "type": "paragraph", "style": "ListParagraph", "text": "Squint: eyes are aligned; one eye appears to be turned in or out, in children or in adult. Refer urgently all children who present with squint to Paediatric Eye Tertiary Centre", "runs": [{"text": "Squint: ", "bold": true}, {"text": "eyes are aligned; one eye appears to be turned in or out, in children or in adult. Refer urgently all children who present with squint to Paediatric Eye Tertiary Centre"}], "list": {"level": 0, "numberingId": "1251"}}, {"id": "body-14941", "type": "paragraph", "style": "ListParagraph", "text": "Ocular swellings disease: The most common ocular swellings are Chalazion, Stye, Pre- septal/Orbital Cellulitis, pterygium and Squamous cell carcinoma of the conjunctiva.", "runs": [{"text": "Ocular swellings disease", "bold": true}, {"text": ": The most common ocular swellings are Chalazion, Stye, Pre- septal/Orbital Cellulitis, pterygium and Squamous cell carcinoma of the conjunctiva."}], "list": {"level": 0, "numberingId": "1251"}}, {"id": "body-14942", "type": "paragraph", "style": "ListParagraph", "text": "Eyelids abnormalities: eyelashes rubbing on cornea (trichiasis), in-turned eyelids (entropion), eyelids bent out too much (ectropion), drooping eyelids (ptosis), inability to close the eyes (lagophthalmos)", "runs": [{"text": "Eyelids abnormalities", "bold": true}, {"text": ": eyelashes rubbing on cornea (trichiasis), in-turned eyelids (entropion), eyelids bent out too much (ectropion), drooping eyelids (ptosis), inability to close the eyes (lagophthalmos)"}], "list": {"level": 0, "numberingId": "1251"}}, {"id": "body-14943-textbox1-00001", "type": "paragraph", "style": "BodyText", "text": "Note: Abnormal tissues excised from eye patients should be subjected to pathology examination for proper diagnosis", "runs": [{"text": "Note:", "bold": true}, {"text": " ", "bold": true}, {"text": "Abnormal"}, {"text": " "}, {"text": "tissues"}, {"text": " "}, {"text": "excised"}, {"text": " "}, {"text": "from"}, {"text": " "}, {"text": "eye"}, {"text": " "}, {"text": "patients"}, {"text": " "}, {"text": "should"}, {"text": " "}, {"text": "be"}, {"text": " "}, {"text": "subjected"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "pathology"}, {"text": " "}, {"text": "examination"}, {"text": " "}, {"text": "for"},