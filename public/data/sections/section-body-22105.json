{"id": "section-body-22105", "title": "Sinus Bradycardia & Sinus Arrest", "chapterId": "chapter-twenty", "tocLevel": 4, "tocPath": ["APPROACH TO PATIENTS WITH EMERGENCY CONDITIONS", "CARDIOVASCULAR DISEASE CONDITIONS", "Cardiac Arrhythmias/ Dysrhythmias", "Sinus Bradycardia & Sinus Arrest"], "blocks": [{"id": "body-22105", "type": "heading", "style": "Heading4", "text": "Sinus Bradycardia & Sinus Arrest", "runs": [{"text": "Sinus"}, {"text": " "}, {"text": "Bradycardia"}, {"text": " "}, {"text": "&"}, {"text": " "}, {"text": "Sinus"}, {"text": " "}, {"text": "Arrest"}], "level": 4, "list": {"level": 2, "numberingId": "781"}}, {"id": "body-22106", "type": "paragraph", "style": "BodyText", "text": "This rhythm does not require treatment, unless they are causing symptoms, i.e. syncope, dizziness, tiredness, and poor effort tolerance. Sinus bradycardia <50/minute or sinus arrest with slow escape rhythm, accompanied by hypotension, strongly suggests a treatable underlying cause:", "runs": [{"text": "This rhythm does not"}, {"text": " "}, {"text": "require treatment,"}, {"text": " "}, {"text": "unless they are causing symptoms,"}, {"text": " "}, {"text": "i.e."}, {"text": " "}, {"text": "syncope,"}, {"text": " "}, {"text": "dizziness,"}, {"text": " "}, {"text": "tiredness,"}, {"text": " "}, {"text": "and poor effort tolerance. Sinus bradycardia <50/minute or sinus arrest with slow escape rhythm, accompanied by hypotension, strongly suggests a treatable underlying cause:"}]}, {"id": "body-22107", "type": "paragraph", "style": "ListParagraph", "text": "Acute inferior myocardial infarct", "runs": [{"text": "Acute"}, {"text": " "}, {"text": "inferior"}, {"text": " "}, {"text": "myocardial"}, {"text": " "}, {"text": "infarct"}], "list": {"level": 0, "numberingId": "678"}}, {"id": "body-22108", "type": "paragraph", "style": "ListParagraph", "text": "Hyperkalemia, especially if wide QRS and/or peaked T waves", "runs": [{"text": "Hyperkalemia,"}, {"text": " "}, {"text": "especially"}, {"text": " "}, {"text": "if"}, {"text": " "}, {"text": "wide"}, {"text": " "}, {"text": "QRS"}, {"text": " "}, {"text": "and/or"}, {"text": " "}, {"text": "peaked"}, {"text": " "}, {"text": "T"}, {"text": " "}, {"text": "waves"}], "list": {"level": 0, "numberingId": "678"}}, {"id": "body-22109", "type": "paragraph", "style": "ListParagraph", "text": "Drugs, especially combination of verapamil and ß –blocker or digoxin", "runs": [{"text": "Drugs,"}, {"text": " "}, {"text": "especially"}, {"text": " "}, {"text": "combination"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "verapamil"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "ß"}, {"text": " "}, {"text": "–blocker"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "digoxin"}], "list": {"level": 0, "numberingId": "678"}}, {"id": "body-22110", "type": "paragraph", "style": "ListParagraph", "text": "Hypothermia", "runs": [{"text": "Hypothermia"}], "list": {"level": 0, "numberingId": "678"}}, {"id": "body-22111", "type": "paragraph", "style": "ListParagraph", "text": "Hypoxia", "runs": [{"text": "Hypoxia"}], "list": {"level": 0, "numberingId": "678"}}, {"id": "body-22112", "type": "paragraph", "style": "BodyText", "text": "Treat the cause. Consider atropine if inferior in", "runs": [{"text": "Treat"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "cause."}, {"text": " "}, {"text": "Consider"}, {"text": " "}, {"text": "atropine"}, {"text": " "}, {"text": "if"}, {"text": " "}, {"text": "inferior"}, {"text": " in"}]}, {"id": "body-22113-textbox1-00001", "type": "paragraph", "style": "BodyText", "text": "Note: Refer the patient After stabilization to the Cardiac Specialized centre for thorough evaluation and Pacemaker Implantation [Temporary/Permanent Pacemaker Implantation (single or Dual chamber) depending on the underlying cause], prepare Vancomycin injection for sterilization of Permanent Pacemaker pouch.", "runs": [{"text": "Note: ", "bold": true}, {"text": "Refer the pati