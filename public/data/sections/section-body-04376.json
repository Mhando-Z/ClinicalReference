: true}, {"text": "liposomal"}, {"text": " "}, {"text": "amphotericin"}, {"text": " "}, {"text": "B:"}, {"text": " "}, {"text": "2.5mg/kg"}, {"text": " "}, {"text": "24hourly"}, {"text": " "}, {"text": "by"}, {"text": " "}, {"text": "infusion"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "20"}, {"text": " "}, {"text": "days,"}, {"text": " "}, {"text": "when"}, {"text": " "}, {"text": "indicated"}]}, {"id": "body-04404", "type": "paragraph", "style": "Normal", "text": "Recommended treatment regimens for cutaneous leishmaniasis, Local therapy, all species S: paromomycin 15% topical ointment apply 12 hourly (BD) to the lesion(s) for 20 days.", "runs": [{"text": "Recommended", "bold": true}, {"text": " ", "bold": true}, {"text": "treatment", "bold": true}, {"text": " ", "bold": true}, {"text": "regimens", "bold": true}, {"text": " ", "bold": true}, {"text": "for", "bold": true}, {"text": " ", "bold": true}, {"text": "cutaneous", "bold": true}, {"text": " ", "bold": true}, {"text": "leishmaniasis,", "bold": true}, {"text": " ", "bold": true}, {"text": "Local", "bold": true}, {"text": " ", "bold": true}, {"text": "therapy,", "bold": true}, {"text": " ", "bold": true}, {"text": "all", "bold": true}, {"text": " ", "bold": true}, {"text": "species S: ", "bold": true}, {"text": "paromomycin 15% topical ointment apply 12 hourly (BD) to the lesion(s) for 20 days."}]}, {"id": "body-04405", "type": "paragraph", "style": "Heading3", "text": "AND", "runs": [{"text": "AND"}], "level": 3, "conjunction": true}, {"id": "body-04406", "type": "paragraph", "style": "BodyText", "text": "S: methylbenzethonium chloride 12% ointment apply 12 hourly (BD) to the lesion(s) for 20 days.", "runs": [{"text": "S:", "bold": true}, {"text": " ", "bold": true}, {"text": "methylbenzethonium"}, {"text": " "}, {"text": "chloride"}, {"text": " "}, {"text": "12%"}, {"text": " "}, {"text": "ointment"}, {"text": " "}, {"text": "apply"}, {"text": " "}, {"text": "12"}, {"text": " "}, {"text": "hourly"}, {"text": " "}, {"text": "(BD)"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "lesion(s)"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "20"}, {"text": " "}, {"text": "days."}]}, {"id": "body-04408", "type": "paragraph", "style": "Heading3", "text": "AND/OR", "runs": [{"text": "AND/OR"}], "level": 3, "conjunction": true}, {"id": "body-04409", "type": "paragraph", "style": "BodyText", "text": "S: thermotherapy Localized heat therapy (50 °C for 30 seconds) — 1–3 sessions (spaced as needed).", "runs": [{"text": "S:", "bold": true}, {"text": " ", "bold": true}, {"text": "thermotherapy"}, {"text": " "}, {"text": "Localized"}, {"text": " "}, {"text": "heat"}, {"text": " "}, {"text": "therapy"}, {"text": " "}, {"text": "(50"}, {"text": " "}, {"text": "°C"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "30"}, {"text": " "}, {"text": "seconds)"}, {"text": " "}, {"text": "—"}, {"text": " "}, {"text": "1–3"}, {"text": " "}, {"text": "sessions"}, {"text": " "}, {"text": "(spaced"}, {"text": " "}, {"text": "as"}, {"text": " "}, {"text": "needed)."}]}, {"id": "body-04410", "type": "paragraph", "style": "Heading3", "text": "AND/OR", "runs": [{"text": "AND/OR"}], "level": 3, "conjunction": true}, {"id": "body-04411", "type": "paragraph", "style": "BodyText", "text": "S: sodium stibogluconate injection 100 mg/mL (intralesional). Inject directly into the lesion until complete blanching is achieved; repeat once weekly for 3–6 weeks or until clinical healing occurs.", "runs": [{"text": "S:", "bold": true}, {"text": " ", "bold": true}, {"text": "sodium"}, {"text": " "}, {"text": "stibogluconate"}, {"text": " "}, {"text": "injection"}, {"text": " "}, {"text": "100"}, {"text": " "}, {"text": "mg/mL"}, {"text": " "}, {"text": "(intralesional)."}, {"text": " "}, {"text": "Inject"}, {"text": " "}, {"text": "directly"}, {"text": " "}, {"text": "into"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "lesion"}, {"te