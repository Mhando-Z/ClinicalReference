sal"}, {"text": " "}, {"text": "spray)"}, {"text": " "}, {"text": "Adults"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "adolescents"}, {"text": " "}, {"text": "from"}, {"text": " "}, {"text": "12years:"}, {"text": " "}, {"text": "2"}, {"text": " "}, {"text": "sprays"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "each"}, {"text": " "}, {"text": "nostril"}, {"text": " "}, {"text": "24hourly"}, {"text": " "}, {"text": "as"}, {"text": " "}, {"text": "needed. Children 6-11years: 1spray in each nostril 24hourly as needed"}]}, {"id": "body-15662-textbox1-00001", "type": "paragraph", "style": "BodyText", "text": "Note: Otitis media with effusion with hearing loss that does not improve after 3months should be referred to a specialist for myringotomy and grommets insertion.", "runs": [{"text": "Note: ", "bold": true}, {"text": "Otitis media with effusion with hearing loss that does not improve after 3months should be referred to a specialist for myringotomy and grommets insertion."}]}, {"id": "body-15663", "type": "heading", "style": "Heading4", "text": "Surgical treatment", "runs": [{"text": "Surgical"}, {"text": " "}, {"text": "treatment"}], "level": 4}, {"id": "body-15664", "type": "paragraph", "style": "BodyText", "text": "Myringotomy + grommet insertion (microscopic/endoscopic)", "runs": [{"text": "Myringotomy"}, {"text": " "}, {"text": "+"}, {"text": " "}, {"text": "grommet"}, {"text": " "}, {"text": "insertion"}, {"text": " "}, {"text": "(microscopic/endoscopic)"}]}, {"id": "body-15665", "type": "paragraph", "style": "BodyText", "text": "+/- Adeno (tonsillectomy)", "runs": [{"text": "+/-"}, {"text": " "}, {"text": "Adeno"}, {"text": " "}, {"text": "(tonsillectomy)"}]}, {"id": "body-15667", "type": "heading", "style": "Heading2", "text": "Hearing Loss", "runs": [{"text": "Hearing"}, {"text": " Loss"}], "level": 2, "list": {"level": 1, "numberingId": "1219"}}, {"id": "body-15668", "type": "paragraph", "style": "BodyText", "text": "A child with hearing loss should be detected and intervention started immediately after delivery. New born hearing screening is done using an otoacoustic emission machine. Any child suspected of hearing loss (usually presenting with delayed speech development) should be referred to a zonal/national hospital immediately since early intervention has a better outcome.", "runs": [{"text": "A"}, {"text": " "}, {"text": "child"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "hearing"}, {"text": " "}, {"text": "loss"}, {"text": " "}, {"text": "should"}, {"text": " "}, {"text": "be"}, {"text": " "}, {"text": "detected"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "intervention"}, {"text": " "}, {"text": "started"}, {"text": " "}, {"text": "immediately"}, {"text": " "}, {"text": "after"}, {"text": " "}, {"text": "delivery."}, {"text": " "}, {"text": "New"}, {"text": " "}, {"text": "born"}, {"text": " "}, {"text": "hearing"}, {"text": " "}, {"text": "screening"}, {"text": " "}, {"text": "is done using an otoacoustic emission machine. Any child suspected of hearing loss (usually presenting with delayed speech development) should be referred to a zonal/national hospital immediately since early intervention has a better outcome."}]}], "source": {"file": "medical.docx", "chapter": "Ear, nose and throat/head and neck diseases", "start": "body-15643", "end": "body-15668"}}