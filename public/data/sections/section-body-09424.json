4"}}, {"id": "body-09431", "type": "paragraph", "style": "ListParagraph", "text": "Pain", "runs": [{"text": "Pain"}], "list": {"level": 0, "numberingId": "1494"}}, {"id": "body-09433", "type": "paragraph", "style": "ListParagraph", "text": "Pruritus", "runs": [{"text": "Pruritus"}], "list": {"level": 0, "numberingId": "1494"}}, {"id": "body-09434", "type": "paragraph", "style": "ListParagraph", "text": "Prolaps", "runs": [{"text": "Prolaps"}], "list": {"level": 0, "numberingId": "1494"}}, {"id": "body-09437", "type": "heading", "style": "Heading4", "text": "Investigations", "runs": [{"text": "Investigations"}], "level": 4}, {"id": "body-09438", "type": "paragraph", "style": "BodyText", "text": "Endoscopy (Anoscopy, or proctosigmoidoscopy) for evidence of characteristic anal recta piles.", "runs": [{"text": "Endoscopy"}, {"text": " "}, {"text": "(Anoscopy,"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "proctosigmoidoscopy)"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "evidence"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "characteristic"}, {"text": " "}, {"text": "anal"}, {"text": " "}, {"text": "recta"}, {"text": " "}, {"text": "piles."}]}, {"id": "body-09441", "type": "heading", "style": "Heading4", "text": "Treatment", "runs": [{"text": "Treatment"}], "level": 4}, {"id": "body-09442", "type": "paragraph", "style": "ListParagraph", "text": "Depends on severity of the disease", "runs": [{"text": "Depends"}, {"text": " "}, {"text": "on"}, {"text": " "}, {"text": "severity"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "disease"}], "list": {"level": 1, "numberingId": "1494"}}, {"id": "body-09443", "type": "paragraph", "style": "ListParagraph", "text": "Grade I hemorrhoids are treated with conservative medical therapy and avoidance of nonsteroidal anti-inflammatory drugs (NSAIDs) and spicy or fatty foods", "runs": [{"text": "Grade I hemorrhoids are treated with conservative medical therapy and avoidance of nonsteroidal anti-inflammatory drugs (NSAIDs) and spicy or fatty foods"}], "list": {"level": 1, "numberingId": "1494"}}, {"id": "body-09445", "type": "heading", "style": "Heading4", "text": "Pharmacological Management", "runs": [{"text": "Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-09447", "type": "paragraph", "style": "ListParagraph", "text": "Grade II or III hemorrhoids are initially treated with nonsurgical procedures (sclerotherapy, band ligation", "runs": [{"text": "Grade II or III hemorrhoids are initially treated with nonsurgical procedures (sclerotherapy, band ligation"}], "list": {"level": 0, "numberingId": "1494"}}, {"id": "body-09448", "type": "paragraph", "style": "ListParagraph", "text": "Very symptomatic grade III and grade IV hemorrhoids are best treated with surgical hemorrhoidectomy", "runs": [{"text": "Very symptomatic grade III and grade IV hemorrhoids are best treated with surgical "}, {"text": "hemorrhoidectomy"}], "list": {"level": 0, "numberingId": "1494"}}, {"id": "body-09450", "type": "paragraph", "style": "BodyText", "text": "A: benzyl benzoate 1.25%, bismuth oxide 0.875%, bismuth subgallate 2.25%, hydrocortisone acetate 0.25%, Peru balsam 1.875%, zinc oxide 10.75% (PR) suppository one or twice a day", "runs": [{"text": "A: ", "bold": true}, {"text": "benzyl benzoate 1.25%, bismuth oxide 0.875%, bismuth subgallate 2.25%, hydrocortisone acetate 0.25%, Peru balsam"}, {"text": " "}, {"text": "1.875%, zinc oxide 10.75% (PR) suppository one or twice a day"}]}, {"id": "body-09451", "type": "paragraph", "style": "Heading3", "text": "OR", "runs": [{"text": "OR"}], "level": 3, "conjunction": true}, {"id": "body-09452", "type": "paragraph", "style": "BodyText", "text": "S: euphobia prostrata extract 100mg+ Calcium dobesilate 500mg (PO) 24hourly (chewable do not swallow)", "runs": [{"text": "S:", "bold": true}, {"text": " ", "bold": true}, {"text": "euphobia"}, {"text": " "}, {"text": "prostrata"}, {"text": " "}, {"text": "extract"}, {"text": " "}, {"text": "100mg+"}, {"text": " "}, {"text": "Calcium"}, {"text": " "}, {"text": "dobesilate"}, {"text": " "}, {"text": "500mg"}, {"text": " "}, {"text": "(PO)"}, {"text": " "}, {"text": "24hourly"}, {"text": " "}, {"text": "(chewable"}, {"text": " "}, {"text": "do"}, {"text": " "}, {"text": "not"}, {"text": " "}, {"text": "swallow)"}]}, {"id": "body-09453", "type": "paragraph", "style": "Heading3", "text": "AND/OR", "runs": [{"text": "AND/OR"}], "level": 3, "conjunction": true}, {"id": "body-09454", "type": "paragraph", "style": "BodyText", "text": "S: prednisolone hexanoate 1.3mg +Cinchocaine hydrochloride 1mg Suppository 24hourly 5-7days", "runs": [{"text": "S:", "bold": true}, {"text": " ", "bold": true}, {"text": "prednisolone"}, {"text": " "}, {"text": "hexanoate"}, {"text": " "}, {"text": "1.3mg"}, {"text": " "}, {"text": "+Cinchocaine"}, {"text": " "}, {"text": "hydrochloride"}, {"text": " "}, {"text": "1mg"}, {"text": " "}, {"text": "Suppository"}, {"text": " "}, {"text": "24hourly"}, {"text": " "}, {"text": "5-"}, {"text": "7days"}]}], "source": {"file": "medical.docx", "chapter": "Gastrointestinal disease conditions", "start": "body-09424", "end": "body-09454"}}