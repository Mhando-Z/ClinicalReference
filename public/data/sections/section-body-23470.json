{"id": "section-body-23470", "title": "21.11. 3 Benign Prostatic Hyperplasia (BPH)", "chapterId": "chapter-twenty-one", "tocLevel": 4, "tocPath": ["APPROACH TO PATIENTS WITH EMERGENCY CONDITIONS", "KIDNEY AND UROLOGICAL DISORDERS", "Urology Disorders", "21.11. 3 Benign Prostatic Hyperplasia (BPH)"], "blocks": [{"id": "body-23470", "type": "heading", "style": "Heading4", "text": "21.11. 3 Benign Prostatic Hyperplasia (BPH)", "runs": [{"text": "21.11."}, {"text": " "}, {"text": "3"}, {"text": " "}, {"text": "Benign"}, {"text": " "}, {"text": "Prostatic"}, {"text": " "}, {"text": "Hyperplasia"}, {"text": " "}, {"text": "(BPH)"}], "level": 4}, {"id": "body-23471", "type": "paragraph", "style": "BodyText", "text": "Benign prostatic hyperplasia is a noncancerous (benign) growth of the prostate gland. Management of BPH depends on severity of symptoms according to International Prostate Symptom Score (IPSS)", "runs": [{"text": "Benign"}, {"text": " "}, {"text": "prostatic"}, {"text": " "}, {"text": "hyperplasia"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "noncancerous"}, {"text": " "}, {"text": "(benign)"}, {"text": " "}, {"text": "growth"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "prostate"}, {"text": " "}, {"text": "gland."}, {"text": " "}, {"text": "Management"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "BPH"}, {"text": " "}, {"text": "depends"}, {"text": " "}, {"text": "on"}, {"text": " "}, {"text": "severity of symptoms according to International Prostate Symptom Score (IPSS)"}]}, {"id": "body-23473", "type": "heading", "style": "Heading4", "text": "Clinical Presentation", "runs": [{"text": "Clinical"}, {"text": " "}, {"text": "Presentation"}], "level": 4}, {"id": "body-23474", "type": "paragraph", "style": "ListParagraph", "text": "Obstructive symptoms: weak, intermittent stream and urinary hesitancy", "runs": [{"text": "Obstructive"}, {"text": " "}, {"text": "symptoms:"}, {"text": " "}, {"text": "weak,"}, {"text": " "}, {"text": "intermittent"}, {"text": " "}, {"text": "stream"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "urinary"}, {"text": " "}, {"text": "hesitancy"}], "list": {"level": 0, "numberingId": "542"}}, {"id": "body-23475", "type": "paragraph", "style": "ListParagraph", "text": "Irritative (frequency, nocturia and urgency) voiding symptoms.", "runs": [{"text": "Irritative"}, {"text": " "}, {"text": "(frequency,"}, {"text": " "}, {"text": "nocturia"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "urgency)"}, {"text": " "}, {"text": "voiding"}, {"text": " "}, {"text": "symptoms."}], "list": {"level": 0, "numberingId": "542"}}, {"id": "body-23476", "type": "paragraph", "style": "ListParagraph", "text": "Digital Rectal Examination reveals a uniform enlargement of the prostate with smooth surface and firm in consistence. The median sulcus is also palpable", "runs": [{"text": "Digital Rectal Examination reveals a uniform enlargement of the prostate with smooth surface and firm in consistence. The median sulcus is also palpable"}], "list": {"level": 0, "numberingId": "542"}}, {"id": "body-23477", "type": "paragraph", "style": "ListParagraph", "text": "Urinary retention with a distended bladder may be present in the absence of severe symptoms, therefore it is important to palpate for an enlarged bladder during examination.", "runs": [{"text": "Urinary"}, {"text": " "}, {"text": "retention"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "distended"}, {"text": " "}, {"text": "bladder"}, {"text": " "}, {"text": "may"}, {"text": " "}, {"text": "be"}, {"text": " "}, {"text": "present"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "absence"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "severe"}, {"text": " "}, {"text": "symptoms,"}, {"text": " "}, {"text": "therefore"}, {"text": " "}, {"text": "it"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "important to palpate for an enlarged bladder during examination."}], "list": {"level": 0, "numberingId": "542"}}, {"id": "body-23478", "type": "paragraph", "style": "ListParagraph", "text": "Pelvic or transrectal USS confirms the prostate enlargement", "runs": [{"text": "Pelvic"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "transrectal"}, {"text": " "}, {"text": "USS"}, {"text": " "}, {"text": "confirms"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "prostate"}, {"text": " "}, {"text": "enlargement"}], "list": {"level": 0, "numberingId": "542"}}, {"id": "body-23479", "type": "paragraph", "style": "ListParagraph", "text": "Prostatic specific antigen levels are within normal range", "runs": [{"text": "Prostatic"}, {"text": " "}, {"text": "specific"}, {"text": " "}, {"text": "antigen"}, {"text": " "}, {"text": "levels"}, {"text": " "}, {"text": "are"}, {"text": " "}, {"text": "within"}, {"text": " "}, {"text": "normal"}, {"text": " "}, {"text": "range"}], "list": {"level": 0, "numberingId": "542"}}, {"id": "body-23480", "type": "paragraph", "style": "ListParagraph", "text": "Symptoms should be graded by the IPSS – international prostate symptom score into mild, moderate and severe.", "runs": [{"text": "Symptoms"}, {"text": " "}, {"text": "should"}, {"text": " "}, {"text": "be"}, {"text": " "}, {"text": "graded"}, {"text": " "}, {"text": "by"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "IPSS"}, {"text": " "}, {"text": "–"}, {"text": " "}, {"text": "international"}, {"text": " "}, {"text": "prostate"}, {"text": " "}, {"text": "symptom"}, {"text": " "}, {"text": "score"}, {"text": " "}, {"text": "into"}, {"text": " "}, {"text": "mild,"}, {"text": " "}, {"text": "moderate"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "severe."}], "list": {"level": 0, "numberingId": "542"}}, {"id": "body-23481", "type": "heading", "style": "Heading4", "text": "Non-Pharmacological Management", "runs": [{"text": "Non-Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-23482", "type": "paragraph", "style": "ListParagraph", "text": "Patients with mild symptoms should be put under watchful waiting (change of lifestyle and regular follow up). Reduce fluid intake especially in the evening, avoid caffeinated drinks", "runs": [{"text": "Patients with mild symptoms should be put under watchful waiting (change of lifestyle and regular follow up). Reduce fluid intake especially in the evening, avoid caffeinated drinks"}], "list": {"level": 0, "numberingId": "542"}}, {"id": "body-23483", "type": "paragraph", "style": "ListParagraph", "text": "Patients with severe symptoms should undergo surgery, transurethral resection of the prostate for prostate weighing up to 75g and those weighing more than 75g should undergo open prostatectomy", "runs": [{"text": "Patients"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "severe"}, {"text": " "}, {"text": "symptoms"}, {"text": " "}, {"text": "should"}, {"text": " "}, {"text": "undergo"}, {"text": " "}, {"text": "surgery,"}, {"text": " "}, {"text": "transurethral"}, {"text": " "}, {"text": "resection"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "prostate"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "prostate"}, {"text": " "}, {"text": "weighing"}, {"text": " "}, {"text": "up to 75g and those weighing more than 75g should undergo open prostatectomy"}], "list": {"level": 0, "numberingId": "542"}}, {"id": "body-23484", "type": "paragraph", "style": "ListParagraph", "text": "For patients presenting with urinary retention, insert a urethral catheter as a temporary measure while patient is transferred to hospital", "runs": [{"text": "For"}, {"text": " "}, {"text": "patients"}, {"text": " "}, {"text": "presenting"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "urinary"}, {"text": " "}, {"text": "retention,"}, {"text": " "}, {"text": "insert"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "urethral"}, {"text": " "}, {"text": "catheter"}, {"text": " "}, {"text": "as"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "temporary"}, {"text": " "}, {"text": "measure"}, {"text": " "}, {"text": "while"}, {"text": " "}, {"text": "patient"}, {"text": " "}, {"text": "is transferred to hospital"}], "list": {"level": 0, "numberingId": "542"}}, {"id": "body-23485", "type": "paragraph", "style": "ListParagraph", "text": "Remove drugs that prevent urinary outflow e.g. tricyclics and neuroleptics.", "runs": [{"text": "Remove"}, {"text": " "}, {"text": "drugs"}, {"text": " "}, {"text": "that"}, {"text": " "}, {"text": "prevent"}, {"text": " "}, {"text": "urinary"}, {"text": " "}, {"text": "outflow"}, {"text": " "}, {"text": "e.g."}, {"text": " "}, {"text": "tricyclics"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "neuroleptics."}], "list": {"level": 0, "numberingId": "542"}}, {"id": "body-23486", "type": "heading", "style": "Heading4", "text": "Pharmacological Management", "runs": [{"text": "Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-23487", "type": "paragraph", "style": "BodyText", "text": "Patients with moderate symptoms according to IPSS should be put under medical therapy unless opt for surgery. Medical treatment of BPH includes alpha-adrenergic blocker or 5 alpha- reductase inhibitor or a combination of both", "runs": [{"text": "Patients with moderate symptoms according to IPSS should be put under medical therapy unless opt for surgery. Medical"}, {"text": " "}, {"text": "treatment"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "BPH"}, {"text": " "}, {"text": "includes"}, {"text": " "}, {"text": "alpha-adrenergic"}, {"text": " "}, {"text": "blocker"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "5"}, {"text": " "}, {"text": "alpha-"}, {"text": " "}, {"text": "reductase"}, {"text": " "}, {"text": "inhibitor"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "combination"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "both"}]}, {"id": "body-23489", "type": "paragraph", "style": "BodyText", "text": "Adrenergic Alpha Blockers:", "runs": [{"text": "Adrenergic"}, {"text": " "}, {"text": "Alpha"}, {"text": " "}, {"text": "Blockers:"}]}, {"id": "body-23490", "type": "paragraph", "style": "BodyText", "text": "D: tamsulosin (PO) 0.4mg 24hourly", "runs": [{"text": "D:", "bold": true}, {"text": " ", "bold": true}, {"text": "tamsulosin"}, {"text": " "}, {"text": "(PO)"}, {"text": " "}, {"text": "0.4mg"}, {"text": " "}, {"text": "24hourly"}]}, {"id": "body-23491", "type": "paragraph", "style": "Heading3", "text": "OR", "runs": [{"text": "OR"}], "level": 3, "conjunction": true}, {"id": "body-23492", "type": "paragraph", "style": "BodyText", "text": "D: alfuzosin (PO) 10mg 24hourly", "runs": [{"text": "D:", "bold": true}, {"text": " ", "bold": true}, {"text": "alfuzosin"}, {"text": " "}, {"text": "(PO)"}, {"text": " "}, {"text": "10mg"}, {"text": " "}, {"text": "24hourly"}]}, {"id": "body-23494", "type": "paragraph", "style": "BodyText", "text": "5-alpha Reductase Inhibitors", "runs": [{"text": "5-alpha"}, {"text": " "}, {"text": "Reductase"}, {"text": " "}, {"text": "Inhibitors"}]}, {"id": "body-23495", "type": "paragraph", "style": "BodyText", "text": "D: finasteride (PO) 5mg 24hourly", "runs": [{"text": "D:", "bold": true}, {"text": " ", "bold": true}, {"text": "finasteride"}, {"text": " "}, {"text": "(PO)"}, {"text": " "}, {"text": "5mg"}, {"text": " "}, {"text": "24hourly"}]}, {"id": "body-23496", "type": "paragraph", "style": "Heading3", "text": "OR", "runs": [{"text": "OR"}], "level": 3, "conjunction": true}, {"id": "body-23497", "type": "paragraph", "style": "BodyText", "text": "S: dutasteride (PO) 0.5mg 24hourly", "runs": [{"text": "S", "bold": true}, {"text": ":"}, {"text": " "}, {"text": "dutasteride"}, {"text": " "}, {"text": "(PO)"}, {"text": " "}, {"text": "0.5mg"}, {"text": " "}, {"text": "24hourly"}]}, {"id": "body-23499", "type": "paragraph", "style": "BodyText", "text": "Anticholinergics", "runs": [{"text": "Anticholinergics"}]}, {"id": "body-23500", "type": "paragraph", "style": "BodyText", "text": "S: oxybutynin (PO) 5mg 8hourly for patients with persistent urgency despite above medications", "runs": [{"text": "S:", "bold": true}, {"text": " ", "bold": true}, {"text": "oxybutynin"}, {"text": " "}, {"text": "(PO)"}, {"text": " "}, {"text": "5mg"}, {"text": " "}, {"text": "8hourly"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "patients"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "persistent"}, {"text": " "}, {"text": "urgency"}, {"text": " "}, {"text": "despite"}, {"text": " "}, {"text": "above"}, {"text": " "}, {"text": "medications"}]}, {"id": "body-23501-textbox1-00001", "type": "paragraph", "style": "BodyText", "text": "Note: All patients with BPH and associated complications like recurrent UTI, Haematuria, Kidney insufficiency, hernia and urinary stones need surgery and should be referred to centres where specialized care can be offered.", "runs": [{"text": "Note: ", "bold": true}, {"text": "All"}, {"text": " "}, {"text": "patients with BPH and associated complications like recurrent UTI, Haematuria, Kidney insufficiency, hernia and urinary stones need surgery and should be referred to centres where specialized care can be offered."}]}, {"id": "body-23501-textbox1-00002", "type": "paragraph", "style": "BodyText", "text": "Prostate Cancer has been posted in Oncology section", "runs": [{"text": "Prostate"}, {"text": " "}, {"text": "Cancer"}, {"text": " "}, {"text": "has"}, {"text": " "}, {"text": "been"}, {"text": " "}, {"text": "posted"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "Oncology"}, {"text": " "}, {"text": "section"}]}], "source": {"file": "medical.docx", "chapter": "Kidney and urological disorders", "start": "body-23470", "end": "body-23501-textbox1-00002"}}