{"id": "section-body-17224", "title": "Bleeding socket", "chapterId": "chapter-sixteen", "tocLevel": 4, "tocPath": ["APPROACH TO PATIENTS WITH EMERGENCY CONDITIONS", "ORAL AND MAXILLOFACIAL CONDITIONS", "Post Extraction Complications", "Bleeding socket"], "blocks": [{"id": "body-17224", "type": "heading", "style": "Heading4", "text": "Bleeding socket", "runs": [{"text": "Bleeding"}, {"text": " "}, {"text": "socket"}], "level": 4, "list": {"level": 2, "numberingId": "1146"}}, {"id": "body-17225", "type": "paragraph", "style": "BodyText", "text": "Can be defined as bleeding that continues beyond 8 to 12 hours after dental/tooth extraction. Local causes of bleeding include, traumatic extraction, bleeding due to disturbing the primary blood clot by the patient through rinsing or inadequate compression on the gauze. Systemic factors include platelet problems, coagulation disorders or excessive fibrinolysis, and inherited or acquired problems (medication induced).", "runs": [{"text": "Can"}, {"text": " "}, {"text": "be"}, {"text": " "}, {"text": "defined"}, {"text": " "}, {"text": "as"}, {"text": " "}, {"text": "bleeding"}, {"text": " "}, {"text": "that"}, {"text": " "}, {"text": "continues"}, {"text": " "}, {"text": "beyond"}, {"text": " "}, {"text": "8"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "12"}, {"text": " "}, {"text": "hours"}, {"text": " "}, {"text": "after"}, {"text": " "}, {"text": "dental/tooth"}, {"text": " "}, {"text": "extraction."}, {"text": " "}, {"text": "Local"}, {"text": " "}, {"text": "causes"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "bleeding"}, {"text": " "}, {"text": "include, traumatic"}, {"text": " "}, {"text": "extraction,"}, {"text": " "}, {"text": "bleeding"}, {"text": " "}, {"text": "due"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "disturbing"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "primary"}, {"text": " "}, {"text": "blood"}, {"text": " "}, {"text": "clot"}, {"text": " "}, {"text": "by"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "patient"}, {"text": " "}, {"text": "through"}, {"text": " "}, {"text": "rinsing"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "inadequate"}, {"text": " "}, {"text": "compression on the gauze."}, {"text": " "}, {"text": "Systemic factors include platelet problems, coagulation disorders or excessive fibrinolysis, and inherited or acquired problems (medication induced)."}]}, {"id": "body-17227", "type": "heading", "style": "Heading4", "text": "Clinical Presentation", "runs": [{"text": "Clinical"}, {"text": " "}, {"text": "Presentation"}], "level": 4}, {"id": "body-17228", "type": "paragraph", "style": "ListParagraph", "text": "Bleeding that continues beyond 12 hours after extraction", "runs": [{"text": "Bleeding"}, {"text": " "}, {"text": "that"}, {"text": " "}, {"text": "continues"}, {"text": " "}, {"text": "beyond"}, {"text": " "}, {"text": "12"}, {"text": " "}, {"text": "hours"}, {"text": " "}, {"text": "after"}, {"text": " "}, {"text": "extraction"}], "list": {"level": 3, "numberingId": "1146"}}, {"id": "body-17229", "type": "paragraph", "style": "ListParagraph", "text": "Development of a large hematoma or ecchymosis within the oral soft tissues;", "runs": [{"text": "Development"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "large"}, {"text": " "}, {"text": "hematoma"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "ecchymosis"}, {"text": " "}, {"text": "within"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "oral"}, {"text": " "}, {"text": "soft"}, {"text": " "}, {"text": "tissues;"}], "list": {"level": 3, "numberingId": "1146"}}, {"id": "body-17230", "type": "paragraph", "style": "BodyText", "text": "Primary Bleeding Socket", "runs": [{"text": "Primary"}, {"text": " "}, {"text": "Bleeding"}, {"text": " "}, {"text": "Socket"}]}, {"id": "body-17231", "type": "paragraph", "style": "ListParagraph", "text": "Active bleeding from the socket", "runs": [{"text": "Active"}, {"text": " "}, {"text": "bleeding"}, {"text": " "}, {"text": "from"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "socket"}], "list": {"level": 3, "numberingId": "1146"}}, {"id": "body-17232", "type": "paragraph", "style": "ListParagraph", "text": "Patient may be dehydrated and pale if has lost significant amount of blood", "runs": [{"text": "Patient"}, {"text": " "}, {"text": "may"}, {"text": " "}, {"text": "be"}, {"text": " "}, {"text": "dehydrated"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "pale"}, {"text": " "}, {"text": "if"}, {"text": " "}, {"text": "has"}, {"text": " "}, {"text": "lost"}, {"text": " "}, {"text": "significant"}, {"text": " "}, {"text": "amount"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "blood"}], "list": {"level": 3, "numberingId": "1146"}}, {"id": "body-17233", "type": "paragraph", "style": "ListParagraph", "text": "Features of decreased pulse rate and volume, hypotension also if patient has lost significant amount of blood", "runs": [{"text": "Features"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "decreased"}, {"text": " "}, {"text": "pulse"}, {"text": " "}, {"text": "rate"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "volume,"}, {"text": " "}, {"text": "hypotension"}, {"text": " "}, {"text": "also"}, {"text": " "}, {"text": "if"}, {"text": " "}, {"text": "patient"}, {"text": " "}, {"text": "has"}, {"text": " "}, {"text": "lost"}, {"text": " "}, {"text": "significant"}, {"text": " "}, {"text": "amount"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "blood"}], "list": {"level": 3, "numberingId": "1146"}}, {"id": "body-17234", "type": "paragraph", "style": "BodyText", "text": "Secondary bleeding", "runs": [{"text": "Secondary"}, {"text": " "}, {"text": "bleeding"}]}, {"id": "body-17235", "type": "paragraph", "style": "ListParagraph", "text": "The socket may show features of infection or trauma", "runs": [{"text": "The"}, {"text": " "}, {"text": "socket"}, {"text": " "}, {"text": "may"}, {"text": " "}, {"text": "show"}, {"text": " "}, {"text": "features"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "infection"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "trauma"}], "list": {"level": 3, "numberingId": "1146"}}, {"id": "body-17236", "type": "heading", "style": "Heading4", "text": "Investigations", "runs": [{"text": "Investigations"}], "level": 4}, {"id": "body-17237", "type": "paragraph", "style": "BodyText", "text": "Depending with the severity of bleeding, patient may need further investigations such as full blood picture, grouping and compatibility testing and coagulation parameters", "runs": [{"text": "Depending"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "severity"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "bleeding,"}, {"text": " "}, {"text": "patient"}, {"text": " "}, {"text": "may"}, {"text": " "}, {"text": "need"}, {"text": " "}, {"text": "further"}, {"text": " "}, {"text": "investigations"}, {"text": " "}, {"text": "such"}, {"text": " "}, {"text": "as"}, {"text": " "}, {"text": "full"}, {"text": " "}, {"text": "blood"}, {"text": " "}, {"text": "picture,"}, {"text": " "}, {"text": "grouping"}, {"text": " "}, {"text": "and compatibility testing and coagulation parameters"}]}, {"id": "body-17239", "type": "heading", "style": "Heading4", "text": "Non-Pharmacological Management", "runs": [{"text": "Non-Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-17240", "type": "paragraph", "style": "ListParagraph", "text": "If the patient is using anticoagulants, discuss with physician for decision to stop or adjust anticoagulants", "runs": [{"text": "If"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "patient"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "using"}, {"text": " "}, {"text": "anticoagulants,"}, {"text": " "}, {"text": "discuss"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "physician"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "decision"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "stop"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "adjust"}, {"text": " "}, {"text": "anticoagulants"}], "list": {"level": 3, "numberingId": "1146"}}, {"id": "body-17241", "type": "paragraph", "style": "ListParagraph", "text": "Depending with the results of the investigations above, patient may be given blood transfusion", "runs": [{"text": "Depending"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "results"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "investigations"}, {"text": " "}, {"text": "above,"}, {"text": " "}, {"text": "patient"}, {"text": " "}, {"text": "may"}, {"text": " "}, {"text": "be"}, {"text": " "}, {"text": "given"}, {"text": " "}, {"text": "blood"}, {"text": " "}, {"text": "transfusion"}], "list": {"level": 3, "numberingId": "1146"}}, {"id": "body-17242", "type": "paragraph", "style": "ListParagraph", "text": "Give local anesthesia (lidocaine 2% with epinephrine (adrenaline) 1 in 80,000 IU).", "runs": [{"text": "Give"}, {"text": " "}, {"text": "local"}, {"text": " "}, {"text": "anesthesia"}, {"text": " "}, {"text": "(lidocaine"}, {"text": " "}, {"text": "2%"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "epinephrine"}, {"text": " "}, {"text": "(adrenaline)"}, {"text": " "}, {"text": "1"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "80,000"}, {"text": " "}, {"text": "IU)."}], "list": {"level": 3, "numberingId": "1146"}}, {"id": "body-17243", "type": "paragraph", "style": "ListParagraph", "text": "Clear any clot available and examine the socket to identify source of bleeding. Suturing of the wound only when necessary (like significantly traumatized gingiva).", "runs": [{"text": "Clear"}, {"text": " "}, {"text": "any"}, {"text": " "}, {"text": "clot"}, {"text": " "}, {"text": "available"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "examine"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "socket"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "identify"}, {"text": " "}, {"text": "source"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "bleeding."}, {"text": " "}, {"text": "Suturing"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "wound"}, {"text": " "}, {"text": "only"}, {"text": " "}, {"text": "when necessary (like significantly traumatized gingiva)."}], "list": {"level": 3, "numberingId": "1146"}}, {"id": "body-17244", "type": "paragraph", "style": "ListParagraph", "text": "Give proper instructions to follow (bite on gauze pack for 30 minutes, not to rinse or eat hot foods on that day at least for 12 hours and avoid disturbance to the wound).", "runs": [{"text": "Give"}, {"text": " "}, {"text": "proper"}, {"text": " "}, {"text": "instructions"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "follow"}, {"text": " "}, {"text": "(bite"}, {"text": " "}, {"text": "on"}, {"text": " "}, {"text": "gauze"}, {"text": " "}, {"text": "pack"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "30"}, {"text": " "}, {"text": "minutes,"}, {"text": " "}, {"text": "not"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "rinse"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "eat"}, {"text": " "}, {"text": "hot"}, {"text": " "}, {"text": "foods"}, {"text": " "}, {"text": "on"}, {"text": " "}, {"text": "that"}, {"text": " "}, {"text": "day"}, {"text": " "}, {"text": "at"}, {"text": " "}, {"text": "least for 12 hours and avoid disturbance to the wound)."}], "list": {"level": 3, "numberingId": "1146"}}, {"id": "body-17246", "type": "heading", "style": "Heading4", "text": "Pharmacological Management", "runs": [{"text": "Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-1