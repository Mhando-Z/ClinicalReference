text": "Management A: ", "bold": true}, {"text": "diazepam10 mg (IV) start."}]}, {"id": "body-26239", "type": "paragraph", "style": "Heading3", "text": "OR", "runs": [{"text": "OR"}], "level": 3, "conjunction": true}, {"id": "body-26240", "type": "paragraph", "style": "BodyText", "text": "C: lorazepam (IM/IV) 2 mg for immediate sedative or hypnotic action. If no response gives a second dose", "runs": [{"text": "C:", "bold": true}, {"text": " ", "bold": true}, {"text": "lorazepam"}, {"text": " "}, {"text": "(IM/IV)"}, {"text": " "}, {"text": "2"}, {"text": " "}, {"text": "mg"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "immediate"}, {"text": " "}, {"text": "sedative"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "hypnotic"}, {"text": " "}, {"text": "action."}, {"text": " "}, {"text": "If"}, {"text": " "}, {"text": "no"}, {"text": " "}, {"text": "response"}, {"text": " "}, {"text": "gives"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "second"}, {"text": " "}, {"text": "dose"}]}, {"id": "body-26241", "type": "paragraph", "style": "Heading3", "text": "OR", "runs": [{"text": "OR"}], "level": 3, "conjunction": true}, {"id": "body-26242", "type": "paragraph", "style": "BodyText", "text": "C: bromocriptine (PO) 2.5 mg 8hourly", "runs": [{"text": "C:", "bold": true}, {"text": " ", "bold": true}, {"text": "bromocriptine"}, {"text": " "}, {"text": "(PO)"}, {"text": " "}, {"text": "2.5"}, {"text": " "}, {"text": "mg"}, {"text": " "}, {"text": "8hourly"}]}, {"id": "body-26244-textbox1-00001", "type": "paragraph", "style": "Normal", "text": "Note", "runs": [{"text": "Note", "bold": true}]}, {"id": "body-26244-textbox1-00002", "type": "paragraph", "style": "BodyText", "text": "NMS is a clinical emergency, it needs ICU care", "runs": [{"text": "NMS"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "clinical"}, {"text": " "}, {"text": "emergency,"}, {"text": " "}, {"text": "it"}, {"text": " "}, {"text": "needs"}, {"text": " "}, {"text": "ICU"}, {"text": " "}, {"text": "care"}], "list": {"level": 0, "numberingId": "370"}}, {"id": "body-26244-textbox1-00003", "type": "paragraph", "style": "BodyText", "text": "It is important to stop the antipsychotics immediately", "runs": [{"text": "It"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "important"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "stop"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "antipsychotics"}, {"text": " "}, {"text": "immediately"}], "list": {"level": 0, "numberingId": "370"}}, {"id": "body-26244-textbox1-00004", "type": "paragraph", "style": "BodyText", "text": "Supportive measures such as bed rest and controlling the hyperthermia by rapid cooling with the help of tepid water spray and via direct fluid replacement should be started immediately", "runs": [{"text": "Supportive"}, {"text": " "}, {"text": "measures"}, {"text": " "}, {"text": "such"}, {"text": " "}, {"text": "as"}, {"text": " "}, {"text": "bed"}, {"text": " "}, {"text": "rest"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "controlling"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "hyperthermia"}, {"text": " "}, {"text": "by"}, {"text": " "}, {"text": "rapid"}, {"text": " "}, {"text": "cooling"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "help"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "tepid"}, {"text": " "}, {"text": "water spray and via direct fluid replacement should be started immediately"}], "list": {"level": 0, "numberingId": "370"}}, {"id": "body-26244-textbox1-00005", "type": "paragraph", "style": "BodyText", "text": "Consideration of ventilator support or intubation would be necessary if the patient has severe breathing difficulties", "runs": [{"text": "Consideration"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "ventilator"}, {"text": " "}, {"text": "support"}, {"text": " "}, {"text": "or"}, {"text": " 