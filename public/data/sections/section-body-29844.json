flammation.", "runs": [{"text": "Muscle"}, {"text": " "}, {"text": "biopsy:"}, {"text": " "}, {"text": "Confirms"}, {"text": " "}, {"text": "inflammation."}], "list": {"level": 0, "numberingId": "73"}}, {"id": "body-29876", "type": "paragraph", "style": "ListParagraph", "text": "Chest CT imaging: for ILD", "runs": [{"text": "Chest"}, {"text": " "}, {"text": "CT"}, {"text": " "}, {"text": "imaging:"}, {"text": " "}, {"text": "for"}, {"text": " ILD"}], "list": {"level": 0, "numberingId": "73"}}, {"id": "body-29877", "type": "paragraph", "style": "ListParagraph", "text": "Malignancy screening: Essential in DM—age- and gender-appropriate cancer screening is advised.", "runs": [{"text": "Malignancy screening: Essential in DM—age- and gender-appropriate cancer screening is advised."}], "list": {"level": 0, "numberingId": "73"}}, {"id": "body-29879", "type": "paragraph", "style": "BodyText", "text": "DM and PM are classified using the 2017 EULAR/ACR criteria with a score of ≥6.7 (with biopsy) or ≥8.7 (without biopsy) in patients without exclusion criteria.", "runs": [{"text": "DM and PM are classified using the 2017 EULAR/ACR criteria with a score of ≥6.7 (with biopsy) or ≥8.7 (without biopsy) in"}, {"text": " "}, {"text": "patients without exclusion criteria."}]}, {"id": "body-29881", "type": "heading", "style": "Heading4", "text": "Non-Pharmacological Management", "runs": [{"text": "Non-Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-29882", "type": "paragraph", "style": "BodyText", "text": "Physiotherapy: Essential for managing weakness, preventing atrophy, and improving strength and flexibility.", "runs": [{"text": "Physiotherapy:"}, {"text": " "}, {"text": "Essential"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "managing"}, {"text": " "}, {"text": "weakness,"}, {"text": " "}, {"text": "preventing"}, {"text": " "}, {"text": "atrophy,"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "improving"}, {"text": " "}