evere headache, abdominal and muscle pains (myalgia)", "runs": [{"text": "Fever,"}, {"text": " "}, {"text": "severe"}, {"text": " "}, {"text": "headache,"}, {"text": " "}, {"text": "abdominal"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "muscle"}, {"text": " "}, {"text": "pains"}, {"text": " "}, {"text": "(myalgia)"}], "list": {"level": 0, "numberingId": "1511"}}, {"id": "body-08931", "type": "paragraph", "style": "ListParagraph", "text": "Delirium, obtundation, intestinal hemorrhage, bowel perforation,", "runs": [{"text": "Delirium,"}, {"text": " "}, {"text": "obtundation,"}, {"text": " "}, {"text": "intestinal"}, {"text": " "}, {"text": "hemorrhage,"}, {"text": " "}, {"text": "bowel"}, {"text": " "}, {"text": "perforation,"}], "list": {"level": 0, "numberingId": "1511"}}, {"id": "body-08932", "type": "paragraph", "style": "ListParagraph", "text": "Sequela neuropsychiatric complications", "runs": [{"text": "Sequela"}, {"text": " "}, {"text": "neuropsychiatric"}, {"text": " "}, {"text": "complications"}], "list": {"level": 0, "numberingId": "1511"}}, {"id": "body-08934", "type": "heading", "style": "Heading4", "text": "Investigations", "runs": [{"text": "Investigations"}], "level": 4}, {"id": "body-08935", "type": "paragraph", "style": "ListParagraph", "text": "Laboratory evidence of positive cultures from bone marrow aspirates; blood or stool done within 1 week of acute infection OR", "runs": [{"text": "Laboratory evidence of positive cultures from bone marrow aspirates; blood or stool done within 1 week of acute"}, {"text": " "}, {"text": "infection OR"}], "list": {"level": 0, "numberingId": "1511"}}, {"id": "body-08936", "type": "paragraph", "style": "ListParagraph", "text": "Salmonella stool antigen test", "runs": [{"text": "Salmonella"}, {"text": " "}, {"text": "stool"}, {"text": " "}, {"text": "antigen"}, {"text": " "}, {"text": "test"}], "list": {"level": 0, "numberingId": "1511"}}, {"id": "body-08937", "type": "paragraph", "style": "ListParagra