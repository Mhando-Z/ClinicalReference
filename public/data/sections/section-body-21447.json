{"id": "section-body-21447", "title": "Hypertensive Urgency", "chapterId": "chapter-twenty", "blocks": [{"id": "body-21447", "type": "heading", "style": "Heading2", "text": "Hypertensive Urgency", "runs": [{"text": "Hypertensive"}, {"text": " "}, {"text": "Urgency"}], "level": 2, "list": {"level": 1, "numberingId": "781"}}, {"id": "body-21448", "type": "paragraph", "style": "BodyText", "text": "Symptomatic severe hypertension SBP 180mmHg and/or DBP >110 mmHg without evidence of target organ damage, such as pulmonary edema, cardiac ischemia, neurologic deficits, or acute renal failure.", "runs": [{"text": "Symptomatic"}, {"text": " "}, {"text": "severe"}, {"text": " "}, {"text": "hypertension"}, {"text": " "}, {"text": "SBP"}, {"text": " "}, {"text": "180mmHg"}, {"text": " "}, {"text": "and/or"}, {"text": " "}, {"text": "DBP"}, {"text": " "}, {"text": ">110"}, {"text": " "}, {"text": "mmHg"}, {"text": " "}, {"text": "without"}, {"text": " "}, {"text": "evidence"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "target"}, {"text": " "}, {"text": "organ"}, {"text": " "}, {"text": "damage,"}, {"text": " "}, {"text": "such"}, {"text": " "}, {"text": "as pulmonary edema, cardiac ischemia, neurologic deficits, or acute renal failure."}]}, {"id": "body-21448-textbox1-00001", "type": "paragraph", "style": "BodyText", "text": "Note: All patients with hypertensive urgency should be treated in hospital", "runs": [{"text": "Note:", "bold": true}, {"text": " ", "bold": true}, {"text": "All"}, {"text": " "}, {"text": "patients"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "hypertensive"}, {"text": " "}, {"text": "urgency"}, {"text": " "}, {"text": "should"}, {"text": " "}, {"text": "be"}, {"text": " "}, {"text": "treated"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "hospital"}]}, {"id": "body-21450", "type": "heading", "style": "Heading4", "text": "Pharmacological Management", "runs": [{"text": "Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-21451", "type": "paragraph", "style": "BodyText", "text": "The goal is to lower DBP to 100mmHg slowly over 48–72hours. This can be achieved with two or more oral agents preferably, Refer to Figure 20.3.", "runs": [{"text": "The"}, {"text": " "}, {"text": "goal"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "lower"}, {"text": " "}, {"text": "DBP"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "100mmHg"}, {"text": " "}, {"text": "slowly"}, {"text": " "}, {"text": "over"}, {"text": " "}, {"text": "48–72hours."}, {"text": " "}, {"text": "This"}, {"text": " "}, {"text": "can"}, {"text": " "}, {"text": "be"}, {"text": " "}, {"text": "achieved"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "two"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "more"}, {"text": " "}, {"text": "oral"}, {"text": " "}, {"text": "agents"}, {"text": " "}, {"text": "preferably, Refer to Figure 20.3."}]}], "source": {"file": "medical.docx", "chapter": "Cardiovascular disease conditions", "start": "body-21447", "end": "body-21451"}}