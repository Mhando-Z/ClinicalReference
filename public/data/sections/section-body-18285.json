{"id": "section-body-18285", "title": "Globulomaxillary cyst", "chapterId": "chapter-sixteen", "tocLevel": 4, "tocPath": ["APPROACH TO PATIENTS WITH EMERGENCY CONDITIONS", "ORAL AND MAXILLOFACIAL CONDITIONS", "Odontogenic and Non- Odontogenic Cysts", "Globulomaxillary cyst"], "blocks": [{"id": "body-18285", "type": "heading", "style": "Heading4", "text": "Globulomaxillary cyst", "runs": [{"text": "Globulomaxillary"}, {"text": " "}, {"text": "cyst"}], "level": 4, "list": {"level": 2, "numberingId": "1126"}}, {"id": "body-18286", "type": "paragraph", "style": "BodyText", "text": "The globulomaxillary cyst is a cyst that appears between a maxillary lateral incisor and the adjacent canine. It often causes the roots of adjacent teeth to diverge.", "runs": [{"text": "The"}, {"text": " "}, {"text": "globulomaxillary"}, {"text": " "}, {"text": "cyst"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "cyst"}, {"text": " "}, {"text": "that"}, {"text": " "}, {"text": "appears"}, {"text": " "}, {"text": "between"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "maxillary"}, {"text": " "}, {"text": "lateral"}, {"text": " "}, {"text": "incisor"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "adjacent"}, {"text": " "}, {"text": "canine."}, {"text": " "}, {"text": "It"}, {"text": " "}, {"text": "often"}, {"text": " "}, {"text": "causes"}, {"text": " "}, {"text": "the roots of adjacent teeth to diverge."}]}, {"id": "body-18288", "type": "heading", "style": "Heading4", "text": "Investigations", "runs": [{"text": "Investigations"}], "level": 4}, {"id": "body-18289", "type": "paragraph", "style": "BodyText", "text": "It exhibits as an \"inverted pear-shaped radiolucency\" on radiographs, or X-ray films.", "runs": [{"text": "It"}, {"text": " "}, {"text": "exhibits"}, {"text": " "}, {"text": "as"}, {"text": " "}, {"text": "an"}, {"text": " "}, {"text": "\"inverted"}, {"text": " "}, {"text": "pear-shaped"}, {"text": " "}, {"text": "radiolucency\""}, {"text": " "}, {"text": "on"}, {"text": " "}, {"text": "radiographs,"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "X-ray"}, {"text": " "}, {"text": "films."}]}, {"id": "body-18291", "type": "heading", "style": "Heading4", "text": "Non-Pharmacological Management", "runs": [{"text": "Non-Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-18292", "type": "paragraph", "style": "BodyText", "text": "Dental cystectomy under local or general anesthesia.", "runs": [{"text": "Dental"}, {"text": " "}, {"text": "cystectomy"}, {"text": " "}, {"text": "under"}, {"text": " "}, {"text": "local"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "general"}, {"text": " "}, {"text": "anesthesia."}]}], "source": {"file": "medical.docx", "chapter": "Oral and maxillofacial conditions", "start": "body-18285", "end": "body-18292"}}