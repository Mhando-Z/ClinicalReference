ased on fracture lines:", "runs": [{"text": "Maxillary"}, {"text": " "}, {"text": "(Upper"}, {"text": " "}, {"text": "Jaw)"}, {"text": " "}, {"text": "Fractures:"}, {"text": " "}, {"text": "include"}, {"text": " "}, {"text": "Le"}, {"text": " "}, {"text": "Fort"}, {"text": " "}, {"text": "fractures:"}, {"text": " "}, {"text": "classified"}, {"text": " "}, {"text": "into"}, {"text": " "}, {"text": "three"}, {"text": " "}, {"text": "patterns"}, {"text": " "}, {"text": "based"}, {"text": " "}, {"text": "on"}, {"text": " "}, {"text": "fracture"}, {"text": " "}, {"text": "lines:"}], "list": {"level": 0, "numberingId": "1103"}}, {"id": "body-17955", "type": "paragraph", "style": "ListParagraph", "text": "Le Fort I: horizontal maxillary fracture (separates maxilla from the palate)", "runs": [{"text": "Le"}, {"text": " "}, {"text": "Fort"}, {"text": " "}, {"text": "I:"}, {"text": " "}, {"text": "horizontal"}, {"text": " "}, {"text": "maxillary"}, {"text": " "}, {"text": "fracture"}, {"text": " "}, {"text": "(separates"}, {"text": " "}, {"text": "maxilla"}, {"text": " "}, {"text": "from"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "palate)"}], "list": {"level": 1, "numberingId": "1103"}}, {"id": "body-17956", "type": "paragraph", "style": "ListParagraph", "text": "Le Fort II: pyramidal fracture involving nasal bridge, maxilla, and orbital floor", "runs": [{"text": "Le"}, {"text": " "}, {"text": "Fort"}, {"text": " "}, {"text": "II:"}, {"text": " "}, {"text": "pyramidal"}, {"text": " "}, {"text": "fracture"}, {"text": " "}, {"text": "involving"}, {"text": " "}, {"text": "nasal"}, {"text": " "}, {"text": "bridge,"}, {"text": " "}, {"text": "maxilla,"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "orbital"}, {"text": " "}, {"text": "floor"}], "list": {"level": 1, "numberingId": "1103"}}, {"id": "body-17957", "type": "paragraph", "style": "ListParagraph", "text": "Le Fort III: craniofacial disjunction, separating the entire midface from the skull base."