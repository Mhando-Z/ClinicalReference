ns": [{"text": "Visual"}, {"text": " "}, {"text": "Acuity"}], "list": {"level": 1, "numberingId": "1302"}}, {"id": "body-13813", "type": "paragraph", "style": "ListParagraph", "text": "Tonometry", "runs": [{"text": "Tonometry"}], "list": {"level": 1, "numberingId": "1302"}}, {"id": "body-13814", "type": "paragraph", "style": "ListParagraph", "text": "Slit Lamp Biomicroscopy", "runs": [{"text": "Slit"}, {"text": " "}, {"text": "Lamp"}, {"text": " "}, {"text": "Biomicroscopy"}], "list": {"level": 1, "numberingId": "1302"}}, {"id": "body-13815", "type": "heading", "style": "Heading4", "text": "Pharmacological Management", "runs": [{"text": "Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-13817", "type": "paragraph", "style": "ListParagraph", "text": "Fundoscopy when cornea clear up", "runs": [{"text": "Fundoscopy"}, {"text": " "}, {"text": "when"}, {"text": " "}, {"text": "cornea"}, {"text": " "}, {"text": "clear"}, {"text": " "}, {"text": "up"}], "list": {"level": 0, "numberingId": "1302"}}, {"id": "body-13818", "type": "paragraph", "style": "ListParagraph", "text": "Gonioscopy when cornea clear up", "runs": [{"text": "Gonioscopy"}, {"text": " "}, {"text": "when"}, {"text": " "}, {"text": "cornea"}, {"text": " "}, {"text": "clear"}, {"text": " "}, {"text": "up"}], "list": {"level": 0, "numberingId": "1302"}}, {"id": "body-13819", "type": "paragraph", "style": "ListParagraph", "text": "Visual Field Analysis for chronic disease", "runs": [{"text": "Visual"}, {"text": " "}, {"text": "Field"}, {"text": " "}, {"text": "Analysis"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "chronic"}, {"text": " "}, {"text": "disease"}], "list": {"level": 0, "numberingId": "1302"}}, {"id": "body-13821", "type": "paragraph", "style": "BodyText", "text": "Institute therapy and then refer the patient to eye specialist at the Regional, Zonal or National Hospital for investigations and proper management.", "runs": [{"text": "Institute therapy and then refer the patient to eye specialist at the Regional, Zonal or National Hospital for investigations and proper management."}]}, {"id": "body-13822", "type": "paragraph", "style": "BodyText", "text": "Try to achieve immediate IOP reduction", "runs": [{"text": "Try"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "achieve"}, {"text": " "}, {"text": "immediate"}, {"text": " "}, {"text": "IOP"}, {"text": " "}, {"text": "reduction"}]}, {"id": "body-13823", "type": "heading", "style": "Heading4", "text": "First-Line", "runs": [{"text": "First-"}, {"text": "Line"}], "level": 4}, {"id": "body-13826", "type": "paragraph", "style": "BodyText", "text": "D: acetazolamide (PO), 500mg immediately as a single dose followed by 250mg 6hourly", "runs": [{"text": "D:", "bold": true}, {"text": " ", "bold": true}, {"text": "acetazolamide"}, {"text": " "}, {"text": "(PO),"}, {"text": " "}, {"text": "500mg"}, {"text": " "}, {"text": "immediately"}, {"text": " "}, {"text": "as"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "single dose followed by 250mg 6hourly"}]}, {"id": "body-13827", "type": "paragraph", "style": "Heading3", "text": "AND", "runs": [{"text": "AND"}], "level": 3, "conjunction": true}, {"id": "body-13828", "type": "paragraph", "style": "BodyText", "text": "D: timolol 0.25–0.5% eye drops, instill one drop 12hourly in the affected eye", "runs": [{"text": "D: ", "bold": true}, {"text": "timolol 0.25–0.5% eye drops, instill one drop 12hourly in the affected eye"}]}, {"id": "body-13829", "type": "paragraph", "style": "Heading3", "text": "AND", "runs": [{"text": "AND"}], "level": 3, "conjunction": true}, {"id": "body-13830", "type": "paragraph", "style": "BodyText", "text": "\nD: pilocarpine hydrochloride 2% or 4%, instill one drop in the affected eye 8 hourly.", "runs": [{"text": "\n"}, {"text": "D: ", "bold": true}, {"text": "pilocarpine hydrochloride 2% or 4%, instill one drop in the affected eye 8 hourly."}]}, {"id": "body-13831", "type": "paragraph", "style": "Heading3", "text": "AND", "runs": [{"text": "AND"}], "level": 3, "conjunction": true}, {"id": "body-13832", "type": "paragraph", "style": "BodyText", "text": "A: ibuprofen 400mg (PO) 12hourly", "runs": [{"text": "A:", "bold": true}, {"text": " ", "bold": true}, {"text": "ibuprofen"}, {"text": " "}, {"text": "400mg"}, {"text": " "}, {"text": "(PO)"}, {"text": " "}, {"text": "12hourly"}]}, {"id": "body-13833", "type": "paragraph", "style": "Heading3", "text": "OR", "runs": [{"text": "OR"}], "level": 3, "conjunction": true}, {"id": "body-13834", "type": "paragraph", "style": "BodyText", "text": "A: paracetamol (PO) 1g 8hourly", "runs": [{"text": "A:", "bold": true}, {"text": " ", "bold": true}, {"text": "paracetamol"}, {"text": " "}, {"text": "(PO)"}, {"text": " "}, {"text": "1g"}, {"text": " "}, {"text": "8hourly"}]}, {"id": "body-13836", "type": "paragraph", "style": "BodyText", "text": "Use the above combined treatment until you have achieved your target IOP reduction, then continue with only Timolol eye drops for life unless patient has received surgical intervention and/or the trigger has been addressed and the IOP is reduced to normal level and no optic nerve damage progression", "runs": [{"text": "Use the above combined treatment until you have achieved your target IOP reduction, then continue with only Timolol eye drops"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "life"}, {"text": " "}, {"text": "unless"}, {"text": " "}, {"text": "patient"}, {"text": " "}, {"text": "has"}, {"text": " "}, {"text": "received"}, {"text": " "}, {"text": "surgical"}, {"text": " "}, {"text": "intervention"}, {"text": " "}, {"text": "and/or"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "trigger"}, {"text": " "}, {"text": "has"}, {"text": " "}, {"text": "been"}, {"text": " "}, {"text": "addressed"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "IOP"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "reduced"}, {"text": " "}, {"text": "to normal level and no optic nerve damage progression"}]}, {"id": "body-13839", "type": "heading", "style": "Heading4", "text": "Second-Line", "runs": [{"text": "Second-"}, {"text": "Line"}], "level": 4}, {"id": "body-13840", "type": "paragraph", "style": "BodyText", "text": "If the above measures fail, use as a short-term treatment, give systemic osmotic agents:", "runs": [{"text": "If"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "above"}, {"text": " "}, {"text": "measures"}, {"text": " "}, {"text": "fail,"}, {"text": " "}, {"text": "use"}, {"text": " "}, {"text": "as"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "short-term"}, {"text": " "}, {"text": "treatment,"}, {"text": " "}, {"text": "give"}, {"text": " "}, {"text": "systemic"}, {"text": " "}, {"text": "osmotic"}, {"text": " "}, {"text": "agents:"}]}, {"id": "body-13841", "type": "paragraph", "style": "BodyText", "text": "C: mannitol 15–20% (IV)1.5–2mg/kg body weight to run slowly over 30–60minutes", "runs": [{"text": "C:", "bold": true}, {"text": " ", "bold": true}, {"text": "mannitol"}, {"text": " "}, {"text": "15–20%"}, {"text": " "}, {"text": "(IV)1.5–2mg/kg"}, {"text": " "}, {"text": "body"}, {"text": " "}, {"text": "weight"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "run"}, {"text": " "}, {"text": "slowly"}, {"text": " "}, {"text": "over"}, {"text": " "}, {"text": "30–60minutes"}]}, {"id": "body-13842", "type": "paragraph", "style": "Heading3", "text": "OR", "runs": [{"text": "OR"}], "level": 3, "conjunction": true}, {"id": "body-13843", "type": "paragraph", "style": "BodyText", "text": "D: paracentesis with a 30G needle for decreasing IOP", "runs": [{"text": "D:", "bold": true}, {"text": " ", "bold": true}, {"text": "paracentesis"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "30G"}, {"text": " "}, {"text": "needle"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "decreasing"}, {"text": " "}, {"text": "IOP"}]}, {"id": "body-13844", "type": "paragraph", "style": "BodyText", "text": "These medicines have diuretic effects, so they are only used as a single dose. They are also used in emergencies to prepare patients with high intraocular pressure for surgery as they lower intraocular pressure rapidly.", "runs": [{"text": "These medicines have diuretic effects, so they are"}, {"text": " "}, {"text": "only used as a single dose. They are also used in emergencies to prepare patients with high intraocular pressure for surgery as they lower intraocular pressure rapidly."}]}, {"id": "body-13845", "type": "heading", "style": "Heading4", "text": "Surgical Treatment", "runs": [{"text": "Surgical"}, {"text": " "}, {"text": "Treatment"}], "level": 4}, {"id": "body-13846", "type": "paragraph", "style": "BodyText", "text": "This is done at a centre with Eye Specialists and necessary diagnostic and treatment equipment. Surgical or Later Peripheral Iridectomy will create a passage for the aqueous fluid from posterior chamber to the drainage angle.", "runs": [{"text": "This is done at a centre with Eye Specialists and necessary diagnostic and treatment equipment. Surgical or Later Peripheral Iridectomy will create a passage for the aqueous fluid from posterior chamber to the drainage angle."}]}, {"id": "body-13847", "type": "paragraph", "style": "BodyText", "text": "Referral: Management of advanced angle closure glaucoma is done by eye specialist. All patients with Angle Closure Glaucoma should be referred to eye specialist for other management modalities and continuity of care.", "runs": [{"text": "Referral:", "bold": true}, {"text": " ", "bold": true}, {"text": "Management"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "advanced"}, {"text": " "}, {"text": "angle"}, {"text": " "}, {"text": "closure"}, {"text": " "}, {"text": "glaucoma"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "done"}, {"text": " "}, {"text": "by"}, {"text": " 