{"id": "section-body-28712", "title": "Paracetamol Poisoning", "chapterId": "chapter-twenty-five", "tocLevel": 4, "tocPath": ["APPROACH TO PATIENTS WITH EMERGENCY CONDITIONS", "POISONING", "Specific poisons", "Paracetamol Poisoning"], "blocks": [{"id": "body-28712", "type": "heading", "style": "Heading4", "text": "Paracetamol Poisoning", "runs": [{"text": "Paracetamol"}, {"text": " "}, {"text": "Poisoning"}], "level": 4, "list": {"level": 2, "numberingId": "154"}}, {"id": "body-28713", "type": "paragraph", "style": "BodyText", "text": "It is the commonest taken drug overdose. The toxic dose is highly variable. In general, the recommended maximum daily dose for healthy adults is 4 grams.", "runs": [{"text": "It"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "commonest"}, {"text": " "}, {"text": "taken"}, {"text": " "}, {"text": "drug"}, {"text": " "}, {"text": "overdose."}, {"text": " "}, {"text": "The"}, {"text": " "}, {"text": "toxic"}, {"text": " "}, {"text": "dose"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "highly"}, {"text": " "}, {"text": "variable."}, {"text": " "}, {"text": "In"}, {"text": " "}, {"text": "general,"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "recommended"}, {"text": " "}, {"text": "maximum"}, {"text": " "}, {"text": "daily"}, {"text": " "}, {"text": "dose for healthy adults is 4 grams."}]}, {"id": "body-28715", "type": "paragraph", "style": "BodyText", "text": "Chronic excessive alcohol consumption and Isoniazid can induce CYP2E1, antiepileptics including carbamazepine, phenytoin, and barbiturates induces CYP enzymes thus increasing the potential toxicity of Paracetamol.", "runs": [{"text": "Chronic"}, {"text": " "}, {"text": "excessive"}, {"text": " "}, {"text": "alcohol"}, {"text": " "}, {"text": "consumption"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "Isoniazid"}, {"text": " "}, {"text": "can"}, {"text": " "}, {"text": "induce"}, {"text": " "}, {"text": "CYP2E1,"}, {"text": " "}, {"text": "antiepileptics"}, {"text": " "}, {"text": "including"}, {"text": " "}, {"text": "carbamazepine,"}, {"text": " "}, {"text": "phenytoin, and barbiturates induces CYP enzymes thus increasing the potential toxicity of Paracetamol."}]}, {"id": "body-28717", "type": "paragraph", "style": "BodyText", "text": "Supportive care is essential in paracetamol toxicity. Immediate assess the patient's airway, breathing, and hemodynamic status", "runs": [{"text": "Supportive"}, {"text": " "}, {"text": "care"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "essential"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "paracetamol"}, {"text": " "}, {"text": "toxicity."}, {"text": " "}, {"text": "Immediate"}, {"text": " "}, {"text": "assess"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "patient's"}, {"text": " "}, {"text": "airway,"}, {"text": " "}, {"text": "breathing,"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "hemodynamic"}, {"text": " "}, {"text": "status"}]}, {"id": "body-28719", "type": "heading", "style": "Heading4", "text": "Clinical Presentation", "runs": [{"text": "Clinical"}, {"text": " "}, {"text": "Presentation"}], "level": 4}, {"id": "body-28720", "type": "paragraph", "style": "ListParagraph", "text": "Phase-1: 0.5–24 hours after ingestion: asymptomatic, to nonspecific symptoms (anorexia, nausea, vomiting and malaise). Pallor, diaphoresis", "runs": [{"text": "Phase-1:"}, {"text": " "}, {"text": "0.5–24"}, {"text": " "}, {"text": "hours"}, {"text": " "}, {"text": "after"}, {"text": " "}, {"text": "ingestion:"}, {"text": " "}, {"text": "asymptomatic,"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "nonspecific"}, {"text": " "}, {"text": "symptoms"}, {"text": " "}, {"text": "(anorexia,"}, {"text": " "}, {"text": "nausea,"}, {"text": " "}, {"text": "vomiting"}, {"text": " "}, {"text": "and malaise). Pallor, diaphoresis"}], "list": {"level": 0, "numberingId": "116"}}, {"id": "body-28721", "type": "paragraph", "style": "ListParagraph", "text": "Phase-2: 18–72 hours after ingestion: Right upper quadrant abdominal pain, anorexia, nausea and vomiting, Tender right upper quadrant, tachycardia, hypotension and oliguria.", "runs": [{"text": "Phase-2: 18–72 hours after ingestion: Right upper quadrant abdominal pain, anorexia, nausea and vomiting, Tender right upper quadrant, tachycardia, hypotension and oliguria."}], "list": {"level": 0, "numberingId": "116"}}, {"id": "body-28722", "type": "paragraph", "style": "ListParagraph", "text": "Phase-3: 72–96 hours after ingestion: all of the above and jaundice, coagulopathy, hypoglycemia and hepatic encephalopathy, Acute Renal failure.", "runs": [{"text": "Phase-3:"}, {"text": " "}, {"text": "72–96"}, {"text": " "}, {"text": "hours"}, {"text": " "}, {"text": "after"}, {"text": " "}, {"text": "ingestion:"}, {"text": " "}, {"text": "all"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "above"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "jaundice,"}, {"text": " "}, {"text": "coagulopathy,"}, {"text": " "}, {"text": "hypoglycemia"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "hepatic encephalopathy, Acute Renal failure."}], "list": {"level": 0, "numberingId": "116"}}, {"id": "body-28723", "type": "paragraph", "style": "ListParagraph", "text": "Phase-4: 4th day to 3weeks after ingestion: patient who survive critical illness in phase 3, have complete recovery.", "runs": [{"text": "Phase-4:"}, {"text": " "}, {"text": "4th"}, {"text": " "}, {"text": "day"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "3weeks"}, {"text": " "}, {"text": "after"}, {"text": " "}, {"text": "ingestion:"}, {"text": " "}, {"text": "patient"}, {"text": " "}, {"text": "who"}, {"text": " "}, {"text": "survive"}, {"text": " "}, {"text": "critical"}, {"text": " "}, {"text": "illness"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "phase"}, {"text": " "}, {"text