{"id": "section-body-25373", "title": "Chronic Myeloid Leukemia (CML) Investigations:", "chapterId": "chapter-twenty-two", "tocLevel": 4, "tocPath": ["APPROACH TO PATIENTS WITH EMERGENCY CONDITIONS", "MALIGNANT DISEASE CONDITIONS", "Haematological Malignancies", "Chronic Myeloid Leukemia (CML)"], "blocks": [{"id": "body-25373", "type": "heading", "style": "Heading4", "text": "Chronic Myeloid Leukemia (CML) Investigations:", "runs": [{"text": "Chronic"}, {"text": " "}, {"text": "Myeloid"}, {"text": " "}, {"text": "Leukemia"}, {"text": " "}, {"text": "(CML) "}, {"text": "Investigations:"}], "level": 4, "list": {"level": 3, "numberingId": "534"}}, {"id": "body-25374", "type": "paragraph", "style": "BodyText", "text": "Similar to other leukemia, plus BCR-ABL1 analysis by PCR or FISH for Ph chromosome analysis", "runs": [{"text": "Similar"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "other"}, {"text": " "}, {"text": "leukemia,"}, {"text": " "}, {"text": "plus"}, {"text": " "}, {"text": "BCR-ABL1"}, {"text": " "}, {"text": "analysis"}, {"text": " "}, {"text": "by"}, {"text": " "}, {"text": "PCR"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "FISH"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "Ph"}, {"text": " "}, {"text": "chromosome"}, {"text": " "}, {"text": "analysis"}]}, {"id": "body-25376", "type": "heading", "style": "Heading4", "text": "Pharmacological Management", "runs": [{"text": "Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-25377", "type": "paragraph", "style": "BodyText", "text": "For BCR-ABL1 positive, first line treatment is Tyrosine kinase inhibitors (TKI) Chronic phase: Characterized by blast cells < 10%.", "runs": [{"text": "For"}, {"text": " "}, {"text": "BCR-ABL1"}, {"text": " "}, {"text": "positive,"}, {"text": " "}, {"text": "first"}, {"text": " "}, {"text": "line"}, {"text": " "}, {"text": "treatment"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "Tyrosine"}, {"text": " "}, {"text": "kinase"}, {"text": " "}, {"text": "inhibitors"}, {"text": " "}, {"text": "(TKI) Chronic phase: Characterized by blast cells < 10%."}]}, {"id": "body-25379", "type": "paragraph", "style": "BodyText", "text": "S: imatinib (PO) 400mg once a day every day.", "runs": [{"text": "S:", "bold": true}, {"text": " ", "bold": true}, {"text": "imatinib"}, {"text": " "}, {"text": "(PO)"}, {"text": " "}, {"text": "400mg"}, {"text": " "}, {"text": "once"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "day"}, {"text": " "}, {"text": "every"}, {"text": " "}, {"text": "day."}]}, {"id": "body-25381", "type": "heading", "style": "Heading4", "text": "Accelerated phase: blasts 10 – 19%.", "runs": [{"text": "Accelerated"}, {"text": " "}, {"text": "phase:"}, {"text": " "}, {"text": "blasts"}, {"text": " "}, {"text": "10"}, {"text": " "}, {"text": "–"}, {"text": " "}, {"text": "19%."}], "level": 4}, {"id": "body-25382", "type": "paragraph", "style": "BodyText", "text": "S: imatinib (PO) 600-800mg/day in 2 divided doses until the chronic phase is reached. Thereafter, continue with 400mg once daily.", "runs": [{"text": "S: ", "bold": true}, {"text": "imatinib (PO) 600-800mg/day in 2 divided doses until the chronic phase is reached. Thereafter, continue with 400mg once "}, {"text": "daily."}]}, {"id": "body-25384", "type": "paragraph", "style": "BodyText", "text": "Blast crisis: Blast cells > 20%. If the patient was not on TKIs, treat as in accelerated phase. If patient was on TKIs, treat as acute leukemia.", "runs": [{"text": "Blast crisis: ", "bold": true}, {"text": "Blast cells > 20%. If the patient was not on TKIs, treat as in accelerated phase. If patient was on TKIs, treat as acute leukemia."}]}, {"id": "body-25386", "type": "paragraph", "style": "BodyText", "text": "S: Second line TKIs include nilotinib, dasatinib, bosutinib and ponatinib (PO) If BCR-ABL1 negative", "runs": [{"text": "S:", "bold": true}, {"text": " ", "bold": true}, {"text": "Second"}, {"text": " "}, {"text": "line"}, {"text": " "}, {"text": "TKIs"}, {"text": " "}, {"text": "include"}, {"text": " "}, {"text": "nilotinib,"}, {"text": " "}, {"text": "dasatinib,"}, {"text": " "}, {"text": "bosutinib"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "ponatinib"}, {"text": " "}, {"text": "(PO) If BCR-ABL1 negative"}]}, {"id": "body-25388", "type": "paragraph", "style": "BodyText", "text": "D: hydroxyurea (PO) 40mg/kg daily. The dose ranges between 1mg and 3mg based on the WBC count.", "runs": [{"text": "D:", "bold": true}, {"text": " ", "bold": true}, {"text": "hydroxyurea"}, {"text": " "}, {"text": "(PO)"}, {"text": " "}, {"text": "40mg/kg"}, {"text": " "}, {"text": "daily."}, {"text": " "}, {"text": "The"}, {"text": " "}, {"text": "dose"}, {"text": " "}, {"text": "ranges"}, {"text": " "}, {"text": "between"}, {"text": " "}, {"text": "1mg"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "3mg"}, {"text": " "}, {"text": "based"}, {"text": " "}, {"text": "on"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "WBC"}, {"text": " "}, {"text": "count."}]}, {"id": "body-25388-textbox1-00001", "type": "paragraph", "style": "BodyText", "text": "Note: Adequate hydration should be maintained. Blood transfusion is indicated based on the degree of anaemia", "runs": [{"text": "Note:", "bold": true}, {"text": " ", "bold": true}, {"text": "Adequate"}, {"text": " "}, {"text": "hydration"}, {"text": " "}, {"text": "should"}, {"text": " "}, {"text": "be"}, {"text": " "}, {"text": "maintained."}, {"text": " "}, {"text": "Blood"}, {"text": " "}, {"text": "transfusion"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "indicated"}, {"text": " "}, {"text": "based"}, {"text": " "}, {"text": "on"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "degree"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "anaemia"}]}, {"id": "body-25390", "type": "paragraph", "style": "BodyText", "text": "B: allopurinol (PO) 300mg 24hourly daily to prevent hyperuricemia.", "runs": [{"text": "B:", "bold": true}, {"text": " ", "bold": true}, {"text": "allopurinol"}, {"text": " "}, {"text": "(PO)"}, {"text": " "}, {"text": "300mg"}, {"text": " "}, {"text": "24hourly"}, {"text": " "}, {"text": "daily"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "prevent"}, {"text": " "}, {"text": "hyperuricemia."}]}, {"id": "body-25392", "type": "paragraph", "style": "ListParagraph", "text": "Chronic Lymphoid Leukemia (CLL) Staging: RAI and Binet staging systems.", "runs": [{"text": "Chronic", "bold": true}, {"text": " ", "bold": true}, {"text": "Lymphoid", "bold": true}, {"text": " ", "bold": true}, {"text": "Leukemia", "bold": true}, {"text": " ", "bold": true}, {"text": "(CLL) Staging: ", "bold": true}, {"text": "RAI and Binet staging systems."}], "list": {"level": 3, "numberingId": "534"}}, {"id": "body-25393", "type": "heading", "style": "Heading4", "text": "Pharmacological Management", "runs": [{"text": "Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-25394", "type": "paragraph", "style": "BodyText", "text": "S: chlorambucil (PO) 0.1mg/kg 24hourly for 2weeks, then rest for 2 weeks, repeat until remission is achieved.", "runs": [{"text": "S:", "bold": true}, {"text": " ", "bold": true}, {"text": "chlorambucil"}, {"text": " "}, {"text": "(PO)"}, {"text": " "}, {"text": "0.1mg/kg"}, {"text": " "}, {"text": "24hourly"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "2weeks,"}, {"text": " "}, {"text": "then"}, {"text": " "}, {"text": "rest"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "2"}, {"text": " "}, {"text": "weeks,"}, {"text": " "}, {"text": "repeat"}, {"text": " "}, {"text": "until"}, {"text": " "}, {"text": "remission"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "achieved."}]}, {"id": "body-25395", "type": "paragraph", "style": "Heading3", "text": "OR", "runs": [{"text": "OR"}], "level": 3, "conjunction": true}, {"id": "body-25396", "type": "paragraph", "style": "BodyText", "text": "S: fludarabine + cyclophosphamide + rituximab (FCR) regimen (IV)", "runs": [{"text": "S:", "bold": true}, {"text": " ", "bold": true}, {"text": "fludarabine"}, {"text": " "}, {"text": "+"}, {"text": " "}, {"text": "cyclophosphamide"}, {"text": " "}, {"text": "+"}, {"text": " "}, {"text": "rituximab"}, {"text": " "}, {"text": "(FCR)"}, {"text": " "}, {"text": "regimen"}, {"text": " "}, {"text": "(IV)"}]}, {"id": "body-25398", "type": "paragraph", "style": "BodyText", "text": "If autoimmune haemolytic anaemia or autoimmune thrombocytopenia is present add", "runs": [{"text": "If"}, {"text": " "}, {"text": "autoimmune"}, {"text": " "}, {"text": "haemolytic"}, {"text": " "}, {"text": "anaemia"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "autoimmune"}, {"text": " "}, {"text": "thrombocytopenia"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "present"}, {"text": " "}, {"text": "add"}]}, {"id": "body-25399", "type": "paragraph", "style": "BodyText", "text": "B: prednisolone (PO) 1mg/kg 24 once a day for 2 weeks", "runs": [{"text": "B:", "bold": true}, {"text": " ", "bold": true}, {"text": "prednisolone"}, {"text": " "}, {"text": "(PO)"}, {"text": " "}, {"text": "1mg/kg"}, {"text": " "}, {"text": "24"}, {"text": " "}, {"text": "once"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "day"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "2"}, {"text": " "}, {"text": "weeks"}]}], "source": {"file": "medical.docx", "chapter": "Malignant disease conditions", "start": "body-25373", "end": "body-25399"}}