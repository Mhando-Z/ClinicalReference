"text": " "}, {"text": "rehydration,"}, {"text": " "}, {"text": "approximately"}, {"text": " "}, {"text": "75-100ml/kg"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "first"}, {"text": " "}, {"text": "four"}, {"text": " "}, {"text": "hours"}], "list": {"level": 0, "numberingId": "1799"}}, {"id": "body-03177", "type": "paragraph", "style": "ListParagraph", "text": "Reassess after four hours; if improved, continue giving WHO based ORS, in quantity corresponding to losses (e.g. after each stool) or 10 to 20ml/kg. If not improved, treat as severe dehydration.", "runs": [{"text": "Reassess after four hours; if improved, continue giving WHO based ORS, in quantity corresponding to losses (e.g. after each stool) or 10 to 20ml/kg. If not improved, treat as severe dehydration."}], "list": {"level": 0, "numberingId": "1799"}}, {"id": "body-03178", "type": "paragraph", "style": "BodyText", "text": "If no signs of dehydration", "runs": [{"text": "If"}, {"text": " "}, {"text": "no"}, {"text": " "}, {"text": "signs"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "dehydration"}]}, {"id": "body-03179", "type": "paragraph", "style": "ListParagraph", "text": "Patients who have no signs of dehydration when first observed can be treated at home", "runs": [{"text": "Patients"}, {"text": " "}, {"text": "who"}, {"text": " "}, {"text": "have"}, {"text": " "}, {"text": "no"}, {"text": " "}, {"text": "signs"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "dehydration"}, {"text": " "}, {"text": "when"}, {"text": " "}, {"text": "first"}, {"text": " "}, {"text": "observed"}, {"text": " "}, {"text": "can"}, {"text": " "}, {"text": "be"}, {"text": " "}, {"text": "treated"}, {"text": " "}, {"text": "at"}, {"text": " "}, {"text": "home"}], "list": {"level": 0, "numberingId": "1799"}}, {"id": "body-03180", "type": "paragraph", "style": "ListParagraph", "text": "Give these patients ORS packets to take home, enough for 2 days", "runs": [{"text": "Give"}, {"text": " "}, {"text": "these"}, {"text": " "}, {"text": "patients"}, {"text": " "}, {"text": "ORS"}, {"text": " "}, {"text": "packets"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "take"}, {"text": " "}, {"text": "home,"}, {"text": " "}, {"text": "enough"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "2"}, {"text": " days"}], "list": {"level": 0, "numberingId": "1799"}}, {"id": "body-03181", "type": "paragraph", "style": "ListParagraph", "text": "Demonstrate how to prepare and give the solution", "runs": [{"text": "Demonstrate"}, {"text": " "}, {"text": "how"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "prepare"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "give"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "solution"}], "list": {"level": 0, "numberingId": "1799"}}, {"id": "body-03182", "type": "paragraph", "style": "ListParagraph", "text": "Instruct the patient or the caretaker to return if any of the following signs develop; increased number of watery stools repeated vomiting or any signs indicating other problems (e.g. fever, blood in stool)", "runs": [{"text": "Instruct"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "patient"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "caretaker"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "return"}, {"text": " "}, {"text": "if"}, {"text": " "}, {"text": "any"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "following"}, {"text": " "}, {"text": "signs"}, {"text": " "}, {"text": "develop;"}, {"text": " "}, {"text": "increased"}, {"text": " "}, {"text": "number"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "watery"}, {"text": " "}, {"text": "stools repeated vomiting or any signs indicating other problems (e.g. fever, blood in stool)"}], "list": {"level": 0, "numberingId": "1799"}}, {"id": "body-03184", "type": "paragraph", "style": "BodyText", "text": "For each loose stool or vomiting give;", "runs": [{"text": "For"}, {"text": " "}, {"text": "each"}, {"text": " "}, {"text": "loose"}, {"text": " "}, {"text": "stool"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "vomiting"}, {"text": " "}, {"text": "give;"}]}, {"id": "body-03185", "type": "paragraph", "style": "ListParagraph", "text": "50-100 ml (¼ - ½ cup) of ORS solution for a child less than 2 years old.", "runs": [{"text": "50-100"}, {"text": " "}, {"text": "ml"}, {"text": " "}, {"text": "(¼"}, {"text": " "}, {"text": "-"}, {"text": " "}, {"text": "½"}, {"text": " "}, {"text": "cup)"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "ORS"}, {"text": " "}, {"text": "solution"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "child"}, {"text": " "}, {"text": "less"}, {"text": " "}, {"text": "than"}, {"text": " "}, {"text": "2"}, {"text": " "}, {"text": "years"}, {"text": " old."}], "list": {"level": 0, "numberingId": "1799"}}, {"id": "body-03186", "type": "paragraph", "style": "ListParagraph", "text": "100-200 ml for older children. Adults can take as much as they want", "runs": [{"text": "100-200"}, {"text": " "}, {"text": "ml"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "older"}, {"text": " "}, {"text": "children."}, {"text": " "}, {"text": "Adults"}, {"text": " "}, {"text": "can"}, {"text": " "}, {"text": "take"}, {"text": " "}, {"text": "as"}, {"text": " "}, {"text": "much"}, {"text": " "}, {"text": "as"}, {"text": " "}, {"text": "they"}, {"text": " "}, {"text": "want"}], "list": {"level": 0, "numberingId": "1799"}}, {"id": "body-03187", "type": "heading", "style": "Heading4", "text": "Zinc and Folic Acid Supplements", "runs": [{"text": "Zinc"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "Folic"}, {"text": " "}, {"text": "Acid"}, {"text": " "}, {"text": "Supplements"}], "level": 4, "list": {"level": 0, "numberingId": "1800"}}, {"id": "body-03188", "type":