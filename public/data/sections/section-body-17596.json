4}, {"id": "body-17611", "type": "paragraph", "style": "ListParagraph", "text": "OPG or CBCT", "runs": [{"text": "OPG"}, {"text": " "}, {"text": "or"}, {"text": " CBCT"}], "list": {"level": 1, "numberingId": "1119"}}, {"id": "body-17612", "type": "paragraph", "style": "ListParagraph", "text": "Pus swab for Gram stain, culture, and sensitivity.", "runs": [{"text": "Pus"}, {"text": " "}, {"text": "swab"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "Gram"}, {"text": " "}, {"text": "stain,"}, {"text": " "}, {"text": "culture,"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "sensitivity."}], "list": {"level": 1, "numberingId": "1119"}}, {"id": "body-17613", "type": "heading", "style": "Heading4", "text": "Non-Pharmacological Management", "runs": [{"text": "Non-Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-17614", "type": "paragraph", "style": "ListParagraph", "text": "Incision and drainage of pus followed by irrigation with hydrogen peroxide 3% and copious amount of sterile saline (0.9% Sodium chloride)", "runs": [{"text": "Incision and drainage of pus followed by irrigation with hydrogen peroxide 3% and copious amount of sterile saline (0.9% Sodium chloride)"}], "list": {"level": 1, "numberingId": "1119"}}, {"id": "body-17615", "type": "paragraph", "style": "ListParagraph", "text": "Dressing with dry or medicated gauze", "runs": [{"text": "Dressing"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "dry"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "medicated"}, {"text": " "}, {"text": "gauze"}], "list": {"level": 1, "numberingId": "1119"}}, {"id": "body-17616", "type": "paragraph", "style": "ListParagraph", "text": "Extraction of offending tooth/teeth", "runs": [{"text": "Extraction"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "offending"}, {"text": " "}, {"text": "tooth/teeth"}], "list": {"level": 1, "numberingId": "1119"}}, {"id": "body-17617", "type": "heading", "style": "Heading4", "text": "Pharmacological Management", "runs": [{"text": "Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-17618", "type": "paragraph", "style": "BodyText", "text": "A: amoxicillin (PO) 500mg 8hourly for 5days", "runs": [{"text": "A:", "bold": true}, {"text": " ", "bold": true}, {"text": "amoxicillin"}, {"text": " "}, {"text": "(PO)"}, {"text": " "}, {"text": "500mg"}, {"text": " "}, {"text": "8hourly"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "5days"}]}, {"id": "body-17619", "type": "paragraph", "style": "Heading3", "text": "AND", "runs": [{"text": "AND"}], "level": 3, "conjunction": true}, {"id": "body-17620", "type": "paragraph", "style": "BodyText", "text": "A: metronidazole (PO) 400mg 8hourly for 5days.", "runs": [{"text": "A:", "bold": true}, {"text": " ", "bold": true}, {"text": "metronidazole"}, {"text": " "}, {"text": "(PO)"}, {"text": " "}, {"text": "400mg"}, {"text": " "}, {"text": "8hourly"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "5days."}]}, {"id": "body-17622", "type": "paragraph", "style": "BodyText", "text": "In severe cases,", "runs": [{"text": "In"}, {"text": " "}, {"text": "severe"}, {"text": " "}, {"text": "cases,"}]}, {"id": "body-17623", "type": "paragraph", "style": "BodyText", "text": "B: amoxicillin+ clavulanic acid (FDC) (PO) 625mg 12 hourly for 5days", "runs": [{"text": "B:", "bold": true}, {"text": " ", "bold": true}, {"text": "amoxicillin+"}, {"text": " "}, {"text": "clavulanic"}, {"text": " "}, {"text": "acid"}, {"text": " "}, {"text": "(FDC)"}, {"text": " "}, {"text": "(PO)"}, {"text": " "}, {"text": "625mg"}, {"text": " "}, {"text": "12"}, {"text": " "}, {"text": "hourly"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "5days"}]}, {"id": "body-17624", "type": "paragraph", "style": "Heading3", "text": "AND", "runs": [{"text": "AND"}], "level": 3, "conjunction": true}, {"id": "body-17625", "type": "paragraph", "style": "BodyText", "text": "A: metronidazole (PO) 400mg 8hourly for 5days.", "runs": [{"text": "A:", "bold": true}, {"text": " ", "bold": true}, {"text": "metronidazole"}, {"text": " "}, {"text": "(PO)"}, {"text": " "}, {"text": "400mg"}, {"text": " "}, {"text": "8hourly"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "5days."}]}, {"id": "body-17627", "type": "paragraph", "style": "BodyText", "text": "If a patient is allergic to penicillin", "runs": [{"text": "If"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "patient"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "allergic"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "penicillin"}]}, {"id": "body-17628", "type": "paragraph", "style": "BodyText", "text": "A: erythromycin (PO) 500mg 8hourly for 5days", "runs": [{"text": "A:", "bold": true}, {"text": " ", "bold": true}, {"text": "erythromycin"}, {"text": " "}, {"text": "(PO)"}, {"text": " "}, {"text": "500mg"}, {"text": " "}, {"text": "8hourly"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "5days"}]}, {"id": "body-17630", "type": "paragraph", "style": "BodyText", "text": "Where parenteral administration of antibiotics is necessary (especially when the patient cannot swallow and has life threatening infection), consider the following", "runs": [{"text": "Where"}, {"text": " "}, {"text": "parenteral"}, {"text": " "}, {"text": "administration"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "antibiotics"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "necessary"}, {"text": " "}, {"text": "(especially"}, {"text": " "}, {"text": "when"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "patient"}, {"text": " "}, {"text": "cannot"}, {"text": " "}, {"text": "swallow"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "has"}, {"text": " "}, {"text": "life"}, {"text": " "}, {"text": "threatening infection), consider the following"}]}, {"id": "body-17631", "type": "paragraph", "style": "BodyText", "text": "B: ceftriaxone (IV) 1gm 24 hourly for 5days", "runs": [{"text": "B:", "bold": true}, {"text": " ", "bold": true}, {"text": "ceftriaxone"}, {"text": " "}, {"text": "(IV)"}, {"text": " "}, {"text": "1gm"}, {"text": " "}, {"text": "24"}, {"text": " "}, {"text": "hourly"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "5days"}]}, {"id": "body-17632", "type": "paragraph", "style": "Heading3", "text": "AND", "runs": [{"text": "AND"}], "level": 3, "conjunction": true}, {"id": "body-17633", "type": "paragraph", "style": "BodyText", "text": "B: metronidazole (IV) 500 mg 8hourly for 5days", "runs": [{"text": "B:", "bold": true}, {"text": " ", "bold": true}, {"text": "metronidazole"}, {"text": " "}, {"text": "(IV)"}, {"text": " "}, {"text": "500"}, {"text": " "}, {"text": "mg"}, {"text": " "}, {"text": "8hourly"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "5days"}]}, {"id": "body-17634", "type": "paragraph", "style": "Heading3", "text": "AND", "runs": [{"text": "AND"}], "level": 3, "conjunction": true}, {"id": "body-17635", "type": "paragraph", "style": "BodyText", "text": "A: gentamicin (IV) 80mg 8hourly for 5days", "runs": [{"text": "A:", "bold": true}, {"text": " ", "bold": true}, {"text": "gentamicin"}, {"text": " "}, {"text": "(IV)"}, {"text": " "}, {"text": "80mg"}, {"text": " "}, {"text": "8hourly"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "5days"}]}, {"id": "body-17636-textbox1-00001", "type": "paragraph", "style": "Normal", "text": "Note:", "runs": [{"text": "Note:", "bold": true}]}, {"id": "body-17636-textbox1-00002", "type": "paragraph", "style": "BodyText", "text": "Incision and drainage are mandatory in cases of deeper spaces involvement followed by a course of antibiotics. The practice of prescribing antibiotics to patients with abscess and denying referral for definitive care until pus has established or resolved has been found to lead to more problems for orofacial infections therefore early referral for definitive care is important", "runs": [{"text": "Incision"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "drainage"}, {"text": " "}, {"text": "are"}, {"text": " "}, {"text": "mandatory"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "cases"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "deeper"}, {"text": " "}, {"text": "spaces"}, {"text": " "}, {"text": "involvement"}, {"text": " "}, {"text": "followed"}, {"text": " "}, {"text": "by"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "course"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "antibiotics. The practice of prescribing antibiotics to patients with abscess and denying referral for definitive care until pus has established or resolved has been found to lead to more problems for orofacial infections therefore early referral for definitive care is important"}], "list": {"level": 0, "numberingId": "1118"}}, {"id": "body-17636-textbox1-00003", "type": "paragraph", "style": "BodyText", "text": "Depending on the level of debilitation patient may need admission to the ward for supportive therapy and dressing twice per day.", "runs": [{"text": "Depending"}, {"text": " "}, {"text": "on"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "level"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "debilitation"}, {"text": " "}, {"text": "patient"}, {"text": " "}, {"text": "may"}, {"text": " "}, {"text": "need"}, {"text": " "}, {"text": "admission"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "ward"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "supportive"}, {"text": " "}, {"text": "therapy"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "dressing twice per day."}], "list": {"level": 0, "numberingId": "1118"}}], "source": {"file": "medical.docx", "chapter": "Oral and maxillofacial conditions", "start": "body-17596", "end": "body-17636-textbox1-00003"}}