{"id": "section-body-09128", "title": "Gastritis", "chapterId": "chapter-ten", "tocLevel": 4, "tocPath": ["APPROACH TO PATIENTS WITH EMERGENCY CONDITIONS", "GASTROINTESTINAL DISEASE CONDITIONS", "Disorders of Gastrointestinal Tract", "Gastritis"], "blocks": [{"id": "body-09128", "type": "heading", "style": "Heading4", "text": "Gastritis", "runs": [{"text": "Gastritis"}], "level": 4, "list": {"level": 3, "numberingId": "1531"}}, {"id": "body-09129", "type": "paragraph", "style": "BodyText", "text": "This is an inflammatory mucosal response to injury from variety of agents and mechanisms including infections, drugs, alcohol, acute stress, radiation, allergy, acid and bile, ischemia or direct trauma. The inflammation may involve the entire stomach (pangastritis) or a region of the stomach (antral gastritis) while the severity of inflammation may be erosive or non-erosive.", "runs": [{"text": "This"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "an"}, {"text": " "}, {"text": "inflammatory"}, {"text": " "}, {"text": "mucosal"}, {"text": " "}, {"text": "response"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "injury"}, {"text": " "}, {"text": "from"}, {"text": " "}, {"text": "variety"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "agents"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "mechanisms"}, {"text": " "}, {"text": "including"}, {"text": " "}, {"text": "infections,"}, {"text": " "}, {"text": "drugs,"}, {"text": " "}, {"text": "alcohol, acute stress, radiation, allergy, acid and bile, ischemia or direct trauma. The inflammation may involve the entire stomach (pangastritis) or a region of the stomach (antral gastritis) while the severity of inflammation may be erosive or non-erosive."}]}, {"id": "body-09131", "type": "heading", "style": "Heading4", "text": "Clinical Presentation", "runs": [{"text": "Clinical"}, {"text": " "}, {"text": "Presentation"}], "level": 4}, {"id": "body-09132", "type": "paragraph", "style": "ListParagraph", "text": "Nausea, vomiting, loss of appetite, belching, and bloating", "runs": [{"text": "Nausea,"}, {"text": " "}, {"text": "vomiting,"}, {"text": " "}, {"text": "loss"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "appetite,"}, {"text": " "}, {"text": "belching,"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "bloating"}], "list": {"level": 0, "numberingId": "1482"}}, {"id": "body-09133", "type": "paragraph", "style": "ListParagraph", "text": "Acute abdominal pain or abdominal discomfort", "runs": [{"text": "Acute"}, {"text": " "}, {"text": "abdominal"}, {"text": " "}, {"text": "pain"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "abdominal"}, {"text": " "}, {"text": "discomfort"}], "list": {"level": 0, "numberingId": "1482"}}, {"id": "body-09134", "type": "paragraph", "style": "ListParagraph", "text": "Fever, chills, and hiccups also may be present", "runs": [{"text": "Fever,"}, {"text": " "}, {"text": "chills,"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "hiccups"}, {"text": " "}, {"text": "also"}, {"text": " "}, {"text": "may"}, {"text": " "}, {"text": "be"}, {"text": " "}, {"text": "present"}], "list": {"level": 0, "numberingId": "1482"}}, {"id": "body-09135", "type": "heading", "style": "Heading4", "text": "Investigations", "runs": [{"text": "Investigations"}], "level": 4}, {"id": "body-09136", "type": "paragraph", "style": "ListParagraph", "text": "Endoscopic evidence of gastric mucosal inflammation", "runs": [{"text": "Endoscopic"}, {"text": " "}, {"text": "evidence"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "gastric"}, {"text": " "}, {"text": "mucosal"}, {"text": " "}, {"text": "inflammation"}], "list": {"level": 0, "numberingId": "1482"}}, {"id": "body-09137", "type": "paragraph", "style": "ListParagraph", "text": "Histologic evidence of chronic active inflammation of biopsy specimen.", "runs": [{"text": "Histologic"}, {"text": " "}, {"text": "evidence"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "chronic"}, {"text": " "}, {"text": "active"}, {"text": " "}, {"text": "inflammation"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "biopsy"}, {"text": " "}, {"text": "specimen."}], "list": {"level": 0, "numberingId": "1482"}}, {"id": "body-09139", "type": "heading", "style": "Heading4", "text": "Non-Pharmacological Management", "runs": [{"text": "Non-Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-09140", "type": "paragraph", "style": "ListParagraph", "text": "Reduce the use of drugs known to cause gastritis (e.g., NSAIDs, alcohol)", "runs": [{"text": "Reduce"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "use"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "drugs"}, {"text": " "}, {"text": "known"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "cause"}, {"text": " "}, {"text": "gastritis"}, {"text": " "}, {"text": "(e.g.,"}, {"text": " "}, {"text": "NSAIDs,"}, {"text": " "}, {"text": "alcohol)"}], "list": {"level": 0, "numberingId": "1482"}}, {"id": "body-09141", "type": "paragraph", "style": "ListParagraph", "text": "Stop smoking", "runs": [{"text": "Stop"}, {"text": " "}, {"text": "smoking"}], "list": {"level": 0, "numberingId": "1482"}}, {"id": "body-09143", "type": "heading", "style": "Heading4", "text": "Pharmacological Management", "runs": [{"text": "Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-09144", "type": "paragraph", "style": "BodyText", "text": "Triple therapy for H. pylori eradication if confirmed present.", "runs": [{"text": "Triple"}, {"text": " "}, {"text": "therapy"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "H."}, {"text": " "}, {"text": "pylori"}, {"text": " "}, {"text": "eradication"}, {"text": " "}, {"text": "if"}, {"text": " "}, {"text": "confirmed"}, {"text": " "}, {"text": "present."}]}, {"id": "body-09145", "type": "paragraph", "style": "BodyText", "text": "Administer fluids and electrolytes as required, particularly if the patient is vomiting.", "runs": [{"text": "Administer"}, {"text": " "}, {"text": "fluids"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "electrolytes"}, {"text": " "}, {"text": "as"}, {"text": " "}, {"text": "required,"}, {"text": " "}, {"text": "particularly"}, {"text": " "}, {"text": "if"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "patient"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "vomiting."}]}, {"id": "body-09147", "type": "paragraph", "style": "BodyText", "text": "C: pantoprazole (IV) 40mg 6hourly 2-3days", "runs": [{"text": "C:", "bold": true}, {"text": " ", "bold": true}, {"text": "pantoprazole"}, {"text": " "}, {"text": "(IV)"}, {"text": " "}, {"text": "40mg"}, {"text": " "}, {"text": "6hourly"}, {"text": " "}, {"text": "2-"}, {"text": "3days"}]}, {"id": "body-09148", "type": "paragraph", "style": "Heading3", "text": "OR", "runs": [{"text": "OR"}], "level": 3, "conjunction": true}, {"id": "body-09149", "type": "paragraph", "style": "BodyText", "text": "S: esomeprazole (IV) 40mg 12hourly 2-3days", "runs": [{"text": "S:", "bold": true}, {"text": " ", "bold": true}, {"text": "esomeprazole"}, {"text": " "}, {"text": "(IV)"}, {"text": " "}, {"text": "40mg"}, {"text": " "}, {"text": "12hourly"}, {"text": " "}, {"text": "2-"}, {"text": "3days"}]}, {"id": "body-09150", "type": "paragraph", "style": "Heading3", "text": "AND", "runs": [{"text": "AND"}], "level": 3, "conjunction": true}, {"id": "body-09151", "type": "paragraph", "style": "BodyText", "text": "B: metoclopramide (IM) 10mg 12hourly when required (for cases presenting with intractable vomiting) in order to relieve symptoms.", "runs": [{"text": "B:", "bold": true}, {"text": " ", "bold": true}, {"text": "metoclopramide"}, {"text": " "}, {"text": "(IM)"}, {"text": " "}, {"text": "10mg"}, {"text": " "}, {"text": "12hourly"}, {"text": " "}, {"text": "when"}, {"text": " "}, {"text": "required"}, {"text": " "}, {"text": "(for"}, {"text": " "}, {"text": "cases"}, {"text": " "}, {"text": "presenting"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "intractable"}, {"text": " "}, {"text": "vomiting)"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "order"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "relieve "}, {"text": "symptoms."}]}, {"id": "body-09152", "type": "heading", "style": "Heading4", "text": "Switch to oral PPI once patient can tolerate oral intake. Referral", "runs": [{"text": "Switch"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "oral"}, {"text": " "}, {"text": "PPI"}, {"text": " "}, {"text": "once"}, {"text": " "}, {"text": "patient"}, {"text": " "}, {"text": "can"}, {"text": " "}, {"text": "tolerate"}, {"text": " "}, {"text": "oral"}, {"text": " "}, {"text": "intake."}, {"text": " "}, {"text": "Referral"}], "level": 4}, {"id": "body-09153", "type": "paragraph", "style": "BodyText", "text": "Refer to next level service with adequate expertise and facilities for complicated case with alarm features (anemia, vomiting blood and weight loss, see complete list under GERD above).", "runs": [{"text": "Refer to next level service with adequate expertise and facilities for complicated case with alarm features (anemia, vomiting blood and weight loss, see complete list under GERD above)."}]}], "source": {"file": "medical.docx", "chapter": "Gastrointestinal disease conditions", "start": "body-09128", "end": "body-09153"}}