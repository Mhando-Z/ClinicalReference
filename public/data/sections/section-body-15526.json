{"id": "section-body-15526", "title": "Foreign Body in the Ear", "chapterId": "chapter-fifteen", "tocLevel": 4, "tocPath": ["APPROACH TO PATIENTS WITH EMERGENCY CONDITIONS", "EAR, NOSE AND THROAT/HEAD AND NECK DISEASES", "Trauma of the Pinna", "Foreign Body in the Ear"], "blocks": [{"id": "body-15526", "type": "heading", "style": "Heading4", "text": "Foreign Body in the Ear", "runs": [{"text": "Foreign"}, {"text": " "}, {"text": "Body"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "the"}, {"text": " Ear"}], "level": 4, "list": {"level": 2, "numberingId": "1219"}}, {"id": "body-15527", "type": "paragraph", "style": "BodyText", "text": "Usually happens in children. Common foreign bodies include beads, stones and seeds (bean, maize, orange). In adult’s foreign bodies include cotton bud and insect", "runs": [{"text": "Usually"}, {"text": " "}, {"text": "happens"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "children."}, {"text": " "}, {"text": "Common"}, {"text": " "}, {"text": "foreign"}, {"text": " "}, {"text": "bodies"}, {"text": " "}, {"text": "include"}, {"text": " "}, {"text": "beads,"}, {"text": " "}, {"text": "stones"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "seeds"}, {"text": " "}, {"text": "(bean,"}, {"text": " "}, {"text": "maize,"}, {"text": " "}, {"text": "orange)."}, {"text": " "}, {"text": "In"}, {"text": " "}, {"text": "adult’s"}, {"text": " "}, {"text": "foreign bodies include cotton bud and insect"}]}, {"id": "body-15529", "type": "heading", "style": "Heading4", "text": "Non-Pharmacological Management", "runs": [{"text": "Non-Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-15530", "type": "paragraph", "style": "ListParagraph", "text": "Should be removed under direct visualization e.g., headlight, Otomicroscopy or endoscopy.", "runs": [{"text": "Should"}, {"text": " "}, {"text": "be"}, {"text": " "}, {"text": "removed"}, {"text": " "}, {"text": "under"}, {"text": " "}, {"text":