, {"text": "year."}], "list": {"level": 0, "numberingId": "360"}}, {"id": "body-26639-textbox1-00004", "type": "paragraph", "style": "BodyText", "text": "Long term medicine treatment may be necessary.", "runs": [{"text": "Long"}, {"text": " "}, {"text": "term"}, {"text": " "}, {"text": "medicine"}, {"text": " "}, {"text": "treatment"}, {"text": " "}, {"text": "may"}, {"text": " "}, {"text": "be"}, {"text": " "}, {"text": "necessary."}], "list": {"level": 0, "numberingId": "360"}}, {"id": "body-26639-textbox1-00005", "type": "paragraph", "style": "BodyText", "text": "Relapses may occur when treatment is discontinued.", "runs": [{"text": "Relapses"}, {"text": " "}, {"text": "may"}, {"text": " "}, {"text": "occur"}, {"text": " "}, {"text": "when"}, {"text": " "}, {"text": "treatment"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "discontinued."}], "list": {"level": 0, "numberingId": "360"}}, {"id": "body-26639-textbox1-00006", "type": "paragraph", "style": "BodyText", "text": "Consider short term co-administration of a benzodiazepine, due to the slow onset of action and the potential for increased anxiety during the initial phase of treatment with antidepressants.", "runs": [{"text": "Consider short term"}, {"text": " "}, {"text": "co-administration of a benzodiazepine, due to the slow onset of action and the potential for"}, {"text": " "}, {"text": "increased anxiety during the initial phase of treatment with antidepressants."}], "list": {"level": 0, "numberingId": "360"}}, {"id": "body-26641", "type": "paragraph", "style": "BodyText", "text": "Referral: Refer to the next level in the following situations; Treatment resistance or need for benzodiazepine treatment beyond 6 weeks", "runs": [{"text": "Referral:", "bold": true}, {"text": " ", "bold": true}, {"text": "Refer"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "next"}, {"text": " "}, {"text": "level"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "th