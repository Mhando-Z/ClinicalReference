{"id": "section-body-12889", "title": "Pityriasis Versicolor", "chapterId": "chapter-thirteen", "tocLevel": 4, "tocPath": ["APPROACH TO PATIENTS WITH EMERGENCY CONDITIONS", "SKIN DISEASES", "Fungal Skin Infections", "Pityriasis Versicolor"], "blocks": [{"id": "body-12889", "type": "heading", "style": "Heading4", "text": "Pityriasis Versicolor", "runs": [{"text": "Pityriasis"}, {"text": " "}, {"text": "Versicolor"}], "level": 4, "list": {"level": 2, "numberingId": "1368"}}, {"id": "body-12890", "type": "paragraph", "style": "BodyText", "text": "It is a common fungal infection caused by yeast of the genus Malassezia.", "runs": [{"text": "It"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "common"}, {"text": " "}, {"text": "fungal"}, {"text": " "}, {"text": "infection"}, {"text": " "}, {"text": "caused"}, {"text": " "}, {"text": "by"}, {"text": " "}, {"text": "yeast"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "genus"}, {"text": " "}, {"text": "Malassezia", "italic": true}, {"text": "."}]}, {"id": "body-12892", "type": "heading", "style": "Heading4", "text": "Clinical Presentation:", "runs": [{"text": "Clinical"}, {"text": " "}, {"text": "Presentation:"}], "level": 4}, {"id": "body-12893", "type": "paragraph", "style": "ListParagraph", "text": "Hypo/hyperpigmented macules and confluent patches with fine scales", "runs": [{"text": "Hypo/hyperpigmented"}, {"text": " "}, {"text": "macules"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "confluent"}, {"text": " "}, {"text": "patches"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "fine"}, {"text": " "}, {"text": "scales"}], "list": {"level": 0, "numberingId": "1356"}}, {"id": "body-12894", "type": "paragraph", "style": "ListParagraph", "text": "Commonly occurs on the chest, back, arms, and occasionally the neck and face", "runs": [{"text": "Commonly"}, {"text": " "}, {"text": "occurs"}, {"text": " "}, {"text": "on"},