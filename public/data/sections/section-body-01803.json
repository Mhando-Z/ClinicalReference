{"id": "section-body-01803", "title": "Anesthesia related Acute hypotension:", "chapterId": "chapter-two", "tocLevel": 4, "tocPath": ["APPROACH TO PATIENTS WITH EMERGENCY CONDITIONS", "ANAESTHESIA AND CRITICAL CARE", "Anaesthesia", "Anesthesia related Acute hypotension:"], "blocks": [{"id": "body-01803", "type": "heading", "style": "Heading4", "text": "Anesthesia related Acute hypotension:", "runs": [{"text": "Anesthesia"}, {"text": " "}, {"text": "related"}, {"text": " "}, {"text": "Acute"}, {"text": " "}, {"text": "hypotension:"}], "level": 4, "list": {"level": 3, "numberingId": "1850"}}, {"id": "body-01804", "type": "paragraph", "style": "BodyText", "text": "Treat the cause of hypotension, ensure appropriate fluids are given to correct hypovolemia.", "runs": [{"text": "Treat"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "cause"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "hypotension,"}, {"text": " "}, {"text": "ensure"}, {"text": " "}, {"text": "appropriate"}, {"text": " "}, {"text": "fluids"}, {"text": " "}, {"text": "are"}, {"text": " "}, {"text": "given"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "correct"}, {"text": " "}, {"text": "hypovolemia."}]}, {"id": "body-01805", "type": "paragraph", "style": "ListParagraph", "text": "The medicines given below all require significant dilution before administration.", "runs": [{"text": "The"}, {"text": " "}, {"text": "medicines"}, {"text": " "}, {"text": "given"}, {"text": " "}, {"text": "below"}, {"text": " "}, {"text": "all"}, {"text": " "}, {"text": "require"}, {"text": " "}, {"text": "significant"}, {"text": " "}, {"text": "dilution"}, {"text": " "}, {"text": "before"}, {"text": " "}, {"text": "administration."}], "list": {"level": 4, "numberingId": "1850"}}, {"id": "body-01806", "type": "paragraph", "style": "ListParagraph", "text": "Adrenergic and dopaminergic agents, e.g.:", "runs": [{"text": "Adrenergic"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "dopaminergic"}, {"text": " "}, {"text": "agents,"}, {"text": " "}, {"text": "e.g.:"}], "list": {"level": 4, "numberingId": "1850"}}, {"id": "body-01807", "type": "paragraph", "style": "ListParagraph", "text": "B: ephedrine (IV) 3–5mg as a single dose and then further boluses as required to a maximum of 30mg.", "runs": [{"text": "B:", "bold": true}, {"text": " ", "bold": true}, {"text": "ephedrine"}, {"text": " "}, {"text": "(IV)"}, {"text": " "}, {"text": "3–5mg"}, {"text": " "}, {"text": "as"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "single"}, {"text": " "}, {"text": "dose"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "then"}, {"text": " "}, {"text": "further"}, {"text": " "}, {"text": "boluses"}, {"text": " "}, {"text": "as"}, {"text": " "}, {"text": "required"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "maximum"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "30mg."}], "list": {"level": 4, "numberingId": "1850"}}, {"id": "body-01808", "type": "paragraph", "style": "ListParagraph", "text": "Increases heart rate and contractility, and vasoconstrictor.", "runs": [{"text": "Increases"}, {"text": " "}, {"text": "heart"}, {"text": " "}, {"text": "rate"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "contractility,"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "vasoconstrictor."}], "list": {"level": 4, "numberingId": "1850"}}, {"id": "body-01809", "type": "paragraph", "style": "ListParagraph", "text": "Repeated administration can result in tolerance and tachyphylaxis.", "runs": [{"text": "Repeated"}, {"text": " "}, {"text": "administration"}, {"text": " "}, {"text": "can"}, {"text": " "}, {"text": "result"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "tolerance"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "tachyphylaxis."}], "list": {"level": 4, "numberingId": "1850"}}, {"id": "body-01810", "type": "paragraph", "style": "ListParagraph", "text": "C: phenylephrine (IV) 50–100mcg, single dose and then 60–180mcg/minute.", "runs": [{"text": "C:", "bold": true}, {"text": " ", "bold": true}, {"text": "phenylephrine"}, {"text": " "}, {"text": "(IV)"}, {"text": " "}, {"text": "50–100mcg,"}, {"text": " "}, {"text": "single"}, {"text": " "}, {"text": "dose"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "then"}, {"text": " "}, {"text": "60–180mcg/minute."}], "list": {"level": 4, "numberingId": "1850"}}, {"id": "body-01811", "type": "paragraph", "style": "ListParagraph", "text": "High doses may cause significant reflexes. Bradycardia: Treat this by discontinuing the phenylephrine only.", "runs": [{"text": "High"}, {"text": " "}, {"text": "doses"}, {"text": " "}, {"text": "may"}, {"text": " "}, {"text": "cause"}, {"text": " "}, {"text": "significant"}, {"text": " "}, {"text": "reflexes."}, {"text": " "}, {"text": "Bradycardia:"}, {"text": " "}, {"text": "Treat"}, {"text": " "}, {"text": "this"}, {"text": " "}, {"text": "by"}, {"text": " "}, {"text": "discontinuing"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "phenylephrine"}, {"text": " "}, {"text": "only."}], "list": {"level": 4, "numberingId": "1850"}}, {"id": "body-01813", "type": "paragraph", "style": "BodyText", "text": "Alternatively;", "runs": [{"text": "Alternatively;"}]}, {"id": "body-01814", "type": "paragraph", "style": "BodyText", "text": "A: epinephrine (adrenaline)/epinephrine (IV) (diluted to 10mcg/ml) give boluses of 5-10mcg may be needed to mitigate unresponsiveness to treatment.", "runs": [{"text": "A:", "bold": true}, {"text": " ", "bold": true}, {"text": "epinephrine"}, {"text": " "}, {"text": "(adrenaline)/epinephrine"}, {"text": " "}, {"text": "(IV)"}, {"text": " "}, {"text": "(diluted"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "10mcg/ml)"}, {"text": " "}, {"text": "give"}, {"text": " "}, {"text": "boluses"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "5-10mcg"}, {"text": " "}, {"text": "may"}, {"tex