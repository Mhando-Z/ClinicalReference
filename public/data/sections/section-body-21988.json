{"id": "section-body-21988", "title": "AV Junctional Re-Entry Tachycardias Non-Pharmacological Management", "chapterId": "chapter-twenty", "tocLevel": 4, "tocPath": ["APPROACH TO PATIENTS WITH EMERGENCY CONDITIONS", "CARDIOVASCULAR DISEASE CONDITIONS", "Cardiac Arrhythmias/ Dysrhythmias", "AV Junctional Re-Entry Tachycardias"], "blocks": [{"id": "body-21988", "type": "heading", "style": "Heading4", "text": "AV Junctional Re-Entry Tachycardias Non-Pharmacological Management", "runs": [{"text": "AV"}, {"text": " "}, {"text": "Junctional"}, {"text": " "}, {"text": "Re-Entry"}, {"text": " "}, {"text": "Tachycardias Non-Pharmacological Management"}], "level": 4, "list": {"level": 2, "numberingId": "781"}}, {"id": "body-21989", "type": "paragraph", "style": "BodyText", "text": "Vagal maneuvers: Valsalva or carotid sinus massage. The patient should be supine and as relaxed as possible, to avoid competing sympathetic reflex", "runs": [{"text": "Vagal"}, {"text": " "}, {"text": "maneuvers:"}, {"text": " "}, {"text": "Valsalva"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "carotid"}, {"text": " "}, {"text": "sinus"}, {"text": " "}, {"text": "massage."}, {"text": " "}, {"text": "The"}, {"text": " "}, {"text": "patient"}, {"text": " "}, {"text": "should"}, {"text": " "}, {"text": "be"}, {"text": " "}, {"text": "supine"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "as"}, {"text": " "}, {"text": "relaxed"}, {"text": " "}, {"text": "as"}, {"text": " "}, {"text": "possible,"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "avoid competing sympathetic reflex"}]}, {"id": "body-21991", "type": "heading", "style": "Heading4", "text": "Pharmacological Management", "runs": [{"text": "Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-21992", "type": "paragraph", "style": "BodyText", "text": "If vagal maneuvers fail:", "runs": [{"text": "If"}, {"text": " "}, {"text": "vagal"}, {"text": " "}, {"text": "maneuvers"}, {"text": " fail:"}]}, {"id": "body-21993", "type": "paragraph", "style": "BodyText", "text": "S: adenosine (IV) 6mg over 1-3 seconds (maybe given IO) followed by rapid flush with 20mL NS, if no conversion within 1- 2minutes give 12mg, repeat a second time if necessary (30mg total).", "runs": [{"text": "S: ", "bold": true}, {"text": "adenosine (IV) 6mg over 1-3 seconds (maybe given IO) followed by rapid flush with 20mL NS, if no conversion within 1- 2minutes give 12mg, repeat a second time if necessary (30mg total)."}]}, {"id": "body-21995", "type": "paragraph", "style": "BodyText", "text": "If none of the above is effective, and patient is hypotensive, consider DC shock", "runs": [{"text": "If"}, {"text": " "}, {"text": "none"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "above"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "effective,"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "patient"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "hypotensive,"}, {"text": " "}, {"text": "consider"}, {"text": " "}, {"text": "DC"}, {"text": " "}, {"text": "shock"}]}, {"id": "body-21997", "type": "heading", "style": "Heading4", "text": "Prevention of recurrent paroxysmal atrial fibrillation", "runs": [{"text": "Prevention"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "recurrent"}, {"text": " "}, {"text": "paroxysmal"}, {"text": " "}, {"text": "atrial"}, {"text": " "}, {"text": "fibrillation"}], "level": 4}, {"id": "body-21998", "type": "paragraph", "style": "BodyText", "text": "Only in patients with severe symptoms despite the above measures:", "runs": [{"text": "Only"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "patients"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "severe"}, {"text": " "}, {"text": "symptoms"}, {"text": " "}, {"text": "despite"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "above"}, {"text": " "}, {"text": "measures:"}]}, {"id": "body-2199