{"id": "section-body-17255", "title": "Infected Socket", "chapterId": "chapter-sixteen", "tocLevel": 4, "tocPath": ["APPROACH TO PATIENTS WITH EMERGENCY CONDITIONS", "ORAL AND MAXILLOFACIAL CONDITIONS", "Post Extraction Complications", "Infected Socket"], "blocks": [{"id": "body-17255", "type": "heading", "style": "Heading4", "text": "Infected Socket", "runs": [{"text": "Infected"}, {"text": " "}, {"text": "Socket"}], "level": 4, "list": {"level": 2, "numberingId": "1146"}}, {"id": "body-17256", "type": "paragraph", "style": "BodyText", "text": "A post extraction complication due to infection of the clot due to contamination (infected socket). The condition is painful and if not managed well could lead to osteomyelitis.", "runs": [{"text": "A"}, {"text": " "}, {"text": "post"}, {"text": " "}, {"text": "extraction"}, {"text": " "}, {"text": "complication"}, {"text": " "}, {"text": "due"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "infection"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "clot"}, {"text": " "}, {"text": "due"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "contamination"}, {"text": " "}, {"text": "(infected"}, {"text": " "}, {"text": "socket)."}, {"text": " "}, {"text": "The"}, {"text": " "}, {"text": "condition"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "painful"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "if not managed well could lead to osteomyelitis."}]}, {"id": "body-17259", "type": "heading", "style": "Heading4", "text": "Clinical Presentation", "runs": [{"text": "Clinical"}, {"text": " "}, {"text": "Presentation"}], "level": 4}, {"id": "body-17260", "type": "paragraph", "style": "ListParagraph", "text": "Severe painful socket 2–4days after tooth extraction", "runs": [{"text": "Severe"}, {"text": " "}, {"text": "painful"}, {"text": " "}, {"text": "socket"}, {"text": " "}, {"text": "2–4days"}, {"text": " "}, {"text": "after"}, {"text": " "}, {"text": "tooth "}, {"text": "extraction"}], "list": {"level": 3, "numberingId": "1146"}}, {"id": "body-17261", "type": "paragraph", "style": "ListParagraph", "text": "Fever", "runs": [{"text": "Fever"}], "list": {"level": 3, "numberingId": "1146"}}, {"id": "body-17262", "type": "paragraph", "style": "ListParagraph", "text": "Necrotic blood clot in the socket", "runs": [{"text": "Necrotic"}, {"text": " "}, {"text": "blood"}, {"text": " "}, {"text": "clot"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "socket"}], "list": {"level": 3, "numberingId": "1146"}}, {"id": "body-17264", "type": "paragraph", "style": "ListParagraph", "text": "Swollen gingiva around the socket", "runs": [{"text": "Swollen"}, {"text": " "}, {"text": "gingiva"}, {"text": " "}, {"text": "around"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "socket"}], "list": {"level": 0, "numberingId": "1129"}}, {"id": "body-17265", "type": "paragraph", "style": "ListParagraph", "text": "Sometimes there may be lymphadenopathy and trismus (inability to open the mouth)", "runs": [{"text": "Sometimes"}, {"text": " "}, {"text": "there"}, {"text": " "}, {"text": "may"}, {"text": " "}, {"text": "be"}, {"text": " "}, {"text": "lymphadenopathy"}, {"text": " "}, {"text": "and trismus (inability to open the mouth)"}], "list": {"level": 0, "numberingId": "1129"}}, {"id": "body-17268", "type": "heading", "style": "Heading4", "text": "Investigations", "runs": [{"text": "Investigations"}], "level": 4}, {"id": "body-17269", "type": "paragraph", "style": "BodyText", "text": "Periapical X-ray of the socket may be necessary when there is limited improvement despite treatment.", "runs": [{"text": "Periapical"}, {"text": " "}, {"text": "X-ray"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "socket"}, {"text": " "}, {"text": "may"}, {"text": " "}, {"text": "be"}, {"text": " "}, {"text": "necessary"}, {"text": " "}, {"text": "when"}, {"text": " "}, {"text": "there"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "limited"}, {"text": " "}, {"text": "improvement"}, {"text": " "}, {"text": "despite"}, {"text": " "}, {"text": "treatment."}]}, {"id": "body-17271", "type": "heading", "style": "Heading4", "text": "Non-Pharmacological Management", "runs": [{"text": "Non-Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-17272", "type": "paragraph", "style": "BodyText", "text": "Socket debridement under local anesthesia with lidocaine 2% and irrigate with hydrogen peroxide 3% followed with copious amounts of normal saline. The procedure of irrigation is repeated the 2nd and 3rd day and where necessary can be extended to the 4th day if pain persists.", "runs": [{"text": "Socket debridement under local anesthesia with lidocaine 2% and irrigate with hydrogen peroxide 3% followed with copious amounts of"}, {"text": " "}, {"text": "normal"}, {"text": " "}, {"text": "saline."}, {"text": " "}, {"text": "The procedure of"}, {"text": " "}, {"text": "irrigation is repeated the 2nd and 3rd day and where necessary can be extended to the 4th day if pain persists."}]}, {"id": "body-17274", "type": "heading", "style": "Heading4", "text": "Pharmacological Management", "runs": [{"text": "Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-17275", "type": "paragraph", "style": "BodyText", "text": "Patient is instructed to rinse with", "runs": [{"text": "Patient"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "instructed"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "rinse"}, {"text": " with"}]}, {"id": "body-17276", "type": "paragraph", "style": "BodyText", "text": "A: hydrogen peroxide 3% mouthwash 3–4 times a day.", "runs": [{"text": "A:", "bold": true}, {"text": " ", "bold": true}, {"text": "hydrogen"}, {"text": " "}, {"text": "peroxide"}, {"text": " "}, {"text": "3%"}, {"text": " "}, {"text": "mouthwash"}, {"text": " "}, {"text": "3–4"}, {"text": " "}, {"text": "times"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "day."}]}, {"id": "body-17277", "type": "paragraph", "style": "Heading3", "text": "OR", "runs": [{"text": "OR"}], "level": 3, "conjunction": true}, {"id": "body-17278", "type": "paragraph", "style": "BodyText", "text": "A: povidone iodine 0.5% solution 3–4 times a day.", "runs": [{"text": "A:", "bold": true}, {"text": " ", "bold": true}, {"text": "povidone"}, {"text": " "}, {"text": "iodine"}, {"text": " "}, {"text": "0.5%"}, {"text": " "}, {"text": "solution"}, {"text": " "}, {"text": "3–4"}, {"text": " "}, {"text": "times"}, {"text": " "}, {"text": "a"}, {"text": " day."}]}, {"id": "body-17279", "type": "paragraph", "style": "Heading3", "text": "AND", "runs": [{"text": "AND"}], "level": 3, "conjunction": true}, {"id": "body-17280", "type": "paragraph", "style": "BodyText", "text": "A: amoxicillin (PO) 500mg 8hourly for 5–7days", "runs": [{"text": "A:", "bold": true}, {"text": " ", "bold": true}, {"text": "amoxicillin"}, {"text": " "}, {"text": "(PO)"}, {"text": " "}, {"text": "500mg"}, {"text": " "}, {"text": "8hourly"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "5–7days"}]}, {"id": "body-17281", "type": "paragraph", "style": "Heading3", "text": "OR", "runs": [{"text": "OR"}], "level": 3, "conjunction": true}, {"id": "body-17282", "type": "paragraph", "style": "BodyText", "text": "B: azithromycin (PO) 500mg 24hourly for 3days", "runs": [{"text": "B:", "bold": true}, {"text": " ", "bold": true}, {"text": "azithromycin"}, {"text": " "}, {"text": "(PO)"}, {"text": " "}, {"text": "500mg"}, {"text": " "}, {"text": "24hourly"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "3days"}]}, {"id": "body-17283", "type": "paragraph", "style": "Heading3", "text": "AND", "runs": [{"text": "AND"}], "level": 3, "conjunction": true}, {"id": "body-17284", "type": "paragraph", "style": "BodyText", "text": "A: metronidazole (PO) 400mg 8hourly for 5days", "runs": [{"text"