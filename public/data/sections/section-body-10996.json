 "style": "Heading4", "text": "Pharmacological Management", "runs": [{"text": "Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-11008", "type": "paragraph", "style": "BodyText", "text": "For mild hypertension 140–159 mmHg systolic and/or 90–109 mmHg diastolic.", "runs": [{"text": "For"}, {"text": " "}, {"text": "mild"}, {"text": " "}, {"text": "hypertension"}, {"text": " "}, {"text": "140–159"}, {"text": " "}, {"text": "mmHg"}, {"text": " "}, {"text": "systolic"}, {"text": " "}, {"text": "and/or"}, {"text": " "}, {"text": "90–109"}, {"text": " "}, {"text": "mmHg"}, {"text": " "}, {"text": "diastolic."}]}, {"id": "body-11009", "type": "paragraph", "style": "BodyText", "text": "A: methyldopa (PO) 250–500mg 8hourly", "runs": [{"text": "A:", "bold": true}, {"text": " ", "bold": true}, {"text": "methyldopa"}, {"text": " "}, {"text": "(PO)"}, {"text": " "}, {"text": "250–500mg"}, {"text": " "}, {"text": "8hourly"}]}, {"id": "body-11010", "type": "paragraph", "style": "Heading3", "text": "OR", "runs": [{"text": "OR"}], "level": 3, "conjunction": true}, {"id": "body-11011", "type": "paragraph", "style": "BodyText", "text": "A: nifedipine (PO) 20mg 12hourly", "runs": [{"text": "A:", "bold": true}, {"text": " ", "bold": true}, {"text": "nifedipine"}, {"text": " "}, {"text": "(PO)"}, {"text": " "}, {"text": "20mg"}, {"text": " "}, {"text": "12hourly"}]}, {"id": "body-11012", "type": "paragraph", "style": "Heading3", "text": "OR", "runs": [{"text": "OR"}], "level": 3, "conjunction": true}, {"id": "body-11013", "type": "paragraph", "style": "BodyText", "text": "C: labetalol (PO) 100mg 12hourly a day", "runs": [{"text": "C:", "bold": true}, {"text": " ", "bold": true}, {"text": "labetalol"}, {"text": " "}, {"text": "(PO)"}, {"text": " "}, {"text": "100mg"}, {"text": " "}, {"text": "12hourly"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "day"}]}, {"id": "body-11014", "type": "paragraph", "style": "Heading3", "text": "AND", "runs": [{"