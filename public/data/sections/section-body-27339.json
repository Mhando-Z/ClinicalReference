signs"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "symptoms"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "meet"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "diagnostic"}, {"text": " "}, {"text": "threshold"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "ODD. These symptoms include:"}]}, {"id": "body-27412", "type": "paragraph", "style": "ListParagraph", "text": "Often loses temper", "runs": [{"text": "Often"}, {"text": " "}, {"text": "loses"}, {"text": " "}, {"text": "temper"}], "list": {"level": 0, "numberingId": "328"}}, {"id": "body-27414", "type": "paragraph", "style": "ListParagraph", "text": "Is often touchy or easily annoyed", "runs": [{"text": "Is"}, {"text": " "}, {"text": "often"}, {"text": " "}, {"text": "touchy"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "easily"}, {"text": " "}, {"text": "annoyed"}], "list": {"level": 0, "numberingId": "328"}}, {"id": "body-27415", "type": "paragraph", "style": "ListParagraph", "text": "Is often angry and resentful", "runs": [{"text": "Is"}, {"text": " "}, {"text": "often"}, {"text": " "}, {"text": "angry"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "resentful"}], "list": {"level": 0, "numberingId": "328"}}, {"id": "body-27416", "type": "paragraph", "style": "ListParagraph", "text": "Often argues with authority figures or, for children and adolescents, with adults", "runs": [{"text": "Often argues with authority figures or, for children and adolescents, with adults"}], "list": {"level": 0, "numberingId": "328"}}, {"id": "body-27417", "type": "paragraph", "style": "ListParagraph", "text": "Often actively defies or refuses to comply with requests from authority figures or with rules", "runs": [{"text": "Often"}, {"text": " "}, {"text": "actively"}, {"text": " "}, {"text": "defies"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "refuses"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "comply"}, {"text": " "}, {"text": "wit