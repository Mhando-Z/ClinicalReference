ext": " "}, {"text": "(ACTG)"}, {"text": " "}, {"text": "system,"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "endemic/classical Kaposi sarcoma uses the Mitsuyasu classification system."}]}, {"id": "body-24464", "type": "heading", "style": "Heading4", "text": "Management:", "runs": [{"text": "Management:"}], "level": 4}, {"id": "body-24465", "type": "paragraph", "style": "ListParagraph", "text": "Treatment is palliative regardless of type and stage; hence, careful assessment and decision-making are required to choose the best palliative treatment.", "runs": [{"text": "Treatment is palliative regardless of type and stage; hence, careful assessment and decision-making are required to choose the best palliative treatment."}], "list": {"level": 1, "numberingId": "446"}}, {"id": "body-24466", "type": "paragraph", "style": "ListParagraph", "text": "ARVs should be initiated in epidemic KS patients who have not started the treatment.", "runs": [{"text": "ARVs"}, {"text": " "}, {"text": "should"}, {"text": " "}, {"text": "be"}, {"text": " "}, {"text": "initiated"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "epidemic"}, {"text": " "}, {"text": "KS"}, {"text": " "}, {"text": "patients"}, {"text": " "}, {"text": "who"}, {"text": " "}, {"text": "have"}, {"text": " "}, {"text": "not"}, {"text": " "}, {"text": "started"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "treatment."}], "list": {"level": 1, "numberingId": "446"}}, {"id": "body-24467", "type": "paragraph", "style": "ListParagraph", "text": "The choice of palliation depends on the patient's Clinical Presentation and general condition.", "runs": [{"text": "The"}, {"text": " "}, {"text": "choice"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "palliation"}, {"text": " "}, {"text": "depends"}, {"text": " "}, {"text": "on"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "patient's"}, {"text": " "}, {"text": "Clinical"}, {"text": " "}, {