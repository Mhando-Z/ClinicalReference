{"id": "section-body-01610", "title": "Pre-anesthetic review and premedication Pre-anesthetic review", "chapterId": "chapter-two", "tocLevel": 4, "tocPath": ["APPROACH TO PATIENTS WITH EMERGENCY CONDITIONS", "ANAESTHESIA AND CRITICAL CARE", "Anaesthesia", "Pre-anesthetic review and premedication"], "blocks": [{"id": "body-01610", "type": "heading", "style": "Heading4", "text": "Pre-anesthetic review and premedication Pre-anesthetic review", "runs": [{"text": "Pre-anesthetic"}, {"text": " "}, {"text": "review"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "premedication Pre-anesthetic review"}], "level": 4, "list": {"level": 2, "numberingId": "1850"}}, {"id": "body-01613", "type": "paragraph", "style": "ListParagraph", "text": "General anaesthesia", "runs": [{"text": "General"}, {"text": " "}, {"text": "anaesthesia"}], "list": {"level": 0, "numberingId": "1846"}}, {"id": "body-01614", "type": "paragraph", "style": "ListParagraph", "text": "A combination of regional and general anaesthesia", "runs": [{"text": "A"}, {"text": " "}, {"text": "combination"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "regional"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "general"}, {"text": " "}, {"text": "anaesthesia"}], "list": {"level": 0, "numberingId": "1846"}}, {"id": "body-01616", "type": "paragraph", "style": "ListParagraph", "text": "Patients MUST be reviewed in the pre-anesthetic outpatient clinic before any anesthetic intervention except for those admitted for emergency operations. The latter can be reviewed a few minutes before anesthesia or the night before the operation for elective inpatients.", "runs": [{"text": "Patients"}, {"text": " "}, {"text": "MUST"}, {"text": " "}, {"text": "be"}, {"text": " "}, {"text": "reviewed"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "pre-anesthetic"}, {"text": " "}, {"text": "outpatient"}, {"text": " "}, {"text": "clinic"}, {"text": " "}, {"text": "before"},