{"id": "section-body-16072", "title": "Congenital Choanal Atresia", "chapterId": "chapter-fifteen", "tocLevel": 4, "tocPath": ["APPROACH TO PATIENTS WITH EMERGENCY CONDITIONS", "EAR, NOSE AND THROAT/HEAD AND NECK DISEASES", "Other Conditions of the Nose", "Congenital Choanal Atresia"], "blocks": [{"id": "body-16072", "type": "heading", "style": "Heading4", "text": "Congenital Choanal Atresia", "runs": [{"text": "Congenital"}, {"text": " "}, {"text": "Choanal"}, {"text": " "}, {"text": "Atresia"}], "level": 4, "list": {"level": 2, "numberingId": "1219"}}, {"id": "body-16073", "type": "paragraph", "style": "BodyText", "text": "A congenital blockage (bony, membranous, or mixed) of the posterior nasal opening, causing nasal obstruction. It may be unilateral or bilateral. Neonates are obligate nasal breathers; therefore, complete bilateral choanal atresia is a medical emergency requiring immediate oral airway support until surgical creation of a patent nasal airway. Early recognition and referral are critical in bilateral cases. Always assess for associated anomalies (e.g., CHARGE syndrome).", "runs": [{"text": "A congenital blockage (bony, membranous, or mixed) of the posterior nasal opening, causing nasal obstruction. It may be unilateral or bilateral."}, {"text": " "}, {"text": "Neonates are obligate nasal breathers; therefore, complete bilateral choanal atresia is a medical emergency"}, {"text": " "}, {"text": "requiring"}, {"text": " "}, {"text": "immediate"}, {"text": " "}, {"text": "oral"}, {"text": " "}, {"text": "airway"}, {"text": " "}, {"text": "support"}, {"text": " "}, {"text": "until"}, {"text": " "}, {"text": "surgical"}, {"text": " "}, {"text": "creation"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "patent"}, {"text": " "}, {"text": "nasal"}, {"text": " "}, {"text": "airway."}, {"text": " "}, {"text": "Early"}, {"text": " "}, {"text": "recognition"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "referr