{"id": "section-body-20262", "title": "Hyperglycemia in Pregnancy", "chapterId": "chapter-nineteen", "blocks": [{"id": "body-20262", "type": "heading", "style": "Heading2", "text": "Hyperglycemia in Pregnancy", "runs": [{"text": "Hyperglycemia"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "Pregnancy"}], "level": 2, "list": {"level": 1, "numberingId": "924"}}, {"id": "body-20263", "type": "paragraph", "style": "BodyText", "text": "Gestational Diabetes Mellitus (GDM) is any degree of glucose intolerance first recognized in pregnancy. Diabetes in pregnancy refers to those with pre-existing diabetes, whether diagnosed or not.", "runs": [{"text": "Gestational"}, {"text": " "}, {"text": "Diabetes"}, {"text": " "}, {"text": "Mellitus"}, {"text": " "}, {"text": "(GDM)"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "any"}, {"text": " "}, {"text": "degree"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "glucose"}, {"text": " "}, {"text": "intolerance"}, {"text": " "}, {"text": "first"}, {"text": " "}, {"text": "recognized"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "pregnancy."}, {"text": " "}, {"text": "Diabetes"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "pregnancy refers to those with pre-existing diabetes, whether diagnosed or not."}]}, {"id": "body-20266", "type": "heading", "style": "Heading4", "text": "Screening at first antenatal visit", "runs": [{"text": "Screening"}, {"text": " "}, {"text": "at"}, {"text": " "}, {"text": "first"}, {"text": " "}, {"text": "antenatal"}, {"text": " "}, {"text": "visit"}], "level": 4}, {"id": "body-20267", "type": "paragraph", "style": "BodyText", "text": "Perform screening in all women at the first antenatal clinic attendance if they have:", "runs": [{"text": "Perform"}, {"text": " "}, {"text": "screening"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "all"}, {"text": " "}, {"text": "women"}, {"text": " "}, {"text": "at"}, {"text": " "}, {"text": "the"}, {"text": "