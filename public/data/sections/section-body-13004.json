{"id": "section-body-13004", "title": "Chicken Pox", "chapterId": "chapter-thirteen", "tocLevel": 4, "tocPath": ["APPROACH TO PATIENTS WITH EMERGENCY CONDITIONS", "SKIN DISEASES", "Viral Infections", "Chicken Pox"], "blocks": [{"id": "body-13004", "type": "heading", "style": "Heading4", "text": "Chicken Pox", "runs": [{"text": "Chicken"}, {"text": " "}, {"text": "Pox"}], "level": 4, "list": {"level": 2, "numberingId": "1368"}}, {"id": "body-13005", "type": "paragraph", "style": "BodyText", "text": "It is a highly infectious disease caused by the Varicella zoster virus (VZV). Most often benign and self-limiting, chickenpox is one of the most common childhood diseases.", "runs": [{"text": "It"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "highly"}, {"text": " "}, {"text": "infectious"}, {"text": " "}, {"text": "disease"}, {"text": " "}, {"text": "caused"}, {"text": " "}, {"text": "by"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "Varicella", "italic": true}, {"text": " ", "italic": true}, {"text": "zoster", "italic": true}, {"text": " ", "italic": true}, {"text": "virus"}, {"text": " "}, {"text": "(VZV)."}, {"text": " "}, {"text": "Most"}, {"text": " "}, {"text": "often"}, {"text": " "}, {"text": "benign"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "self-limiting,"}, {"text": " "}, {"text": "chickenpox"}, {"text": " "}, {"text": "is one of the most common childhood diseases."}]}, {"id": "body-13008", "type": "paragraph", "style": "BodyText", "text": "Clinical Presentation", "runs": [{"text": "Clinical"}, {"text": " "}, {"text": "Presentation"}]}, {"id": "body-13009", "type": "paragraph", "style": "ListParagraph", "text": "Prodrome of fever, malaise, or pharyngitis", "runs": [{"text": "Prodrome"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "fever,"}, {"text": " "}, {"text": "malaise,"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "pharyngitis"}], "list": {"level": 0, "numberingId": "1345"}}, {"id": "body-13010", "type": "paragraph", "style": "ListParagraph", "text": "Followed by lesions that begin as macules that become papules, followed by vesicles", "runs": [{"text": "Followed"}, {"text": " "}, {"text": "by"}, {"text": " "}, {"text": "lesions"}, {"text": " "}, {"text": "that"}, {"text": " "}, {"text": "begin"}, {"text": " "}, {"text": "as"}, {"text": " "}, {"text": "macules"}, {"text": " "}, {"text": "that become papules, followed by vesicles"}], "list": {"level": 0, "numberingId": "1345"}}, {"id": "body-13012", "type": "paragraph", "style": "ListParagraph", "text": "Intense pruritus", "runs": [{"text": "Intense"}, {"text": " "}, {"text": "pruritus"}], "list": {"level": 0, "numberingId": "1345"}}, {"id": "body-13013", "type": "paragraph", "style": "ListParagraph", "text": "Occasional regional lymphadenopathy", "runs": [{"text": "Occasional"}, {"text": " "}, {"text": "regional"}, {"text": " "}, {"text": "lymphadenopathy"}], "list": {"level": 0, "numberingId": "1345"}}, {"id": "body-13016", "type": "heading", "style": "Heading4", "text": "Pharmacological Management", "runs": [{"text": "Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-13017", "type": "paragraph", "style": "BodyText", "text": "B: acyclovir (PO) 800mg; paediatric 20mg/kg; 6hourly for 7 days", "runs": [{"text": "B:", "bold": true}, {"text": " ", "bold": true}, {"text": "acyclovir"}, {"text": " "}, {"text": "(PO)"}, {"text": " "}, {"text": "800mg;"}, {"text": " "}, {"text": "paediatric"}, {"text": " "}, {"text": "20mg/kg;"}, {"text": " "}, {"text": "6hourly"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "7"}, {"text": " "}, {"text": "days"}]}, {"id": "body-13018", "type": "paragraph", "style": "Heading3", "text": "AND", "runs": [{"text": "AND"}], "level": 3, "conjunction": true}, {"id": "body-13019", "type": "paragraph", "style": "BodyText", "text": "A: paracetamol (PO)1g; paediatric 10mg/kg; 8hourly for 3 days", "runs": [{"text":