{"id": "section-body-01788", "title": "Local Anesthesia Systemic Toxicity:", "chapterId": "chapter-two", "tocLevel": 4, "tocPath": ["APPROACH TO PATIENTS WITH EMERGENCY CONDITIONS", "ANAESTHESIA AND CRITICAL CARE", "Anaesthesia", "Local Anesthesia Systemic Toxicity"], "blocks": [{"id": "body-01788", "type": "heading", "style": "Heading4", "text": "Local Anesthesia Systemic Toxicity:", "runs": [{"text": "Local"}, {"text": " "}, {"text": "Anesthesia"}, {"text": " "}, {"text": "Systemic"}, {"text": " "}, {"text": "Toxicity:"}], "level": 4, "list": {"level": 3, "numberingId": "1850"}}, {"id": "body-01789", "type": "paragraph", "style": "Normal", "text": "Pharmacological Management", "runs": [{"text": "Pharmacological", "bold": true}, {"text": " ", "bold": true}, {"text": "Management", "bold": true}]}, {"id": "body-01790", "type": "paragraph", "style": "BodyText", "text": "Stop injection, follow the ABC approach, and ventilate with 100% oxygen. Seizure suppression with", "runs": [{"text": "Stop"}, {"text": " "}, {"text": "injection,"}, {"text": " "}, {"text": "follow"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "ABC"}, {"text": " "}, {"text": "approach,"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "ventilate"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "100%"}, {"text": " "}, {"text": "oxygen."}, {"text": " "}, {"text": "Seizure"}, {"text": " "}, {"text": "suppression"}, {"text": " "}, {"text": "with"}]}, {"id": "body-01791", "type": "paragraph", "style": "BodyText", "text": "D: midazolam 3-5mg", "runs": [{"text": "D:", "bold": true}, {"text": " ", "bold": true}, {"text": "midazolam"}, {"text": " "}, {"text": "3-"}, {"text": "5mg"}]}, {"id": "body-01792", "type": "paragraph", "style": "Heading3", "text": "OR", "runs": [{"text": "OR"}], "level": 3, "conjunction": true}, {"id": "body-01793", "type": "paragraph", "style": "BodyText", "text": "A: diazepam, IV, 5-10 mg.", "runs": [{"text": "A:", "bold": true}, {"text": " ", "bold": true}, {"text": "diazepam,"}, {"text": " "}, {"text": "IV,"}, {"text": " "}, {"text": "5-10"}, {"text": " "}, {"text": "mg."}]}, {"id": "body-01794", "type": "paragraph", "style": "BodyText", "text": "If seizure persists, then", "runs": [{"text": "If"}, {"text": " "}, {"text": "seizure"}, {"text": " "}, {"text": "persists,"}, {"text": " "}, {"text": "then"}]}, {"id": "body-01795", "type": "paragraph", "style": "BodyText", "text": "C: thiopental 1-2 mg/kg and or add diazepam. If worse, paralyse and intubate.", "runs": [{"text": "C:", "bold": true}, {"text": " ", "bold": true}, {"text": "thiopental"}, {"text": " "}, {"text": "1-2"}, {"text": " "}, {"text": "mg/kg"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "add"}, {"text": " "}, {"text": "diazepam."}, {"text": " "}, {"text": "If"}, {"text": " "}, {"text": "worse,"}, {"text": " "}, {"text": "paralyse"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "intubate."}]}, {"id": "body-01796", "type": "paragraph", "style": "ListParagraph", "text": "S: Lipid emulsion (20%), IV, 1.5 mL/kg over 1 minute, then continuous infusion 0.25ml/kg per minute.", "runs": [{"text": "S", "bold": true}, {"text": ":"}, {"text": " "}, {"text": "Lipid"}, {"text": " "}, {"text": "emulsion"}, {"text": " "}, {"text": "(20%),"}, {"text": " "}, {"text": "IV,"}, {"text": " "}, {"text": "1.5"}, {"text": " "}, {"text": "mL/kg"}, {"text": " "}, {"text": "over"}, {"text": " "}, {"text": "1"}, {"text": " "}, {"text": "minute,"}, {"text": " "}, {"text": "then"}, {"text": " "}, {"text": "continuous"}, {"text": " "}, {"text": "infusion"}, {"text": " "}, {"text": "0.25ml/kg"}, {"text": " "}, {"text": "per"}, {"text": " "}, {"text": "minute."}], "list": {"level": 0, "numberingId": "1844"}}, {"id": "body-01797", "type": "paragraph", "style": "ListParagraph", "text": "Repeat bolus 1–2 times for persistent cardiovascular collapse.", "runs": [{"text": "Repeat"}, {"text": " "}, {"text": "bolus"}, {"text": " "}, {"