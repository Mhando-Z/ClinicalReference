{"id": "section-body-12174", "title": "Ectoparasites", "chapterId": "chapter-twelve", "blocks": [{"id": "body-12174", "type": "heading", "style": "Heading2", "text": "Ectoparasites", "runs": [{"text": "Ectoparasites"}], "level": 2, "list": {"level": 1, "numberingId": "1397"}}, {"id": "body-12175", "type": "paragraph", "style": "BodyText", "text": "Parasites that live on the surface of the host (skin or hair) rather than inside the body. They commonly infest humans and can cause irritation, skin disease, and transmit infections. Ectoparasites are transmitted through close contact, poor hygiene, overcrowding, or contaminated clothing/bedding.", "runs": [{"text": "Parasites"}, {"text": " "}, {"text": "that"}, {"text": " "}, {"text": "live"}, {"text": " "}, {"text": "on the surface of"}, {"text": " "}, {"text": "the host"}, {"text": " "}, {"text": "(skin or hair)"}, {"text": " "}, {"text": "rather"}, {"text": " "}, {"text": "than inside the body."}, {"text": " "}, {"text": "They commonly infest"}, {"text": " "}, {"text": "humans and can cause irritation, skin disease, and transmit infections. Ectoparasites are transmitted through"}, {"text": " "}, {"text": "close contact, poor hygiene, overcrowding, or contaminated clothing/bedding."}]}, {"id": "body-12177", "type": "heading", "style": "Heading4", "text": "Clinical Presentation", "runs": [{"text": "Clinical"}, {"text": " "}, {"text": "Presentation"}], "level": 4}, {"id": "body-12178", "type": "paragraph", "style": "BodyText", "text": "Intense itching, visible lice or mites, excoriations.", "runs": [{"text": "Intense"}, {"text": " "}, {"text": "itching,"}, {"text": " "}, {"text": "visible"}, {"text": " "}, {"text": "lice"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "mites,"}, {"text": " "}, {"text": "excoriations."}]}, {"id": "body-12180", "type": "heading", "style": "Heading4", "text": "Investigations", "runs": [{"text": "Investigations"}], "level": 4}, {"id": "body-12181", "type": "paragraph", "style": "BodyText", "text": "Clinical diagnosis by inspection.", "runs": [{"text": "Clinical"}, {"text": " "}, {"text": "diagnosis"}, {"text": " "}, {"text": "by"}, {"text": " "}, {"text": "inspection."}]}, {"id": "body-12183", "type": "heading", "style": "Heading4", "text": "Pharmacological Management", "runs": [{"text": "Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-12184", "type": "paragraph", "style": "BodyText", "text": "D: permethrin 5% w/v cream/lotion apply topically 12 hourly for 7days", "runs": [{"text": "D:", "bold": true}, {"text": " ", "bold": true}, {"text": "permethrin"}, {"text": " "}, {"text": "5%"}, {"text": " "}, {"text": "w/v"}, {"text": " "}, {"text": "cream/lotion"}, {"text": " "}, {"text": "apply"}, {"text": " "}, {"text": "topically"}, {"text": " "}, {"text": "12"}, {"text": " "}, {"text": "hourly"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "7days"}]}, {"id": "body-12185", "type": "paragraph", "style": "Heading3", "text": "OR", "runs": [{"text": "OR"}], "level": 3, "conjunction": true}, {"id": "body-12186", "type": "paragraph", "style": "BodyText", "text": "D: malathion 0.5% lotion applied topically 12 hourly for 7days. Treat close contacts; wash clothing and bedding.", "runs": [{"text": "D:", "bold": true}, {"text": " ", "bold": true}, {"text": "malathion"}, {"text": " "}, {"text": "0.5%"}, {"text": " "}, {"text": "lotion"}, {"text": " "}, {"text": "applied"}, {"text": " "}, {"text": "topically"}, {"text": " "}, {"text": "12"}, {"text": " "}, {"text": "hourly"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "7days. Treat close contacts; wash clothing and bedding."}]}], "source": {"file": "medical.docx", "chapter": "Sexually transmitted infections", "start": "body-12174", "end": "body-12186"}}