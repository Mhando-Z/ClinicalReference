{"id": "section-body-12867", "title": "Tinea Unguium (Onychomycosis)", "chapterId": "chapter-thirteen", "tocLevel": 4, "tocPath": ["APPROACH TO PATIENTS WITH EMERGENCY CONDITIONS", "SKIN DISEASES", "Fungal Skin Infections", "Tinea Unguium (Onychomycosis)"], "blocks": [{"id": "body-12867", "type": "heading", "style": "Heading4", "text": "Tinea Unguium (Onychomycosis)", "runs": [{"text": "Tinea"}, {"text": " "}, {"text": "Unguium"}, {"text": " "}, {"text": "(Onychomycosis)"}], "level": 4, "list": {"level": 2, "numberingId": "1368"}}, {"id": "body-12868", "type": "paragraph", "style": "BodyText", "text": "It is a chronic fungal infection of the toenails or fingernails. It is more common in adults than in children. Patients with diabetes, advanced age, obesity, smoking, or peripheral neuropathy may be at a higher risk.", "runs": [{"text": "It"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "chronic"}, {"text": " "}, {"text": "fungal"}, {"text": " "}, {"text": "infection"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "toenails"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "fingernails."}, {"text": " "}, {"text": "It"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "more"}, {"text": " "}, {"text": "common"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "adults"}, {"text": " "}, {"text": "than"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "children."}, {"text": " "}, {"text": "Patients"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "diabetes, advanced age, obesity, smoking, or peripheral neuropathy may be at a higher risk."}]}, {"id": "body-12869", "type": "heading", "style": "Heading4", "text": "Clinical Presentation:", "runs": [{"text": "Clinical"}, {"text": " "}, {"text": "Presentation:"}], "level": 4}, {"id": "body-12870", "type": "paragraph", "style": "ListParagraph", "text": "White, yellow, or brown discoloration of the distal corner of the nail", "runs": [{"text": "White,"}, {"text": " "}, {"text": "yellow,"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "brown"}, {"text": " "}, {"text": "discoloration"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "distal"}, {"text": " "}, {"text": "corner"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "nail"}], "list": {"level": 0, "numberingId": "1355"}}, {"id": "body-12871", "type": "paragraph", "style": "ListParagraph", "text": "Subungual hyperkeratosis and onycholysis", "runs": [{"text": "Subungual"}, {"text": " "}, {"text": "hyperkeratosis"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "onycholysis"}], "list": {"level": 0, "numberingId": "1355"}}, {"id": "body-12873", "type": "heading", "style": "Heading4", "text": "Investigations:", "runs": [{"text": "Investigations:"}], "level": 4}, {"id": "body-12874", "type": "paragraph", "style": "BodyText", "text": "KOH preparation, Fungal Culture and Sensitivity.", "runs": [{"text": "KOH"}, {"text": " "}, {"text": "preparation,"}, {"text": " "}, {"text": "Fungal"}, {"text": " "}, {"text": "Culture"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "Sensitivity."}]}, {"id": "body-12876", "type": "heading", "style": "Heading4", "text": "Non-Pharmacological Management", "runs": [{"text": "Non-Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-12877", "type": "paragraph", "style": "ListParagraph", "text": "Maintain foot hygiene", "runs": [{"text": "Maintain"}, {"text": " "}, {"text": "foot"}, {"text": " "}, {"text": "hygiene"}], "list": {"level": 0, "numberingId": "1355"}}, {"id": "body-12878", "type": "paragraph", "style": "ListParagraph", "text": "Keep nails trimmed back", "runs": [{"text": "Keep"}, {"text": " "}, {"text": "nails"}, {"text": " "}, {"text": "trimmed"}, {"text": " "}, {"text": "back"}], "list": {"level": 0, "numberingId": "1355"}}, {"id": "body-12879