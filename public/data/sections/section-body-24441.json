 {"level": 1, "numberingId": "446"}}, {"id": "body-24473", "type": "paragraph", "style": "ListParagraph", "text": "A dose of 9Gy/3Fractions or 22Gy/11 Fractions can be prescribed for lesions elsewhere.", "runs": [{"text": "A"}, {"text": " "}, {"text": "dose"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "9Gy/3Fractions"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "22Gy/11"}, {"text": " "}, {"text": "Fractions"}, {"text": " "}, {"text": "can"}, {"text": " "}, {"text": "be"}, {"text": " "}, {"text": "prescribed"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "lesions"}, {"text": " "}, {"text": "elsewhere."}], "list": {"level": 1, "numberingId": "446"}}, {"id": "body-24475", "type": "heading", "style": "Heading4", "text": "Pharmacological Management", "runs": [{"text": "Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-24477", "type": "paragraph", "style": "BodyText", "text": "First-line palliative chemotherapy (generalized disease)", "runs": [{"text": "First-line"}, {"text": " "}, {"text": "palliative"}, {"text": " "}, {"text": "chemotherapy"}, {"text": " "}, {"text": "(generalized"}, {"text": " "}, {"text": "disease)"}]}, {"id": "body-24479", "type": "paragraph", "style": "BodyText", "text": "S: liposomal doxorubicin 20 mg/m² IV every 2–3 weeks for 6 cycles", "runs": [{"text": "S:", "bold": true}, {"text": " ", "bold": true}, {"text": "liposomal"}, {"text": " "}, {"text": "doxorubicin"}, {"text": " "}, {"text": "20"}, {"text": " "}, {"text": "mg/m²"}, {"text": " "}, {"text": "IV"}, {"text": " "}, {"text": "every"}, {"text": " "}, {"text": "2–3"}, {"text": " "}, {"text": "weeks"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "6"}, {"text": " "}, {"text": "cycles"}]}, {"id": "body-24480", "type": "paragraph", "style": "Heading3", "text": "OR", "runs": [{"text": "OR"}], "level": 3, "conjunction": true}, {"id": "body-24481", "type": "paragraph", "style": "BodyText", "text": "S: doxorubicin (