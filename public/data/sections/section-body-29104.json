rapy", "runs": [{"text": "Occupational"}, {"text": " "}, {"text": "therapy"}], "list": {"level": 4, "numberingId": "105"}}, {"id": "body-29137", "type": "paragraph", "style": "ListParagraph", "text": "Lifestyle: Smoking cessation, Healthy diet & weight control, Psychosocial support.", "runs": [{"text": "Lifestyle:"}, {"text": " "}, {"text": "Smoking"}, {"text": " "}, {"text": "cessation,"}, {"text": " "}, {"text": "Healthy"}, {"text": " "}, {"text": "diet"}, {"text": " "}, {"text": "&"}, {"text": " "}, {"text": "weight"}, {"text": " "}, {"text": "control,"}, {"text": " "}, {"text": "Psychosocial"}, {"text": " "}, {"text": "support."}], "list": {"level": 4, "numberingId": "105"}}, {"id": "body-29139", "type": "heading", "style": "Heading4", "text": "Pharmacological Management", "runs": [{"text": "Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-29141", "type": "paragraph", "style": "ListParagraph", "text": "Disease-modifying anti-rheumatic Drugs (DMARDs)", "runs": [{"text": "Disease-modifying"}, {"text": " "}, {"text": "anti-rheumatic"}, {"text": " "}, {"text": "Drugs"}, {"text": " "}, {"text": "(DMARDs)"}], "list": {"level": 0, "numberingId": "103"}}, {"id": "body-29142", "type": "paragraph", "style": "BodyText", "text": "DMARDs are the cornerstone of RA treatment. They should be started as soon as the diagnosis is made.", "runs": [{"text": "DMARDs"}, {"text": " "}, {"text": "are"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "cornerstone"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "RA"}, {"text": " "}, {"text": "treatment."}, {"text": " "}, {"text": "They"}, {"text": " "}, {"text": "should"}, {"text": " "}, {"text": "be"}, {"text": " "}, {"text": "started"}, {"text": " "}, {"text": "as"}, {"text": " "}, {"text": "soon"}, {"text": " "}, {"text": "as"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "diagnosis"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "made."}]}, {"id": "body-29144", "type": "paragraph", "style": "ListParagraph", "text": "Conventional Synthetic DMARDs (csDMARDs)", "runs": [{"text": "Conventional"}, {"text": " "}, {"text": "Synthetic"}, {"text": " "}, {"text": "DMARDs"}, {"text": " "}, {"text": "(csDMARDs)"}], "list": {"level": 1, "numberingId": "103"}}, {"id": "body-29145", "type": "paragraph", "style": "BodyText", "text": "All patients with active rheumatoid arthritis should be initiated on methotrexate as first-line therapy unless there are contraindications or intolerance", "runs": [{"text": "All"}, {"text": " "}, {"text": "patients"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "active"}, {"text": " "}, {"text": "rheumatoid"}, {"text": " "}, {"text": "arthritis"}, {"text": " "}, {"text": "should"}, {"text": " "}, {"text": "be"}, {"text": " "}, {"text": "initiated"}, {"text": " "}, {"text": "on"}, {"text": " "}, {"text": "methotrexate"}, {"text": " "}, {"text": "as"}, {"text": " "}, {"text": "first-line"}, {"text": " "}, {"text": "therapy"}, {"text": " "}, {"text": "unless"}, {"text": " "}, {"text": "there"}, {"text": " "}, {"text": "are contraindications or intolerance"}]}, {"id": "body-29147", "type": "paragraph", "style": "BodyText", "text": "S: methotrexate (PO) Start with 10–15 mg/week; increase by 5 mg every 2–4 weeks, depending on the response, up to a maximum of 20-25mg/week.", "runs": [{"text": "S:", "bold": true}, {"text": " ", "bold": true}, {"text": "methotrexate"}, {"text": " "}, {"text": "(PO)"}, {"text": " "}, {"text": "Start"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "10–15"}, {"text": " "}, {"text": "mg/week;"}, {"text": " "}, {"text": "increase"}, {"text": " "}, {"text": "by"}, {"text": " "}, {"text": "5"}, {"text": " "}, {"text": "mg"}, {"text": " "}, {"text": "every"}, {"text": " "}, {"text": "2–4"}, {"text": " "}, {"text": "weeks,"}, {"text": " "}, {"text": "depending"}, {"text": " "}, {"text": "on"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "response,"}, {"