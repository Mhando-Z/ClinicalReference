{"id": "section-body-16451", "title": "Laryngopharyngeal reflux disease (LPR) with/without Vocal cord nodules or Laryngeal polyp)", "chapterId": "chapter-fifteen", "tocLevel": 4, "tocPath": ["APPROACH TO PATIENTS WITH EMERGENCY CONDITIONS", "EAR, NOSE AND THROAT/HEAD AND NECK DISEASES", "Throat Conditions", "Laryngopharyngeal reflux disease (LPR) with/without Vocal cord nodules or Laryngeal polyp)"], "blocks": [{"id": "body-16451", "type": "heading", "style": "Heading4", "text": "Laryngopharyngeal reflux disease (LPR) with/without Vocal cord nodules or Laryngeal polyp)", "runs": [{"text": "Laryngopharyngeal"}, {"text": " "}, {"text": "reflux"}, {"text": " "}, {"text": "disease"}, {"text": " "}, {"text": "(LPR)"}, {"text": " "}, {"text": "with/without"}, {"text": " "}, {"text": "Vocal"}, {"text": " "}, {"text": "cord"}, {"text": " "}, {"text": "nodules"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "Laryngeal"}, {"text": " "}, {"text": "polyp)"}], "level": 4, "list": {"level": 2, "numberingId": "1219"}}, {"id": "body-16452", "type": "paragraph", "style": "ListParagraph", "text": "Occurs when gastric contents reach the larynx, affecting the glottis and vocal cords.", "runs": [{"text": "Occurs"}, {"text": " "}, {"text": "when"}, {"text": " "}, {"text": "gastric"}, {"text": " "}, {"text": "contents"}, {"text": " "}, {"text": "reach"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "larynx,"}, {"text": " "}, {"text": "affecting"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "glottis"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "vocal"}, {"text": " "}, {"text": "cords."}], "list": {"level": 0, "numberingId": "1171"}}, {"id": "body-16453", "type": "paragraph", "style": "ListParagraph", "text": "It commonly presents with hoarseness, globus sensation, chronic throat clearing, and sometimes heartburn or regurgitation.", "runs": [{"text": "It"}, {"text": " "}, {"text": "commonly"}, {"text": " "}, {"text": "presents"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "hoarseness,"}, {"text": " "}, {"text": "globus"}, {"text": " "}, {"text": "sensation,"}, {"text": " "}, {"text": "chronic"}, {"text": " "}, {"text": "throat"}, {"text": " "}, {"text": "clearing,"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "sometimes"}, {"text": " "}, {"text": "heartburn"}, {"text": " "}, {"text": "or "}, {"text": "regurgitation."}], "list": {"level": 0, "numberingId": "1171"}}, {"id": "body-16454", "type": "paragraph", "style": "ListParagraph", "text": "Unlike gastroesophageal reflux disease (GERD), which involves the lower esophageal sphincter, LPR is linked to dysfunction of the upper esophageal sphincter.", "runs": [{"text": "Unlike gastroesophageal reflux disease (GERD), which involves the lower esophageal sphincter, LPR is linked to"}, {"text": " "}, {"text": "dysfunction of the upper esophageal sphincter."}], "list": {"level": 0, "numberingId": "1171"}}, {"id": "body-16455", "type": "paragraph", "style": "ListParagraph", "text": "Proper evaluation and management require a coordinated interprofessional approach.", "runs": [{"text": "Proper"}, {"text": " "}, {"text": "evaluation"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "management"}, {"text": " "}, {"text": "require"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "coordinated"}, {"text": " "}, {"text": "interprofessional"}, {"text": " "}, {"text": "approach."}], "list": {"level": 0, "numberingId": "1171"}}, {"id": "body-16456", "type": "heading", "style": "Heading4", "text": "Investigations", "runs": [{"text": "Investigations"}], "level": 4}, {"id": "body-16457", "type": "paragraph", "style": "BodyText", "text": "Fiberoptic Nasolaryngoscopy", "runs": [{"text": "Fiberoptic"}, {"text": " "}, {"text": "Nasolaryngoscopy"}]}, {"id": "body-16458", "type": "heading", "style": "Heading4", "text": "Non-Pharmacological Management", "runs": [{"text": "Non-Pharmacological"}, {"text": " "}, {"text": "Management"}], "level"