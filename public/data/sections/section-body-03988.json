type": "paragraph", "style": "BodyText", "text": "The mainstay treatment for Zika Virus is the supportive symptomatic treatment.", "runs": [{"text": "The"}, {"text": " "}, {"text": "mainstay"}, {"text": " "}, {"text": "treatment"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "Zika"}, {"text": " "}, {"text": "Virus"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "supportive"}, {"text": " "}, {"text": "symptomatic"}, {"text": " "}, {"text": "treatment."}]}, {"id": "body-04013", "type": "paragraph", "style": "BodyText", "text": "A: Assure plenty of rest to patients", "runs": [{"text": "A:", "bold": true}, {"text": " ", "bold": true}, {"text": "Assure"}, {"text": " "}, {"text": "plenty"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "rest"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "patients"}]}, {"id": "body-04015", "type": "heading", "style": "Heading4", "text": "Pharmacological Management", "runs": [{"text": "Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-04016", "type": "paragraph", "style": "BodyText", "text": "A: sodium lactate compound (ringer’s lactate)(Ringers Lactate) intravenously.", "runs": [{"text": "A:", "bold": true}, {"text": " ", "bold": true}, {"text": "sodium"}, {"text": " "}, {"text": "lactate"}, {"text": " "}, {"text": "compound"}, {"text": " "}, {"text": "(ringer’s"}, {"text": " "}, {"text": "lactate)(Ringers"}, {"text": " "}, {"text": "Lactate)"}, {"text": " "}, {"text": "intravenously."}]}, {"id": "body-04017", "type": "paragraph", "style": "Heading3", "text": "AND", "runs": [{"text": "AND"}], "level": 3, "conjunction": true}, {"id": "body-04018", "type": "paragraph", "style": "BodyText", "text": "A: paracetamol 15mg/kg (PO/IV) 8hourly for 3-5days", "runs": [{"text": "A:", "bold": true}, {"text": " ", "bold": true}, {"text": "paracetamol"}, {"text": " "}, {"text": "15mg/kg"}, {"text": " "}, {"text": "(PO/IV)"}, {"text": " "}, {"text": "8hourly"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "3-"}, {"text": "5days"}]}, {"id": "body-04019-textbox1-00001", "type": "paragraph", "style": "Normal", "text": "Note:", "runs": [{"text": "Note:", "bold": true}]}, {"id": "body-04019-textbox1-00002", "type": "paragraph", "style": "BodyText", "text": "No antibiotics are of proven value.", "runs": [{"text": "No"}, {"text": " "}, {"text": "antibiotics"}, {"text": " "}, {"text": "are"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "proven"}, {"text": " "}, {"text": "value."}], "list": {"level": 0, "numberingId": "1774"}}, {"id": "body-04019-textbox1-00003", "type": "paragraph", "style": "BodyText", "text": "Steroids should not be used.", "runs": [{"text": "Steroids"}, {"text": " "}, {"text": "should"}, {"text": " "}, {"text": "not"}, {"text": " "}, {"text": "be"}, {"text": " "}, {"text": "used."}], "list": {"level": 0, "numberingId": "1774"}}, {"id": "body-04019-textbox1-00004", "type": "paragraph", "style": "BodyText", "text": "Non-Steroidal Anti-Inflammatory Drugs (NSAIDs) such as ibuprofen and aspirin should be avoided. These anti- inflammatory drugs act by thinning the blood, and in a disease with risk of hemorrhage, blood thinners may exacerbate the prognosis", "runs": [{"text": "Non-Steroidal Anti-Inflammatory Drugs (NSAIDs) such as ibuprofen and aspirin should be avoided. These anti- inflammatory drugs act by thinning the blood, and in a disease with"}, {"text": " "}, {"text": "risk of hemorrhage, blood thinners may exacerbate the prognosis"}], "list": {"level": 0, "numberingId": "1774"}}, {"id": "body-04019-textbox1-00005", "type": "paragraph", "style": "BodyText", "text": "Do not use products containing oil of lemon eucalyptus (OLE) or para-menthane-diol (PMD) on children under 3 years old.", "runs": [{"text": "Do"}, {"text": " "}, {"text": "not"}, {"text": " "}, {"text": "use"}, {"text": " "}, {"text": "products"}, {"text": " "}, {"text": "containing"}, {"text": " "}, {"text": "oil"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "lemon"}, {"text": " "}, {"text": "eucalyptus"}, {"text": " "}, {"text": "(OLE)"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "para-menthane-diol"}, {"text": " "}, {"text": "(PMD)"}, {"text": " "}, {"text": "on"}, {"text": " "}, {"text": "children"}, {"text": " "}, {"text": "under"}, {"text": " "}, {"text": "3 years old."}], "list": {"level": 0, "numberingId": "1774"}}, {"id": "body-04019-textbox1-00006", "type": "paragraph", "style": "BodyText", "text": "Do not apply insect repellent to a child’s hands, eyes, mouth, cuts, or irritated skin", "runs": [{"text": "Do"}, {"text": " "}, {"text": "not"}, {"text": " "}, {"text": "apply"}, {"text": " "}, {"text": "insect"}, {"text": " "}, {"text": "repellent"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "child’s"}, {"text": " "}, {"text": "hands,"}, {"text": " "}, {"text": "eyes,"}, {"text": " "}, {"text": "mouth,"}, {"text": " "}, {"text": "cuts,"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "irritated"}, {"text": " "}, {"text": "skin"}], "list": {"level": 0, "numberingId": "1774"}}, {"id": "body-04021", "type": "heading", "style": "Heading4", "text": "Prevention", "runs": [{"text": "Prevention"}], "level": 4}, {"id": "body-04022", "type": "paragraph", "style": "ListParagraph", "text": "Vector control: - removal and modification of breeding sites and reducing contact between mosquitoes and people", "runs": [{"text": "Vector"}, {"text": " "}, {"text": "control:"}, {"text": " "}, {"text": "-"}, {"text": " "}, {"text": "removal"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "modification"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "breeding"}, {"text": " "}, {"text": "sites"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "reducing"}, {"text": " "}, {"text": "contact"}, {"text": " "}, {"text": "between"}, {"text": " "}, {"text": "mosquitoes"}, {"text": " "}, {"text"