129", "type": "paragraph", "style": "BodyText", "text": "A: ibuprofen (PO) 400mg 8hourly for 24 hours", "runs": [{"text": "A:", "bold": true}, {"text": " ", "bold": true}, {"text": "ibuprofen"}, {"text": " "}, {"text": "(PO)"}, {"text": " "}, {"text": "400mg"}, {"text": " "}, {"text": "8hourly"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "24"}, {"text": " "}, {"text": "hours"}]}, {"id": "body-01130", "type": "paragraph", "style": "Heading3", "text": "OR", "runs": [{"text": "OR"}], "level": 3, "conjunction": true}, {"id": "body-01131", "type": "paragraph", "style": "BodyText", "text": "A: diclofenac (IM/IV) 50-100mg stat Mild to moderate pain:", "runs": [{"text": "A:", "bold": true}, {"text": " ", "bold": true}, {"text": "diclofenac"}, {"text": " "}, {"text": "(IM/IV)"}, {"text": " "}, {"text": "50-100mg"}, {"text": " "}, {"text": "stat Mild to moderate pain:"}]}, {"id": "body-01132", "type": "paragraph", "style": "BodyText", "text": "A: paracetamol (PO/IV) 1g 6hourly for 24 hours", "runs": [{"text": "A:", "bold": true}, {"text": " ", "bold": true}, {"text": "paracetamol"}, {"text": " "}, {"text": "(PO/IV)"}, {"text": " "}, {"text": "1g"}, {"text": " "}, {"text": "6hourly"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "24"}, {"text": " "}, {"text": "hours"}]}, {"id": "body-01133", "type": "paragraph", "style": "Heading3", "text": "OR", "runs": [{"text": "OR"}], "level": 3, "conjunction": true}, {"id": "body-01134", "type": "paragraph", "style": "BodyText", "text": "A: ibuprofen (PO) 400mg 8hourly for 24 hours", "runs": [{"text": "A:", "bold": true}, {"text": " ", "bold": true}, {"text": "ibuprofen"}, {"text": " "}, {"text": "(PO)"}, {"text": " "}, {"text": "400mg"}, {"text": " "}, {"text": "8hourly"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "24"}, {"text": " "}, {"text": "hours"}]}, {"id": "body-01135", "type": "paragraph", "style": "Heading3", "text": "OR", "runs": [{"text": "OR"}], "level": 3, "conjunction": true}, {"id": "