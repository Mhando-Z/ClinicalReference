{"id": "section-body-14561", "title": "Chemical Injuries/Burn", "chapterId": "chapter-fourteen", "tocLevel": 4, "tocPath": ["APPROACH TO PATIENTS WITH EMERGENCY CONDITIONS", "EYE DISEASES AND REFRACTIVE ERRORS", "Painful Red Eyes", "Chemical Injuries/Burn"], "blocks": [{"id": "body-14561", "type": "heading", "style": "Heading4", "text": "Chemical Injuries/Burn", "runs": [{"text": "Chemical"}, {"text": " "}, {"text": "Injuries/Burn"}], "level": 4, "list": {"level": 3, "numberingId": "1271"}}, {"id": "body-14562", "type": "paragraph", "style": "BodyText", "text": "This is an Ophthalmological emergency. It occurs when chemicals such as acid or alkali (e.g., household detergents, bleaching agents), snake spit, insect bite, traditional eye medicine, cement or lime cause a damage to the eye.", "runs": [{"text": "This"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "an"}, {"text": " "}, {"text": "Ophthalmological"}, {"text": " "}, {"text": "emergency."}, {"text": " "}, {"text": "It"}, {"text": " "}, {"text": "occurs"}, {"text": " "}, {"text": "when"}, {"text": " "}, {"text": "chemicals"}, {"text": " "}, {"text": "such"}, {"text": " "}, {"text": "as"}, {"text": " "}, {"text": "acid"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "alkali"}, {"text": " "}, {"text": "(e.g.,"}, {"text": " "}, {"text": "household"}, {"text": " "}, {"text": "detergents,"}, {"text": " "}, {"text": "bleaching agents), snake spit, insect bite, traditional eye medicine, cement or lime cause a damage to the eye."}]}, {"id": "body-14565", "type": "heading", "style": "Heading4", "text": "Clinical Presentation", "runs": [{"text": "Clinical"}, {"text": " "}, {"text": "Presentation"}], "level": 4}, {"id": "body-14566", "type": "paragraph", "style": "ListParagraph", "text": "Diagnosis relies mostly with patients’ history", "runs": [{"text": "Diagnosis"}, {"text": " "}, {"text": "relies"}, {"text": " "}, {"text": "mostly"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "patient