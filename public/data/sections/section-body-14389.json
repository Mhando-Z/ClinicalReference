{"id": "section-body-14389", "title": "Low Vision and Blindness", "chapterId": "chapter-fourteen", "tocLevel": 4, "tocPath": ["APPROACH TO PATIENTS WITH EMERGENCY CONDITIONS", "EYE DISEASES AND REFRACTIVE ERRORS", "Major Blinding Eye Diseases", "Low Vision and Blindness"], "blocks": [{"id": "body-14389", "type": "heading", "style": "Heading4", "text": "Low Vision and Blindness", "runs": [{"text": "Low"}, {"text": " "}, {"text": "Vision"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "Blindness"}], "level": 4, "list": {"level": 2, "numberingId": "1312"}}, {"id": "body-14390", "type": "paragraph", "style": "BodyText", "text": "Low vision is a permanent visual impairment that cannot be corrected by medication, surgery, or standard spectacles and interferes with daily activities. It is defined as visual acuity less than 6/18 but equal to or better than 3/60, or a visual field less than 20 degrees in the better eye with the best possible correction.", "runs": [{"text": "Low vision is a permanent visual impairment that cannot be corrected by medication, surgery, or standard spectacles and interferes with daily activities. It is defined as visual acuity less than 6/18 but equal to or better than 3/60, or a visual field less than 20 degrees in the better eye with the best possible correction."}]}, {"id": "body-14392", "type": "paragraph", "style": "BodyText", "text": "Blindness defined as a presenting visual acuity of less than 3/60 in the better eye, or a visual field of less than 10 degrees from the central fixation, even with the best possible spectacle correction.", "runs": [{"text": "Blindness ", "bold": true}, {"text": "defined as a presenting visual acuity of less than 3/60 in the better eye, or a visual field of less than 10 degrees from the central fixation, even with the best possible spectacle correction."}]}, {"id": "body-14395", "type": "heading", "style": "Heading4", "text": "Clinical Presentation", "runs": [{"text": "Clinical"}, {"text": " "}, {"text": "Presentation"}], "level": 4}, {"id": "body-14396", "type": "paragraph", "style": "BodyText", "text": "Inability to", "runs": [{"text": "Inability"}, {"text": " "}, {"text": "to"}]}, {"id": "body-14397", "type": "paragraph", "style": "ListParagraph", "text": "Recognize people in the streets,", "runs": [{"text": "Recognize"}, {"text": " "}, {"text": "people"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "streets,"}], "list": {"level": 0, "numberingId": "1273"}}, {"id": "body-14398", "type": "paragraph", "style": "ListParagraph", "text": "Read black boards,", "runs": [{"text": "Read"}, {"text": " "}, {"text": "black"}, {"text": " "}, {"text": "boards,"}], "list": {"level": 0, "numberingId": "1273"}}, {"id": "body-14400", "type": "paragraph", "style": "ListParagraph", "text": "Write at the same speed as peers", "runs": [{"text": "Write"}, {"text": " "}, {"text": "at"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "same"}, {"text": " "}, {"text": "speed"}, {"text": " "}, {"text": "as"}, {"text": " "}, {"text": "peers"}], "list": {"level": 0, "numberingId": "1273"}}, {"id": "body-14401", "type": "paragraph", "style": "ListParagraph", "text": "Play with friends.", "runs": [{"text": "Play"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "friends."}], "list": {"level": 0, "numberingId": "1273"}}, {"id": "body-14405", "type": "heading", "style": "Heading4", "text": "Investigations", "runs": [{"text": "Investigations"}], "level": 4}, {"id": "body-14406", "type": "paragraph", "style": "ListParagraph", "text": "Visual acuity", "runs": [{"text": "Visual"}, {"text": " "}, {"text": "acuity"}], "list": {"level": 1, "numberingId": "1273"}}, {"id": "body-14407", "type": "paragraph", "style": "ListParagraph", "text": "Refraction", "runs": [{"text": "Refraction"}], "list": {"level": 1, "numberingId": "1273"}}, {"id": "body-14408", "type": "paragraph", "style": "ListParagraph", "text": "Tonometry", "runs": [{"text": "