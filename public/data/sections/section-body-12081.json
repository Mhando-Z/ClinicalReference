{"id": "section-body-12081", "title": "Gonorrhea", "chapterId": "chapter-twelve", "blocks": [{"id": "body-12081", "type": "heading", "style": "Heading2", "text": "Gonorrhea", "runs": [{"text": "Gonorrhea"}], "level": 2, "list": {"level": 1, "numberingId": "1397"}}, {"id": "body-12082", "type": "paragraph", "style": "BodyText", "text": "A sexually transmitted infection caused by the bacterium Neisseria gonorrhoeae, affecting the urogenital tract, rectum, pharynx, and eyes.", "runs": [{"text": "A"}, {"text": " "}, {"text": "sexually"}, {"text": " "}, {"text": "transmitted"}, {"text": " "}, {"text": "infection"}, {"text": " "}, {"text": "caused"}, {"text": " "}, {"text": "by"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "bacterium"}, {"text": " "}, {"text": "Neisseria", "italic": true}, {"text": " ", "italic": true}, {"text": "gonorrhoeae", "italic": true}, {"text": ","}, {"text": " "}, {"text": "affecting"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "urogenital"}, {"text": " "}, {"text": "tract,"}, {"text": " "}, {"text": "rectum,"}, {"text": " "}, {"text": "pharynx, and eyes."}]}, {"id": "body-12085", "type": "heading", "style": "Heading4", "text": "Clinical Presentation", "runs": [{"text": "Clinical"}, {"text": " "}, {"text": "Presentation"}], "level": 4}, {"id": "body-12086", "type": "paragraph", "style": "ListParagraph", "text": "Men: Urethral discharge, burning or painful urination, itchy urethra, increased frequency/urgency.", "runs": [{"text": "Men:"}, {"text": " "}, {"text": "Urethral discharge, burning or painful urination, itchy urethra, increased "}, {"text": "frequency/urgency."}], "list": {"level": 0, "numberingId": "1371"}}, {"id": "body-12087", "type": "paragraph", "style": "ListParagraph", "text": "Women: Vaginal\tdischarge,\tdysuria, intermenstrual bleeding, lower abdominal pain, dyspareunia.", "runs": [{"text": "Women: Vaginal"}, {"text": "\t"}, {"text": "discharge,"}, {"text": "\t"}, {"text": "dysuria, "}, {"text": "interm