linical Presentation", "runs": [{"text": "Clinical"}, {"text": " "}, {"text": "Presentation"}], "level": 4}, {"id": "body-04895", "type": "paragraph", "style": "ListParagraph", "text": "Fever", "runs": [{"text": "Fever"}], "list": {"level": 0, "numberingId": "1742"}}, {"id": "body-04896", "type": "paragraph", "style": "ListParagraph", "text": "Lethargy", "runs": [{"text": "Lethargy"}], "list": {"level": 0, "numberingId": "1742"}}, {"id": "body-04897", "type": "paragraph", "style": "ListParagraph", "text": "Unable to breastfeed", "runs": [{"text": "Unable"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "breastfeed"}], "list": {"level": 0, "numberingId": "1742"}}, {"id": "body-04898", "type": "paragraph", "style": "ListParagraph", "text": "Vomiting", "runs": [{"text": "Vomiting"}], "list": {"level": 0, "numberingId": "1742"}}, {"id": "body-04899", "type": "paragraph", "style": "ListParagraph", "text": "Irritability", "runs": [{"text": "Irritability"}], "list": {"level": 0, "numberingId": "1742"}}, {"id": "body-04900", "type": "paragraph", "style": "ListParagraph", "text": "Respiratory distress", "runs": [{"text": "Respiratory"}, {"text": " "}, {"text": "distress"}], "list": {"level": 0, "numberingId": "1742"}}, {"id": "body-04902", "type": "paragraph", "style": "ListParagraph", "text": "Seizures", "runs": [{"text": "Seizures"}], "list": {"level": 0, "numberingId": "1742"}}, {"id": "body-04903", "type": "paragraph", "style": "ListParagraph", "text": "Jaundice", "runs": [{"text": "Jaundice"}], "list": {"level": 0, "numberingId": "1742"}}, {"id": "body-04904", "type": "paragraph", "style": "ListParagraph", "text": "Pallor", "runs": [{"text": "Pallor"}], "list": {"level": 0, "numberingId": "1742"}}, {"id": "body-04905", "type": "paragraph", "style": "ListParagraph", "text": "Hepatosplenomegaly", "runs": [{"text": "Hepatosplenomegaly"}], "list": {"level": 0, "numberingId": "1742"}}, {"id": "body-04907", "type": "paragraph", "style": "ListParagraph", "text": "Laboratory findings will include the presence of malaria parasites.", "runs": [{"text": "Laboratory"}, {"text": " "}, {"text": "findings"}, {"text": " "}, {"text": "will"}, {"text": " "}, {"text": "include"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "presence"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "malaria"}, {"text": " "}, {"text": "parasites."}], "list": {"level": 1, "numberingId": "1742"}}, {"id": "body-04909", "type": "heading", "style": "Heading4", "text": "Investigations", "runs": [{"text": "Investigations"}], "level": 4}, {"id": "body-04910", "type": "paragraph", "style": "ListParagraph", "text": "Full blood picture", "runs": [{"text": "Full"}, {"text": " "}, {"text": "blood"}, {"text": " "}, {"text": "picture"}], "list": {"level": 1, "numberingId": "1742"}}, {"id": "body-04911", "type": "paragraph", "style": "ListParagraph", "text": "blood sugar", "runs": [{"text": "blood"}, {"text": " "}, {"text": "sugar"}], "list": {"level": 1, "numberingId": "1742"}}, {"id": "body-04912", "type": "paragraph", "style": "ListParagraph", "text": "blood culture and sensitivity, blood smear for malaria parasite, serum electrolytes", "runs": [{"text": "blood"}, {"text": " "}, {"text": "culture"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "sensitivity,"}, {"text": " "}, {"text": "blood"}, {"text": " "}, {"text": "smear"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "malaria"}, {"text": " "}, {"text": "parasite,"}, {"text": " "}, {"text": "serum"}, {"text": " "}, {"text": "electrolytes"}], "list": {"level": 1, "numberingId": "1742"}}, {"id": "body-04913", "type": "paragraph", "style": "ListParagraph", "text": "CSF for analysis", "runs": [{"text": "CSF"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "analysis"}], "list": {"level": 1, "numberingId": "1742"}}, {"id": "body-04915", "type": "heading", "style": "Heading4", "text": "Management of neonatal malaria", "runs": [{"text": "Management"}, {"text": " "}, {"text":