{"id": "section-body-06578", "title": "Cranial Nerve Disorder", "chapterId": "chapter-eight", "blocks": [{"id": "body-06578", "type": "heading", "style": "Heading2", "text": "Cranial Nerve Disorder", "runs": [{"text": "Cranial"}, {"text": " "}, {"text": "Nerve"}, {"text": " "}, {"text": "Disorder"}], "level": 2, "list": {"level": 1, "numberingId": "1659"}}, {"id": "body-06580", "type": "heading", "style": "Heading4", "text": "Trigeminal Neuralgia", "runs": [{"text": "Trigeminal Neuralgia"}], "level": 4, "list": {"level": 2, "numberingId": "1659"}}, {"id": "body-06581", "type": "paragraph", "style": "BodyText", "text": "Trigeminal neuralgia (TN) is a syndrome characterized by chronic paroxysmal brief episodes of unilateral electric shock-like pains, in one or more divisions of the trigeminal nerve. TN is often mistaken as a dental problem leading to delayed correct diagnosis and appropriate treatment. The diagnosis is based on the characteristic clinical picture.", "runs": [{"text": "Trigeminal neuralgia (TN) is a syndrome characterized by chronic paroxysmal brief episodes of unilateral electric shock-like pains, in one or more divisions of the trigeminal nerve. TN is often mistaken as a dental problem leading to delayed correct diagnosis and appropriate treatment. The diagnosis is based on the characteristic clinical picture."}]}, {"id": "body-06583", "type": "heading", "style": "Heading4", "text": "Clinical Presentation", "runs": [{"text": "Clinical"}, {"text": " "}, {"text": "Presentation"}], "level": 4}, {"id": "body-06584", "type": "paragraph", "style": "BodyText", "text": "Unilateral recurrent sudden intense and sharp shock like brief pains in one or more division of trigeminal nerve, jaw, teeth, gums, cheek pain exacerbated by cutaneous stimuli, e.g., chewing, brushing or touching the face", "runs": [{"text": "Unilateral"}, {"text": " "}, {"text": "recurrent"}, {"text": " "}, {"text": "sudden"}, {"text": " "}, {"text": "intense"}, {"text": " "}, {"text": "and"