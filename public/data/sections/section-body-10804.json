{"id": "section-body-10804", "title": "Primary Postpartum Haemorrhage", "chapterId": "chapter-eleven", "tocLevel": 4, "tocPath": ["APPROACH TO PATIENTS WITH EMERGENCY CONDITIONS", "OBSTETRICS, GYNECOLOGY AND CONTRACEPTION", "Postpartum Hemorrhage (PPH)", "Primary Postpartum Haemorrhage"], "blocks": [{"id": "body-10804", "type": "heading", "style": "Heading4", "text": "Primary Postpartum Haemorrhage", "runs": [{"text": "Primary"}, {"text": " "}, {"text": "Postpartum"}, {"text": " "}, {"text": "Haemorrhage"}], "level": 4, "list": {"level": 2, "numberingId": "1452"}}, {"id": "body-10805", "type": "paragraph", "style": "BodyText", "text": "It is typically loss of more than 500 ml of blood from the genital tract after vaginal delivery or more than 1000 ml after Caesarean section in the first 24 hours. OR it is any amount of blood loss after delivery that would result in hemodynamic instability.", "runs": [{"text": "It"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "typically"}, {"text": " "}, {"text": "loss"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "more"}, {"text": " "}, {"text": "than"}, {"text": " "}, {"text": "500"}, {"text": " "}, {"text": "ml"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "blood"}, {"text": " "}, {"text": "from"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "genital"}, {"text": " "}, {"text": "tract"}, {"text": " "}, {"text": "after"}, {"text": " "}, {"text": "vaginal"}, {"text": " "}, {"text": "delivery"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "more"}, {"text": " "}, {"text": "than"}, {"text": " "}, {"text": "1000"}, {"text": " "}, {"text": "ml"}, {"text": " "}, {"text": "after"}, {"text": " "}, {"text": "Caesarean section in the first 24 hours. OR it is any amount of blood loss after delivery that would result in hemodynamic instability."}]}, {"id": "body-10808", "type": "heading", "style": "Heading4", "text": "Management of PPH at Dispensary and Health center", "runs": [{"text": 