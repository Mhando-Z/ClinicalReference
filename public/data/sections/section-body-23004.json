{"id": "section-body-23004", "title": "Premedication for (S) Rabbit Antithymocyte Globulin (rATG)", "chapterId": "chapter-twenty-one", "tocLevel": 4, "tocPath": ["APPROACH TO PATIENTS WITH EMERGENCY CONDITIONS", "KIDNEY AND UROLOGICAL DISORDERS", "Kidney Transplantation", "Premedication for (S) Rabbit Antithymocyte Globulin (rATG)"], "blocks": [{"id": "body-23004", "type": "heading", "style": "Heading4", "text": "Premedication for (S) Rabbit Antithymocyte Globulin (rATG)", "runs": [{"text": "Premedication"}, {"text": " "}, {"text": "for"}, {"text": " "}, {"text": "(S)"}, {"text": " "}, {"text": "Rabbit"}, {"text": " "}, {"text": "Antithymocyte"}, {"text": " "}, {"text": "Globulin"}, {"text": " "}, {"text": "(rATG)"}], "level": 4, "list": {"level": 3, "numberingId": "666"}}, {"id": "body-23005", "type": "paragraph", "style": "BodyText", "text": "Premedication should be administered 30 minutes to 1 hour before each dose of (S) rATG to reduce infusion-related reactions. Administer:", "runs": [{"text": "Premedication"}, {"text": " "}, {"text": "should"}, {"text": " "}, {"text": "be"}, {"text": " "}, {"text": "administered"}, {"text": " "}, {"text": "30"}, {"text": " "}, {"text": "minutes"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "1"}, {"text": " "}, {"text": "hour"}, {"text": " "}, {"text": "before"}, {"text": " "}, {"text": "each"}, {"text": " "}, {"text": "dose"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "(S)"}, {"text": " "}, {"text": "rATG"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "reduce"}, {"text": " "}, {"text": "infusion-related"}, {"text": " "}, {"text": "reactions. "}, {"text": "Administer:"}]}, {"id": "body-23006", "type": "paragraph", "style": "BodyText", "text": "D: paracetamol 1 g IV stat", "runs": [{"text": "D:", "bold": true}, {"text": " ", "bold": true}, {"text": "paracetamol"}, {"text": " "}, {"text": "1"}, {"text": " "}, {"text": "g"}, {"text": " "}, {"text": "IV"}, {"text": " stat"}]}, {"id": "body-23007"