 {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "when"}, {"text": " "}, {"text": "available"}, {"text": " "}, {"text": "should"}, {"text": " "}, {"text": "be"}, {"text": " "}, {"text": "offered "}, {"text": "asap."}], "list": {"level": 0, "numberingId": "1228"}}, {"id": "body-15306-textbox1-00003", "type": "paragraph", "style": "BodyText", "text": "Adjust antibiotics accordingly to culture and sensitivity", "runs": [{"text": "Adjust"}, {"text": " "}, {"text": "antibiotics"}, {"text": " "}, {"text": "accordingly"}, {"text": " "}, {"text": "to"}, {"text": " "}, {"text": "culture"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "sensitivity"}], "list": {"level": 0, "numberingId": "1228"}}, {"id": "body-15306-textbox1-00004", "type": "paragraph", "style": "BodyText", "text": "4th generation fluoroquinolones have better ocular penetration.", "runs": [{"text": "4th"}, {"text": " "}, {"text": "generation"}, {"text": " "}, {"text": "fluoroquinolones"}, {"text": " "}, {"text": "have"}, {"text": " "}, {"text": "better"}, {"text": " "}, {"text": "ocular"}, {"text": " "}, {"text": "penetration."}], "list": {"level": 0, "numberingId": "1228"}}, {"id": "body-15306-textbox1-00005", "type": "paragraph", "style": "BodyText", "text": "Systemic ceftazidime, cefazolin, ciprofloxacin, gatifloxacin and moxifloxacin have been shown to penetrate the blood ocular barrier efficiently and can be used as adjunctive oral antibiotics.", "runs": [{"text": "Systemic ceftazidime, cefazolin, ciprofloxacin, gatifloxacin and moxifloxacin have been shown to penetrate the blood ocular barrier efficiently and can be used as adjunctive oral antibiotics."}], "list": {"level": 0, "numberingId": "1228"}}], "source": {"file": "medical.docx", "chapter": "Eye diseases and refractive errors", "start": "body-15259", "end": "body-15306-textbox1-00005"}}