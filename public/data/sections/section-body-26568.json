{"id": "section-body-26568", "title": "Generalized Anxiety Disorder", "chapterId": "chapter-twenty-three", "blocks": [{"id": "body-26568", "type": "heading", "style": "Heading2", "text": "Generalized Anxiety Disorder", "runs": [{"text": "Generalized"}, {"text": " "}, {"text": "Anxiety"}, {"text": " "}, {"text": "Disorder"}], "level": 2, "list": {"level": 1, "numberingId": "381"}}, {"id": "body-26569", "type": "paragraph", "style": "BodyText", "text": "Generalized anxiety disorder is characterized by excessive, exaggerated anxiety and worry about everyday life events with no obvious reasons for worry.", "runs": [{"text": "Generalized"}, {"text": " "}, {"text": "anxiety"}, {"text": " "}, {"text": "disorder"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "characterized"}, {"text": " "}, {"text": "by"}, {"text": " "}, {"text": "excessive,"}, {"text": " "}, {"text": "exaggerated"}, {"text": " "}, {"text": "anxiety"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "worry"}, {"text": " "}, {"text": "about"}, {"text": " "}, {"text": "everyday"}, {"text": " "}, {"text": "life"}, {"text": " "}, {"text": "events"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "no obvious reasons for worry."}]}, {"id": "body-26571", "type": "heading", "style": "Heading4", "text": "Clinical Presentation", "runs": [{"text": "Clinical"}, {"text": " "}, {"text": "Presentation"}], "level": 4}, {"id": "body-26572", "type": "paragraph", "style": "ListParagraph", "text": "Persistent worry", "runs": [{"text": "Persistent"}, {"text": " "}, {"text": "worry"}], "list": {"level": 2, "numberingId": "381"}}, {"id": "body-26573", "type": "paragraph", "style": "ListParagraph", "text": "Disturbances in sleep", "runs": [{"text": "Disturbances"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "sleep"}], "list": {"level": 2, "numberingId": "381"}}, {"id": "body-26574", "type": "paragraph", "style": "ListParagraph", "text": "Poor concentration", "runs": [{"text": "Poor"}, {"text": " "}, {"text": "concentration"}], "list": {"level": 2, "numberingId": "381"}}, {"id": "body-26575", "type": "paragraph", "style": "ListParagraph", "text": "Mood disturbances", "runs": [{"text": "Mood"}, {"text": " "}, {"text": "disturbances"}], "list": {"level": 2, "numberingId": "381"}}, {"id": "body-26576", "type": "paragraph", "style": "ListParagraph", "text": "Muscle tension", "runs": [{"text": "Muscle"}, {"text": " "}, {"text": "tension"}], "list": {"level": 2, "numberingId": "381"}}, {"id": "body-26577", "type": "paragraph", "style": "ListParagraph", "text": "Tremors", "runs": [{"text": "Tremors"}], "list": {"level": 2, "numberingId": "381"}}, {"id": "body-26578", "type": "heading", "style": "Heading4", "text": "Non-Pharmacological Management", "runs": [{"text": "Non-Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-26579", "type": "paragraph", "style": "BodyText", "text": "Psychotherapy, most patients can be treated as outpatients", "runs": [{"text": "Psychotherapy,"}, {"text": " "}, {"text": "most"}, {"text": " "}, {"text": "patients"}, {"text": " "}, {"text": "can"}, {"text": " "}, {"text": "be"}, {"text": " "}, {"text": "treated"}, {"text": " "}, {"text": "as"}, {"text": " "}, {"text": "outpatients"}]}, {"id": "body-26581", "type": "heading", "style": "Heading4", "text": "Pharmacological Management", "runs": [{"text": "Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-26582", "type": "paragraph", "style": "BodyText", "text": "Indicated where symptoms are interfering with normal functions of daily living. Where there is concomitant drug/alcohol dependence or co-morbid major depressive episode, an antidepressant may be more appropriate.", "runs": [{"text": "Indicated"}, {"text": " "}, {"text": "where"}, {"text": " "}, {"text": "symptoms"}, {"text": " "}, {"text": "are"}, {"text": " "}, {"text": "interfering"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "normal"}, {"text":