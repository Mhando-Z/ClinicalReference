{"id": "section-body-14663", "title": "Herpes Zoster Ophthalmicus", "chapterId": "chapter-fourteen", "tocLevel": 4, "tocPath": ["APPROACH TO PATIENTS WITH EMERGENCY CONDITIONS", "EYE DISEASES AND REFRACTIVE ERRORS", "Painful Red Eyes", "Herpes Zoster Ophthalmicus"], "blocks": [{"id": "body-14663", "type": "heading", "style": "Heading4", "text": "Herpes Zoster Ophthalmicus", "runs": [{"text": "Herpes"}, {"text": " "}, {"text": "Zoster"}, {"text": " "}, {"text": "Ophthalmicus"}], "level": 4, "list": {"level": 3, "numberingId": "1271"}}, {"id": "body-14664", "type": "paragraph", "style": "BodyText", "text": "Occurs when Varicella Zoster Virus reactivates in the trigeminal ganglion and passes down the ophthalmic division of the trigeminal nerve", "runs": [{"text": "Occurs"}, {"text": " "}, {"text": "when"}, {"text": " "}, {"text": "Varicella"}, {"text": " "}, {"text": "Zoster"}, {"text": " "}, {"text": "Virus"}, {"text": " "}, {"text": "reactivates"}, {"text": " "}, {"text": "in"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "trigeminal"}, {"text": " "}, {"text": "ganglion"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "passes"}, {"text": " "}, {"text": "down"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "ophthalmic"}, {"text": " "}, {"text": "division"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "the trigeminal nerve"}]}, {"id": "body-14666", "type": "heading", "style": "Heading4", "text": "Clinical Presentation", "runs": [{"text": "Clinical"}, {"text": " "}, {"text": "Presentation"}], "level": 4}, {"id": "body-14667", "type": "paragraph", "style": "ListParagraph", "text": "Presents with painful vesicular rash in the trigeminal V1 area–vesicles on the tip of the nose indicate nasociliary branch involvement and increases the risk of ocular involvement", "runs": [{"text": "Presents"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "painful"}, {"text": " "}, {"text": "vesicular"}, {"text": " "}, {"text": "rash"},