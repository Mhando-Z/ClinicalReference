{"id": "section-body-17792", "title": "Viral Infections", "chapterId": "chapter-sixteen", "blocks": [{"id": "body-17792", "type": "heading", "style": "Heading2", "text": "Viral Infections", "runs": [{"text": "Viral"}, {"text": " "}, {"text": "Infections"}], "level": 2, "list": {"level": 1, "numberingId": "1126"}}, {"id": "body-17794", "type": "heading", "style": "Heading4", "text": "Herpes Simplex Virus", "runs": [{"text": "Herpes"}, {"text": " "}, {"text": "Simplex"}, {"text": " "}, {"text": "Virus"}], "level": 4, "list": {"level": 2, "numberingId": "1126"}}, {"id": "body-17795", "type": "paragraph", "style": "BodyText", "text": "This is a viral infection commonly affecting the lips and perioral soft tissues presenting as papulovesicular lesions which ultimately ulcerate. The primary infection affects mainly the gingiva and palate.", "runs": [{"text": "This"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "a"}, {"text": " "}, {"text": "viral"}, {"text": " "}, {"text": "infection"}, {"text": " "}, {"text": "commonly"}, {"text": " "}, {"text": "affecting"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "lips"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "perioral"}, {"text": " "}, {"text": "soft"}, {"text": " "}, {"text": "tissues"}, {"text": " "}, {"text": "presenting"}, {"text": " "}, {"text": "as"}, {"text": " "}, {"text": "papulovesicular"}, {"text": " "}, {"text": "lesions"}, {"text": " "}, {"text": "which ultimately ulcerate. The primary infection affects mainly the gingiva and palate."}]}, {"id": "body-17797", "type": "heading", "style": "Heading4", "text": "Clinical Presentation", "runs": [{"text": "Clinical"}, {"text": " "}, {"text": "Presentation"}], "level": 4}, {"id": "body-17798", "type": "paragraph", "style": "ListParagraph", "text": "A prodromal of tingling, warmth or itching at the site usually precedes the occurrence", "runs": [{"text": "A"}, {"text": " "}, {"text": "prodromal"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "tingling,"}, {"text": " "}, {"text": "warmth"}, {"text": " "}, {"text": "or"}, {"text": " "}, {"text": "itching"}, {"text": " "}, {"text": "at"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "site"}, {"text": " "}, {"text": "usually"}, {"text": " "}, {"text": "precedes"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "occurrence"}], "list": {"level": 0, "numberingId": "1102"}}, {"id": "body-17799", "type": "paragraph", "style": "ListParagraph", "text": "About 12 hours later, redness appears followed by papules and then vesicles", "runs": [{"text": "About"}, {"text": " "}, {"text": "12"}, {"text": " "}, {"text": "hours"}, {"text": " "}, {"text": "later,"}, {"text": " "}, {"text": "redness"}, {"text": " "}, {"text": "appears"}, {"text": " "}, {"text": "followed"}, {"text": " "}, {"text": "by"}, {"text": " "}, {"text": "papules"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "then"}, {"text": " "}, {"text": "vesicles"}], "list": {"level": 0, "numberingId": "1102"}}, {"id": "body-17800", "type": "paragraph", "style": "ListParagraph", "text": "These vesicles then burst, weep, dry, scab and then heal", "runs": [{"text": "These"}, {"text": " "}, {"text": "vesicles"}, {"text": " "}, {"text": "then"}, {"text": " "}, {"text": "burst,"}, {"text": " "}, {"text": "weep,"}, {"text": " "}, {"text": "dry,"}, {"text": " "}, {"text": "scab"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "then"}, {"text": " "}, {"text": "heal"}], "list": {"level": 0, "numberingId": "1102"}}, {"id": "body-17801", "type": "paragraph", "style": "ListParagraph", "text": "The length of the cycle is variable 5–12days mean time being 7days", "runs": [{"text": "The"}, {"text": " "}, {"text": "length"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "cycle"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "variable"}, {"text": " "}, {"text": "5–12days"}, {"text": " "}, {"text": "mean"}, {"text": " "}, {"text": "time"}, {"text": " "}, {"text": "being"}, {"text": " "}, {"text": "7days"}], "list": {"level": 0, "numberingId": "1102"}}, {"id": "body-17804", "type": "heading", "style": "Heading4", "text": "Non-Pharmacological Management", "runs": [{"text": "Non-Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-17805", "type": "paragraph", "style": "ListParagraph", "text": "Adequate hydration", "runs": [{"text": "Adequate"}, {"text": " "}, {"text": "hydration"}], "list": {"level": 0, "numberingId": "1102"}}, {"id": "body-17806", "type": "paragraph", "style": "ListParagraph", "text": "Avoid salty and acidic drinks", "runs": [{"text": "Avoid"}, {"text": " "}, {"text": "salty"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "acidic"}, {"text": " "}, {"text": "drinks"}], "list": {"level": 0, "numberingId": "1102"}}, {"id": "body-17807", "type": "paragraph", "style": "ListParagraph", "text": "Cover lesions on the lips with Petroleum jelly and control any underlying cause", "runs": [{"text": "Cover"}, {"text": " "}, {"text": "lesions"}, {"text": " "}, {"text": "on"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "lips"}, {"text": " "}, {"text": "with"}, {"text": " "}, {"text": "Petroleum"}, {"text": " "}, {"text": "jelly"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "control"}, {"text": " "}, {"text": "any"}, {"text": " "}, {"text": "underlying"}, {"text": " "}, {"text": "cause"}], "list": {"level": 0, "numberingId": "1102"}}, {"id": "body-17809", "type": "heading", "style": "Heading4", "text": "Pharmacological Management", "runs": [{"text": "Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-17810", "type": "paragraph", "style": "BodyText", "text": "This is an otherwise self-limiting condition but if persistent for 10days or recurrent infection use medication:", "runs": [{"text": "This"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "an"}, {"text": " "}, {"text": "ot