{"id": "section-body-15492", "title": "Ear Keloid", "chapterId": "chapter-fifteen", "tocLevel": 4, "tocPath": ["APPROACH TO PATIENTS WITH EMERGENCY CONDITIONS", "EAR, NOSE AND THROAT/HEAD AND NECK DISEASES", "Trauma of the Pinna", "Ear Keloid"], "blocks": [{"id": "body-15492", "type": "heading", "style": "Heading4", "text": "Ear Keloid", "runs": [{"text": "Ear"}, {"text": " "}, {"text": "Keloid"}], "level": 4, "list": {"level": 2, "numberingId": "1219"}}, {"id": "body-15493", "type": "paragraph", "style": "BodyText", "text": "This is abnormal proliferation of scar tissue that forms at the site of cutaneous injury and grows beyond the original margins of the scar. Most common causes are ear piercing, trauma or surgical incisions.", "runs": [{"text": "This"}, {"text": " "}, {"text": "is"}, {"text": " "}, {"text": "abnormal"}, {"text": " "}, {"text": "proliferation"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "scar"}, {"text": " "}, {"text": "tissue"}, {"text": " "}, {"text": "that"}, {"text": " "}, {"text": "forms"}, {"text": " "}, {"text": "at"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "site"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "cutaneous"}, {"text": " "}, {"text": "injury"}, {"text": " "}, {"text": "and"}, {"text": " "}, {"text": "grows"}, {"text": " "}, {"text": "beyond"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "original"}, {"text": " "}, {"text": "margins"}, {"text": " "}, {"text": "of the scar. Most common causes are ear piercing, trauma or surgical incisions."}]}, {"id": "body-15495", "type": "heading", "style": "Heading4", "text": "Clinical Presentation", "runs": [{"text": "Clinical"}, {"text": " "}, {"text": "Presentation"}], "level": 4}, {"id": "body-15496", "type": "paragraph", "style": "BodyText", "text": "Swelling of the involved area of the ear, most commonly ear lobe", "runs": [{"text": "Swelling"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "involved"}, {"text": " "}, {"text": "area"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "the"}, {"text": " "}, {"text": "ear,"}, {"text": " "}, {"text": "most"}, {"text": " "}, {"text": "commonly"}, {"text": " "}, {"text": "ear"}, {"text": " "}, {"text": "lobe"}]}, {"id": "body-15498", "type": "heading", "style": "Heading4", "text": "Non-Pharmacological Management", "runs": [{"text": "Non-Pharmacological"}, {"text": " "}, {"text": "Management"}], "level": 4}, {"id": "body-15499", "type": "paragraph", "style": "BodyText", "text": "Use of pressure therapy e.g., pressure clips", "runs": [{"text": "Use"}, {"text": " "}, {"text": "of"}, {"text": " "}, {"text": "pressure"}, {"text": " "}, {"text": "therapy"}, {"text": " "}, {"text": "e.g.,"}, {"text": " "}, {"text": "pressure"}, {"text": " "}, {"text": "clips"}]}, {"id": "body-15501", "type": "paragraph", "style": "BodyText", "text": "Intra-lesional steroid injection", "runs": [{"text": "Intra-lesional"}, {"text": " "}, {"text": "steroid"}, {"text": " "}, {"text": "injection"}]}, {"id": "body-15502", "type": "paragraph", "style": "BodyText", "text": "S: triamcinolone acetonide (Intra-lesional) 40mg depending on the size of the lesion weekly for 4weeks before excision and 4weeks after excision", "runs": [{"text": "S: ", "bold": true}, {"text": "triamcinolone acetonide (Intra-lesional) 40mg depending on the size of the lesion weekly for 4weeks before excision and 4weeks after excision"}]}, {"id": "body-15504", "type": "heading", "style": "Heading4", "text": "Surgical management", "runs": [{"text": "Surgical"}, {"text": " "}, {"text": "management"}], "level": 4}, {"id": "body-15505", "type": "paragraph", "style": "BodyText", "text": "Total keloidectomy +/- Steroid injection. (should be done by expertise, involve dermatologist/plastics for best decision)", "runs": [{"text": "Total"}, {"text": " "}, {"text": "keloidectomy"}, {"text": " "}, {"text": "+/-"}, {"text": " "}, {"text": "Steroid"}, {"text": " "}, {"text": "